@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.Inventory
@inject IToastService ToastService
@inject IModalService ModalService
@inject IMaterialCategoryService MaterialCategoryService
@inject IMaterialService MaterialService
@inject IMaterialBrandService MaterialBrandService

<div class="d-flex justify-content-end mb-2">
    <button class="btn btn-success" @onclick="OpenNewCategoryModal" type="button">
        <i class="bi bi-plus-lg"></i> Yeni Kategori
    </button>
</div>

@if (Categories?.Any() != true)
{
    <p>Kategori bulunamadi.</p>
}
else
{
    <GenericTable TItem="MaterialCategory"
                  Items="Categories"
                  PageSize="10"
                  PageSizeOptions="new[] { 10, 20, 50, 100 }"
                  TableHeight="Auto"
                  ShowSearch="true"
                  ShowExport="true"
                  ExportFileName="material-categories.xlsx"
                  KeySelector="(c => c.Id)"
                  TableClass="table-hover table-sm table-bordered">

        <HeaderTemplate>
            <th>Ad</th>
            <th>Açiklama</th>
            <th>Üst Kategori</th>
            <th class="text-center">Islemler</th>
        </HeaderTemplate>

        <RowTemplate Context="cat">
            <td class="align-middle">@cat.CategoryName</td>
            <td class="align-middle">@cat.Aciklama</td>
            <td class="align-middle">@GetParentCategoryName(cat.ParentCategoryId)</td>
            <td class="text-center align-middle" style="white-space:nowrap;">
                <button class="btn btn-sm btn-primary me-2" @onclick="() => OnEditClicked(cat)">Düzenle</button>
                <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteClicked(cat)">Sil</button>
            </td>
        </RowTemplate>
    </GenericTable>
}

@if (showEditModal && selectedCategory != null)
{
    <MaterialCategoryEditModal Category="@selectedCategory"
                              IsOpen="true"
                              OnSave="HandleSave"
                              OnClose="HideModal"
                              ParentCategories="Categories?.Where(x => x.Id != selectedCategory.Id).ToList()" />
}

@code
{
    [Parameter] public List<MaterialCategory> Categories { get; set; } = new();

    private readonly Dictionary<int, string> _categoryNameById = new();

    private MaterialCategory? selectedCategory;
    private bool showEditModal;

    protected override void OnParametersSet()
    {
        _categoryNameById.Clear();

        if (Categories != null)
        {
            foreach (var c in Categories)
            {
                _categoryNameById[c.Id] = c.CategoryName ?? string.Empty;
            }
        }
    }

    private string GetParentCategoryName(int? parentCategoryId)
        => parentCategoryId.HasValue && _categoryNameById.TryGetValue(parentCategoryId.Value, out var name) ? name : string.Empty;

    private Task OnEditClicked(MaterialCategory category)
    {
        selectedCategory = category;
        showEditModal = true;
        return Task.CompletedTask;
    }

    private async void HandleSave()
    {
        if (selectedCategory != null)
        {
            if (selectedCategory.Id == 0)
            {
                var saved = await MaterialCategoryService.AddAsync(selectedCategory);
                if (saved.IsSuccess)
                {
                    Categories.Add(selectedCategory);
                }
            }
            else
            {
                await MaterialCategoryService.UpdateAsync(selectedCategory);
            }

            showEditModal = false;
            StateHasChanged();
        }
    }

    private async Task OnDeleteClicked(MaterialCategory category)
    {
        var hasChildren = Categories.Any(m => m.ParentCategoryId == category.Id);
        if (hasChildren)
        {
            var childTitles = Categories
                .Where(m => m.ParentCategoryId == category.Id)
                .Select(m => m.CategoryName)
                .Where(title => !string.IsNullOrEmpty(title))
                .ToList();

            var childList = string.Join(", ", childTitles);
            var message = "Önce alt kategoriler silinmelidir.";
            if (childTitles.Count > 0)
            {
                message += $" Alt Kategoriler: {childList}";
            }

            ToastService.ShowToast(message, ToastType.Error, 5000);
            return;
        }

        var hasMaterialR = await MaterialService.AnyAsync(m => m.CategoryId == category.Id);
        var hasMaterial = hasMaterialR.IsSuccess && hasMaterialR.Value;
        if (hasMaterial)
        {
            ToastService.ShowToast("Bu kategoriye bagli malzemeler var, önce onlari silmelisiniz.", ToastType.Error, 5000);
            return;
        }

        var hasBrandR = await MaterialBrandService.AnyAsync(m => m.CategoryId == category.Id);
        var hasBrand = hasBrandR.IsSuccess && hasBrandR.Value;
        if (hasBrand)
        {
            ToastService.ShowToast("Bu kategoriye bagli markalar var, önce onlari silmelisiniz.", ToastType.Error, 5000);
            return;
        }

        ModalService.ShowConfirmation(
            "Silme Onayi",
            $"'{category.CategoryName}' kategorisini silmek istediginizden emin misiniz?",
            async result =>
            {
                if (!result)
                {
                    return;
                }

                var deleted = await MaterialCategoryService.DeleteAsync(category.Id);
                if (deleted.IsSuccess)
                {
                    ToastService.ShowToast($"{category.CategoryName} silindi", ToastType.Success, 3000);
                    Categories.Remove(category);
                    StateHasChanged();
                }
                else
                {
                    ToastService.ShowToast("Silme islemi basarisiz oldu", ToastType.Error, 3000);
                }
            });
    }

    private void HideModal()
    {
        selectedCategory = null;
        showEditModal = false;
    }

    private Task OpenNewCategoryModal()
    {
        selectedCategory = new MaterialCategory();
        showEditModal = true;
        return Task.CompletedTask;
    }
}
