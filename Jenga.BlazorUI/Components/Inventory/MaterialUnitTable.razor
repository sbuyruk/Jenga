@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.Inventory
@inject IMaterialService MaterialService
@inject IMaterialEntryService MaterialEntryService
@inject IMaterialUnitService MaterialUnitService
@inject IToastService ToastService
@inject IModalService ModalService

<h3>MaterialUnitTable</h3>

@if (CanCreate)
{
<div class="d-flex justify-content-end mb-2">
    <button class="btn btn-success" @onclick="OpenNewUnitModal" type="button">
        <i class="bi bi-plus-lg"></i> Yeni Birim
    </button>
</div>
}

@if (MaterialUnits?.Any() != true)
{
    <p>Tanimli birim yok.</p>
}
else
{
    <GenericTable TItem="MaterialUnit"
                  Items="MaterialUnits"
                  PageSize="10"
                  PageSizeOptions="new[] { 10, 20, 50, 100 }"
                  TableHeight="Auto"
                  ShowSearch="true"
                  ShowExport="true"
                  ExportFileName="material-units.xlsx"
                  KeySelector="(u => u.Id)"
                  TableClass="table-hover table-sm table-bordered">

        <HeaderTemplate>
            <th>Birim Adi</th>
            <th>Sembol</th>
            <th>Açiklama</th>
            <th class="text-center">Islemler</th>
        </HeaderTemplate>

        <RowTemplate Context="unit">
            <td class="align-middle">@unit.Name</td>
            <td class="align-middle">@unit.Symbol</td>
            <td class="align-middle">@unit.Aciklama</td>
            <td class="text-center align-middle" style="white-space:nowrap;">
                @if (CanEdit)
                {
                    <button class="btn btn-sm btn-primary me-2" @onclick="() => OnEditClicked(unit)">Düzenle</button>
                }
                @if (CanDelete)
                {
                    <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteClicked(unit)">Sil</button>
                }
            </td>
        </RowTemplate>
    </GenericTable>
}

@if (showEditModal && selectedUnit != null)
{
    <MaterialUnitEditModal MaterialUnit="@selectedUnit"
                          IsOpen="true"
                          OnSave="HandleSave"
                          OnClose="HideModal" />
}

@code {
    [Parameter] public List<MaterialUnit> MaterialUnits { get; set; } = new();
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public bool CanCreate { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }

    private MaterialUnit? selectedUnit;
    private bool showEditModal;

    private void OnEditClicked(MaterialUnit unit)
    {
        selectedUnit = unit;
        showEditModal = true;
    }

    private async Task HandleSave()
    {
        if (selectedUnit != null)
        {
            if (selectedUnit.Id == 0)
            {
                var saved = await MaterialUnitService.AddAsync(selectedUnit);
                if (saved.IsSuccess)
                {
                    MaterialUnits.Add(selectedUnit);
                    ToastService.ShowToast($"{selectedUnit.Name} eklendi.", ToastType.Success, 3000);
                }
                else
                {
                    ToastService.ShowToast(saved.Error?.Message ?? "Birim eklenemedi.", ToastType.Error, 5000);
                    return;
                }
            }
            else
            {
                var updated = await MaterialUnitService.UpdateAsync(selectedUnit);
                if (updated.IsSuccess)
                {
                    ToastService.ShowToast($"{selectedUnit.Name} güncellendi.", ToastType.Success, 3000);
                }
                else
                {
                    ToastService.ShowToast(updated.Error?.Message ?? "Birim güncellenemedi.", ToastType.Error, 5000);
                    return;
                }
            }

            showEditModal = false;

            if (OnRefresh.HasDelegate)
                await OnRefresh.InvokeAsync();

            StateHasChanged();
        }
    }

    private async Task OnDeleteClicked(MaterialUnit unit)
    {
        var hasMaterialResult = await MaterialService.AnyAsync(m => m.MaterialUnitId == unit.Id);
        var hasMaterial = hasMaterialResult.IsSuccess && hasMaterialResult.Value;
        if (hasMaterial)
        {
            ToastService.ShowToast("Bu birimi kullanan malzemeler var, önce onlari silmelisiniz.", ToastType.Error, 5000);
            return;
        }

        var hasEntryResult = await MaterialEntryService.AnyAsync(m => m.MaterialUnitId == unit.Id);
        var hasEntry = hasEntryResult.IsSuccess && hasEntryResult.Value;
        if (hasEntry)
        {
            ToastService.ShowToast("Bu birime bagli malzeme girisleri var, önce onlari silmelisiniz.", ToastType.Error, 5000);
            return;
        }

        ModalService.ShowConfirmation(
            "Silme Onayi",
            $"'{unit.Name}' birimini silmek istediginizden emin misiniz?",
            async result =>
            {
                if (!result)
                {
                    return;
                }

                var deleted = await MaterialUnitService.DeleteAsync(unit);
                if (deleted.IsSuccess)
                {
                    ToastService.ShowToast($"{unit.Name} silindi.", ToastType.Success, 3000);
                    MaterialUnits.Remove(unit);

                    if (OnRefresh.HasDelegate)
                        await OnRefresh.InvokeAsync();

                    StateHasChanged();
                }
                else
                {
                    ToastService.ShowToast("Silme islemi basarisiz oldu", ToastType.Error, 3000);
                }
            });
    }

    private void HideModal()
    {
        selectedUnit = null;
        showEditModal = false;
    }

    private Task OpenNewUnitModal()
    {
        selectedUnit = new MaterialUnit();
        showEditModal = true;
        return Task.CompletedTask;
    }
}
