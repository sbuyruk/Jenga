@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.Inventory
@inject IToastService ToastService
@inject IModalService ModalService
@inject IMaterialBrandService MaterialBrandService
@inject IMaterialEntryService MaterialEntryService

<div class="d-flex justify-content-end mb-2">
    <button class="btn btn-success" @onclick="OpenNewBrandModal" type="button">
        <i class="bi bi-plus-lg"></i> Yeni Marka
    </button>
</div>

@if (Brands?.Any() != true)
{
    <p>Marka bulunamadi.</p>
}
else
{
    <GenericTable TItem="MaterialBrand"
                  @ref="brandTable"
                  Items="Brands"
                  PageSize="10"
                  PageSizeOptions="new[] { 10, 20, 50, 100 }"
                  TableHeight="Auto"
                  ShowSearch="true"
                  ShowExport="true"
                  ExportFileName="material-brands.xlsx"
                  KeySelector="(b => b.Id)"
                  TableClass="table-hover table-sm table-bordered">

        <HeaderTemplate>
            <th role="button" @onclick="() => OnSort(nameof(MaterialBrand.BrandName))">
                <span class="d-inline-flex align-items-center">
                    <span>Ad</span>
                    <i class="@GetSortIcon(nameof(MaterialBrand.BrandName))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialBrand.CategoryId))">
                <span class="d-inline-flex align-items-center">
                    <span>Kategori</span>
                    <i class="@GetSortIcon(nameof(MaterialBrand.CategoryId))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialBrand.Aciklama))">
                <span class="d-inline-flex align-items-center">
                    <span>Açiklama</span>
                    <i class="@GetSortIcon(nameof(MaterialBrand.Aciklama))"></i>
                </span>
            </th>
            <th class="text-center">Islemler</th>
        </HeaderTemplate>

        <RowTemplate Context="brand">
            <td class="align-middle">@brand.BrandName</td>
            <td class="align-middle">@GetCategoryName(brand.CategoryId)</td>
            <td class="align-middle">@brand.Aciklama</td>
            <td class="text-center align-middle" style="white-space:nowrap;">
                <button class="btn btn-sm btn-primary me-2" @onclick="() => OnEditClicked(brand)">Düzenle</button>
                <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteClicked(brand)">Sil</button>
            </td>
        </RowTemplate>
    </GenericTable>
}

@if (showEditModal && selectedBrand != null)
{
    <MaterialBrandEditModal Brand="@selectedBrand"
                           Categories="@Categories"
                           IsOpen="true"
                           OnSave="HandleSave"
                           OnClose="HideModal" />
}

@code
{
    [Parameter] public List<MaterialBrand> Brands { get; set; } = new();
    [Parameter] public List<MaterialCategory> Categories { get; set; } = new();

    private readonly Dictionary<int, string> _categoryNameById = new();

    private GenericTable<MaterialBrand>? brandTable;
    private MaterialBrand? selectedBrand;
    private bool showEditModal;

    protected override void OnParametersSet()
    {
        _categoryNameById.Clear();

        if (Categories != null)
        {
            foreach (var c in Categories)
            {
                _categoryNameById[c.Id] = c.CategoryName ?? string.Empty;
            }
        }
    }

    private string GetCategoryName(int? categoryId)
        => categoryId.HasValue && _categoryNameById.TryGetValue(categoryId.Value, out var name) ? name : string.Empty;

    private void OnSort(string field)
    {
        brandTable?.SortBy(field);
    }

    private string GetSortIcon(string field)
    {
        if (brandTable?.CurrentSortField != field)
        {
            return "bi bi-arrow-down-up ms-2 text-muted";
        }

        return brandTable.CurrentSortDescending
            ? "bi bi-caret-down-fill ms-2"
            : "bi bi-caret-up-fill ms-2";
    }

    private void OnEditClicked(MaterialBrand brand)
    {
        selectedBrand = brand;
        showEditModal = true;
    }

    private async void HandleSave()
    {
        if (selectedBrand != null)
        {
            if (selectedBrand.Id == 0)
            {
                var saved = await MaterialBrandService.AddAsync(selectedBrand);
                if (saved.IsSuccess)
                {
                    Brands.Add(selectedBrand);
                }
            }
            else
            {
                await MaterialBrandService.UpdateAsync(selectedBrand);
            }

            showEditModal = false;
            StateHasChanged();
        }
    }

    private async Task OnDeleteClicked(MaterialBrand brand)
    {
        var hasMaterialEntryR = await MaterialEntryService.AnyAsync(m => m.BrandId == brand.Id);
        var hasMaterialEntry = hasMaterialEntryR.IsSuccess && hasMaterialEntryR.Value;
        if (hasMaterialEntry)
        {
            ToastService.ShowToast("Bu marka bir malzeme girisinde kullaniliyor, önce onu silmelisiniz.", ToastType.Error, 5000);
            return;
        }

        ModalService.ShowConfirmation(
            "Silme Onayi",
            $"'{brand.BrandName}' markasini silmek istediginizden emin misiniz?",
            async result =>
            {
                if (!result)
                {
                    return;
                }

                var deleted = await MaterialBrandService.DeleteAsync(brand);
                if (deleted.IsSuccess)
                {
                    ToastService.ShowToast($"{brand.BrandName} silindi", ToastType.Success, 3000);
                    Brands.Remove(brand);
                    StateHasChanged();
                }
                else
                {
                    ToastService.ShowToast("Silme islemi basarisiz oldu", ToastType.Error, 3000);
                }
            });
    }

    private void HideModal()
    {
        selectedBrand = null;
        showEditModal = false;
    }

    private Task OpenNewBrandModal()
    {
        selectedBrand = new MaterialBrand();
        showEditModal = true;
        return Task.CompletedTask;
    }
}
