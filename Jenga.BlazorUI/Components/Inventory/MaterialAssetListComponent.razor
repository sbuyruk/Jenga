<h3>MaterialAssetListComponent</h3>

@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.IKYS
@using Jenga.Models.Inventory

@inject IMaterialAssetService MaterialAssetService
@inject IMaterialService MaterialService
@inject IMaterialBrandService MaterialBrandService
@inject IMaterialModelService MaterialModelService
@inject ILocationService LocationService
@inject IToastService ToastService

<div class="card shadow-sm">
    <div class="card-header bg-primary-subtle d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="bi bi-cpu me-1"></i> Demirbas (Asset) Kayitlari</h6>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAssets">
            <i class="bi bi-arrow-clockwise"></i> Yenile
        </button>
    </div>
    <div class="card-body p-0">
        @if (assets == null || !assets.Any())
        {
            <div class="text-muted text-center p-3">Henüz demirbas kaydi bulunmuyor.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Malzeme</th>
                            <th>Marka</th>
                            <th>Model</th>
                            <th>Seri No</th>
                            <th>Barkod</th>
                            <th>Satin Alma</th>
                            <th>Garanti Bitis</th>
                            <th>Durum</th>
                            <th>Lokasyon</th>
                            <th>Personel</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asset in assets)
                        {
                            <tr>
                                <td>@GetMaterialName(asset.MaterialId)</td>
                                <td>@GetBrandName(asset.BrandId)</td>
                                <td>@GetModelName(asset.ModelId)</td>
                                <td>
                                    @if (editingAssetId == asset.Id)
                                    {
                                        <input class="form-control form-control-sm" @bind="editForm.SerialNumber" />
                                    }
                                    else
                                    {
                                        <span class="@(string.IsNullOrEmpty(asset.SerialNumber) ? "text-muted fst-italic" : "")">
                                            @(string.IsNullOrEmpty(asset.SerialNumber) ? "Girilmedi" : asset.SerialNumber)
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (editingAssetId == asset.Id)
                                    {
                                        <input class="form-control form-control-sm" @bind="editForm.Barcode" />
                                    }
                                    else
                                    {
                                        <span class="@(string.IsNullOrEmpty(asset.Barcode) ? "text-muted fst-italic" : "")">
                                            @(string.IsNullOrEmpty(asset.Barcode) ? "Girilmedi" : asset.Barcode)
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (editingAssetId == asset.Id)
                                    {
                                        <input class="form-control form-control-sm" type="date" @bind="editForm.PurchaseDate" />
                                    }
                                    else
                                    {
                                        @(asset.PurchaseDate?.ToString("dd.MM.yyyy") ?? "-")
                                    }
                                </td>
                                <td>
                                    @if (editingAssetId == asset.Id)
                                    {
                                        <input class="form-control form-control-sm" type="date" @bind="editForm.WarrantyExpiry" />
                                    }
                                    else
                                    {
                                        @(asset.WarrantyExpiry?.ToString("dd.MM.yyyy") ?? "-")
                                    }
                                </td>
                                <td>
                                    @if (editingAssetId == asset.Id)
                                    {
                                        <select class="form-select form-select-sm" @bind="editForm.Status">
                                            @foreach (var s in Enum.GetValues<AssetStatus>())
                                            {
                                                <option value="@s">@GetStatusLabel(s)</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="badge @GetStatusBadgeClass(asset.Status)">@GetStatusLabel(asset.Status)</span>
                                    }
                                </td>
                                <td>@GetLocationName(asset.LocationId)</td>
                                <td>@GetPersonelName(asset.PersonelId)</td>
                                <td>
                                    @if (editingAssetId == asset.Id)
                                    {
                                        <button class="btn btn-sm btn-success me-1" @onclick="SaveEdit">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(asset)" title="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int? FilterMaterialId { get; set; }
    [Parameter] public List<Location> Locations { get; set; } = new();
    [Parameter] public List<Personel> Persons { get; set; } = new();

    private List<MaterialAsset> assets = new();
    private List<Material> materials = new();
    private List<MaterialBrand> brands = new();
    private List<MaterialModel> models = new();

    private int? editingAssetId;
    private AssetEditForm editForm = new();

    protected override async Task OnInitializedAsync()
    {
        var t1 = MaterialService.GetAllAsync();
        var t2 = MaterialBrandService.GetAllAsync();
        var t3 = MaterialModelService.GetAllAsync();

        await Task.WhenAll(t1, t2, t3);

        materials = t1.Result.IsSuccess ? t1.Result.Value : new();
        brands = t2.Result.IsSuccess ? t2.Result.Value : new();
        models = t3.Result.IsSuccess ? t3.Result.Value : new();

        await LoadAssets();
    }

    private async Task LoadAssets()
    {
        if (FilterMaterialId.HasValue)
        {
            var r = await MaterialAssetService.GetByMaterialIdAsync(FilterMaterialId.Value);
            assets = r.IsSuccess ? r.Value : new();
        }
        else
        {
            var r = await MaterialAssetService.GetAllAsync();
            assets = r.IsSuccess ? r.Value : new();
        }

        StateHasChanged();
    }

    private void StartEdit(MaterialAsset asset)
    {
        editingAssetId = asset.Id;
        editForm = new AssetEditForm
        {
            SerialNumber = asset.SerialNumber,
            Barcode = asset.Barcode,
            PurchaseDate = asset.PurchaseDate,
            WarrantyExpiry = asset.WarrantyExpiry,
            Status = asset.Status
        };
    }

    private void CancelEdit()
    {
        editingAssetId = null;
        editForm = new();
    }

    private async Task SaveEdit()
    {
        if (editingAssetId == null) return;

        var asset = assets.FirstOrDefault(a => a.Id == editingAssetId);
        if (asset == null) return;

        asset.SerialNumber = editForm.SerialNumber;
        asset.Barcode = editForm.Barcode;
        asset.PurchaseDate = editForm.PurchaseDate;
        asset.WarrantyExpiry = editForm.WarrantyExpiry;
        asset.Status = editForm.Status;

        await MaterialAssetService.UpdateAsync(asset);
        ToastService.ShowSuccess("Demirbas bilgileri güncellendi.");

        editingAssetId = null;
        editForm = new();
        await LoadAssets();
    }

    private string GetMaterialName(int id) => materials.FirstOrDefault(m => m.Id == id)?.MaterialName ?? "-";
    private string GetBrandName(int? id) => id.HasValue ? brands.FirstOrDefault(b => b.Id == id)?.BrandName ?? "-" : "-";
    private string GetModelName(int? id) => id.HasValue ? models.FirstOrDefault(m => m.Id == id)?.ModelName ?? "-" : "-";
    private string GetLocationName(int? id) => id.HasValue ? Locations.FirstOrDefault(l => l.Id == id)?.LocationName ?? "-" : "-";
    private string GetPersonelName(int? id)
    {
        if (!id.HasValue) return "-";
        var p = Persons.FirstOrDefault(x => x.Id == id);
        return p != null ? $"{p.Adi} {p.Soyadi}" : "-";
    }

    private string GetStatusLabel(AssetStatus status) => status switch
    {
        AssetStatus.Active => "Aktif",
        AssetStatus.InRepair => "Onarimda",
        AssetStatus.Retired => "Hurda",
        AssetStatus.Lost => "Kayip",
        _ => status.ToString()
    };

    private string GetStatusBadgeClass(AssetStatus status) => status switch
    {
        AssetStatus.Active => "bg-success",
        AssetStatus.InRepair => "bg-warning text-dark",
        AssetStatus.Retired => "bg-secondary",
        AssetStatus.Lost => "bg-danger",
        _ => "bg-light text-dark"
    };

    private class AssetEditForm
    {
        public string? SerialNumber { get; set; }
        public string? Barcode { get; set; }
        public DateTime? PurchaseDate { get; set; }
        public DateTime? WarrantyExpiry { get; set; }
        public AssetStatus Status { get; set; }
    }
}
