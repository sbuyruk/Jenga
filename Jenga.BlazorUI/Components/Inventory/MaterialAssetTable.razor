@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.IKYS
@using Jenga.Models.Inventory
@using Jenga.Utility.Toast

@inject IMaterialAssetService MaterialAssetService
@inject IMaterialAssetLogService MaterialAssetLogService
@inject IToastService ToastService
@inject IModalService ModalService

@if (Assets?.Any() != true)
{
    <div class="text-muted text-center p-4">Kayıt bulunamadı.</div>
}
else
{
    <GenericTable TItem="MaterialAsset"
                  @ref="assetTable"
                  Items="Assets"
                  KeySelector="a => a.Id"
                  SearchTextSelector="GetAssetSearchText"
                  RowClassSelector="GetAssetRowClass"
                  TableHeight="Auto"
                  TableClass="table-sm table-hover align-middle"
                  ShowSearch="true"
                  ShowCopy="true"
                  ShowExport="true"
                  ExportFileName="demirbaslar.xlsx"
                  ExportHeaders="exportHeaders"
                  ExportRow="GetExportRow"
                  PageSize="10">

        <HeaderTemplate>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.MaterialId))">
                <span class="d-inline-flex align-items-center">
                    <span>Malzeme</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.MaterialId))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.BrandId))">
                <span class="d-inline-flex align-items-center">
                    <span>Marka</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.BrandId))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.ModelId))">
                <span class="d-inline-flex align-items-center">
                    <span>Model</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.ModelId))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.SerialNumber))">
                <span class="d-inline-flex align-items-center">
                    <span>Seri No</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.SerialNumber))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.Barcode))">
                <span class="d-inline-flex align-items-center">
                    <span>Barkod</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.Barcode))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.PurchaseDate))">
                <span class="d-inline-flex align-items-center">
                    <span>Satın Alma</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.PurchaseDate))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.WarrantyExpiry))">
                <span class="d-inline-flex align-items-center">
                    <span>Garanti Bitiş</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.WarrantyExpiry))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.Status))">
                <span class="d-inline-flex align-items-center">
                    <span>Durum</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.Status))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.LocationId))">
                <span class="d-inline-flex align-items-center">
                    <span>Lokasyon</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.LocationId))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.PersonelId))">
                <span class="d-inline-flex align-items-center">
                    <span>Personel</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.PersonelId))"></i>
                </span>
            </th>
            <th class="text-center" style="width:120px;">İşlemler</th>
        </HeaderTemplate>

        <RowTemplate Context="asset">
            <td>@GetMaterialName(asset.MaterialId)</td>
            <td>@GetBrandName(asset.BrandId)</td>
            <td>@GetModelName(asset.ModelId)</td>

            <td>
                @if (editingAssetId == asset.Id)
                {
                    <input class="form-control form-control-sm" @bind="editForm.SerialNumber" placeholder="Seri No" />
                }
                else
                {
                    <span class="@(string.IsNullOrEmpty(asset.SerialNumber) ? "text-muted fst-italic" : "fw-semibold")">
                        @(string.IsNullOrEmpty(asset.SerialNumber) ? "—" : asset.SerialNumber)
                    </span>
                }
            </td>

            <td>
                @if (editingAssetId == asset.Id)
                {
                    <input class="form-control form-control-sm" @bind="editForm.Barcode" placeholder="Barkod" />
                }
                else
                {
                    <span class="@(string.IsNullOrEmpty(asset.Barcode) ? "text-muted fst-italic" : "")">
                        @(string.IsNullOrEmpty(asset.Barcode) ? "—" : asset.Barcode)
                    </span>
                }
            </td>

            <td>
                @if (editingAssetId == asset.Id)
                {
                    <input class="form-control form-control-sm" type="date" @bind="editForm.PurchaseDate" />
                }
                else
                {
                    @(asset.PurchaseDate?.ToString("dd.MM.yyyy") ?? "—")
                }
            </td>

            <td>
                @if (editingAssetId == asset.Id)
                {
                    <input class="form-control form-control-sm" type="date" @bind="editForm.WarrantyExpiry" />
                }
                else
                {
                    var warranty = asset.WarrantyExpiry;
                    var isExpired = warranty.HasValue && warranty.Value < DateTime.Today;
                    <span class="@(isExpired ? "text-danger fw-semibold" : "")">
                        @(warranty?.ToString("dd.MM.yyyy") ?? "—")
                        @if (isExpired)
                        {
                            <i class="bi bi-exclamation-triangle-fill ms-1" title="Garanti süresi dolmuş"></i>
                        }
                    </span>
                }
            </td>

            <td>
                @if (editingAssetId == asset.Id)
                {
                    <select class="form-select form-select-sm" @bind="editForm.Status">
                        @foreach (var s in Enum.GetValues<AssetStatus>())
                        {
                            <option value="@s">@GetStatusLabel(s)</option>
                        }
                    </select>
                }
                else
                {
                    <span class="badge @GetStatusBadgeClass(asset.Status)">@GetStatusLabel(asset.Status)</span>
                }
            </td>

            <td>@GetLocationName(asset.LocationId)</td>
            <td>@GetPersonelName(asset.PersonelId)</td>

            <td class="text-center">
                @if (editingAssetId == asset.Id)
                {
                    <button class="btn btn-sm btn-success me-1" @onclick="SaveEdit" title="Kaydet">
                        <i class="bi bi-check-lg"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit" title="İptal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(asset)" title="Düzenle">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-info me-1" @onclick="() => ShowLog(asset)" title="Geçmiş">
                        <i class="bi bi-clock-history"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(asset)" title="Sil">
                        <i class="bi bi-trash"></i>
                    </button>
                }
            </td>
        </RowTemplate>

        <DetailRowTemplate Context="asset">
            @if (showingLogAssetId == asset.Id && assetLogs.Any())
            {
                <tr>
                    <td colspan="11" class="bg-light p-2">
                        <div class="small">
                            <strong>Zimmet / Transfer Geçmişi</strong>
                            <table class="table table-sm table-borderless mb-0 mt-1">
                                <thead>
                                    <tr class="text-muted">
                                        <th>Tarih</th>
                                        <th>İşlem</th>
                                        <th>Kimden</th>
                                        <th>Kime</th>
                                        <th>Nereden</th>
                                        <th>Nereye</th>
                                        <th>Açıklama</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in assetLogs)
                                    {
                                        <tr>
                                            <td>@log.TransactionDate.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td><span class="badge bg-info text-dark">@log.TransactionType</span></td>
                                            <td>@GetPersonelName(log.FromPersonelId)</td>
                                            <td>@GetPersonelName(log.ToPersonelId)</td>
                                            <td>@GetLocationName(log.FromLocationId)</td>
                                            <td>@GetLocationName(log.ToLocationId)</td>
                                            <td class="text-muted">@(log.Aciklama ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            }
        </DetailRowTemplate>
    </GenericTable>
}

@code
{
    [Parameter] public List<MaterialAsset> Assets { get; set; } = new();
    [Parameter] public List<Material> Materials { get; set; } = new();
    [Parameter] public List<MaterialBrand> Brands { get; set; } = new();
    [Parameter] public List<MaterialModel> Models { get; set; } = new();
    [Parameter] public List<Location> Locations { get; set; } = new();
    [Parameter] public List<Personel> Persons { get; set; } = new();
    [Parameter] public EventCallback OnDataChanged { get; set; }

    private GenericTable<MaterialAsset>? assetTable;
    private List<MaterialAssetLog> assetLogs = new();

    private int? editingAssetId;
    private int? showingLogAssetId;
    private AssetEditForm editForm = new();

    private static readonly IReadOnlyList<string> exportHeaders = new[]
    {
        "Malzeme", "Marka", "Model", "Seri No", "Barkod",
        "Satın Alma", "Garanti Bitiş", "Durum", "Lokasyon", "Personel"
    };

    private readonly Dictionary<int, string> _materialNameById = new();
    private readonly Dictionary<int, string> _brandNameById = new();
    private readonly Dictionary<int, string> _modelNameById = new();
    private readonly Dictionary<int, string> _locationNameById = new();
    private readonly Dictionary<int, string> _personelNameById = new();

    protected override void OnParametersSet()
    {
        RebuildLookups();
    }

    private void RebuildLookups()
    {
        _materialNameById.Clear();
        _brandNameById.Clear();
        _modelNameById.Clear();
        _locationNameById.Clear();
        _personelNameById.Clear();

        if (Materials != null)
            foreach (var m in Materials)
                _materialNameById[m.Id] = m.MaterialName ?? "—";

        if (Brands != null)
            foreach (var b in Brands)
                _brandNameById[b.Id] = b.BrandName ?? "—";

        if (Models != null)
            foreach (var m in Models)
                _modelNameById[m.Id] = m.ModelName ?? "—";

        if (Locations != null)
            foreach (var l in Locations)
                _locationNameById[l.Id] = l.LocationName ?? "—";

        if (Persons != null)
            foreach (var p in Persons)
                _personelNameById[p.Id] = $"{p.Adi} {p.Soyadi}";
    }

    #region Sort

    private void OnSort(string field) => assetTable?.SortBy(field);

    private string GetSortIcon(string field)
    {
        if (assetTable?.CurrentSortField != field)
            return "bi bi-arrow-down-up ms-2 text-muted";

        return assetTable.CurrentSortDescending
            ? "bi bi-caret-down-fill ms-2"
            : "bi bi-caret-up-fill ms-2";
    }

    #endregion

    #region Inline Edit

    private void StartEdit(MaterialAsset asset)
    {
        editingAssetId = asset.Id;
        showingLogAssetId = null;
        editForm = new AssetEditForm
        {
            SerialNumber = asset.SerialNumber,
            Barcode = asset.Barcode,
            PurchaseDate = asset.PurchaseDate,
            WarrantyExpiry = asset.WarrantyExpiry,
            Status = asset.Status
        };
    }

    private void CancelEdit()
    {
        editingAssetId = null;
        editForm = new();
    }

    private async Task SaveEdit()
    {
        if (editingAssetId == null) return;
        var asset = Assets.FirstOrDefault(a => a.Id == editingAssetId);
        if (asset == null) return;

        asset.SerialNumber = editForm.SerialNumber;
        asset.Barcode = editForm.Barcode;
        asset.PurchaseDate = editForm.PurchaseDate;
        asset.WarrantyExpiry = editForm.WarrantyExpiry;
        asset.Status = editForm.Status;

        await MaterialAssetService.UpdateAsync(asset);
        ToastService.ShowSuccess("Demirbaş bilgileri güncellendi.");

        editingAssetId = null;
        editForm = new();
        await OnDataChanged.InvokeAsync();
    }

    #endregion

    #region Log

    private async Task ShowLog(MaterialAsset asset)
    {
        if (showingLogAssetId == asset.Id)
        {
            showingLogAssetId = null;
            assetLogs.Clear();
            return;
        }

        showingLogAssetId = asset.Id;
        editingAssetId = null;
        var assetLogsR = await MaterialAssetLogService.GetByAssetIdAsync(asset.Id);
        assetLogs = assetLogsR.IsSuccess ? assetLogsR.Value : new();
        StateHasChanged();
    }

    #endregion

    #region Delete

    private void ConfirmDelete(MaterialAsset asset)
    {
        ModalService.ShowConfirmation(
            "Demirbaş Silme",
            $"'{asset.SerialNumber ?? $"ID:{asset.Id}"}' silinsin mi?",
            async (confirmed) =>
            {
                if (confirmed)
                {
                    await MaterialAssetService.DeleteAsync(asset);
                    ToastService.ShowSuccess("Demirbaş silindi.");
                    await OnDataChanged.InvokeAsync();
                }
            });
    }

    #endregion

    #region Helpers

    private string GetAssetSearchText(MaterialAsset a) =>
        $"{a.SerialNumber} {a.Barcode} {GetBrandName(a.BrandId)} {GetModelName(a.ModelId)} {GetPersonelName(a.PersonelId)} {GetLocationName(a.LocationId)}";
    private string GetAssetRowClass(MaterialAsset a) => editingAssetId == a.Id ? "table-warning" : "";

    private string GetMaterialName(int id)
        => _materialNameById.TryGetValue(id, out var name) ? name : "—";

    private string GetBrandName(int? id)
        => id.HasValue && _brandNameById.TryGetValue(id.Value, out var name) ? name : "—";

    private string GetModelName(int? id)
        => id.HasValue && _modelNameById.TryGetValue(id.Value, out var name) ? name : "—";

    private string GetLocationName(int? id)
        => id.HasValue && _locationNameById.TryGetValue(id.Value, out var name) ? name : "—";

    private string GetPersonelName(int? id)
        => id.HasValue && _personelNameById.TryGetValue(id.Value, out var name) ? name : "—";

    private string GetStatusLabel(AssetStatus status) => status switch
    {
        AssetStatus.Active => "Aktif",
        AssetStatus.InRepair => "Onarımda",
        AssetStatus.Retired => "Hurda",
        AssetStatus.Lost => "Kayıp",
        _ => status.ToString()
    };

    private string GetStatusBadgeClass(AssetStatus status) => status switch
    {
        AssetStatus.Active => "bg-success",
        AssetStatus.InRepair => "bg-warning text-dark",
        AssetStatus.Retired => "bg-secondary",
        AssetStatus.Lost => "bg-danger",
        _ => "bg-light text-dark"
    };

    private IReadOnlyList<object?> GetExportRow(MaterialAsset a) => new object?[]
    {
        GetMaterialName(a.MaterialId),
        GetBrandName(a.BrandId),
        GetModelName(a.ModelId),
        a.SerialNumber ?? "—",
        a.Barcode ?? "—",
        a.PurchaseDate?.ToString("dd.MM.yyyy") ?? "—",
        a.WarrantyExpiry?.ToString("dd.MM.yyyy") ?? "—",
        GetStatusLabel(a.Status),
        GetLocationName(a.LocationId),
        GetPersonelName(a.PersonelId)
    };

    #endregion

    private class AssetEditForm
    {
        public string? SerialNumber { get; set; }
        public string? Barcode { get; set; }
        public DateTime? PurchaseDate { get; set; }
        public DateTime? WarrantyExpiry { get; set; }
        public AssetStatus Status { get; set; }
    }
}