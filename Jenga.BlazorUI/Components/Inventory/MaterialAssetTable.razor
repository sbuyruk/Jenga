@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.IKYS
@using Jenga.Models.Inventory

@inject IMaterialAssetService MaterialAssetService
@inject IMaterialAssetLogService MaterialAssetLogService
@inject IMaterialEntryService MaterialEntryService
@inject IMaterialExitService MaterialExitService
@inject IMaterialTransferService MaterialTransferService
@inject IMaterialInventoryService MaterialInventoryService
@inject IToastService ToastService
@inject IModalService ModalService
@inject ICurrentUserService CurrentUserService

@if (Assets?.Any() != true)
{
    <div class="text-muted text-center p-4">Kayit bulunamadi.</div>
}
else
{
    <GenericTable TItem="MaterialAsset"
                  @ref="assetTable"
                  Items="Assets"
                  KeySelector="a => a.Id"
                  SearchTextSelector="GetAssetSearchText"
                  RowClassSelector="GetAssetRowClass"
                  TableHeight="Auto"
                  TableClass="table-sm table-hover align-middle"
                  ShowSearch="true"
                  ShowCopy="true"
                  ShowExport="true"
                  ExportFileName="demirbaslar.xlsx"
                  ExportHeaders="exportHeaders"
                  ExportRow="GetExportRow"
                  PageSize="10">

        <HeaderTemplate>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.MaterialId))">
                <span class="d-inline-flex align-items-center">
                    <span>Malzeme</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.MaterialId))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.BrandId))" style="width:100px;">
                <span class="d-inline-flex align-items-center">
                    <span>Marka</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.BrandId))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.ModelId))" style="width:100px;">
                <span class="d-inline-flex align-items-center">
                    <span>Model</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.ModelId))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.SerialNumber))" style="width:110px;">
                <span class="d-inline-flex align-items-center">
                    <span>Seri No</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.SerialNumber))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.Status))" style="width:90px;">
                <span class="d-inline-flex align-items-center">
                    <span>Durum</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.Status))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.LocationId))">
                <span class="d-inline-flex align-items-center">
                    <span>Lokasyon</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.LocationId))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => OnSort(nameof(MaterialAsset.PersonelId))">
                <span class="d-inline-flex align-items-center">
                    <span>Personel</span>
                    <i class="@GetSortIcon(nameof(MaterialAsset.PersonelId))"></i>
                </span>
            </th>
            <th class="text-center" style="width:340px;">Islemler</th>
        </HeaderTemplate>

        <RowTemplate Context="asset">
            <td>@GetMaterialName(asset.MaterialId)</td>
            <td>@GetBrandName(asset.BrandId)</td>
            <td>@GetModelName(asset.ModelId)</td>

            <td>
                @if (editingAssetId == asset.Id)
                {
                    <input class="form-control form-control-sm" @bind="editForm.SerialNumber" placeholder="Seri No" />
                }
                else
                {
                    <span class="@(string.IsNullOrEmpty(asset.SerialNumber) ? "text-muted fst-italic" : "fw-semibold")">
                        @(string.IsNullOrEmpty(asset.SerialNumber) ? "�" : asset.SerialNumber)
                    </span>
                }
            </td>

            <td>
                @if (editingAssetId == asset.Id)
                {
                    <select class="form-select form-select-sm" @bind="editForm.Status">
                        @foreach (var s in Enum.GetValues<AssetStatus>())
                        {
                            <option value="@s">@GetStatusLabel(s)</option>
                        }
                    </select>
                }
                else
                {
                    <span class="badge @GetStatusBadgeClass(asset.Status)">@GetStatusLabel(asset.Status)</span>
                }
            </td>

            <td>@GetLocationName(asset.LocationId)</td>
            <td>@GetPersonelName(asset.PersonelId)</td>

            <td class="text-center">
                @if (editingAssetId == asset.Id)
                {
                    <button class="btn btn-sm btn-success me-1" @onclick="SaveEdit" title="Kaydet">
                        <i class="bi bi-check-lg"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit" title="Iptal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
                else
                {
                    @if (CanEdit)
                    {
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(asset)" title="Düzenle">
                            <i class="bi bi-pencil"></i> Düzenle
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-info me-1" @onclick="() => ShowLog(asset)" title="Geçmis">
                        <i class="bi bi-clock-history"></i> Geçmis
                    </button>
                    @if (CanCreate)
                    {
                        <button class="btn btn-sm btn-outline-success me-1" @onclick="() => StartEntry(asset)" title="Giris">
                            <i class="bi bi-box-arrow-in-right"></i> Giris
                        </button>
                    }
                    @if (CanDelete)
                    {
                        <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => StartExit(asset)" title="Çikis">
                            <i class="bi bi-box-arrow-right"></i> Çikis
                        </button>
                    }
                    @if (CanEdit)
                    {
                        <button class="btn btn-sm btn-outline-warning" @onclick="() => StartTransfer(asset)" title="Transfer">
                            <i class="bi bi-arrow-left-right"></i> Transfer
                        </button>
                    }
                }
            </td>
        </RowTemplate>

        <DetailRowTemplate Context="asset">
            @if (showingLogAssetId == asset.Id && assetLogs.Any())
            {
                <tr>
                    <td colspan="8" class="bg-light p-2">
                        <div class="small">
                            <strong>Zimmet / Transfer Ge�misi</strong>
                            <table class="table table-sm table-borderless mb-0 mt-1">
                                <thead>
                                    <tr class="text-muted">
                                        <th>Tarih</th>
                                        <th>Islem</th>
                                        <th>Kimden</th>
                                        <th>Kime</th>
                                        <th>Nereden</th>
                                        <th>Nereye</th>
                                        <th>A�iklama</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in assetLogs)
                                    {
                                        <tr>
                                            <td>@log.TransactionDate.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td><span class="badge bg-info text-dark">@log.TransactionType</span></td>
                                            <td>@GetPersonelName(log.FromPersonelId)</td>
                                            <td>@GetPersonelName(log.ToPersonelId)</td>
                                            <td>@GetLocationName(log.FromLocationId)</td>
                                            <td>@GetLocationName(log.ToLocationId)</td>
                                            <td class="text-muted">@(log.Aciklama ?? "�")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            }
        </DetailRowTemplate>
    </GenericTable>
}

<MaterialEntryEditModal MaterialEntry="editingEntry"
                        Materials="Materials"
                        MaterialUnits="MaterialUnits"
                        Locations="Locations"
                        Persons="Persons"
                        Brands="Brands"
                        Models="Models"
                        Categories="Categories"
                        IsOpen="isEntryOpen"
                        IsMaterialFixed="true"
                        OnSave="OnEntryModalSave"
                        OnClose="CloseEntryModal" />

<MaterialExitEditModal MaterialExit="editingExit"
                       Materials="Materials"
                       MaterialUnits="MaterialUnits"
                       Locations="Locations"
                       Persons="Persons"
                       Brands="Brands"
                       Models="Models"
                       MaterialInventories="MaterialInventories"
                       IsOpen="isExitOpen"
                       IsMaterialFixed="true"
                       CanCreate="@CanCreate"
                       CanDelete="@CanDelete"
                       OnSave="OnExitModalSave"
                       OnSaveWithAssets="OnExitAssetIdsReceived"
                       OnClose="CloseExitModal" />

<MaterialTransferEditModal MaterialTransfer="editingTransfer"
                             Materials="Materials"
                             MaterialUnits="MaterialUnits"
                             Locations="Locations"
                             Persons="Persons"
                             Brands="Brands"
                             Models="Models"
                             MaterialInventories="MaterialInventories"
                             IsOpen="isTransferOpen"
                             IsMaterialFixed="true"
                             CanEdit="@CanEdit"
                             InitialSelectedFromInventoryId="modalInitialFromInventoryId"
                             OnSave="OnTransferModalSave"
                             OnSaveWithAssets="OnTransferAssetIdsReceived"
                             OnClose="CloseTransferModal" />

@code
{
    [Parameter] public List<MaterialAsset> Assets { get; set; } = new();
    [Parameter] public List<Material> Materials { get; set; } = new();
    [Parameter] public List<MaterialBrand> Brands { get; set; } = new();
    [Parameter] public List<MaterialModel> Models { get; set; } = new();
    [Parameter] public List<Location> Locations { get; set; } = new();
    [Parameter] public List<Personel> Persons { get; set; } = new();
    [Parameter] public List<MaterialInventory> MaterialInventories { get; set; } = new();
    [Parameter] public List<MaterialUnit> MaterialUnits { get; set; } = new();
    [Parameter] public List<MaterialCategory> Categories { get; set; } = new();
    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public bool CanCreate { get; set; } = true;
    [Parameter] public bool CanEdit { get; set; } = true;
    [Parameter] public bool CanDelete { get; set; } = true;

    private GenericTable<MaterialAsset>? assetTable;
    private List<MaterialAssetLog> assetLogs = new();

    private int? editingAssetId;
    private int? showingLogAssetId;
    private AssetEditForm editForm = new();

    // Entry/Exit/Transfer modal state
    private MaterialEntry? editingEntry;
    private bool isEntryOpen;

    private MaterialExit? editingExit;
    private bool isExitOpen;

    private MaterialTransfer? editingTransfer;
    private bool isTransferOpen;
    private int? modalInitialFromInventoryId;

    private List<int>? pendingExitAssetIds;
    private List<int>? pendingTransferAssetIds;

    private static readonly IReadOnlyList<string> exportHeaders = new[]
    {
        "Malzeme", "Marka", "Model", "Seri No",
        "Durum", "Lokasyon", "Personel"
    };

    private readonly Dictionary<int, string> _materialNameById = new();
    private readonly Dictionary<int, string> _brandNameById = new();
    private readonly Dictionary<int, string> _modelNameById = new();
    private readonly Dictionary<int, string> _locationNameById = new();
    private readonly Dictionary<int, string> _personelNameById = new();

    protected override void OnParametersSet()
    {
        RebuildLookups();
    }

    private void RebuildLookups()
    {
        _materialNameById.Clear();
        _brandNameById.Clear();
        _modelNameById.Clear();
        _locationNameById.Clear();
        _personelNameById.Clear();

        if (Materials != null)
            foreach (var m in Materials)
                _materialNameById[m.Id] = m.MaterialName ?? "�";

        if (Brands != null)
            foreach (var b in Brands)
                _brandNameById[b.Id] = b.BrandName ?? "�";

        if (Models != null)
            foreach (var m in Models)
                _modelNameById[m.Id] = m.ModelName ?? "�";

        if (Locations != null)
            foreach (var l in Locations)
                _locationNameById[l.Id] = l.LocationName ?? "�";

        if (Persons != null)
            foreach (var p in Persons)
                _personelNameById[p.Id] = $"{p.Adi} {p.Soyadi}";
    }

    #region Sort

    private void OnSort(string field) => assetTable?.SortBy(field);

    private string GetSortIcon(string field)
    {
        if (assetTable?.CurrentSortField != field)
            return "bi bi-arrow-down-up ms-2 text-muted";

        return assetTable.CurrentSortDescending
            ? "bi bi-caret-down-fill ms-2"
            : "bi bi-caret-up-fill ms-2";
    }

    #endregion

    #region Inline Edit

    private void StartEdit(MaterialAsset asset)
    {
        editingAssetId = asset.Id;
        showingLogAssetId = null;
        editForm = new AssetEditForm
        {
            SerialNumber = asset.SerialNumber,
            Barcode = asset.Barcode,
            PurchaseDate = asset.PurchaseDate,
            WarrantyExpiry = asset.WarrantyExpiry,
            Status = asset.Status
        };
    }

    private void CancelEdit()
    {
        editingAssetId = null;
        editForm = new();
    }

    private async Task SaveEdit()
    {
        if (editingAssetId == null) return;
        var asset = Assets.FirstOrDefault(a => a.Id == editingAssetId);
        if (asset == null) return;

        asset.SerialNumber = editForm.SerialNumber;
        asset.Barcode = editForm.Barcode;
        asset.PurchaseDate = editForm.PurchaseDate;
        asset.WarrantyExpiry = editForm.WarrantyExpiry;
        asset.Status = editForm.Status;

        await MaterialAssetService.UpdateAsync(asset);
        ToastService.ShowSuccess("Demirbas bilgileri g�ncellendi.");

        editingAssetId = null;
        editForm = new();
        await OnDataChanged.InvokeAsync();
    }

    #endregion

    #region Log

    private async Task ShowLog(MaterialAsset asset)
    {
        if (showingLogAssetId == asset.Id)
        {
            showingLogAssetId = null;
            assetLogs.Clear();
            return;
        }

        showingLogAssetId = asset.Id;
        editingAssetId = null;
        var assetLogsR = await MaterialAssetLogService.GetByAssetIdAsync(asset.Id);
        assetLogs = assetLogsR.IsSuccess ? assetLogsR.Value : new();
        StateHasChanged();
    }

    #endregion

    #region Delete

    private void ConfirmDelete(MaterialAsset asset)
    {
        ModalService.ShowConfirmation(
            "Demirbas Silme",
            $"'{asset.SerialNumber ?? $"ID:{asset.Id}"}' silinsin mi?",
            async (confirmed) =>
            {
                if (confirmed)
                {
                    await MaterialAssetService.DeleteAsync(asset);
                    ToastService.ShowSuccess("Demirbas silindi.");
                    await OnDataChanged.InvokeAsync();
                }
            });
    }

    #endregion

    #region Entry

    private void StartEntry(MaterialAsset asset)
    {
        var mat = Materials.FirstOrDefault(m => m.Id == asset.MaterialId);
        if (mat == null) return;

        editingEntry = new MaterialEntry
        {
            MaterialId = mat.Id,
            MaterialUnitId = mat.MaterialUnitId,
            EntryDate = DateTime.Now,
            Quantity = 1
        };
        isEntryOpen = true;
    }

    private async Task OnEntryModalSave()
    {
        if (editingEntry == null) return;
        try
        {
            var currentUser = await CurrentUserService.GetUserNameAsync();
            var saved = await MaterialEntryService.AddAsync(editingEntry, currentUser, CancellationToken.None);
            if (saved.IsSuccess)
            {
                ToastService.ShowSuccess("Giris kaydedildi.");
                var invR = await MaterialInventoryService.GetAllAsync();
                MaterialInventories = invR.IsSuccess ? invR.Value : new();
                await OnDataChanged.InvokeAsync();
            }
            else
            {
                ToastService.ShowError("Giris kaydedilemedi.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Hata: {ex.Message}");
        }
        finally
        {
            isEntryOpen = false;
            editingEntry = null;
            StateHasChanged();
        }
    }

    private void CloseEntryModal()
    {
        isEntryOpen = false;
        editingEntry = null;
    }

    #endregion

    #region Exit

    private void StartExit(MaterialAsset asset)
    {
        var mat = Materials.FirstOrDefault(m => m.Id == asset.MaterialId);
        if (mat == null) return;

        editingExit = new MaterialExit
        {
            MaterialId = mat.Id,
            MaterialUnitId = mat.MaterialUnitId,
            ExitDate = DateTime.Now,
            Quantity = 1,
            LocationId = asset.LocationId,
            PersonelId = asset.PersonelId
        };
        isExitOpen = true;
    }

    private void OnExitAssetIdsReceived(List<int> assetIds) => pendingExitAssetIds = assetIds;

    private async Task OnExitModalSave()
    {
        if (editingExit == null) return;
        var assetIds = pendingExitAssetIds;
        pendingExitAssetIds = null;
        try
        {
            await MaterialExitService.AddAsync(editingExit, assetIds, CancellationToken.None);
            ToastService.ShowSuccess("�ikis kaydedildi.");
            var invR = await MaterialInventoryService.GetAllAsync();
            MaterialInventories = invR.IsSuccess ? invR.Value : new();
            await OnDataChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Hata: {ex.Message}");
        }
        finally
        {
            isExitOpen = false;
            editingExit = null;
            StateHasChanged();
        }
    }

    private void CloseExitModal()
    {
        isExitOpen = false;
        editingExit = null;
    }

    #endregion

    #region Transfer

    private void StartTransfer(MaterialAsset asset)
    {
        var mat = Materials.FirstOrDefault(m => m.Id == asset.MaterialId);
        if (mat == null) return;

        editingTransfer = new MaterialTransfer
        {
            MaterialId = mat.Id,
            MaterialUnitId = mat.MaterialUnitId,
            TransferDate = DateTime.Now,
            Quantity = 1
        };

        var initialInvId = MaterialInventories
            .Where(mi => mi.MaterialId == mat.Id && mi.LocationId == asset.LocationId && mi.PersonelId == asset.PersonelId)
            .Select(mi => mi.Id)
            .FirstOrDefault();

        modalInitialFromInventoryId = initialInvId == 0 ? null : initialInvId;
        isTransferOpen = true;
    }

    private void OnTransferAssetIdsReceived(List<int> assetIds) => pendingTransferAssetIds = assetIds;

    private async Task OnTransferModalSave(MaterialTransfer? transfer)
    {
        if (transfer == null) return;
        var assetIds = pendingTransferAssetIds;
        pendingTransferAssetIds = null;
        try
        {
            var currentUser = await CurrentUserService.GetUserNameAsync();
            var ok = await MaterialTransferService.AddAsync(transfer, currentUser, assetIds, CancellationToken.None);
            if (ok.IsSuccess)
            {
                ToastService.ShowSuccess("Transfer kaydedildi.");
                var invR = await MaterialInventoryService.GetAllAsync();
                MaterialInventories = invR.IsSuccess ? invR.Value : new();
                await OnDataChanged.InvokeAsync();
            }
            else
            {
                ToastService.ShowError("Transfer kaydedilemedi.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Hata: {ex.Message}");
        }
        finally
        {
            isTransferOpen = false;
            editingTransfer = null;
            StateHasChanged();
        }
    }

    private void CloseTransferModal()
    {
        isTransferOpen = false;
        editingTransfer = null;
        modalInitialFromInventoryId = null;
    }

    #endregion

    #region Helpers

    private string GetAssetSearchText(MaterialAsset a) =>
        $"{a.SerialNumber} {a.Barcode} {GetBrandName(a.BrandId)} {GetModelName(a.ModelId)} {GetPersonelName(a.PersonelId)} {GetLocationName(a.LocationId)}";
    private string GetAssetRowClass(MaterialAsset a) => editingAssetId == a.Id ? "table-warning" : "";

    private string GetMaterialName(int id)
        => _materialNameById.TryGetValue(id, out var name) ? name : "�";

    private string GetBrandName(int? id)
        => id.HasValue && _brandNameById.TryGetValue(id.Value, out var name) ? name : "�";

    private string GetModelName(int? id)
        => id.HasValue && _modelNameById.TryGetValue(id.Value, out var name) ? name : "�";

    private string GetLocationName(int? id)
        => id.HasValue && _locationNameById.TryGetValue(id.Value, out var name) ? name : "�";

    private string GetPersonelName(int? id)
        => id.HasValue && _personelNameById.TryGetValue(id.Value, out var name) ? name : "�";

    private string GetStatusLabel(AssetStatus status) => status switch
    {
        AssetStatus.Active => "Aktif",
        AssetStatus.InRepair => "Onarimda",
        AssetStatus.Retired => "Hurda",
        AssetStatus.Lost => "Kayip",
        _ => status.ToString()
    };

    private string GetStatusBadgeClass(AssetStatus status) => status switch
    {
        AssetStatus.Active => "bg-success",
        AssetStatus.InRepair => "bg-warning text-dark",
        AssetStatus.Retired => "bg-secondary",
        AssetStatus.Lost => "bg-danger",
        _ => "bg-light text-dark"
    };

    private IReadOnlyList<object?> GetExportRow(MaterialAsset a) => new object?[]
    {
        GetMaterialName(a.MaterialId),
        GetBrandName(a.BrandId),
        GetModelName(a.ModelId),
        a.SerialNumber ?? "�",
        GetStatusLabel(a.Status),
        GetLocationName(a.LocationId),
        GetPersonelName(a.PersonelId)
    };

    #endregion

    private class AssetEditForm
    {
        public string? SerialNumber { get; set; }
        public string? Barcode { get; set; }
        public DateTime? PurchaseDate { get; set; }
        public DateTime? WarrantyExpiry { get; set; }
        public AssetStatus Status { get; set; }
    }
}
