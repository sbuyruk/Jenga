@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.Enums
@using Jenga.Models.IKYS
@using Jenga.Models.Inventory
@using Jenga.BlazorUI.Helpers

@inject IMaterialService MaterialService
@inject IMaterialExitService MaterialExitService
@inject IMaterialAssetService MaterialAssetService
@inject IToastService ToastService

@if (IsOpen)
{
    <div class="modal show" tabindex="-1" style="display: block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger-subtle">
                    <h5 class="modal-title text-danger-emphasis">Malzeme �ikis D�zenle</h5>
                    <button type="button" class="btn-close" @onclick="OnClose" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Malzeme</label>
                        @if (IsMaterialFixed && MaterialExit != null && MaterialExit.MaterialId > 0)
                        {
                            <select class="form-select" @bind="MaterialId" disabled>
                                <option value="@MaterialExit.MaterialId">
                                    @Materials.FirstOrDefault(m => m.Id == MaterialExit.MaterialId)?.MaterialName
                                </option>
                            </select>
                        }
                        else
                        {
                            <select class="form-select" @bind="MaterialId">
                                <option value="0">Malzeme se�iniz</option>
                                @foreach (var mat in DropdownMaterials)
                                {
                                    <option value="@mat.Id">@mat.MaterialName</option>
                                }
                            </select>
                        }
                    </div>

                    @if (!IsSelectedMaterialAsset)
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-8">
                                <label class="form-label">Miktar</label>
                                <input class="form-control" type="number" @bind="MaterialExit!.Quantity" min="1" max="@AvailableQuantity" />
                                @if (ShowQuantityError)
                                {
                                    <div class="text-danger small mt-1">Miktar en az 1 olmalidir.</div>
                                }
                                @if (ShowExceedsError)
                                {
                                    <div class="text-danger small mt-1">Girilen miktar mevcut stoktan (@AvailableQuantity) fazla olamaz.</div>
                                }
                            </div>
                            <div class="col-4">
                                <label class="form-label">Birim</label>
                                <input class="form-control" value="@SelectedUnitName" disabled />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-8">
                                <label class="form-label">Se�ilen</label>
                                <input class="form-control" value="@($"{selectedAssetIds.Count} adet")" disabled />
                            </div>
                            <div class="col-4">
                                <label class="form-label">Birim</label>
                                <input class="form-control" value="@SelectedUnitName" disabled />
                            </div>
                        </div>
                    }

                    <div class="mb-3 bg-light p-3 rounded border">
                        <label class="form-label fw-bold">�ikis Yeri (Kaynak Stok)</label>

                        <div class="mb-2">
                            <label class="small text-muted">Kaynak Stok</label>
                            <select class="form-select form-select-sm" @bind="SelectedSourceId">
                                <option value="0">-- Kaynak Stok Se�iniz --</option>
                                @foreach (var s in SourceOptions)
                                {
                                    <option value="@s.Id">@s.DisplayName</option>
                                }
                            </select>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="small text-muted">Se�ili Stok: <strong>@AvailableQuantity</strong> @SelectedUnitName</span>
                        </div>

                        @if (ShowLocationError)
                        {
                            <div class="text-danger small mt-1">L�tfen ge�erli bir kaynak stok se�iniz.</div>
                        }

                        @if (IsSelectedMaterialAsset && SelectedSourceId != 0)
                        {
                            <div class="mt-3 border-top pt-2">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-cpu me-1"></i> �ikis Yapilacak Demirbaslari Se�in
                                </label>
                                @if (!availableAssets.Any())
                                {
                                    <div class="text-muted small">Bu kaynakta aktif demirbas bulunamadi.</div>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush" style="max-height:200px; overflow-y:auto;">
                                        @foreach (var asset in availableAssets)
                                        {
                                            var isChecked = selectedAssetIds.Contains(asset.Id);
                                            <label class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-1 @(isChecked ? "list-group-item-danger" : "")">
                                                <input type="checkbox" class="form-check-input mt-0"
                                                       checked="@isChecked"
                                                       @onchange="() => ToggleAsset(asset.Id)" />
                                                <span class="fw-semibold">@(asset.SerialNumber ?? $"ID:{asset.Id}")</span>
                                                @if (!string.IsNullOrEmpty(asset.Barcode))
                                                {
                                                    <span class="text-muted small">BC: @asset.Barcode</span>
                                                }
                                                <span class="badge bg-success ms-auto">@GetAssetStatusLabel(asset.Status)</span>
                                            </label>
                                        }
                                    </div>
                                    @if (selectedAssetIds.Count == 0)
                                    {
                                        <div class="text-danger small mt-1">En az bir demirbas se�melisiniz.</div>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">�ikis Sebebi</label>
                        <select class="form-select" @bind="MaterialExit.ExitType">
                            <option value="">Se�iniz...</option>
                            @foreach (MaterialExitType type in Enum.GetValues(typeof(MaterialExitType)))
                            {
                                <option value="@((int)type)">@EnumHelper.GetEnumDescription(type)</option>
                            }
                        </select>
                        @if (ShowExitTypeError)
                        {
                            <div class="text-danger small mt-1">L�tfen �ikis sebebini se�iniz.</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tarih</label>
                        <input class="form-control" type="date" @bind="MaterialExit.ExitDate" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">A�iklama</label>
                        <textarea class="form-control" rows="3" @bind="MaterialExit.Aciklama"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" @onclick="HandleSave" disabled="@IsSaveDisabled">
                        <i class="bi bi-box-arrow-right me-1"></i> Envanterden �ikar
                    </button>
                    <button class="btn btn-secondary" @onclick="OnClose">Iptal</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    #region Models
    public class InventoryOption
    {
        public int InventoryId { get; set; }
        public int? LocationId { get; set; }
        public int? PersonelId { get; set; }
        public int? BrandId { get; set; }
        public int? ModelId { get; set; }
        public int Quantity { get; set; }
    }

    public class SourceOption
    {
        public int Id { get; set; }
        public int? LocationId { get; set; }
        public int? PersonelId { get; set; }
        public int? BrandId { get; set; }
        public int? ModelId { get; set; }
        public int Quantity { get; set; }
        public string DisplayName { get; set; } = "";
    }
    #endregion

    #region Parameters
    [Parameter] public MaterialExit? MaterialExit { get; set; }
    [Parameter] public List<Material> Materials { get; set; } = new();
    [Parameter] public List<MaterialUnit> MaterialUnits { get; set; } = new();
    [Parameter] public List<Location> Locations { get; set; } = new();
    [Parameter] public List<Personel> Persons { get; set; } = new();
    [Parameter] public List<MaterialBrand> Brands { get; set; } = new();
    [Parameter] public List<MaterialModel> Models { get; set; } = new();
    [Parameter] public List<MaterialInventory> MaterialInventories { get; set; } = new();
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool IsMaterialFixed { get; set; } = false;
    [Parameter] public EventCallback<List<int>> OnSaveWithAssets { get; set; }
    #endregion

    #region State
    private List<InventoryOption> AvailableInventoryOptions { get; set; } = new();
    private List<SourceOption> SourceOptions { get; set; } = new();

    private List<MaterialAsset> availableAssets = new();
    private List<int> selectedAssetIds = new();

    private int _selectedSourceId;
    private int SelectedSourceId
    {
        get => _selectedSourceId;
        set
        {
            if (_selectedSourceId == value) return;
            _selectedSourceId = value;
            SyncSelectedSourceToMaterialExit();
            selectedAssetIds.Clear();
            InvokeAsync(LoadAvailableAssets);
        }
    }

    private void SyncSelectedSourceToMaterialExit()
    {
        var sel = SourceOptions.FirstOrDefault(s => s.Id == SelectedSourceId);
        if (sel != null && MaterialExit != null)
        {
            MaterialExit.LocationId = sel.LocationId;
            MaterialExit.PersonelId = sel.PersonelId;
            MaterialExit.BrandId = (sel.BrandId.HasValue && sel.BrandId.Value != 0) ? sel.BrandId : null;
            MaterialExit.ModelId = (sel.ModelId.HasValue && sel.ModelId.Value != 0) ? sel.ModelId : null;
        }
    }
    #endregion

    #region Computed Properties
    private bool IsSelectedMaterialAsset =>
        MaterialExit != null
        && MaterialExit.MaterialId > 0
        && Materials.FirstOrDefault(m => m.Id == MaterialExit.MaterialId)?.IsAsset == true;

    private int MaterialId
    {
        get => MaterialExit?.MaterialId ?? 0;
        set
        {
            if (MaterialExit != null)
            {
                MaterialExit.MaterialId = value;
                var selectedMaterial = Materials.FirstOrDefault(m => m.Id == value);
                if (selectedMaterial != null)
                    MaterialExit.MaterialUnitId = selectedMaterial.MaterialUnitId;
                else
                    MaterialExit.MaterialUnitId = 0;
            }
            SelectedSourceId = 0;
            selectedAssetIds.Clear();
            availableAssets.Clear();
            RecalculateDerived();
        }
    }

    private IEnumerable<Material> DropdownMaterials
    {
        get
        {
            if (IsOpen && MaterialExit != null && MaterialExit.MaterialId > 0)
            {
                var single = Materials.Where(m => m.Id == MaterialExit.MaterialId);
                if (single.Any()) return single;
            }
            return Materials;
        }
    }

    private string? SelectedUnitName => MaterialExit != null
        ? MaterialUnits.FirstOrDefault(u => u.Id == MaterialExit.MaterialUnitId)?.Symbol
        : null;

    private int AvailableQuantity
    {
        get
        {
            if (MaterialExit == null || SelectedSourceId == 0) return 0;
            var sel = SourceOptions.FirstOrDefault(s => s.Id == SelectedSourceId);
            return sel?.Quantity ?? 0;
        }
    }

    private bool ShowQuantityError => !IsSelectedMaterialAsset && MaterialExit != null && MaterialExit.Quantity < 1;
    private bool ShowExceedsError => !IsSelectedMaterialAsset && MaterialExit != null && AvailableQuantity > 0 && MaterialExit.Quantity > AvailableQuantity;
    private bool ShowLocationError => SelectedSourceId == 0;
    private bool ShowExitTypeError => MaterialExit != null && !MaterialExit.ExitType.HasValue;

    private bool IsSaveDisabled
    {
        get
        {
            if (MaterialExit == null || ShowLocationError || ShowExitTypeError) return true;
            if (IsSelectedMaterialAsset)
                return selectedAssetIds.Count == 0;
            return ShowQuantityError || ShowExceedsError;
        }
    }
    #endregion

    protected override void OnParametersSet()
    {
        selectedAssetIds.Clear();
        availableAssets.Clear();
        RecalculateDerived();

        if (MaterialExit != null && IsOpen)
        {
            var existing = SourceOptions.FirstOrDefault(s =>
                (s.LocationId ?? 0) == (MaterialExit.LocationId ?? 0) &&
                (s.PersonelId ?? 0) == (MaterialExit.PersonelId ?? 0) &&
                (s.BrandId ?? 0) == (MaterialExit.BrandId ?? 0) &&
                (s.ModelId ?? 0) == (MaterialExit.ModelId ?? 0));

            if (existing != null)
            {
                _selectedSourceId = existing.Id;
                SyncSelectedSourceToMaterialExit();
                InvokeAsync(LoadAvailableAssets);
            }
            else if (SourceOptions.Count == 1)
            {
                _selectedSourceId = SourceOptions.First().Id;
                SyncSelectedSourceToMaterialExit();
                InvokeAsync(LoadAvailableAssets);
            }
            else
            {
                _selectedSourceId = 0;
            }
        }
    }

    private async Task LoadAvailableAssets()
    {
        availableAssets.Clear();
        if (!IsSelectedMaterialAsset || SelectedSourceId == 0 || MaterialExit == null) return;

        var opt = SourceOptions.FirstOrDefault(o => o.Id == SelectedSourceId);
        if (opt == null) return;

        var allAssetsR = await MaterialAssetService.GetByMaterialIdAsync(MaterialExit.MaterialId);
        var allAssets = allAssetsR.IsSuccess ? allAssetsR.Value : new();
        availableAssets = allAssets
            .Where(a => a.Status == AssetStatus.Active
                && a.LocationId == opt.LocationId
                && a.PersonelId == opt.PersonelId
                && a.BrandId == opt.BrandId
                && a.ModelId == opt.ModelId)
            .ToList();

        StateHasChanged();
    }

    private void ToggleAsset(int assetId)
    {
        if (selectedAssetIds.Contains(assetId))
            selectedAssetIds.Remove(assetId);
        else
            selectedAssetIds.Add(assetId);

        if (IsSelectedMaterialAsset && MaterialExit != null)
            MaterialExit.Quantity = selectedAssetIds.Count;
    }

    private string GetAssetStatusLabel(AssetStatus status) => status switch
    {
        AssetStatus.Active => "Aktif",
        AssetStatus.InRepair => "Onarimda",
        AssetStatus.Retired => "Hurda",
        AssetStatus.Lost => "Kayip",
        _ => status.ToString()
    };

    private void RecalculateDerived()
    {
        if (MaterialExit == null) return;
        var matId = MaterialExit.MaterialId;

        AvailableInventoryOptions = MaterialInventories
            .Where(mi => mi.MaterialId == matId && mi.Quantity > 0)
            .Select(mi => new InventoryOption
            {
                InventoryId = mi.Id,
                LocationId = mi.LocationId,
                PersonelId = mi.PersonelId,
                BrandId = (mi.BrandId.HasValue && mi.BrandId.Value != 0) ? mi.BrandId : null,
                ModelId = (mi.ModelId.HasValue && mi.ModelId.Value != 0) ? mi.ModelId : null,
                Quantity = mi.Quantity
            })
            .ToList();

        BuildSourceOptions();

        if (SourceOptions.Any(s => s.Id == SelectedSourceId))
            return;

        var match = SourceOptions.FirstOrDefault(s =>
            (s.LocationId ?? 0) == (MaterialExit.LocationId ?? 0) &&
            (s.PersonelId ?? 0) == (MaterialExit.PersonelId ?? 0) &&
            (s.BrandId ?? 0) == (MaterialExit.BrandId ?? 0) &&
            (s.ModelId ?? 0) == (MaterialExit.ModelId ?? 0));

        if (match != null) { SelectedSourceId = match.Id; return; }
        if (SourceOptions.Count == 1) { SelectedSourceId = SourceOptions[0].Id; return; }
        SelectedSourceId = 0;
    }

    private void BuildSourceOptions()
    {
        SourceOptions = AvailableInventoryOptions
            .Select(opt =>
            {
                string baseName;
                if (opt.PersonelId.HasValue && opt.LocationId.HasValue)
                {
                    var p = Persons.FirstOrDefault(pp => pp.Id == opt.PersonelId.Value);
                    var l = Locations.FirstOrDefault(ll => ll.Id == opt.LocationId.Value);
                    var pName = p != null ? $"{p.Adi} {p.Soyadi}" : $"Personel {opt.PersonelId}";
                    var lName = l != null ? InventoryUIHelper.GetLocationFullName(l.Id, Locations) : $"Lokasyon {opt.LocationId}";
                    baseName = lName + "/" + pName + " - ";
                }
                else if (opt.PersonelId.HasValue)
                {
                    var p = Persons.FirstOrDefault(pp => pp.Id == opt.PersonelId.Value);
                    baseName = p != null ? $"{p.Adi} {p.Soyadi}" : $"Personel {opt.PersonelId}";
                }
                else if (opt.LocationId.HasValue)
                {
                    var l = Locations.FirstOrDefault(ll => ll.Id == opt.LocationId.Value);
                    baseName = l != null ? InventoryUIHelper.GetLocationFullName(l.Id, Locations) : $"Lokasyon {opt.LocationId}";
                }
                else
                {
                    baseName = string.Empty;
                }

                var brandName = opt.BrandId.HasValue ? Brands.FirstOrDefault(b => b.Id == opt.BrandId.Value)?.BrandName : null;
                var modelName = opt.ModelId.HasValue ? Models.FirstOrDefault(m => m.Id == opt.ModelId.Value)?.ModelName : null;

                var brandModelPart = (brandName, modelName) switch
                {
                    (null, null) => "",
                    (var b, null) => $" - {b}",
                    (null, var m) => $" - {m}",
                    (var b, var m) => $" - {b}/{m}"
                };

                return new SourceOption
                {
                    Id = opt.InventoryId,
                    LocationId = opt.LocationId,
                    PersonelId = opt.PersonelId,
                    BrandId = opt.BrandId,
                    ModelId = opt.ModelId,
                    Quantity = opt.Quantity,
                    DisplayName = $"{baseName}{brandModelPart} ({opt.Quantity} {SelectedUnitName})"
                };
            })
            .OrderBy(s => s.DisplayName)
            .ToList();
    }

    private async Task HandleSave()
    {
        if (IsSaveDisabled)
        {
            ToastService.ShowWarning("L�tfen formu kontrol ediniz.");
            return;
        }

        if (MaterialExit != null)
        {
            var sel = SourceOptions.FirstOrDefault(s => s.Id == SelectedSourceId);
            if (sel != null)
            {
                MaterialExit.LocationId = sel.LocationId;
                MaterialExit.PersonelId = sel.PersonelId;
                MaterialExit.BrandId = (sel.BrandId.HasValue && sel.BrandId.Value != 0) ? sel.BrandId : null;
                MaterialExit.ModelId = (sel.ModelId.HasValue && sel.ModelId.Value != 0) ? sel.ModelId : null;
            }
            else
            {
                MaterialExit.LocationId = null;
                MaterialExit.PersonelId = null;
                MaterialExit.BrandId = null;
                MaterialExit.ModelId = null;
            }

            if (IsSelectedMaterialAsset)
                MaterialExit.Quantity = selectedAssetIds.Count;
        }

        if (IsSelectedMaterialAsset && OnSaveWithAssets.HasDelegate)
        {
            await OnSaveWithAssets.InvokeAsync(selectedAssetIds);
        }

        await OnSave.InvokeAsync();
    }
}