@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.Enums
@using Jenga.Models.IKYS
@using Jenga.Models.Inventory
@using Jenga.Utility.Helpers
@using Jenga.Utility.Toast
@using Jenga.BlazorUI.Helpers

@inject IMaterialService MaterialService
@inject IMaterialExitService MaterialExitService
@inject IToastService ToastService

@if (IsOpen)
{
    <div class="modal show" tabindex="-1" style="display: block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger-subtle">
                    <h5 class="modal-title text-danger-emphasis">Malzeme Çıkış Düzenle</h5>
                    <button type="button" class="btn-close" @onclick="OnClose" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <!-- Malzeme Seçimi -->
                    <div class="mb-3">
                        <label class="form-label">Malzeme</label>
                        <select class="form-select" @bind="MaterialId">
                            <option value="0">Malzeme seçiniz</option>
                            @foreach (var mat in Materials)
                            {
                                <option value="@mat.Id">@mat.MaterialName</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label">Miktar</label>
                            <input class="form-control" type="number" @bind="MaterialExit!.Quantity" min="1" max="@AvailableQuantity" />

                            @if (ShowQuantityError)
                            {
                                <div class="text-danger small mt-1">Miktar en az 1 olmalıdır.</div>
                            }
                            @if (ShowExceedsError)
                            {
                                <div class="text-danger small mt-1">Girilen miktar mevcut stoktan (@AvailableQuantity) fazla olamaz.</div>
                            }
                        </div>
                        <div class="col-4">
                            <label class="form-label">Birim</label>
                            <input class="form-control" value="@SelectedUnitName" disabled />
                        </div>
                    </div>

                    <!-- Çıkış Yeri Seçimi (Personel ve Lokasyon Ayrıldı) -->
                    <div class="mb-3 bg-light p-3 rounded border">
                        <label class="form-label fw-bold">Çıkış Yeri (Kaynak Stok)</label>

                        <div class="mb-2">
                            <label class="small text-muted">Personelden Çıkış</label>
                            <select class="form-select form-select-sm" value="@CurrentPersonId" @onchange="OnPersonChanged">
                                <option value="0">-- Personel Yok / Seçiniz --</option>
                                @foreach (var p in SourcePersons)
                                {
                                    <option value="@p.Id">@p.FullName</option>
                                }
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="small text-muted">Lokasyondan Çıkış</label>
                            <select class="form-select form-select-sm" value="@CurrentLocationId" @onchange="OnLocationChanged">
                                <option value="0">-- Lokasyon Yok / Seçiniz --</option>
                                @foreach (var l in SourceLocations)
                                {
                                    <option value="@l.Id">@l.LocationName</option>
                                }
                            </select>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="small text-muted">Seçili Stok: <strong>@AvailableQuantity</strong> @SelectedUnitName</span>
                        </div>

                        @if (ShowLocationError)
                        {
                            <div class="text-danger small mt-1">Lütfen geçerli bir kaynak stok seçiniz.</div>
                        }
                    </div>

                    <!-- Çıkış Tipi ve Tarih -->
                    <div class="mb-3">
                        <label class="form-label">Çıkış Sebebi</label>
                        <select class="form-select" @bind="MaterialExit.ExitType">
                            <option value="">Seçiniz...</option>
                            @foreach (MaterialExitType type in Enum.GetValues(typeof(MaterialExitType)))
                            {
                                <option value="@((int)type)">@EnumHelper.GetEnumDescription(type)</option>
                            }
                        </select>
                        @if (ShowExitTypeError)
                        {
                            <div class="text-danger small mt-1">Lütfen çıkış sebebini seçiniz.</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tarih</label>
                        <input class="form-control" type="date" @bind="MaterialExit.ExitDate" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea class="form-control" rows="3" @bind="MaterialExit.Aciklama"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" @onclick="HandleSave" disabled="@IsSaveDisabled">
                        <i class="bi bi-box-arrow-right me-1"></i> Envanterden Çıkar
                    </button>
                    <button class="btn btn-secondary" @onclick="OnClose">İptal</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    #region Models
    public class InventoryOption
    {
        public int? LocationId { get; set; }
        public int? PersonelId { get; set; }
        public int Quantity { get; set; }
    }
    public class SourceItem { public int Id { get; set; } public string FullName { get; set; } = ""; }
    public class LocationItem { public int Id { get; set; } public string LocationName { get; set; } = ""; }
    #endregion

    #region Parameters
    [Parameter] public MaterialExit? MaterialExit { get; set; }
    [Parameter] public List<Material> Materials { get; set; } = new();
    [Parameter] public List<MaterialUnit> MaterialUnits { get; set; } = new();
    [Parameter] public List<Location> Locations { get; set; } = new();
    [Parameter] public List<Personel> Persons { get; set; } = new(); // Parent component'ten gelmeli
    [Parameter] public List<MaterialInventory> MaterialInventories { get; set; } = new();
    [Parameter] public bool IsOpen { get; set; }

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    #endregion

    #region State
    // Dropdownlarda seçili görünen değerler
    private int CurrentPersonId { get; set; }
    private int CurrentLocationId { get; set; }

    // Hesaplanan Listeler
    private List<InventoryOption> AvailableInventoryOptions { get; set; } = new();
    private List<SourceItem> SourcePersons { get; set; } = new();
    private List<LocationItem> SourceLocations { get; set; } = new();
    #endregion

    #region Computed Properties
    private int MaterialId
    {
        get => MaterialExit?.MaterialId ?? 0;
        set
        {
            if (MaterialExit != null)
            {
                MaterialExit.MaterialId = value;
                var selectedMaterial = Materials.FirstOrDefault(m => m.Id == value);
                if (selectedMaterial != null)
                {
                    MaterialExit.MaterialUnitId = selectedMaterial.MaterialUnitId;
                }
            }
            RecalculateDerived();
        }
    }

    private string? SelectedUnitName => MaterialExit != null
        ? MaterialUnits.FirstOrDefault(u => u.Id == MaterialExit.MaterialUnitId)?.Symbol
        : null;

    // Mevcut seçim kombinasyonuna (Personel + Lokasyon) ait stok miktarı
    private int AvailableQuantity
    {
        get
        {
            if (CurrentPersonId == 0 && CurrentLocationId == 0) return 0;

            // Tam eşleşme ara
            var match = AvailableInventoryOptions.FirstOrDefault(x =>
                (x.PersonelId ?? 0) == CurrentPersonId &&
                (x.LocationId ?? 0) == CurrentLocationId);

            return match?.Quantity ?? 0;
        }
    }

    // Validasyonlar
    private bool ShowQuantityError => MaterialExit != null && MaterialExit.Quantity < 1;
    private bool ShowExceedsError => MaterialExit != null && AvailableQuantity > 0 && MaterialExit.Quantity > AvailableQuantity;
    private bool ShowLocationError => CurrentPersonId == 0 && CurrentLocationId == 0;
    private bool ShowExitTypeError => MaterialExit != null && !MaterialExit.ExitType.HasValue;

    private bool IsSaveDisabled =>
        MaterialExit == null ||
        ShowLocationError ||
        ShowQuantityError ||
        ShowExceedsError ||
        ShowExitTypeError;
    #endregion

    protected override void OnParametersSet()
    {
        RecalculateDerived();

        // Modeli UI State ile eşle (Eğer model dolu gelirse - örn düzenleme)
        if (MaterialExit != null && IsOpen)
        {
            CurrentLocationId = MaterialExit.LocationId ?? 0;
            CurrentPersonId = MaterialExit.PersonId ?? 0;
        }
    }

    private void RecalculateDerived()
    {
        if (MaterialExit == null) return;
        var matId = MaterialExit.MaterialId;

        // 1. Mevcut envanter seçeneklerini grupla
        AvailableInventoryOptions = MaterialInventories
            .Where(mi => mi.MaterialId == matId)
            .GroupBy(mi => new { mi.LocationId, mi.PersonelId })
            .Select(g => new InventoryOption
            {
                LocationId = g.Key.LocationId,
                PersonelId = g.Key.PersonelId,
                Quantity = g.Sum(x => x.Quantity)
            })
            .Where(x => x.Quantity > 0)
            .ToList();

        // 2. Dropdown listelerini güncelle
        UpdateSelectionLists();

        // 3. Mevcut seçim artık geçersizse (stok bitmişse vs) sıfırla
        var currentExists = AvailableInventoryOptions.Any(x =>
            (x.PersonelId ?? 0) == CurrentPersonId &&
            (x.LocationId ?? 0) == CurrentLocationId);

        if (!currentExists && IsOpen)
        {
            // Eğer seçim geçersizse ama listede tek bir seçenek varsa onu seç
            if (AvailableInventoryOptions.Count == 1)
            {
                var onlyOpt = AvailableInventoryOptions.First();
                CurrentPersonId = onlyOpt.PersonelId ?? 0;
                CurrentLocationId = onlyOpt.LocationId ?? 0;
            }
            else
            {
                CurrentPersonId = 0;
                CurrentLocationId = 0;
            }
        }
    }

    private void UpdateSelectionLists()
    {
        // Personel Listesi (Miktar ile)
        var personTotals = AvailableInventoryOptions
            .Where(x => x.PersonelId.HasValue)
            .GroupBy(x => x.PersonelId!.Value)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Quantity));

        SourcePersons = Persons
            .Where(p => personTotals.ContainsKey(p.Id))
            .Select(p => new SourceItem
            {
                Id = p.Id,
                FullName = $"{p.Adi} {p.Soyadi} ({personTotals[p.Id]} {SelectedUnitName})"
            })
            .OrderBy(x => x.FullName).ToList();

        // Lokasyon Listesi (Miktar ile)
        var locationTotals = AvailableInventoryOptions
            .Where(x => x.LocationId.HasValue)
            .GroupBy(x => x.LocationId!.Value)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Quantity));

        SourceLocations = Locations
            .Where(l => locationTotals.ContainsKey(l.Id))
            .Select(l => new LocationItem
            {
                Id = l.Id,
                LocationName = $"{InventoryUIHelper.GetLocationFullName(l.Id, Locations)} ({locationTotals[l.Id]} {SelectedUnitName})"
            })
            .OrderBy(x => x.LocationName).ToList();
    }

    // Dropdown Change Handlers (Senkronizasyon)
    private void OnPersonChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newPersonId))
        {
            CurrentPersonId = newPersonId;

            // Bu personel seçiliyken, mevcut lokasyon uygun mu?
            var match = AvailableInventoryOptions.FirstOrDefault(x =>
                (x.PersonelId ?? 0) == CurrentPersonId &&
                (x.LocationId ?? 0) == CurrentLocationId);

            if (match == null)
            {
                // Uygun değilse, personelin ilk uygun lokasyonunu bul
                var bestMatch = AvailableInventoryOptions.FirstOrDefault(x => (x.PersonelId ?? 0) == CurrentPersonId);
                CurrentLocationId = bestMatch?.LocationId ?? 0;
            }
            // match != null ise lokasyon değişmez, senkronize kalır.
        }
    }

    private void OnLocationChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newLocationId))
        {
            CurrentLocationId = newLocationId;

            // Bu lokasyon seçiliyken, mevcut personel uygun mu?
            var match = AvailableInventoryOptions.FirstOrDefault(x =>
                (x.PersonelId ?? 0) == CurrentPersonId &&
                (x.LocationId ?? 0) == CurrentLocationId);

            if (match == null)
            {
                // Uygun değilse, lokasyonun ilk uygun personelini bul
                var bestMatch = AvailableInventoryOptions.FirstOrDefault(x => (x.LocationId ?? 0) == CurrentLocationId);
                CurrentPersonId = bestMatch?.PersonelId ?? 0;
            }
        }
    }

    private async Task HandleSave()
    {
        if (IsSaveDisabled)
        {
            ToastService.ShowWarning("Lütfen formu kontrol ediniz.");
            return;
        }

        if (MaterialExit != null)
        {
            // UI seçimlerini Modele aktar
            MaterialExit.LocationId = CurrentLocationId != 0 ? CurrentLocationId : null;
            MaterialExit.PersonId = CurrentPersonId != 0 ? CurrentPersonId : null;
        }

        await OnSave.InvokeAsync();
    }
}