@using Jenga.BlazorUI.Components.Common
@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.IKYS
@using Jenga.Models.Inventory
@using Jenga.BlazorUI.Helpers
@using Jenga.Models.Common  
@inject IMaterialMovementService MaterialMovementService

@if (MaterialId <= 0)
{
    <div class="text-muted small">Select a material.</div>
}
else if (!loaded)
{
    <div class="text-muted small">Loading...</div>
}
else if (movementRows == null || movementRows.Count == 0)
{
    <div class="text-muted small">No movements found for the selected material.</div>
}
else
{
    <GenericTable TItem="MovementRow"
                  @ref="tableRef"
                  Items="movementRows"
                  TableHeight="@TableHeight"
                  ShowSearch="true"
                  PageSize="@(MaxItems > 0 ? MaxItems : 10)"
                  PageSizeOptions="new[] {5, 10, 20, 50}">
        <HeaderTemplate>
            <th @onclick="() => tableRef.SortBy(nameof(MovementRow.ActionType))">
                Action @(tableRef != null && tableRef.CurrentSortField == nameof(MovementRow.ActionType) ? (tableRef.CurrentSortDescending ? "▼" : "▲") : "")
            </th>
            <th @onclick="() => tableRef.SortBy(nameof(MovementRow.FromLocation))">
                From @(tableRef != null && tableRef.CurrentSortField == nameof(MovementRow.FromLocation) ? (tableRef.CurrentSortDescending ? "▼" : "▲") : "")
            </th>
            <th @onclick="() => tableRef.SortBy(nameof(MovementRow.FromPerson))">
                From Person @(tableRef != null && tableRef.CurrentSortField == nameof(MovementRow.FromPerson) ? (tableRef.CurrentSortDescending ? "▼" : "▲") : "")
            </th>
            <th @onclick="() => tableRef.SortBy(nameof(MovementRow.ToLocation))">
                To @(tableRef != null && tableRef.CurrentSortField == nameof(MovementRow.ToLocation) ? (tableRef.CurrentSortDescending ? "▼" : "▲") : "")
            </th>
            <th @onclick="() => tableRef.SortBy(nameof(MovementRow.ToPerson))">
                To Person @(tableRef != null && tableRef.CurrentSortField == nameof(MovementRow.ToPerson) ? (tableRef.CurrentSortDescending ? "▼" : "▲") : "")
            </th>
            <th @onclick="() => tableRef.SortBy(nameof(MovementRow.QuantityValue))" class="text-end">
                Quantity @(tableRef != null && tableRef.CurrentSortField == nameof(MovementRow.QuantityValue) ? (tableRef.CurrentSortDescending ? "▼" : "▲") : "")
            </th>
            <th @onclick="() => tableRef.SortBy(nameof(MovementRow.Brand))">
                Brand @(tableRef != null && tableRef.CurrentSortField == nameof(MovementRow.Brand) ? (tableRef.CurrentSortDescending ? "▼" : "▲") : "")
            </th>
            <th @onclick="() => tableRef.SortBy(nameof(MovementRow.Model))">
                Model @(tableRef != null && tableRef.CurrentSortField == nameof(MovementRow.Model) ? (tableRef.CurrentSortDescending ? "▼" : "▲") : "")
            </th>
            <th @onclick="() => tableRef.SortBy(nameof(MovementRow.Operation))">
                Operation @(tableRef != null && tableRef.CurrentSortField == nameof(MovementRow.Operation) ? (tableRef.CurrentSortDescending ? "▼" : "▲") : "")
            </th>
            <th @onclick="() => tableRef.SortBy(nameof(MovementRow.DateValue))">
                Date @(tableRef != null && tableRef.CurrentSortField == nameof(MovementRow.DateValue) ? (tableRef.CurrentSortDescending ? "▼" : "▲") : "")
            </th>
        </HeaderTemplate>

        <RowTemplate Context="m">
            <td class="align-middle">@m.ActionType</td>
            <td class="align-middle">@m.FromLocation</td>
            <td class="align-middle">@m.FromPerson</td>
            <td class="align-middle">@m.ToLocation</td>
            <td class="align-middle">@m.ToPerson</td>
            <td class="align-middle text-end">@m.QuantityText</td>
            <td class="align-middle">@m.Brand</td>
            <td class="align-middle">@m.Model</td>
            <td class="align-middle">@m.Operation</td>
            <td class="align-middle">@m.DateText</td>
        </RowTemplate>
    </GenericTable>
}

@code {
    private GenericTable<MovementRow> tableRef;

    [Parameter] public int MaterialId { get; set; }
    [Parameter] public List<Material>? Materials { get; set; }
    [Parameter] public List<MaterialCategory>? Categories { get; set; }
    [Parameter] public List<Location>? Locations { get; set; }
    [Parameter] public List<Personel>? Persons { get; set; }
    [Parameter] public List<MaterialUnit>? MaterialUnits { get; set; }
    [Parameter] public List<MaterialBrand>? Brands { get; set; }
    [Parameter] public List<MaterialModel>? Models { get; set; }

    [Parameter] public int MaxItems { get; set; } = 0; // 0 = no limit
    [Parameter] public string TableHeight { get; set; } = "Auto";

    private List<MaterialMovement>? movements;
    private List<MovementRow>? movementRows;
    private bool loaded;

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        movements = null;
        movementRows = null;

        if (MaterialId > 0)
        {
            var list = await MaterialMovementService.GetMovementsByMaterialIdAsync(MaterialId);
            movements = (MaxItems > 0)
                ? list.OrderByDescending(m => m.MovementDate).Take(MaxItems).ToList()
                : list.OrderByDescending(m => m.MovementDate).ToList();
        }

        if (movements != null)
        {
            movementRows = BuildMovementRows(movements);
        }

        loaded = true;
    }

    private List<MovementRow> BuildMovementRows(IEnumerable<MaterialMovement> list)
    {
        var brandLookup = (Brands ?? new List<MaterialBrand>()).ToDictionary(b => b.Id, b => b);
        var modelLookup = (Models ?? new List<MaterialModel>()).ToDictionary(m => m.Id, m => m);
        var materialLookup = (Materials ?? new List<Material>()).ToDictionary(m => m.Id, m => m);
        var unitLookup = (MaterialUnits ?? new List<MaterialUnit>()).ToDictionary(u => u.Id, u => u);
        var locationList = Locations ?? new List<Location>();
        var personList = Persons ?? new List<Personel>();

        var rows = new List<MovementRow>();

        foreach (var m in list)
        {
            var brandName = (m.BrandId != null && brandLookup.TryGetValue(m.BrandId.Value, out var b)) ? b.BrandName : string.Empty;
            var modelName = (m.ModelId != null && modelLookup.TryGetValue(m.ModelId.Value, out var md)) ? md.ModelName : string.Empty;

            var unitSymbol = string.Empty;
            if (m.MaterialUnitId != null && unitLookup.TryGetValue(m.MaterialUnitId.Value, out var u))
                unitSymbol = u.Symbol ?? u.Name;
            else if (materialLookup.TryGetValue(m.MaterialId, out var mat) && unitLookup.TryGetValue(mat.MaterialUnitId, out var u2))
                unitSymbol = u2.Symbol ?? u2.Name;

            // assume m.Quantity is decimal (adjust if your model uses double/int)
            var quantityValue = m.Quantity;
            var qtyText = $"{m.Quantity} {unitSymbol}".Trim();

            var fromLoc = InventoryUIHelper.GetLocationFullName(m.FromLocationId, locationList);
            var toLoc = InventoryUIHelper.GetLocationFullName(m.ToLocationId, locationList);
            var fromPerson = GetPersonName(m.FromPersonId, personList);
            var toPerson = GetPersonName(m.ToPersonId, personList);

            var actionLabel = GetMovementTypeLabel(m);

            rows.Add(new MovementRow
            {
                Id = m.Id,
                ActionType = actionLabel,
                Operation = m.Operation ?? string.Empty,
                Brand = brandName ?? string.Empty,
                Model = modelName ?? string.Empty,
                QuantityText = qtyText,
                QuantityValue = quantityValue,
                FromLocation = fromLoc,
                FromPerson = fromPerson,
                ToLocation = toLoc,
                ToPerson = toPerson,
                DateText = m.MovementDate.ToString("dd.MM.yyyy HH:mm"),
                DateValue = m.MovementDate
            });
        }

        return rows;
    }

    private string GetPersonName(int? personId, List<Personel> personList)
    {
        if (!personId.HasValue || personList == null) return string.Empty;
        var p = personList.FirstOrDefault(x => x.Id == personId.Value);
        return p != null ? $"{p.Adi} {p.Soyadi}" : string.Empty;
    }

    private string GetMovementTypeLabel(MaterialMovement m)
    {
        if (!string.IsNullOrWhiteSpace(m.MovementType))
        {
            return m.MovementType;
        }

        bool isEntry = !m.FromLocationId.HasValue && m.ToLocationId.HasValue;
        bool isExit = m.FromLocationId.HasValue && !m.ToLocationId.HasValue;
        bool isTransfer = m.FromLocationId.HasValue && m.ToLocationId.HasValue;

        return isTransfer ? "Transfer" : (isEntry ? "Entry" : (isExit ? "Exit" : "Other"));
    }
}