@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.Inventory
@using Jenga.Utility.Toast
@inject IToastService ToastService
@inject IModalService ModalService
@inject IMaterialModelService MaterialModelService
@inject IMaterialEntryService MaterialEntryService

<div class="d-flex justify-content-end mb-2">
    <button class="btn btn-success" @onclick="OpenNewModelModal" type="button">
        <i class="bi bi-plus-lg"></i> Yeni Model
    </button>
</div>

@if (Models?.Any() != true)
{
    <p>Model bulunamadı.</p>
}
else
{
    <GenericTable TItem="MaterialModel"
                  @ref="_tableRef"
                  Items="Models"
                  PageSize="10"
                  PageSizeOptions="new[] { 10, 20, 50, 100 }"
                  TableHeight="Auto"
                  ShowSearch="true"
                  ShowExport="true"
                  ExportFileName="material-models.xlsx"
                  KeySelector="(m => m.Id)"
                  TableClass="table-hover table-sm table-bordered">

        <HeaderTemplate>
            <th role="button" @onclick="() => SortBy(nameof(MaterialModel.ModelName))">
                <span class="d-inline-flex align-items-center">
                    <span>Ad</span>
                    <i class="@(GetSortIcon(nameof(MaterialModel.ModelName)))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => SortBy(nameof(MaterialModel.BrandId))">
                <span class="d-inline-flex align-items-center">
                    <span>Marka</span>
                    <i class="@(GetSortIcon(nameof(MaterialModel.BrandId)))"></i>
                </span>
            </th>
            <th role="button" @onclick="() => SortBy(nameof(MaterialModel.Aciklama))">
                <span class="d-inline-flex align-items-center">
                    <span>Açıklama</span>
                    <i class="@(GetSortIcon(nameof(MaterialModel.Aciklama)))"></i>
                </span>
            </th>
            <th class="text-center">İşlemler</th>
        </HeaderTemplate>

        <RowTemplate Context="model">
            <td class="align-middle">@model.ModelName</td>
            <td class="align-middle">@GetBrandName(model.BrandId)</td>
            <td class="align-middle">@model.Aciklama</td>
            <td class="text-center align-middle" style="white-space:nowrap;">
                <button class="btn btn-sm btn-primary me-2" @onclick="() => OnEditClicked(model)">Düzenle</button>
                <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteClicked(model)">Sil</button>
            </td>
        </RowTemplate>
    </GenericTable>
}

@if (showEditModal && selectedModel != null)
{
    <MaterialModelEditModal Model="@selectedModel"
                            IsOpen="true"
                            OnSave="HandleSave"
                            OnClose="HideModal"
                            Brands="Brands" />
}

@code {
    [Parameter] public List<MaterialModel> Models { get; set; } = new();
    [Parameter] public List<MaterialBrand> Brands { get; set; } = new();

    private readonly Dictionary<int, string> _brandNameById = new();

    private GenericTable<MaterialModel>? _tableRef;
    private MaterialModel? selectedModel;
    private bool showEditModal;

    protected override void OnParametersSet()
    {
        _brandNameById.Clear();

        if (Brands != null)
        {
            foreach (var b in Brands)
            {
                _brandNameById[b.Id] = b.BrandName ?? string.Empty;
            }
        }
    }

    private string GetBrandName(int brandId)
        => _brandNameById.TryGetValue(brandId, out var name) ? name : string.Empty;

    private void SortBy(string field)
    {
        _tableRef?.SortBy(field);
    }

    private string GetSortIcon(string field)
    {
        if (_tableRef?.CurrentSortField != field)
        {
            return "bi bi-arrow-down-up ms-2 text-muted";
        }

        return _tableRef.CurrentSortDescending
            ? "bi bi-caret-down-fill ms-2"
            : "bi bi-caret-up-fill ms-2";
    }

    private void OnEditClicked(MaterialModel model)
    {
        selectedModel = model;
        showEditModal = true;
    }

    private async void HandleSave()
    {
        if (selectedModel != null)
        {
            if (selectedModel.Id == 0)
            {
                var saved = await MaterialModelService.AddAsync(selectedModel);
                if (saved.IsSuccess)
                {
                    Models.Add(selectedModel);
                }
            }
            else
            {
                await MaterialModelService.UpdateAsync(selectedModel);
            }

            showEditModal = false;
            StateHasChanged();
        }
    }

    private async Task OnDeleteClicked(MaterialModel model)
    {
        var hasMaterialEntryResult = await MaterialEntryService.AnyAsync(m => m.ModelId == model.Id);
        var hasMaterialEntry = hasMaterialEntryResult.IsSuccess && hasMaterialEntryResult.Value;
        if (hasMaterialEntry)
        {
            ToastService.ShowToast("Bu model bir malzeme girişinde kullanılıyor, önce onu silmelisiniz.", ToastType.Error, 5000);
            return;
        }

        ModalService.ShowConfirmation(
            "Silme Onayı",
            $"'{model.ModelName}' modelini silmek istediğinizden emin misiniz?",
            async result =>
            {
                if (!result)
                {
                    return;
                }

                var deleted = await MaterialModelService.DeleteAsync(model);
                if (deleted.IsSuccess)
                {
                    ToastService.ShowToast($"{model.ModelName} silindi", ToastType.Success, 3000);
                    Models.Remove(model);
                    StateHasChanged();
                }
                else
                {
                    ToastService.ShowToast("Silme işlemi başarısız oldu", ToastType.Error, 3000);
                }
            });
    }

    private void HideModal()
    {
        selectedModel = null;
        showEditModal = false;
    }

    private Task OpenNewModelModal()
    {
        selectedModel = new MaterialModel();
        showEditModal = true;
        return Task.CompletedTask;
    }
}