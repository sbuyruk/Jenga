@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.IKYS
@using Jenga.Models.Inventory
@using Jenga.BlazorUI.Helpers
@using System.Linq

@inject IToastService ToastService

@if (IsOpen)
{
    <div class="modal show" tabindex="-1" style="display: block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success-subtle">
                    <h5 class="modal-title">@(IsNewEntry ? "Envantere Malzeme Girişi" : "Giriş Düzenle")</h5>
                    <button type="button" class="btn-close" @onclick="OnClose" aria-label="Kapat"></button>
                </div>
                @if (!HasPermission)
                {
                    <div class="modal-body">
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-shield-exclamation me-1"></i>
                            Bu işlem için yetkiniz bulunmamaktadır.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="OnClose">Kapat</button>
                    </div>
                }
                else
                {
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Malzeme</label>

                        @* If material selection is fixed (opened from table), render only the selected item and disable the select.
                           Otherwise render full list so user can change selection. *@
                        @if (IsMaterialFixed && MaterialEntry != null && MaterialEntry.MaterialId > 0)
                        {
                            <select class="form-select" @bind="MaterialId" disabled>
                                <option value="@MaterialEntry.MaterialId">
                                    @Materials.FirstOrDefault(m => m.Id == MaterialEntry.MaterialId)?.MaterialName
                                </option>
                            </select>
                        }
                        else
                        {
                            <select class="form-select" @bind="MaterialId">
                                <option value="0">Seçiniz</option>
                                @foreach (var mat in Materials)
                                {
                                    <option value="@mat.Id">@mat.MaterialName</option>
                                }
                            </select>
                        }

                        @if (MaterialId == 0)
                        {
                            <div class="text-danger small mt-2">Lütfen bir malzeme seçiniz.</div>
                        }
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label">Miktar</label>
                            <input class="form-control" @bind="MaterialEntry!.Quantity" type="number" min="1" />
                        </div>
                        <div class="col-4">
                            <label class="form-label">Birim</label>
                            <input class="form-control" value="@GetUnitName()" disabled />
                        </div>
                        @if (MaterialEntry!.Quantity < 1)
                        {
                            <div class="text-danger small">En az 1 girilmelidir.</div>
                        }
                    </div>

                    @* Brand / Model selection for the entry *@
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">Marka (Opsiyonel)</label>
                            <select class="form-select form-select-sm" @bind="BrandId" @bind:event="onchange">
                                <option value="">Seçiniz</option>
                                @foreach (var b in FilteredBrands)
                                {
                                    <option value="@b.Id">@b.BrandName</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Model (Opsiyonel)</label>
                            <select class="form-select form-select-sm" @bind="MaterialEntry.ModelId">
                                <option value="">Seçiniz</option>
                                @foreach (var m in FilteredModels)
                                {
                                    <option value="@m.Id">@m.ModelName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Hedef Seçimi -->
                    <div class="mb-3 bg-light p-3 rounded border">
                        <label class="form-label fw-bold">Malzeme Yeri</label>

                        <div class="mb-2">
                            <label class="small text-muted">Lokasyon</label>
                            <input class="form-control form-control-sm mb-1" placeholder="Ara..." @bind="locSearch" @bind:event="oninput" />
                            <select class="form-select form-select-sm" @bind="MaterialEntry.LocationId">
                                <option value="">Seçiniz</option>
                                @foreach (var loc in FilteredLocations)
                                {
                                    <option value="@loc.Id">@InventoryUIHelper.GetLocationFullName(loc.Id, Locations)</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="small text-muted">Personel (Opsiyonel)</label>
                            <input class="form-control form-control-sm mb-1" placeholder="Ara..." @bind="persSearch" @bind:event="oninput" />
                            <select class="form-select form-select-sm" @bind="MaterialEntry.PersonelId">
                                <option value="">Seçiniz</option>
                                @foreach (var p in FilteredPersons)
                                {
                                    <option value="@p.Id">@p.Adi @p.Soyadi</option>
                                }
                            </select>
                        </div>

                        @if (IsLocationInvalid)
                        {
                            <div class="text-danger small mt-2">Bir lokasyon veya personel seçmelisiniz.</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tarih</label>
                        <input class="form-control" @bind="MaterialEntry.EntryDate" type="date" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Belge No</label>
                        <input class="form-control" @bind="MaterialEntry.InvoiceNo" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success" @onclick="HandleSave" disabled="@IsSaveDisabled">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Envantere Kaydet
                    </button>
                    <button class="btn btn-secondary" @onclick="OnClose">Iptal</button>
                </div>
                } @* end HasPermission *@
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public MaterialEntry? MaterialEntry { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public List<Material> Materials { get; set; } = new();
    [Parameter] public List<MaterialUnit> MaterialUnits { get; set; } = new();
    [Parameter] public List<Location> Locations { get; set; } = new();
    [Parameter] public List<Personel> Persons { get; set; } = new();

    // Brands/models (kept: entry-level brand/model are still selectable)
    [Parameter] public List<MaterialBrand> Brands { get; set; } = new();
    [Parameter] public List<MaterialModel> Models { get; set; } = new();

    // Categories needed to resolve root category of a material (recursive)
    [Parameter] public List<MaterialCategory> Categories { get; set; } = new();

    // New parameter: when true, user cannot change the material (opened from inventory table)
    [Parameter] public bool IsMaterialFixed { get; set; } = false;

    [Parameter] public bool CanCreate { get; set; } = true;
    [Parameter] public bool CanEdit { get; set; } = true;

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string locSearch = "";
    private string persSearch = "";

    private bool IsNewEntry => MaterialEntry == null || MaterialEntry.Id == 0;

    // True when the current user has permission for the current operation (create vs edit)
    private bool HasPermission => IsNewEntry ? CanCreate : CanEdit;

    private int MaterialId
    {
        get => MaterialEntry?.MaterialId ?? 0;
        set
        {
            if (MaterialEntry != null)
            {
                MaterialEntry.MaterialId = value;
                var mat = Materials.FirstOrDefault(m => m.Id == value);
                if (mat != null)
                {
                    MaterialEntry.MaterialUnitId = mat.MaterialUnitId;
                    // IMPORTANT: Do NOT read or assign BrandId/ModelId from the Material entity 
                    // Material no longer contains BrandId/ModelId.
                }
                else
                {
                    MaterialEntry.MaterialUnitId = 0;
                }
            }
        }
    }

    private int? _brandId;
    private int? BrandId
    {
        get => MaterialEntry?.BrandId;
        set
        {
            if (MaterialEntry != null)
            {
                MaterialEntry.BrandId = value;
                OnBrandChanged();
            }
        }
    }

    private IEnumerable<Location> FilteredLocations => string.IsNullOrWhiteSpace(locSearch)
        ? Locations
        : Locations.Where(l => l.LocationName.Contains(locSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<Personel> FilteredPersons => string.IsNullOrWhiteSpace(persSearch)
        ? Persons
        : Persons.Where(p => (p.Adi + " " + p.Soyadi).Contains(persSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<MaterialModel> FilteredModels
    {
        get
        {
            if (MaterialEntry != null && MaterialEntry.BrandId.HasValue)
            {
                return Models.Where(m => m.BrandId == MaterialEntry.BrandId.Value);
            }

            // If editing an existing entry that has a ModelId but no BrandId, ensure the selected model appears
            if (MaterialEntry != null && MaterialEntry.ModelId.HasValue)
            {
                var selected = Models.FirstOrDefault(m => m.Id == MaterialEntry.ModelId.Value);
                if (selected != null)
                {
                    // Return the selected model first, then any other models (optional)
                    return new[] { selected }.Concat(Models.Where(m => m.Id != selected.Id));
                }
            }

            return Models;
        }
    }

    // Filter brands to only those whose CategoryId equals the selected material's root category id (recursive)
    // Ensure currently-selected brand is present in the list when editing.
    private IEnumerable<MaterialBrand> FilteredBrands
    {
        get
        {
            if (MaterialEntry == null || MaterialEntry.MaterialId == 0) return Enumerable.Empty<MaterialBrand>();

            var mat = Materials.FirstOrDefault(m => m.Id == MaterialEntry.MaterialId);
            if (mat == null) return Enumerable.Empty<MaterialBrand>();

            var rootCatId = GetRootCategoryId(mat.CategoryId);
            var list = rootCatId.HasValue
                ? Brands.Where(b => b.CategoryId.HasValue && b.CategoryId.Value == rootCatId.Value).ToList()
                : new List<MaterialBrand>();

            // Include currently selected brand even if it isn't in the filtered list (ensures brand/model are visible on edit)
            if (MaterialEntry.BrandId.HasValue)
            {
                var sel = Brands.FirstOrDefault(b => b.Id == MaterialEntry.BrandId.Value);
                if (sel != null && !list.Any(b => b.Id == sel.Id))
                {
                    list.Insert(0, sel);
                }
            }

            return list;
        }
    }

    // Walks up the category tree until the root (ParentCategoryId == null or 0) and returns that Id
    private int? GetRootCategoryId(int? categoryId)
    {
        if (!categoryId.HasValue) return null;
        if (Categories == null || Categories.Count == 0) return categoryId;

        var current = Categories.FirstOrDefault(c => c.Id == categoryId.Value);
        if (current == null) return categoryId;

        var visited = new HashSet<int>();
        while (current.ParentCategoryId.HasValue && current.ParentCategoryId.Value != 0)
        {
            if (!visited.Add(current.Id)) break; // protect against cycles
            var parent = Categories.FirstOrDefault(c => c.Id == current.ParentCategoryId.Value);
            if (parent == null) break;
            current = parent;
        }

        return current.Id;
    }

    // Validation Properties
    private bool IsLocationInvalid => MaterialEntry != null && (MaterialEntry.LocationId == null || MaterialEntry.LocationId == 0) && (MaterialEntry.PersonelId == null || MaterialEntry.PersonelId == 0);
    private bool IsSaveDisabled => MaterialEntry == null || MaterialEntry.Quantity < 1 || IsLocationInvalid || MaterialId == 0;

    private string GetUnitName()
    {
        if (MaterialEntry == null) return "";
        var u = MaterialUnits.FirstOrDefault(x => x.Id == MaterialEntry.MaterialUnitId);
        return u != null ? $"{u.Name} ({u.Symbol})" : "";
    }

    private void OnBrandChanged()
    {
        // @bind already updated MaterialEntry.BrandId; fix model selection only if necessary
        if (MaterialEntry == null) return;

        if (MaterialEntry.BrandId.HasValue)
        {
            var modelsForBrand = Models.Where(m => m.BrandId == MaterialEntry.BrandId.Value).ToList();
            if (MaterialEntry.ModelId.HasValue && !modelsForBrand.Any(m => m.Id == MaterialEntry.ModelId.Value))
            {
                MaterialEntry.ModelId = null;
            }
        }
        else
        {
            // brand cleared by user -> clear model
            MaterialEntry.ModelId = null;
        }

        StateHasChanged();
    }

    private async Task HandleSave()
    {
        if (IsSaveDisabled)
        {
            ToastService.ShowWarning("Lütfen zorunlu alanları doldurunuz.");
            return;
        }
        await OnSave.InvokeAsync();
    }
}