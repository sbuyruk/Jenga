@using Jenga.Models.Inventory
@using Jenga.Models.IKYS
@using Jenga.DataAccess.Services.Inventory
@using Jenga.Utility.Toast

@inject IMaterialEntryService MaterialEntryService
@inject IMaterialExitService MaterialExitService
@inject IMaterialTransferService MaterialTransferService
@inject IMaterialInventoryService MaterialInventoryService
@inject IToastService ToastService
@inject IHttpContextAccessor HttpContextAccessor

<!-- Styles moved to MaterialInventoryTable.razor.css -->

<table class="table table-sm table-hover table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>Malzeme</th>
            <th>Kategori</th>
            <th class="text-end">Toplam Miktar</th>
            <th>Birim</th>
            <th>Kritik Stok</th>
            <th>Bulunduğu Yerler</th>
            <th>Malzeme Hareketleri</th>
            <th>Giriş</th>
            <th>Çıkış</th>
            <th>Transfer</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Summaries)
        {
            <tr class="@(s.IsCritical ? "critical-row" : "")" role="row" aria-live="polite">
                <td class="text-start">@s.MaterialName</td>
                <td class="text-start">@s.CategoryName</td>
                <td class="text-end">@s.TotalQuantity</td>
                <td class="text-start">@s.UnitSymbol</td>
                <td class="text-center">
                    @if (s.HasCriticalStock)
                    {
                        if (s.IsCritical)
                        {
                            <span class="d-inline-flex align-items-center">
                                <i class="bi bi-exclamation-triangle-fill critical-icon" aria-hidden="true"></i>
                                <span class="badge bg-danger critical-badge">Kritik: @s.CriticalStock</span>
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">OK  <small>(@s.CriticalStock)</small></span>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">—</span>
                    }
                </td>

                <td class="text-center">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenLocations(s.MaterialId)">Bulunduğu yerler</button>
                </td>
                <td class="text-center">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenMovements(s.MaterialId)">Hareketler</button>
                </td>
                <td class="text-center">
                    <button class="btn btn-sm btn-outline-success" @onclick="() => StartEntry(s.MaterialId)">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Giriş
                    </button>
                </td>
                <td class="text-center">
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => StartExit(s.MaterialId)">
                        <i class="bi bi-box-arrow-right me-1"></i>Çıkış
                    </button>
                </td>
                <td class="text-center">
                    <button class="btn btn-sm btn-outline-warning" @onclick="() => StartTransfer(s.MaterialId)">
                        <i class="bi bi-arrow-left-right me-1"></i>Transfer
                    </button>
                </td>

            </tr>
        }
    </tbody>
</table>

@* Local modals for Entry / Exit / Transfer *@
<MaterialEntryEditModal MaterialEntry="editingEntry"
                        Materials="Materials"
                        MaterialUnits="MaterialUnits"
                        Locations="Locations"
                        Persons="Persons"
                        IsOpen="isEntryOpen"
                        IsMaterialFixed="isEntryMaterialFixed"
                        OnSave="OnEntryModalSave"
                        OnClose="CloseEntryModal" />

<MaterialExitEditModal MaterialExit="editingExit"
                       Materials="Materials"
                       MaterialUnits="MaterialUnits"
                       Locations="Locations"
                       Persons="Persons"
                       MaterialInventories="MaterialInventories"
                       IsOpen="isExitOpen"
                       IsMaterialFixed="isExitMaterialFixed"
                       OnSave="OnExitModalSave"
                       OnClose="CloseExitModal" />

<MaterialTransferEditModalV2 MaterialTransfer="editingTransfer"
                             Materials="Materials"
                             MaterialUnits="MaterialUnits"
                             Locations="Locations"
                             Persons="Persons"
                             MaterialInventories="MaterialInventories"
                             IsOpen="isTransferOpen"
                             IsMaterialFixed="isTransferMaterialFixed"
                             InitialSelectedFromInventoryId="modalInitialFromInventoryId"
                             OnSave="OnTransferModalSave"
                             OnClose="CloseTransferModal" />

@code {
    [Parameter] public List<MaterialInventory> MaterialInventories { get; set; } = new();
    [Parameter] public List<Material> Materials { get; set; } = new();
    [Parameter] public List<MaterialUnit> MaterialUnits { get; set; } = new();
    [Parameter] public List<MaterialCategory> Categories { get; set; } = new();

    // Optional: parent can provide locations/persons for the modals
    [Parameter] public List<Location> Locations { get; set; } = new();
    [Parameter] public List<Personel> Persons { get; set; } = new();

    [Parameter] public EventCallback<int> OnOpenMovements { get; set; }
    [Parameter] public EventCallback<int> OnOpenLocations { get; set; }

    // Parent callbacks (optional). If provided, component will prefer delegating start actions to parent.
    [Parameter] public EventCallback<Material> OnStartEntry { get; set; }
    [Parameter] public EventCallback<Material> OnStartExit { get; set; }
    [Parameter] public EventCallback<Material> OnStartTransfer { get; set; }

    private class Summary
    {
        public int MaterialId { get; set; }
        public string MaterialName { get; set; } = string.Empty;
        public string CategoryName { get; set; } = string.Empty;
        public decimal TotalQuantity { get; set; }
        public string UnitSymbol { get; set; } = string.Empty;
        public int? CriticalStock { get; set; }

        // treat as "has defined critical" only when > 0
        public bool HasCriticalStock => CriticalStock.HasValue && CriticalStock.Value > 0;

        // critical when total <= critical value
        public bool IsCritical => HasCriticalStock && TotalQuantity <= (decimal)CriticalStock.Value;
    }

    private IEnumerable<Summary> Summaries
    {
        get
        {
            var groups = MaterialInventories
                .GroupBy(mi => mi.MaterialId)
                .Select(g => new
                {
                    MaterialId = g.Key,
                    Total = g.Sum(x => x.Quantity)
                });

            var materialLookup = Materials.ToDictionary(m => m.Id);
            var unitLookup = MaterialUnits.ToDictionary(u => u.Id);
            var categoryLookup = Categories.ToDictionary(c => c.Id);

            foreach (var g in groups.OrderBy(x => materialLookup.ContainsKey(x.MaterialId) ? materialLookup[x.MaterialId].MaterialName : x.MaterialId.ToString()))
            {
                Material? mat = materialLookup.ContainsKey(g.MaterialId) ? materialLookup[g.MaterialId] : null;
                var unit = mat != null && unitLookup.ContainsKey(mat.MaterialUnitId) ? unitLookup[mat.MaterialUnitId] : null;
                var cat = mat != null && categoryLookup.ContainsKey(mat.CategoryId) ? categoryLookup[mat.CategoryId] : null;

                yield return new Summary
                {
                    MaterialId = g.MaterialId,
                    MaterialName = mat?.MaterialName ?? $"(id:{g.MaterialId})",
                    CategoryName = cat?.CategoryName ?? "-",
                    TotalQuantity = g.Total,
                    UnitSymbol = unit?.Symbol ?? unit?.Name ?? "",
                    CriticalStock = mat?.CriticalStock
                };
            }
        }
    }

    private Task OpenMovements(int materialId) => OnOpenMovements.InvokeAsync(materialId);
    private Task OpenLocations(int materialId) => OnOpenLocations.InvokeAsync(materialId);

    // Local modal state for MaterialEntry / MaterialExit / MaterialTransfer
    private MaterialEntry? editingEntry;
    private bool isEntryOpen;
    private bool isEntryMaterialFixed;

    private MaterialExit? editingExit;
    private bool isExitOpen;
    private bool isExitMaterialFixed;

    private MaterialTransfer? editingTransfer;
    private bool isTransferOpen;
    private bool isTransferMaterialFixed;
    private int? modalInitialFromInventoryId;

    // Entry flow
    private Task StartEntry(int materialId)
    {
        var mat = Materials.FirstOrDefault(m => m.Id == materialId);

        // Prefer parent handler
        if (mat != null && OnStartEntry.HasDelegate)
            return OnStartEntry.InvokeAsync(mat);

        if (mat != null)
        {
            editingEntry = new MaterialEntry
            {
                MaterialId = mat.Id,
                MaterialUnitId = mat.MaterialUnitId,
                EntryDate = DateTime.Now,
                Quantity = 1
            };
            isEntryOpen = true;
            isEntryMaterialFixed = true; // lock selection when opened from the table
        }
        return Task.CompletedTask;
    }

    private async Task OnEntryModalSave()
    {
        if (editingEntry == null) return;

        try
        {
            var currentUser = HttpContextAccessor.HttpContext?.User?.Identity?.Name;
            var saved = await MaterialEntryService.AddAsync(editingEntry, currentUser, CancellationToken.None);
            if (saved)
            {
                ToastService.ShowToast("Giriş kaydedildi.", ToastType.Success, 2000);
                MaterialInventories = await MaterialInventoryService.GetAllAsync();
            }
            else
            {
                ToastService.ShowToast("Giriş kaydedilemedi.", ToastType.Error, 3000);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast($"Hata: {ex.Message}", ToastType.Error, 5000);
        }
        finally
        {
            isEntryOpen = false;
            editingEntry = null;
            isEntryMaterialFixed = false;
            StateHasChanged();
        }
    }

    private void CloseEntryModal()
    {
        isEntryOpen = false;
        editingEntry = null;
        isEntryMaterialFixed = false;
    }

    // Exit flow
    private Task StartExit(int materialId)
    {
        var mat = Materials.FirstOrDefault(m => m.Id == materialId);

        // Prefer parent handler
        if (mat != null && OnStartExit.HasDelegate)
            return OnStartExit.InvokeAsync(mat);

        if (mat != null)
        {
            editingExit = new MaterialExit
            {
                MaterialId = mat.Id,
                MaterialUnitId = mat.MaterialUnitId,
                ExitDate = DateTime.Now,
                Quantity = 1
            };
            isExitOpen = true;
            isExitMaterialFixed = true;
        }
        return Task.CompletedTask;
    }

    private async Task OnExitModalSave()
    {
        if (editingExit == null) return;

        try
        {
            await MaterialExitService.AddAsync(editingExit, CancellationToken.None);
            ToastService.ShowToast("Çıkış kaydedildi.", ToastType.Success, 2000);
            MaterialInventories = await MaterialInventoryService.GetAllAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowToast($"Hata: {ex.Message}", ToastType.Error, 5000);
        }
        finally
        {
            isExitOpen = false;
            editingExit = null;
            isExitMaterialFixed = false;
            StateHasChanged();
        }
    }

    private void CloseExitModal()
    {
        isExitOpen = false;
        editingExit = null;
        isExitMaterialFixed = false;
    }

    // Transfer flow (new)
    private Task StartTransfer(int materialId)
    {
        var mat = Materials.FirstOrDefault(m => m.Id == materialId);

        // Prefer parent handler
        if (mat != null && OnStartTransfer.HasDelegate)
            return OnStartTransfer.InvokeAsync(mat);

        if (mat != null)
        {
            editingTransfer = new MaterialTransfer
            {
                MaterialId = mat.Id,
                MaterialUnitId = mat.MaterialUnitId,
                TransferDate = DateTime.Now,
                Quantity = 1
            };
            // no preselected from-inventory by default; parent can pass if needed via InitialSelectedFromInventoryId parameter
            modalInitialFromInventoryId = null;
            isTransferOpen = true;
            isTransferMaterialFixed = true;
        }
        return Task.CompletedTask;
    }

    private async Task OnTransferModalSave()
    {
        if (editingTransfer == null) return;

        try
        {
            var currentUser = HttpContextAccessor.HttpContext?.User?.Identity?.Name;
            var ok = await MaterialTransferService.AddAsync(editingTransfer, currentUser, CancellationToken.None);
            if (ok)
            {
                ToastService.ShowToast("Transfer kaydedildi.", ToastType.Success, 2000);
                MaterialInventories = await MaterialInventoryService.GetAllAsync();
            }
            else
            {
                ToastService.ShowToast("Transfer kaydedilemedi.", ToastType.Error, 3000);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast($"Hata: {ex.Message}", ToastType.Error, 5000);
        }
        finally
        {
            isTransferOpen = false;
            editingTransfer = null;
            modalInitialFromInventoryId = null;
            isTransferMaterialFixed = false;
            StateHasChanged();
        }
    }

    private void CloseTransferModal()
    {
        isTransferOpen = false;
        editingTransfer = null;
        modalInitialFromInventoryId = null;
        isTransferMaterialFixed = false;
    }
}