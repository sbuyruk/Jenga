@using System.ComponentModel.DataAnnotations
@using Jenga.Models.Inventory
@using Jenga.Models.IKYS
@using Jenga.DataAccess.Services.Inventory
@using Jenga.Utility.Logging
@using Jenga.Utility.Toast
@using Jenga.BlazorUI.Helpers
@using Jenga.BlazorUI.Components.Common

@inject IMaterialEntryService MaterialEntryService
@inject IMaterialExitService MaterialExitService
@inject IMaterialTransferService MaterialTransferService
@inject IMaterialInventoryService MaterialInventoryService
@inject IToastService ToastService
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogService LogService

@if (inventoryRows == null || !inventoryRows.Any())
{
    <div class="text-muted small">No inventory rows available.</div>
}
else
{
    <GenericTable TItem="InventoryRow"
                  @ref="tableRef"
                  Items="inventoryRows"
                  TableHeight="Auto"
                  ShowSearch="true"
                  PageSize="10"
                  PageSizeOptions="new[] {5, 10, 20, 50}"
                  KeySelector="(r => r.MaterialId)">

        <HeaderTemplate>
            @HeaderCell("Malzeme", nameof(InventoryRow.MaterialName))
            @HeaderCell("Kategori", nameof(InventoryRow.CategoryName))
            @HeaderCell("Toplam Miktar", nameof(InventoryRow.TotalQuantity), "text-end")
            @HeaderCell("Birim", nameof(InventoryRow.UnitSymbol))
            @HeaderCell("Kritik", nameof(InventoryRow.CriticalStock), "text-center")
            <th class="text-center">Yerler</th>
            <th class="text-center">Hareketler</th>
            <th class="text-center">Giriş</th>
            <th class="text-center">Çıkış</th>
            <th class="text-center">Transfer</th>
        </HeaderTemplate>

        <RowTemplate Context="r">
            <td class="align-middle">@r.MaterialName</td>
            <td class="align-middle">@r.CategoryName</td>
            <td class="align-middle text-end">@r.TotalQuantity</td>
            <td class="align-middle">@r.UnitSymbol</td>
            <td class="align-middle text-center">
                @if (r.HasCriticalStock)
                {
                    if (r.IsCritical)
                    {
                        <span class="d-inline-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill critical-icon" aria-hidden="true"></i>
                            <span class="badge bg-danger critical-badge">Kritik: @r.CriticalStock</span>
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">OK  <small>(@r.CriticalStock)</small></span>
                    }
                }
                else
                {
                    <span class="text-muted small">—</span>
                }
            </td>
            <td class="text-center align-middle">
                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenLocations(r.MaterialId)">Bulunduğu yerler</button>
            </td>
            <td class="text-center align-middle">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenMovements(r.MaterialId)">Hareketler</button>
            </td>
            <td class="text-center align-middle">
                <button class="btn btn-sm btn-outline-success" @onclick="() => StartEntry(r.MaterialId)">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Giriş
                </button>
            </td>
            <td class="text-center align-middle">
                <button class="btn btn-sm btn-outline-danger" @onclick="() => StartExit(r.MaterialId)">
                    <i class="bi bi-box-arrow-right me-1"></i>Çıkış
                </button>
            </td>
            <td class="text-center align-middle">
                <button class="btn btn-sm btn-outline-info" @onclick="() => StartTransfer(r.MaterialId)">
                    <i class="bi bi-arrow-left-right me-1"></i>Transfer
                </button>
            </td>
        </RowTemplate>
    </GenericTable>
}

@* Local modals for Entry / Exit / Transfer *@
<MaterialEntryEditModal MaterialEntry="editingEntry"
                        Materials="Materials"
                        MaterialUnits="MaterialUnits"
                        Locations="Locations"
                        Persons="Persons"
                        Brands="Brands"
                        Models="Models"
                        Categories="Categories"
                        IsOpen="isEntryOpen"
                        IsMaterialFixed="isEntryMaterialFixed"
                        OnSave="OnEntryModalSave"
                        OnClose="CloseEntryModal" />

<MaterialExitEditModal MaterialExit="editingExit"
                       Materials="Materials"
                       MaterialUnits="MaterialUnits"
                       Locations="Locations"
                       Persons="Persons"
                       Brands="Brands"
                       Models="Models"
                       MaterialInventories="MaterialInventories"
                       IsOpen="isExitOpen"
                       IsMaterialFixed="isExitMaterialFixed"
                       OnSave="OnExitModalSave"
                       OnSaveWithAssets="OnExitAssetIdsReceived"
                       OnClose="CloseExitModal" />

<MaterialTransferEditModalV2 MaterialTransfer="editingTransfer"
                             Materials="Materials"
                             MaterialUnits="MaterialUnits"
                             Locations="Locations"
                             Persons="Persons"
                             Brands="Brands"
                             Models="Models"
                             MaterialInventories="MaterialInventories"
                             IsOpen="isTransferOpen"
                             IsMaterialFixed="isTransferMaterialFixed"
                             InitialSelectedFromInventoryId="modalInitialFromInventoryId"
                             OnSave="OnTransferModalSave"
                             OnSaveWithAssets="OnTransferAssetIdsReceived"
                             OnClose="CloseTransferModal" />

<MaterialLocationsModal IsOpen="isLocationsModalOpen"
                        MaterialId="locationsMaterialId"
                        MaterialInventories="locationsModalInventories"
                        Materials="Materials"
                        Locations="Locations"
                        Persons="Persons"
                        Brands="Brands"
                        Models="Models"
                        OnClose="CloseLocationsModal" />

@code {
    private List<InventoryRow> inventoryRows = new();

    [Parameter] public List<MaterialInventory> MaterialInventories { get; set; } = new();
    [Parameter] public List<Material> Materials { get; set; } = new();
    [Parameter] public List<MaterialUnit> MaterialUnits { get; set; } = new();
    [Parameter] public List<MaterialCategory> Categories { get; set; } = new();

    // Optional: parent can provide locations/persons for the modals
    [Parameter] public List<Location> Locations { get; set; } = new();
    [Parameter] public List<Personel> Persons { get; set; } = new();

    // Optional lookups used in the locations modal
    [Parameter] public List<MaterialBrand> Brands { get; set; } = new();
    [Parameter] public List<MaterialModel> Models { get; set; } = new();

    [Parameter] public EventCallback<int> OnOpenMovements { get; set; }
    [Parameter] public EventCallback<int> OnOpenLocations { get; set; }

    // Parent callbacks (optional). If provided, component will prefer delegating start actions to parent.
    [Parameter] public EventCallback<Material> OnStartEntry { get; set; }
    [Parameter] public EventCallback<Material> OnStartExit { get; set; }
    [Parameter] public EventCallback<Material> OnStartTransfer { get; set; }

    // New: notify parent when inventory data changed so parent can reload latest DB data
    [Parameter] public EventCallback OnInventoryChanged { get; set; }

    private class Summary
    {
        public int MaterialId { get; set; }
        public string MaterialName { get; set; } = string.Empty;
        public string CategoryName { get; set; } = string.Empty;
        public decimal TotalQuantity { get; set; }
        public string UnitSymbol { get; set; } = string.Empty;
        public int? CriticalStock { get; set; }

        public bool HasCriticalStock => CriticalStock.HasValue && CriticalStock.Value > 0;
        public bool IsCritical => HasCriticalStock && TotalQuantity <= (decimal)CriticalStock.Value;
    }

    private IEnumerable<Summary> Summaries
    {
        get
        {
            var groups = MaterialInventories
                .GroupBy(mi => mi.MaterialId)
                .Select(g => new
                {
                    MaterialId = g.Key,
                    Total = g.Sum(x => x.Quantity)
                });

            var materialLookup = Materials.ToDictionary(m => m.Id);
            var unitLookup = MaterialUnits.ToDictionary(u => u.Id);
            var categoryLookup = Categories.ToDictionary(c => c.Id);

            foreach (var g in groups.OrderBy(x => materialLookup.ContainsKey(x.MaterialId) ? materialLookup[x.MaterialId].MaterialName : x.MaterialId.ToString()))
            {
                Material? mat = materialLookup.ContainsKey(g.MaterialId) ? materialLookup[g.MaterialId] : null;
                var unit = mat != null && unitLookup.ContainsKey(mat.MaterialUnitId) ? unitLookup[mat.MaterialUnitId] : null;
                var cat = mat != null && categoryLookup.ContainsKey(mat.CategoryId) ? categoryLookup[mat.CategoryId] : null;

                yield return new Summary
                {
                    MaterialId = g.MaterialId,
                    MaterialName = mat?.MaterialName ?? $"(id:{g.MaterialId})",
                    CategoryName = cat?.CategoryName ?? "-",
                    TotalQuantity = g.Total,
                    UnitSymbol = unit?.Symbol ?? unit?.Name ?? "",
                    CriticalStock = mat?.CriticalStock
                };
            }
        }
    }

    protected override void OnParametersSet()
    {
        BuildInventoryRows();
    }

    private void BuildInventoryRows()
    {
        inventoryRows = Summaries.Select(s => new InventoryRow
        {
            MaterialId = s.MaterialId,
            MaterialName = s.MaterialName ?? string.Empty,
            CategoryName = s.CategoryName ?? string.Empty,
            TotalQuantity = s.TotalQuantity,
            UnitSymbol = s.UnitSymbol ?? string.Empty,
            CriticalStock = s.CriticalStock,
            HasCriticalStock = s.HasCriticalStock,
            IsCritical = s.IsCritical
        }).ToList();
    }

    private Task OpenMovements(int materialId) => OnOpenMovements.InvokeAsync(materialId);

    // If parent handles OnOpenLocations, prefer that. Otherwise open local modal that shows MaterialInventory rows.
    private async Task OpenLocations(int materialId)
    {
        locationsMaterialId = materialId;
        locationsModalInventories = (MaterialInventories ?? new List<MaterialInventory>())
            .Where(mi => mi.MaterialId == materialId && mi.Quantity > 0)
            .ToList();

        isLocationsModalOpen = true;
        StateHasChanged();

        if (OnOpenLocations.HasDelegate)
        {
            try
            {
                await OnOpenLocations.InvokeAsync(materialId);
            }
            catch
            {
                // swallow to avoid breaking UI
            }
        }
    }

    private void CloseLocationsModal()
    {
        isLocationsModalOpen = false;
        locationsMaterialId = 0;
        locationsModalInventories = new();
    }

    // Local modal state for MaterialEntry / MaterialExit / MaterialTransfer
    private MaterialEntry? editingEntry;
    private bool isEntryOpen;
    private bool isEntryMaterialFixed;

    private MaterialExit? editingExit;
    private bool isExitOpen;
    private bool isExitMaterialFixed;

    private MaterialTransfer? editingTransfer;
    private bool isTransferOpen;
    private bool isTransferMaterialFixed;
    private int? modalInitialFromInventoryId;

    // Locations modal state
    private bool isLocationsModalOpen;
    private int locationsMaterialId;
    private List<MaterialInventory> locationsModalInventories = new();

    // Entry flow
    private Task StartEntry(int materialId)
    {
        var mat = Materials.FirstOrDefault(m => m.Id == materialId);

        if (mat != null && OnStartEntry.HasDelegate)
            return OnStartEntry.InvokeAsync(mat);

        if (mat != null)
        {
            editingEntry = new MaterialEntry
            {
                MaterialId = mat.Id,
                MaterialUnitId = mat.MaterialUnitId,
                EntryDate = DateTime.Now,
                Quantity = 1
            };
            isEntryOpen = true;
            isEntryMaterialFixed = true;
        }
        return Task.CompletedTask;
    }

    private async Task OnEntryModalSave()
    {
        if (editingEntry == null) return;

        try
        {
            var currentUser = HttpContextAccessor.HttpContext?.User?.Identity?.Name;
            var saved = await MaterialEntryService.AddAsync(editingEntry, currentUser, CancellationToken.None);
            if (saved)
            {
                ToastService.ShowToast("Giriş kaydedildi.", ToastType.Success, 2000);
                MaterialInventories = await MaterialInventoryService.GetAllAsync();
                // notify parent to refresh its data
                if (OnInventoryChanged.HasDelegate)
                    await OnInventoryChanged.InvokeAsync();
            }
            else
            {
                ToastService.ShowToast("Giriş kaydedilemedi.", ToastType.Error, 3000);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast($"Hata: {ex.Message}", ToastType.Error, 5000);
        }
        finally
        {
            isEntryOpen = false;
            editingEntry = null;
            isEntryMaterialFixed = false;
            StateHasChanged();
        }
    }

    private void CloseEntryModal()
    {
        isEntryOpen = false;
        editingEntry = null;
        isEntryMaterialFixed = false;
    }

    // Exit flow
    private Task StartExit(int materialId)
    {
        var mat = Materials.FirstOrDefault(m => m.Id == materialId);

        if (mat != null && OnStartExit.HasDelegate)
            return OnStartExit.InvokeAsync(mat);

        if (mat != null)
        {
            editingExit = new MaterialExit
            {
                MaterialId = mat.Id,
                MaterialUnitId = mat.MaterialUnitId,
                ExitDate = DateTime.Now,
                Quantity = 1
            };

            var initial = (MaterialInventories ?? new List<MaterialInventory>())
                .Where(mi => mi.MaterialId == mat.Id)
                .GroupBy(mi => new { mi.LocationId, mi.PersonelId })
                .Select(g => new
                {
                    InvId = g.First().Id,
                    Loc = g.Key.LocationId,
                    Pers = g.Key.PersonelId,
                    Qty = g.Sum(x => x.Quantity)
                })
                .Where(x => x.Qty > 0)
                .OrderByDescending(x => x.Qty)
                .FirstOrDefault();

            if (initial != null)
            {
                editingExit.LocationId = (initial.Loc.HasValue && initial.Loc.Value != 0) ? initial.Loc : null;
                editingExit.PersonelId = (initial.Pers.HasValue && initial.Pers.Value != 0) ? initial.Pers : null;
            }

            isExitOpen = true;
            isExitMaterialFixed = true;
        }
        return Task.CompletedTask;
    }

    private List<int>? pendingExitAssetIds;
    private List<int>? pendingTransferAssetIds;

    private void OnExitAssetIdsReceived(List<int> assetIds)
    {
        pendingExitAssetIds = assetIds;
    }

    private void OnTransferAssetIdsReceived(List<int> assetIds)
    {
        pendingTransferAssetIds = assetIds;
    }

    private async Task OnExitModalSave()
    {
        if (editingExit == null) return;
        var assetIds = pendingExitAssetIds;
        pendingExitAssetIds = null;

        try
        {
            await MaterialExitService.AddAsync(editingExit, assetIds, CancellationToken.None);
            ToastService.ShowToast("Çıkış kaydedildi.", ToastType.Success, 2000);
            MaterialInventories = await MaterialInventoryService.GetAllAsync();
            if (OnInventoryChanged.HasDelegate)
                await OnInventoryChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowToast($"Hata: {ex.Message}", ToastType.Error, 5000);
        }
        finally
        {
            isExitOpen = false;
            editingExit = null;
            isExitMaterialFixed = false;
            StateHasChanged();
        }
    }

    private void CloseExitModal()
    {
        isExitOpen = false;
        editingExit = null;
        isExitMaterialFixed = false;
    }

    // Transfer flow (new)
    private Task StartTransfer(int materialId)
    {
        var mat = Materials.FirstOrDefault(m => m.Id == materialId);

        if (mat != null && OnStartTransfer.HasDelegate)
            return OnStartTransfer.InvokeAsync(mat);

        if (mat != null)
        {
            editingTransfer = new MaterialTransfer
            {
                MaterialId = mat.Id,
                MaterialUnitId = mat.MaterialUnitId,
                TransferDate = DateTime.Now,
                Quantity = 1
            };

            var initialInvId = (MaterialInventories ?? new List<MaterialInventory>())
                .Where(mi => mi.MaterialId == mat.Id)
                .GroupBy(mi => new { mi.LocationId, mi.PersonelId })
                .Select(g => new { InvId = g.First().Id, Qty = g.Sum(x => x.Quantity) })
                .Where(x => x.Qty > 0)
                .OrderByDescending(x => x.Qty)
                .Select(x => x.InvId)
                .FirstOrDefault();

            modalInitialFromInventoryId = initialInvId == 0 ? null : initialInvId;

            isTransferOpen = true;
            isTransferMaterialFixed = true;
        }
        return Task.CompletedTask;
    }

    private async Task OnTransferModalSave(MaterialTransfer? transfer)
    {
        if (transfer == null) return;
        var assetIds = pendingTransferAssetIds;
        pendingTransferAssetIds = null;

        try
        {
            var currentUser = HttpContextAccessor.HttpContext?.User?.Identity?.Name;
            var ok = await MaterialTransferService.AddAsync(transfer, currentUser, assetIds, CancellationToken.None);
            if (ok)
            {
                ToastService.ShowToast("Transfer kaydedildi.", ToastType.Success, 2000);
                MaterialInventories = await MaterialInventoryService.GetAllAsync();
                // notify parent to refresh its data
                if (OnInventoryChanged.HasDelegate)
                    await OnInventoryChanged.InvokeAsync();
            }
            else
            {
                ToastService.ShowToast("Transfer kaydedilemedi.", ToastType.Error, 3000);
            }
        }
        catch (Exception ex)
        {
            LogService.LogError("Malzeme transfer başarısız oldu", ex);
            throw; //ToastService.ShowToast($"Hata: {ex.Message}", ToastType.Error, 5000);
        }
        finally
        {
            isTransferOpen = false;
            editingTransfer = null;
            modalInitialFromInventoryId = null;
            isTransferMaterialFixed = false;
            StateHasChanged();
        }
    }

    private void CloseTransferModal()
    {
        isTransferOpen = false;
        editingTransfer = null;
        modalInitialFromInventoryId = null;
        isTransferMaterialFixed = false;
    }

    private class InventoryRow
    {
        public int MaterialId { get; set; }

        [Display(Name = "Malzeme")]
        public string MaterialName { get; set; } = string.Empty;

        [Display(Name = "Kategori")]
        public string CategoryName { get; set; } = string.Empty;

        [Display(Name = "Toplam Miktar")]
        public decimal TotalQuantity { get; set; }

        [Display(Name = "Birim")]
        public string UnitSymbol { get; set; } = string.Empty;

        [Display(Name = "Kritik Stok")]
        public int? CriticalStock { get; set; }

        public bool HasCriticalStock { get; set; }
        public bool IsCritical { get; set; }
    }

    private GenericTable<InventoryRow>? tableRef;

    private RenderFragment HeaderCell(string title, string field, string? thClass = null) => __builder =>
    {
        var seq = 0;

        __builder.OpenElement(seq++, "th");
        if (!string.IsNullOrWhiteSpace(thClass))
        {
            __builder.AddAttribute(seq++, "class", thClass);
        }
        __builder.AddAttribute(seq++, "role", "button");
        __builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => tableRef!.SortBy(field)));

        __builder.OpenElement(seq++, "span");
        __builder.AddAttribute(seq++, "class", "d-inline-flex align-items-center");

        __builder.OpenElement(seq++, "span");
        __builder.AddContent(seq++, title);
        __builder.CloseElement();

        if (tableRef?.CurrentSortField == field)
        {
            __builder.OpenElement(seq++, "i");
            __builder.AddAttribute(seq++, "class", $"gt-sort-indicator bi {(tableRef.CurrentSortDescending ? "bi-caret-down-fill" : "bi-caret-up-fill")} ms-2");
            __builder.AddAttribute(seq++, "aria-hidden", "true");
            __builder.CloseElement();
        }

        __builder.CloseElement(); // span
        __builder.CloseElement(); // th
    };
}