@using Jenga.Models.IKYS
@using Jenga.Models.Inventory
@using Jenga.BlazorUI.Helpers
@using Jenga.DataAccess.Services.Inventory

@inject IToastService ToastService
@inject IMaterialAssetService MaterialAssetService

@if (IsOpen)
{
    <div class="modal show" tabindex="-1" style="display: block;">
        <div class="modal-dialog modal-lg">
            <div class="modal-content small">
                <div class="modal-header bg-info-subtle">
                    <h5 class="modal-title">Malzeme Transferi</h5>
                    <button type="button" class="btn-close" @onclick="OnClose" aria-label="Kapat"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">
                        <!-- SOL ÜST: Malzeme Seçimi -->
                        <div class="col-md-6">
                            <label class="form-label">Malzeme</label>
                            @if (IsMaterialFixed && WorkingTransfer != null && WorkingTransfer.MaterialId > 0)
                            {
                                <select class="form-select" @bind="MaterialId" disabled>
                                    <option value="@WorkingTransfer.MaterialId">
                                        @Materials.FirstOrDefault(m => m.Id == WorkingTransfer.MaterialId)?.MaterialName
                                    </option>
                                </select>
                            }
                            else
                            {
                                <select class="form-select" @bind="MaterialId">
                                    <option value="0">Malzeme seçiniz</option>
                                    @foreach (var mat in DropdownMaterials) { <option value="@mat.Id">@mat.MaterialName</option> }
                                </select>
                            }
                        </div>

                        @if (!IsSelectedMaterialAsset)
                        {
                            <div class="col-md-3">
                                <label class="form-label">Miktar</label>
                                <input class="form-control form-control-sm" @bind="WorkingTransfer.Quantity" type="number" min="1" max="@SelectedFromInventoryQuantity" />
                                @if (ShowQuantityError)
                                {
                                    <div class="text-danger small mt-1">
                                        @(WorkingTransfer.Quantity < 1 ? "En az 1 olmali." : $"Maks: {SelectedFromInventoryQuantity}")
                                    </div>
                                }
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Birim</label>
                                <input class="form-control form-control-sm" value="@SelectedUnitName" disabled />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-3">
                                <label class="form-label">Seçilen</label>
                                <input class="form-control form-control-sm" value="@($"{selectedAssetIds.Count} adet")" disabled />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Birim</label>
                                <input class="form-control form-control-sm" value="@SelectedUnitName" disabled />
                            </div>
                        }

                        <!-- ORTA SOL: KAYNAK (FROM) -->
                        <div class="col-md-6 bg-danger-subtle p-3 rounded-start">
                            <label class="form-label fw-bold text-danger-emphasis">Nereden (Kaynak)</label>

                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="small text-muted">Kaynak Lokasyon</label>
                                    <select class="form-select form-select-sm" @bind="SelectedFromInventoryId">
                                        <option value="0">-- Lokasyon / Marka / Model Seçiniz --</option>
                                        @foreach (var l in FromSourceLocations)
                                        {
                                            <option value="@l.Id">@l.LocationName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="small text-muted">Kaynak Personel</label>
                                    <select class="form-select form-select-sm" @bind="SelectedFromInventoryId">
                                        <option value="0">-- Personel Yok / Seçiniz --</option>
                                        @foreach (var p in FromSourcePersons)
                                        {
                                            <option value="@p.Id">@p.FullName</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="small text-muted mt-2">
                                Seçili Stok: <strong>@SelectedFromInventoryQuantity</strong> @SelectedUnitName
                            </div>

                            @if (ShowFromSelectionError)
                            {
                                <div class="text-danger small mt-1">Geçerli bir kaynak stok kaydi seçmelisiniz.</div>
                            }

                            <!-- ASSET SEÇIM PANELI -->
                            @if (IsSelectedMaterialAsset && SelectedFromInventoryId != 0)
                            {
                                <div class="mt-3 border-top pt-2">
                                    <label class="form-label fw-semibold">
                                        <i class="bi bi-cpu me-1"></i> Transfer Edilecek Demirbaslari Seçin
                                    </label>
                                    @if (!availableAssets.Any())
                                    {
                                        <div class="text-muted small">Bu kaynakta aktif demirbas bulunamadi.</div>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush" style="max-height:200px; overflow-y:auto;">
                                            @foreach (var asset in availableAssets)
                                            {
                                                var isChecked = selectedAssetIds.Contains(asset.Id);
                                                <label class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-1 @(isChecked ? "list-group-item-info" : "")">
                                                    <input type="checkbox" class="form-check-input mt-0"
                                                           checked="@isChecked"
                                                           @onchange="() => ToggleAsset(asset.Id)" />
                                                    <span class="fw-semibold">@(asset.SerialNumber ?? $"ID:{asset.Id}")</span>
                                                    @if (!string.IsNullOrEmpty(asset.Barcode))
                                                    {
                                                        <span class="text-muted small">BC: @asset.Barcode</span>
                                                    }
                                                    <span class="badge bg-success ms-auto">@GetAssetStatusLabel(asset.Status)</span>
                                                </label>
                                            }
                                        </div>
                                        @if (selectedAssetIds.Count == 0)
                                        {
                                            <div class="text-danger small mt-1">En az bir demirbas seçmelisiniz.</div>
                                        }
                                    }
                                </div>
                            }

                            <div class="transfer-arrow-container" aria-hidden="true">
                                <div class="transfer-arrow">
                                    <div class="track"></div>
                                    <svg class="arrow-icon" viewBox="0 0 36 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="0" y1="9" x2="24" y2="9" stroke-opacity="0.9" />
                                        <polyline points="18,2 30,9 18,16" stroke-opacity="0.95" fill="currentColor" />
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <!-- ORTA SAG: HEDEF (TO) -->
                        <div class="col-md-6 bg-success-subtle p-3 rounded-end">
                            <label class="form-label fw-bold text-success-emphasis">Nereye (Hedef)</label>

                            <div class="mb-2">
                                <div class="small text-muted">Hedef Lokasyon</div>
                                <div class="input-group input-group-sm">
                                    <input class="form-control" placeholder="Ara..." @bind="toLocationSearch" @bind:event="oninput" />
                                    <select class="form-select" @bind="SelectedToLocationId" style="max-width: 70%;">
                                        <option value="0">Seçiniz...</option>
                                        @foreach (var loc in AvailableToLocationsFiltered)
                                        {
                                            <option value="@loc.Id">@GetLocationOptionLabel(loc)</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="mb-1">
                                <div class="small text-muted">Hedef Personel</div>
                                <div class="input-group input-group-sm">
                                    <input class="form-control" placeholder="Ara..." @bind="toPersonSearch" @bind:event="oninput" />
                                    <select class="form-select" @bind="SelectedToPersonId" style="max-width: 70%;">
                                        <option value="">Seçiniz</option>
                                        @foreach (var p in AvailableToPersonsFiltered)
                                        {
                                            <option value="@p.PersonId">@GetPersonOptionLabel(p)</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            @if (ShowToSelectionError)
                            {
                                <div class="text-danger small mt-1">Hedef lokasyon veya kisi seçmelisiniz.</div>
                            }
                        </div>

                        <!-- ALT: Tarih ve Açiklama -->
                        <div class="col-md-6">
                            <label class="form-label">Tarih</label>
                            <input class="form-control" @bind="WorkingTransfer.TransferDate" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Referans / Belge No</label>
                            <input class="form-control" @bind="Reference" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Açiklama</label>
                            <textarea class="form-control" rows="2" @bind="WorkingTransfer.Aciklama"></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-info" @onclick="HandleSave" disabled="@IsSaveDisabled">
                        <i class="bi bi-arrow-left-right me-1"></i> Transfer Et
                    </button>
                    <button class="btn btn-secondary" @onclick="OnClose">Iptal</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    #region Models
    public class InventoryOption
    {
        public int InventoryId { get; set; }
        public int? LocationId { get; set; }
        public int? PersonelId { get; set; }
        public string Label { get; set; } = "";
        public int Quantity { get; set; }
        public int? BrandId { get; set; }
        public int? ModelId { get; set; }
    }

    public class PersonLiteWithQty
    {
        public int PersonId { get; set; }
        public string FullName { get; set; } = "";
        public int Quantity { get; set; }
    }

    public class FromSourceItem { public int Id { get; set; } public string FullName { get; set; } = ""; }
    public class FromLocationItem { public int Id { get; set; } public string LocationName { get; set; } = ""; }
    #endregion

    #region Parameters
    [Parameter] public MaterialTransfer? MaterialTransfer { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public List<Material> Materials { get; set; } = new();
    [Parameter] public List<MaterialUnit> MaterialUnits { get; set; } = new();
    [Parameter] public List<Location> Locations { get; set; } = new();
    [Parameter] public List<Personel> Persons { get; set; } = new();
    [Parameter] public List<MaterialBrand> Brands { get; set; } = new();
    [Parameter] public List<MaterialModel> Models { get; set; } = new();
    [Parameter] public List<MaterialInventory>? MaterialInventories { get; set; }
    [Parameter] public int? InitialSelectedFromInventoryId { get; set; }
    [Parameter] public EventCallback<MaterialTransfer?> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool IsMaterialFixed { get; set; } = false;
    [Parameter] public EventCallback<List<int>> OnSaveWithAssets { get; set; }
    #endregion

    #region State
    private string? Reference { get; set; }
    private string toLocationSearch = "";
    private string toPersonSearch = "";

    private MaterialTransfer WorkingTransfer { get; set; } = new MaterialTransfer();

    private int _selectedFromInventoryId;
    private int SelectedFromInventoryId
    {
        get => _selectedFromInventoryId;
        set
        {
            if (_selectedFromInventoryId == value) return;
            _selectedFromInventoryId = value;
            MapSelectedFromInventoryToTransfer();
            SyncFromDropdowns();
            selectedAssetIds.Clear();
            _ = LoadAvailableAssets();
            StateHasChanged();
        }
    }

    private int? SelectedFromPersonId { get; set; }
    private int? SelectedFromLocationId { get; set; }
    private int? SelectedToLocationId { get; set; }
    private int? SelectedToPersonId { get; set; }

    private List<InventoryOption> AvailableFromInventoryOptions { get; set; } = new();
    private List<FromSourceItem> FromSourcePersons { get; set; } = new();
    private List<FromLocationItem> FromSourceLocations { get; set; } = new();
    private Dictionary<int, int> ToLocationQuantities { get; set; } = new();
    private List<PersonLiteWithQty> AvailableToPersons { get; set; } = new();

    private List<MaterialAsset> availableAssets = new();
    private List<int> selectedAssetIds = new();
    #endregion

    #region Computed Properties
    private bool IsSelectedMaterialAsset =>
        WorkingTransfer != null
        && WorkingTransfer.MaterialId > 0
        && Materials.FirstOrDefault(m => m.Id == WorkingTransfer.MaterialId)?.IsAsset == true;

    private int MaterialId
    {
        get => WorkingTransfer?.MaterialId ?? 0;
        set
        {
            if (WorkingTransfer != null)
            {
                WorkingTransfer.MaterialId = value;
                var mat = Materials.FirstOrDefault(m => m.Id == value);
                if (mat != null)
                {
                    WorkingTransfer.MaterialUnitId = mat.MaterialUnitId;
                }
            }
            selectedAssetIds.Clear();
            availableAssets.Clear();
            RecalculateDerived();
        }
    }

    private IEnumerable<Material> DropdownMaterials
    {
        get
        {
            if (IsOpen && WorkingTransfer != null && WorkingTransfer.MaterialId > 0)
            {
                var single = Materials.Where(m => m.Id == WorkingTransfer.MaterialId);
                if (single.Any()) return single;
            }
            return Materials;
        }
    }

    private IEnumerable<Location> AvailableToLocationsFiltered =>
        string.IsNullOrWhiteSpace(toLocationSearch)
            ? Locations
            : Locations.Where(l => l.LocationName.Contains(toLocationSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<PersonLiteWithQty> AvailableToPersonsFiltered =>
        string.IsNullOrWhiteSpace(toPersonSearch)
            ? AvailableToPersons
            : AvailableToPersons.Where(p => p.FullName.Contains(toPersonSearch, StringComparison.OrdinalIgnoreCase));

    private int SelectedFromInventoryQuantity => AvailableFromInventoryOptions.FirstOrDefault(o => o.InventoryId == SelectedFromInventoryId)?.Quantity ?? 0;
    private string? SelectedUnitName => MaterialUnits.FirstOrDefault(u => u.Id == (WorkingTransfer?.MaterialUnitId ?? 0))?.Symbol;

    private bool ShowQuantityError => !IsSelectedMaterialAsset && WorkingTransfer != null && (WorkingTransfer.Quantity < 1 || (SelectedFromInventoryQuantity > 0 && WorkingTransfer.Quantity > SelectedFromInventoryQuantity));
    private bool ShowFromSelectionError => SelectedFromInventoryId == 0;
    private bool ShowToSelectionError => (SelectedToLocationId == 0 || SelectedToLocationId == null) && (SelectedToPersonId == 0 || SelectedToPersonId == null);

    private bool IsSaveDisabled
    {
        get
        {
            if (WorkingTransfer == null || ShowFromSelectionError || ShowToSelectionError) return true;
            if (IsSelectedMaterialAsset)
                return selectedAssetIds.Count == 0;
            return ShowQuantityError;
        }
    }
    #endregion

    protected override void OnParametersSet()
    {
        if (MaterialTransfer != null)
        {
            WorkingTransfer = new MaterialTransfer
            {
                Id = MaterialTransfer.Id,
                MaterialId = MaterialTransfer.MaterialId,
                Quantity = MaterialTransfer.Quantity,
                MaterialUnitId = MaterialTransfer.MaterialUnitId,
                FromLocationId = MaterialTransfer.FromLocationId,
                FromPersonId = MaterialTransfer.FromPersonId,
                ToLocationId = MaterialTransfer.ToLocationId,
                ToPersonId = MaterialTransfer.ToPersonId,
                TransferDate = MaterialTransfer.TransferDate,
                BrandId = MaterialTransfer.BrandId,
                ModelId = MaterialTransfer.ModelId,
                Aciklama = MaterialTransfer.Aciklama
            };

            SelectedToLocationId = WorkingTransfer.ToLocationId;
            SelectedToPersonId = WorkingTransfer.ToPersonId == 0 ? null : WorkingTransfer.ToPersonId;
            Reference = Reference ?? WorkingTransfer.Aciklama;
        }
        else
        {
            if (IsOpen)
            {
                WorkingTransfer = new MaterialTransfer
                {
                    TransferDate = DateTime.Now,
                    Quantity = 1
                };
                SelectedToLocationId = null;
                SelectedToPersonId = null;
                Reference = null;
            }
        }

        selectedAssetIds.Clear();
        availableAssets.Clear();
        RecalculateDerived();

        if (InitialSelectedFromInventoryId.HasValue && InitialSelectedFromInventoryId.Value > 0)
        {
            var targetInv = MaterialInventories?.FirstOrDefault(x => x.Id == InitialSelectedFromInventoryId.Value);
            if (targetInv != null)
            {
                var matchingOption = AvailableFromInventoryOptions.FirstOrDefault(o =>
                    o.LocationId == targetInv.LocationId &&
                    o.PersonelId == targetInv.PersonelId &&
                    o.BrandId == targetInv.BrandId &&
                    o.ModelId == targetInv.ModelId);
                if (matchingOption != null)
                {
                    _selectedFromInventoryId = matchingOption.InventoryId;
                    MapSelectedFromInventoryToTransfer();
                    SyncFromDropdowns();
                    _ = LoadAvailableAssets();
                }
            }
        }
    }

    private async Task LoadAvailableAssets()
    {
        availableAssets.Clear();
        if (!IsSelectedMaterialAsset || SelectedFromInventoryId == 0) return;

        var opt = AvailableFromInventoryOptions.FirstOrDefault(o => o.InventoryId == SelectedFromInventoryId);
        if (opt == null) return;

        var allAssetsR = await MaterialAssetService.GetByMaterialIdAsync(WorkingTransfer.MaterialId);
        var allAssets = allAssetsR.IsSuccess ? allAssetsR.Value : new();
        availableAssets = allAssets
            .Where(a => a.Status == AssetStatus.Active
                && a.LocationId == opt.LocationId
                && a.PersonelId == opt.PersonelId
                && a.BrandId == opt.BrandId
                && a.ModelId == opt.ModelId)
            .ToList();

        StateHasChanged();
    }

    private void ToggleAsset(int assetId)
    {
        if (selectedAssetIds.Contains(assetId))
            selectedAssetIds.Remove(assetId);
        else
            selectedAssetIds.Add(assetId);

        if (IsSelectedMaterialAsset)
            WorkingTransfer.Quantity = selectedAssetIds.Count;
    }

    private string GetAssetStatusLabel(AssetStatus status) => status switch
    {
        AssetStatus.Active => "Aktif",
        AssetStatus.InRepair => "Onarimda",
        AssetStatus.Retired => "Hurda",
        AssetStatus.Lost => "Kayip",
        _ => status.ToString()
    };

    private void RecalculateDerived()
    {
        if (WorkingTransfer == null) return;
        var matId = WorkingTransfer.MaterialId;

        AvailableFromInventoryOptions = (MaterialInventories ?? new List<MaterialInventory>())
            .Where(mi => mi.MaterialId == matId)
            .GroupBy(mi => new { mi.LocationId, mi.PersonelId, mi.BrandId, mi.ModelId })
            .Select(g => new InventoryOption
            {
                InventoryId = g.First().Id,
                LocationId = g.Key.LocationId,
                PersonelId = g.Key.PersonelId,
                Quantity = g.Sum(x => x.Quantity),
                Label = "",
                BrandId = g.Key.BrandId,
                ModelId = g.Key.ModelId
            })
            .Where(x => x.Quantity > 0)
            .OrderByDescending(x => x.Quantity)
            .ToList();

        UpdateFromSelectionLists();

        var personQtys = (MaterialInventories ?? new List<MaterialInventory>())
            .Where(mi => mi.MaterialId == matId && mi.PersonelId.HasValue)
            .GroupBy(mi => mi.PersonelId!.Value)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Quantity));

        AvailableToPersons = Persons.Select(p => new PersonLiteWithQty
        {
            PersonId = p.Id,
            FullName = $"{p.Adi} {p.Soyadi}",
            Quantity = personQtys.ContainsKey(p.Id) ? personQtys[p.Id] : 0
        }).OrderBy(p => p.FullName).ToList();

        ToLocationQuantities = (MaterialInventories ?? new List<MaterialInventory>())
            .Where(mi => mi.MaterialId == matId && mi.LocationId.HasValue)
            .GroupBy(mi => mi.LocationId!.Value)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Quantity));

        if (SelectedFromInventoryId != 0 && !AvailableFromInventoryOptions.Any(x => x.InventoryId == SelectedFromInventoryId))
        {
            SelectedFromInventoryId = 0;
        }
        else if (SelectedFromInventoryId != 0)
        {
            SyncFromDropdowns();
        }
    }

    private void UpdateFromSelectionLists()
    {
        if (WorkingTransfer == null || WorkingTransfer.MaterialId == 0)
        {
            FromSourcePersons = new List<FromSourceItem>();
            FromSourceLocations = new List<FromLocationItem>();
            return;
        }

        FromSourcePersons = AvailableFromInventoryOptions
            .Where(x => x.PersonelId.HasValue)
            .Select(x =>
            {
                var person = Persons.FirstOrDefault(p => p.Id == x.PersonelId!.Value);
                var personName = person != null ? $"{person.Adi} {person.Soyadi}" : "Bilinmiyor";
                var bm = GetBrandModelLabel(x.BrandId, x.ModelId);
                var qty = x.Quantity;
                return new FromSourceItem
                {
                    Id = x.InventoryId,
                    FullName = $"{personName} - {bm} ({qty} {SelectedUnitName})"
                };
            })
            .OrderBy(x => x.FullName)
            .ToList();

        FromSourceLocations = AvailableFromInventoryOptions
            .Where(x => x.LocationId.HasValue)
            .Select(x =>
            {
                var locName = InventoryUIHelper.GetLocationFullName(x.LocationId!.Value, Locations);
                var bm = GetBrandModelLabel(x.BrandId, x.ModelId);
                var qty = x.Quantity;
                return new FromLocationItem
                {
                    Id = x.InventoryId,
                    LocationName = $"{locName} - {bm} ({qty} {SelectedUnitName})"
                };
            })
            .OrderBy(x => x.LocationName)
            .ToList();
    }

    private void SyncFromDropdowns()
    {
        var selectedInv = AvailableFromInventoryOptions.FirstOrDefault(x => x.InventoryId == SelectedFromInventoryId);
        if (selectedInv != null)
        {
            SelectedFromPersonId = selectedInv.PersonelId ?? 0;
            SelectedFromLocationId = selectedInv.LocationId ?? 0;
        }
        else
        {
            SelectedFromPersonId = 0;
            SelectedFromLocationId = 0;
        }
    }

    private void MapSelectedFromInventoryToTransfer()
    {
        if (WorkingTransfer == null) return;
        var opt = AvailableFromInventoryOptions.FirstOrDefault(o => o.InventoryId == SelectedFromInventoryId);
        if (opt != null)
        {
            WorkingTransfer.FromLocationId = opt.LocationId ?? 0;
            WorkingTransfer.FromPersonId = opt.PersonelId;
            WorkingTransfer.BrandId = opt.BrandId;
            WorkingTransfer.ModelId = opt.ModelId;
        }
        else
        {
            WorkingTransfer.FromLocationId = null;
            WorkingTransfer.FromPersonId = null;
        }
    }

    private string GetBrandModelLabel(int? brandId, int? modelId)
    {
        var brandName = brandId.HasValue ? Brands.FirstOrDefault(b => b.Id == brandId.Value)?.BrandName : null;
        var modelName = modelId.HasValue ? Models.FirstOrDefault(m => m.Id == modelId.Value)?.ModelName : null;

        if (!string.IsNullOrWhiteSpace(brandName) && !string.IsNullOrWhiteSpace(modelName))
            return $"{brandName} / {modelName}";
        if (!string.IsNullOrWhiteSpace(brandName))
            return brandName!;
        if (!string.IsNullOrWhiteSpace(modelName))
            return modelName!;
        return "Genel";
    }

    private string GetLocationOptionLabel(Location loc)
    {
        var name = InventoryUIHelper.GetLocationFullName(loc.Id, Locations);
        if (ToLocationQuantities.TryGetValue(loc.Id, out int qty) && qty > 0)
            return $"{name} (Mevcut: {qty} {SelectedUnitName})";
        return name;
    }

    private string GetPersonOptionLabel(PersonLiteWithQty p)
    {
        return p.Quantity > 0 ? $"{p.FullName} (Mevcut: {p.Quantity} {SelectedUnitName})" : p.FullName;
    }

    private async Task HandleSave()
    {
        if (IsSaveDisabled)
        {
            ToastService.ShowWarning("Lütfen tüm zorunlu alanlari doldurunuz.");
            return;
        }

        if (WorkingTransfer != null)
        {
            var selectedGroup = AvailableFromInventoryOptions.FirstOrDefault(x => x.InventoryId == SelectedFromInventoryId);
            if (selectedGroup != null)
            {
                WorkingTransfer.FromLocationId = selectedGroup.LocationId;
                WorkingTransfer.FromPersonId = selectedGroup.PersonelId;
                WorkingTransfer.BrandId = selectedGroup.BrandId;
                WorkingTransfer.ModelId = selectedGroup.ModelId;
            }
            else
            {
                WorkingTransfer.FromLocationId = SelectedFromLocationId == 0 ? null : SelectedFromLocationId;
                WorkingTransfer.FromPersonId = SelectedFromPersonId == 0 ? null : SelectedFromPersonId;
            }

            WorkingTransfer.ToLocationId = SelectedToLocationId == 0 ? null : SelectedToLocationId;
            WorkingTransfer.ToPersonId = SelectedToPersonId == 0 ? null : SelectedToPersonId;
            WorkingTransfer.Aciklama = Reference;

            if (IsSelectedMaterialAsset)
                WorkingTransfer.Quantity = selectedAssetIds.Count;
        }

        if (IsSelectedMaterialAsset && OnSaveWithAssets.HasDelegate)
        {
            await OnSaveWithAssets.InvokeAsync(selectedAssetIds.ToList());
        }

        await OnSave.InvokeAsync(WorkingTransfer);
    }
}