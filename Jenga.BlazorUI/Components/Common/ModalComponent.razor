@rendermode InteractiveServer
@using Jenga.BlazorUI.Services.Common
@inject IModalService ModalService

@if (IsVisible)
{
    <div class="modal-backdrop"></div>

    <div class="modal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Request?.Title</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    @if (Request?.Content != null)
                    {
                        @Request.Content
                    }
                    else
                    {
                        <p>@Request?.Message</p>
                    }
                </div>
                <div class="modal-footer">
                    <div class="modal-actions">
                        @if (Request?.ShowConfirmationButtons == true && Request?.OnResult != null)
                        {
                            <button class="btn btn-success" @onclick="Confirm">Evet</button>
                            <button class="btn btn-danger" @onclick="Cancel">Hayır</button>
                        }
                        else
                        {
                            <button class="btn btn-secondary" @onclick="Cancel">Kapat</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ModalRequest? Request;
    private bool IsVisible;

    protected override void OnInitialized()
    {
        ModalService.OnShow += ShowModal;
    }

    private Task ShowModal(ModalRequest request)
    {
        // allow content to request modal close via request.Close
        request.Close = Close;

        Request = request;
        IsVisible = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Confirm()
    {
        Request?.OnResult?.Invoke(true);
        Close();
    }

    private void Cancel()
    {
        Request?.OnResult?.Invoke(false);
        Close();
    }

    private void Close()
    {
        IsVisible = false;
        Request = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        ModalService.OnShow -= ShowModal;
    }
}
