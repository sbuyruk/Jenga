@typeparam TItem
@using System.Globalization

<div class="generic-bar-chart">
    @if (Items == null || !Items.Any())
    {
        <div class="text-muted">No data to display</div>
    }
    else
    {
        <div class="d-flex align-items-start gap-3 ">
            <!-- GenericBarChart.razor -->
            <svg width="100%" height="@Height" viewBox="0 0 @Width @Height" style="max-width:@($"{Width}px")" class="flex-shrink-0" preserveAspectRatio="xMinYMin meet">
                @* Axis lines *@
                <line x1="@LeftPadding" y1="@TopPadding" x2="@LeftPadding" y2="@(TopPadding + ChartHeight)" stroke="#ddd" stroke-width="1" />
                <line x1="@LeftPadding" y1="@((TopPadding + ChartHeight))" x2="@((LeftPadding + ChartWidth))" y2="@((TopPadding + ChartHeight))" stroke="#ddd" stroke-width="1" />

                @* Bars *@
                @foreach (var b in Bars)
                {
                    <rect x="@b.X.ToString(CultureInfo.InvariantCulture)"
                          y="@b.Y.ToString(CultureInfo.InvariantCulture)"
                          width="@b.Width.ToString(CultureInfo.InvariantCulture)"
                          height="@b.Height.ToString(CultureInfo.InvariantCulture)"
                          fill="@b.Color"
                          rx="4"
                          class="bar-rect">
                    </rect>

                    @* value label above bar (formatted, larger) *@
                    <svg:text x="@( (b.X + b.Width/2.0).ToString(CultureInfo.InvariantCulture) )"
                              y="@( (b.Y - 8).ToString(CultureInfo.InvariantCulture) )"
                              text-anchor="middle" font-size="11" font-weight="600" fill="#111">
                        @FormatValue(b.Value)
                    </svg:text>

                    @* category label below axis — rotated for readability *@
                    <svg:text x="@(GetBarLabelCx(b).ToString(CultureInfo.InvariantCulture))"
                              y="@(GetBarLabelCy().ToString(CultureInfo.InvariantCulture))"
                              text-anchor="middle" font-size="11" fill="#333"
                              transform="rotate(-30 @(GetBarLabelCx(b).ToString(CultureInfo.InvariantCulture)) @(GetBarLabelCy().ToString(CultureInfo.InvariantCulture)))">
                        @b.Label
                    </svg:text>
                }

                @* Optional title at top center *@
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <svg:text x="@(Width/2.0)" y="14" text-anchor="middle" font-size="14" font-weight="600" fill="#222">
                        @Title
                    </svg:text>
                }
            </svg>

            @if (ShowLegend)
            {
                <div class="legend">
                    @foreach (var b in Bars)
                    {
                        <div class="d-flex align-items-center mb-1">
                            <span style="display:inline-block;width:14px;height:14px;background:@b.Color;border-radius:3px;margin-right:8px;"></span>
                            <div>
                                <div><strong>@b.Label</strong></div>
                                <div class="text-muted" style="font-size:0.85rem;">@FormatValue(b.Value) (@(b.Percent.ToString("P1", CultureInfo.CurrentCulture)))</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    [Parameter]
    public Func<TItem, string>? LabelSelector { get; set; }

    // Accept nullable numeric values safely
    [Parameter]
    public Func<TItem, decimal?>? ValueSelector { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public int Width { get; set; } = 600;

    [Parameter]
    public int Height { get; set; } = 320;

    [Parameter]
    public string[]? ColorPalette { get; set; }

    // Optional format string for displayed values (e.g. "C0" for currency, "N0" for number)
    [Parameter]
    public string ValueFormat { get; set; } = "C0";

    [Parameter]
    public bool ShowLegend { get; set; } = true;

    // Layout paddings (increase bottom to allow rotated labels)
    private double LeftPadding => 48;
    private double RightPadding => 12;
    private double TopPadding => 24;
    private double BottomPadding => 56;
    private double ChartWidth => Math.Max(10, Width - LeftPadding - RightPadding);
    private double ChartHeight => Math.Max(10, Height - TopPadding - BottomPadding);

    private record BarModel(string Label, decimal Value, string Color, double X, double Y, double Width, double Height, double Percent);

    private List<BarModel> Bars { get; set; } = new();

    protected override void OnParametersSet()
    {
        BuildBars();
    }

    private void BuildBars()
    {
        Bars.Clear();

        if (Items == null || LabelSelector == null || ValueSelector == null) return;

        var list = Items.Select(i => new { Label = LabelSelector(i), Value = ValueSelector(i) ?? 0m })
                        .ToList();

        if (!list.Any()) return;

        var total = list.Sum(x => x.Value);
        var max = list.Max(x => Math.Abs(x.Value));
        if (max <= 0) return;

        var palette = ColorPalette ?? new[]
        {
            "#4e79a7", "#f28e2b", "#e15759", "#76b7b2", "#59a14f", "#edc949", "#af7aa1", "#ff9da7", "#9c755f", "#bab0ac"
        };

        int count = list.Count;
        double spacing = 8;
        double barAreaWidth = ChartWidth;
        double slotWidth = (barAreaWidth - (spacing * (count - 1))) / count;
        double barWidth = Math.Max(6, slotWidth * 0.78);

        int idx = 0;
        foreach (var item in list)
        {
            double percent = total != 0 ? (double)item.Value / (double)total : 0.0;
            double height = ((double)item.Value / (double)max) * ChartHeight;
            double x = LeftPadding + idx * (slotWidth + spacing) + (slotWidth - barWidth) / 2.0;
            double y = TopPadding + (ChartHeight - height);

            var color = palette[idx % palette.Length];

            Bars.Add(new BarModel(
                Label: string.IsNullOrWhiteSpace(item.Label) ? "Diğer" : item.Label!,
                Value: item.Value,
                Color: color,
                X: x,
                Y: y,
                Width: barWidth,
                Height: Math.Max(1, height),
                Percent: percent
            ));

            idx++;
        }
    }

    private string FormatValue(decimal v)
    {
        // Use the component ValueFormat parameter; fallback to "N0"
        try
        {
            return v.ToString(ValueFormat ?? "N0", CultureInfo.CurrentCulture);
        }
        catch
        {
            return v.ToString("N0", CultureInfo.CurrentCulture);
        }
    }

    private double GetBarLabelCx(BarModel b) => b.X + b.Width / 2.0;
    private double GetBarLabelCy() => TopPadding + ChartHeight + 20;
}