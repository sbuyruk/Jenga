@typeparam TItem
@using System.Globalization
@using ApexCharts


<div class="generic-chart" style="@ChartStyle">
    @if (!HasRenderableData)
    {
        <div class="text-muted">No data to display</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <div class="generic-chart-title">@Title</div>
        }

        <div class="generic-chart-stage">
            <ApexChart TItem="ChartPoint"
                       @ref="_chart"
                       Options="@_options">

                @if (_seriesPoints.Count > 0 && IsXYChart(Type))
                {
                    foreach (var s in _seriesPoints)
                    {
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="@s.Points"
                                         Name="@s.Name"
                                         XValue="p => p.Label"
                                         YValue="p => p.Value"
                                         ShowDataLabels="ShowDataLabels"
                                         SeriesType="@GetSeriesType(Type)" />
                    }
                }
                else
                {
                    <ApexPointSeries TItem="ChartPoint"
                                     Items="@_points"
                                     Name="@SeriesName"
                                     XValue="p => p.Label"
                                     YValue="p => p.Value"
                                     ShowDataLabels="ShowDataLabels"
                                     SeriesType="@GetSeriesType(Type)" />
                }

            </ApexChart>
        </div>
    }
</div>

@code {

    public enum GenericChartType
    {
        Bar,
        Line,
        Area,
        Pie,
        Donut
    }

    private sealed record ChartPoint(string Label, decimal Value, int Index, string? TooltipExtra);
    public sealed record GenericSeries(string Name, IEnumerable<TItem> Items);
    private sealed record SeriesPoints(string Name, List<ChartPoint> Points);

    private ApexChart<ChartPoint>? _chart;
    private ApexChartOptions<ChartPoint> _options = new();
    private readonly List<ChartPoint> _points = new();
    private readonly List<SeriesPoints> _seriesPoints = new();
    private readonly List<string> _xCategories = new();
    private readonly List<string> _tooltipExtras = new();

    private bool _initialized;

    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public IReadOnlyList<GenericSeries>? Series { get; set; }
    [Parameter] public Func<TItem, string>? LabelSelector { get; set; }
    [Parameter] public Func<TItem, decimal?>? ValueSelector { get; set; }
    [Parameter] public Func<TItem, string?>? TooltipExtraSelector { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string SeriesName { get; set; } = "Series";
    [Parameter] public GenericChartType Type { get; set; } = GenericChartType.Bar;
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public bool ShowDataLabels { get; set; }
    [Parameter] public string[]? ColorPalette { get; set; }
    [Parameter] public bool AutoUpdate { get; set; } = true;
    [Parameter] public bool LockToMonthCategories { get; set; }

    [Parameter] public int XAxisLabelRotateDegrees { get; set; } = -45;
    [Parameter] public bool XAxisLabelsAlwaysRotate { get; set; } = true;
    [Parameter] public bool XAxisHideOverlappingLabels { get; set; } = true;
    [Parameter] public int GridPaddingBottom { get; set; } = 18;

    [Parameter] public string? Height { get; set; } = "360px";
    [Parameter] public string? Width { get; set; }

    [Parameter] public bool BarDataLabelsOnTop { get; set; }
    [Parameter] public string BarDataLabelColor { get; set; } = "#111827";

    private static readonly string[] _monthCategoriesTr =
    [
        "Oca", "Şub", "Mar", "Nis", "May", "Haz", "Tem", "Ağu", "Eyl", "Eki", "Kas", "Ara"
    ];

    private bool HasRenderableData =>
        LabelSelector is not null &&
        ValueSelector is not null &&
        ((Items?.Any() ?? false) || (Series?.Any() ?? false));

    private bool UseBarTopLabels =>
        ShowDataLabels &&
        Type == GenericChartType.Bar &&
        BarDataLabelsOnTop;

    private bool IsFluid => IsPercentage(Width) || IsPercentage(Height);

    private string? ChartStyle
    {
        get
        {
            var parts = new List<string>();

            if (!string.IsNullOrWhiteSpace(Width))
                parts.Add($"width: {Width};");

            if (!string.IsNullOrWhiteSpace(Height))
                parts.Add($"height: {Height};");

            return parts.Count > 0 ? string.Join(" ", parts) : null;
        }
    }

    protected override void OnParametersSet()
    {
        BuildSeriesPoints();
        BuildPoints();
        BuildOptions();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _initialized = true;
            return;
        }

        if (_initialized && AutoUpdate && _chart is not null)
        {
            try
            {
                await _chart.UpdateSeriesAsync(true);
            }
            catch (ObjectDisposedException)
            {
            }
        }
    }

    private void BuildPoints()
    {
        _points.Clear();
        _tooltipExtras.Clear();

        if (Items == null || LabelSelector == null || ValueSelector == null)
        {
            return;
        }

        var i = 0;
        foreach (var item in Items)
        {
            var label = NormalizeLabel(LabelSelector(item));
            var value = ValueSelector(item) ?? 0m;
            var tooltipExtra = TooltipExtraSelector?.Invoke(item);

            _points.Add(new ChartPoint(label, value, i, tooltipExtra));
            _tooltipExtras.Add(tooltipExtra ?? string.Empty);
            i++;
        }
    }

    private void BuildSeriesPoints()
    {
        _seriesPoints.Clear();
        _xCategories.Clear();

        if (Series == null || Series.Count == 0 || LabelSelector == null || ValueSelector == null)
        {
            return;
        }

        if (LockToMonthCategories)
        {
            _xCategories.AddRange(_monthCategoriesTr);
        }
        else
        {
            var labelOrder = new Dictionary<string, int>(StringComparer.Ordinal);
            var order = 0;

            foreach (var series in Series)
            {
                foreach (var item in series.Items ?? Array.Empty<TItem>())
                {
                    var label = NormalizeLabel(LabelSelector(item));

                    if (!labelOrder.ContainsKey(label))
                    {
                        labelOrder[label] = order++;
                    }
                }
            }

            _xCategories.AddRange(labelOrder
                .OrderBy(kvp => kvp.Value)
                .Select(kvp => kvp.Key));
        }

        foreach (var series in Series)
        {
            var map = new Dictionary<string, decimal>(StringComparer.Ordinal);

            foreach (var item in series.Items ?? Array.Empty<TItem>())
            {
                var label = NormalizeLabel(LabelSelector(item));
                var value = ValueSelector(item) ?? 0m;
                map[label] = map.TryGetValue(label, out var cur) ? cur + value : value;
            }

            var points = new List<ChartPoint>(_xCategories.Count);
            for (var i = 0; i < _xCategories.Count; i++)
            {
                var label = _xCategories[i];
                var value = map.TryGetValue(label, out var v) ? v : 0m;
                points.Add(new ChartPoint(label, value, i, null));
            }

            _seriesPoints.Add(new SeriesPoints(series.Name, points));
        }
    }

    private void BuildOptions()
    {
        var palette = ColorPalette ?? new[]
        {
            "#4e79a7", "#f28e2b", "#e15759", "#76b7b2", "#59a14f", "#edc949", "#af7aa1", "#ff9da7", "#9c755f", "#bab0ac"
        };

        var jsNumberFormatter =
            "function (val) { try { return (val ?? 0).toLocaleString(); } catch(e) { return val; } }";

        var jsCompactFormatter = BuildJsYAxisFormatter();

        var jsYAxisFormatter = jsCompactFormatter;

        var jsTooltipCustom = BuildTooltipCustomJs();

        var tooltip = new Tooltip
        {
            Y = new TooltipY
            {
                Formatter = jsNumberFormatter
            }
        };

        if (!string.IsNullOrWhiteSpace(jsTooltipCustom))
        {
            tooltip.Custom = jsTooltipCustom;
        }

        var hasMultiSeriesXY = _seriesPoints.Count > 0 && IsXYChart(Type);
        var chartWidthPx = IsPercentage(Width) ? null : TryParsePxToInt(Width);
        var chartHeightPx = IsPercentage(Height) ? null : TryParsePxToInt(Height);

        _options = new ApexChartOptions<ChartPoint>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Animations = new Animations { Enabled = true },
                Height = IsFluid ? "100%" : (object?)chartHeightPx,
                Width = IsFluid ? "100%" : (object?)chartWidthPx
            },
            Colors = palette.ToList(),
            DataLabels = new DataLabels
            {
                Enabled = ShowDataLabels,
                OffsetY = UseBarTopLabels ? -6 : 0,
                Style = new DataLabelsStyle
                {
                    Colors = new List<string> { BarDataLabelColor }
                },
                Formatter = jsCompactFormatter
            },
            Tooltip = tooltip,
            Xaxis = new XAxis
            {
                Categories = hasMultiSeriesXY ? _xCategories : null,
                TickPlacement = TickPlacement.Between,
                TickAmount = hasMultiSeriesXY ? _xCategories.Count : null,
                Labels = new XAxisLabels
                {
                    Rotate = XAxisLabelRotateDegrees,
                    RotateAlways = XAxisLabelsAlwaysRotate,
                    HideOverlappingLabels = XAxisHideOverlappingLabels,
                    Trim = true,
                    OffsetX = 0
                }
            },
            Yaxis = new List<YAxis>
            {
                new()
                {
                    Labels = new YAxisLabels
                    {
                        Formatter = jsYAxisFormatter
                    }
                }
            },
            Legend = new Legend
            {
                Show = ShowLegend
            },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    BorderRadius = 2,
                    Horizontal = false,
                    ColumnWidth = "85%"
                }
            },
            Grid = new Grid
            {
                Padding = new Padding
                {
                    Top = UseBarTopLabels ? 24 : 0,
                    Bottom = GridPaddingBottom
                }
            },
            Responsive = IsFluid ? null : BuildResponsiveBreakpoints(chartWidthPx)
        };
    }

    private static string BuildJsYAxisFormatter()
    {
        return "function (val) {"
               + "try {"
               + "  var v = val ?? 0;"
               + "  var abs = Math.abs(v);"
               + "  var sign = v < 0 ? '-' : '';"
               + "  if (abs >= 1e9) return sign + (Math.abs(v) / 1e9).toLocaleString('tr-TR', { maximumFractionDigits: 1 }) + 'B';"
               + "  if (abs >= 1e6) return sign + (Math.abs(v) / 1e6).toLocaleString('tr-TR', { maximumFractionDigits: 1 }) + 'M';"
               + "  if (abs >= 1e3) return sign + (Math.abs(v) / 1e3).toLocaleString('tr-TR', { maximumFractionDigits: 1 }) + 'K';"
               + "  return v.toLocaleString('tr-TR', { maximumFractionDigits: 2 });"
               + "} catch(e) { return val; }"
               + "}";
    }

    private static List<Responsive<ChartPoint>>? BuildResponsiveBreakpoints(int? chartWidthPx)
    {
        if (chartWidthPx is null or <= 0)
            return null;

        static int Scale(int original, double ratio) =>
            Math.Max(280, (int)(original * ratio));

        return
        [
            new Responsive<ChartPoint>
            {
                Breakpoint = 1400,
                Options = new ApexChartOptions<ChartPoint>
                {
                    Chart = new Chart { Width = Scale(chartWidthPx.Value, 0.85) }
                }
            },
            new Responsive<ChartPoint>
            {
                Breakpoint = 1200,
                Options = new ApexChartOptions<ChartPoint>
                {
                    Chart = new Chart { Width = Scale(chartWidthPx.Value, 0.70) }
                }
            },
            new Responsive<ChartPoint>
            {
                Breakpoint = 992,
                Options = new ApexChartOptions<ChartPoint>
                {
                    Chart = new Chart { Width = Scale(chartWidthPx.Value, 0.55) }
                }
            },
            new Responsive<ChartPoint>
            {
                Breakpoint = 768,
                Options = new ApexChartOptions<ChartPoint>
                {
                    Chart = new Chart { Width = Scale(chartWidthPx.Value, 0.90) }
                }
            },
            new Responsive<ChartPoint>
            {
                Breakpoint = 576,
                Options = new ApexChartOptions<ChartPoint>
                {
                    Chart = new Chart { Width = Scale(chartWidthPx.Value, 0.75) }
                }
            }
        ];
    }

    private string BuildTooltipFormatterJs(string fallbackFormatter)
    {
        if (_tooltipExtras.Count == 0 || _tooltipExtras.All(string.IsNullOrWhiteSpace))
        {
            return fallbackFormatter;
        }

        var extras = _tooltipExtras.Select(x => $"'{EscapeJsString(x)}'");
        var extrasJsArray = $"[{string.Join(", ", extras)}]";

        return "function (val, opts) {"
               + $"var extras = {extrasJsArray};"
               + "var idx = (opts && typeof opts.dataPointIndex === 'number') ? opts.dataPointIndex : -1;"
               + "var extra = (idx >= 0 && idx < extras.length) ? extras[idx] : '';"
               + "var valueText = '';"
               + "try { valueText = (val ?? 0).toLocaleString(); } catch(e) { valueText = val; }"
               + "if (!extra) { return valueText; }"
               + "return valueText + '<br/>' + extra.replace(/\\n/g, '<br/>');"
               + "}";
    }

    private string? BuildTooltipCustomJs()
    {
        if (_tooltipExtras.Count == 0 || _tooltipExtras.All(string.IsNullOrWhiteSpace))
        {
            return null;
        }

        var extras = _tooltipExtras.Select(x => $"'{EscapeJsString(x)}'");
        var labels = _points.Select(x => $"'{EscapeJsString(x.Label)}'");

        var extrasJsArray = $"[{string.Join(", ", extras)}]";
        var labelsJsArray = $"[{string.Join(", ", labels)}]";

        return "function({ series, seriesIndex, dataPointIndex, w }) {"
               + $"var extras = {extrasJsArray};"
               + $"var labels = {labelsJsArray};"
               + "var idx = (typeof dataPointIndex === 'number') ? dataPointIndex : -1;"
               + "var extra = (idx >= 0 && idx < extras.length) ? extras[idx] : '';"
               + "var title = (idx >= 0 && idx < labels.length) ? labels[idx] : '';"
               + "var seriesName = (w && w.globals && w.globals.seriesNames && w.globals.seriesNames[seriesIndex]) ? w.globals.seriesNames[seriesIndex] : 'Series';"
               + "var rawValue = (series && series[seriesIndex] && series[seriesIndex][idx] != null) ? series[seriesIndex][idx] : 0;"
               + "var valueText = '';"
               + "try { valueText = (rawValue ?? 0).toLocaleString(); } catch(e) { valueText = rawValue; }"
               + "var rows = '';"
               + "if (extra) {"
               + "  var lines = extra.split('\\n');"
               + "  for (var i = 0; i < lines.length; i++) {"
               + "    var line = lines[i];"
               + "    if (!line) { continue; }"
               + "    var parts = line.split('=');"
               + "    if (parts.length > 1) {"
               + "      var key = parts.shift();"
               + "      var val = parts.join('=');"
               + "      rows += \"<div style='display:flex;justify-content:space-between;gap:10px;'><span>\" + key + \"</span><span style='font-weight:600;'>\" + val + \"</span></div>\";"
               + "    } else {"
               + "      rows += \"<div>\" + line + \"</div>\";"
               + "    }"
               + "  }"
               + "} "
               + "return \"<div class='apexcharts-tooltip-title'>\" + title + \"</div>\""
               + " + \"<div style='padding:6px 10px;min-width:220px;'>\""
               + " + \"<div style='display:flex;justify-content:space-between;gap:10px;'><span>\" + seriesName + \"</span><span style='font-weight:600;'>\" + valueText + \"</span></div>\""
               + " + rows"
               + " + \"</div>\";"
               + "}";
    }

    private static string EscapeJsString(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        return value
            .Replace("\\", "\\\\", StringComparison.Ordinal)
            .Replace("'", "\\'", StringComparison.Ordinal)
            .Replace("\r", string.Empty, StringComparison.Ordinal)
            .Replace("\n", "\\n", StringComparison.Ordinal);
    }

    private static bool IsXYChart(GenericChartType type) =>
        type is GenericChartType.Bar or GenericChartType.Line or GenericChartType.Area;

    private static SeriesType GetSeriesType(GenericChartType type) =>
        type switch
        {
            GenericChartType.Line => SeriesType.Line,
            GenericChartType.Area => SeriesType.Area,
            GenericChartType.Pie => SeriesType.Pie,
            GenericChartType.Donut => SeriesType.Donut,
            _ => SeriesType.Bar
        };

    private static string NormalizeLabel(string? label) =>
        string.IsNullOrWhiteSpace(label) ? "Diğer" : label.Trim();

    private static int? TryParsePxToInt(string? cssSize)
    {
        if (string.IsNullOrWhiteSpace(cssSize))
        {
            return null;
        }

        var s = cssSize.Trim();

        if (!s.EndsWith("px", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        s = s[..^2].Trim();

        return int.TryParse(s, NumberStyles.Integer, CultureInfo.InvariantCulture, out var px) && px > 0
            ? px
            : null;
    }

    private static bool IsPercentage(string? value) =>
        !string.IsNullOrWhiteSpace(value) && value.Trim().EndsWith('%');
}