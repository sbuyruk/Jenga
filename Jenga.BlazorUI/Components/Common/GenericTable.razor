@using System.Reflection
@using System.Globalization
@using System.Text
@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

@typeparam TItem
<div class="generic-table p-1">
    <div class="gt-controls bg-body-tertiary">
        @if (ShowSearch)
        {
            <input class="gt-search small" placeholder="@PlaceholderSearch" @bind="SearchText" @bind:event="oninput" />
        }
        <div class="gt-page-controls">
            <label class="fw-bold me-3">

                <select @bind="BoundPageSize" @bind:event="onchange" class="form-select-sm">
                    @foreach (var opt in PageSizeOptions)
                    {
                        <option value="@opt">@opt</option>
                    }
                </select>
                Satır Göster
            </label>
            @if (ShowCopy)
            {
                <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="CopyToClipboard" title="Kopyala" aria-label="Kopyala">
                    <i class="bi bi-clipboard me-1" aria-hidden="true"></i> Kopyala
                </button>
            }
            @if (ShowExport)
            {
                <button class="btn btn-sm btn-secondary ms-2" @onclick="ExportToExcel" title="Excel'e Aktar" aria-label="Excel'e Aktar">
                    <i class="bi bi-download me-1" aria-hidden="true"></i> Excel'e Aktar
                </button>
            }
        </div>
    </div>

    <div class="gt-table-wrapper" style="height:@TableHeight">
        <table id="@_tableId" class="@TableCssClass">
            <thead>
                <tr>
                    @if (HeaderTemplate != null)
                    {
                        @HeaderTemplate
                    }
                    else
                    {
                        @foreach (var col in Columns)
                        {
                            <th @onclick="() => ToggleSort(col.Name)" role="button" aria-label="Sırala: @col.DisplayName">
                                <span class="d-inline-flex align-items-center">
                                    <span>@col.DisplayName</span>
                                    @if (sortField == col.Name)
                                    {
                                        <i class="gt-sort-indicator bi @(sortDescending ? "bi-caret-down-fill" : "bi-caret-up-fill") ms-2" aria-hidden="true"></i>
                                    }
                                </span>
                            </th>
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @if (RowTemplate != null)
                {
                    @foreach (var item in PagedItems)
                    {
                        <tr @onclick="() => OnRowClickedInternal(item)" class="gt-row" @key="GetKey(item)">
                            @RowTemplate(item)
                        </tr>
                    }
                }
                else
                {
                    @foreach (var item in PagedItems)
                    {
                        <tr @onclick="() => OnRowClickedInternal(item)" class="gt-row" @key="GetKey(item)">
                            @foreach (var col in Columns)
                            {
                                <td>@FormatValue(col.Property.GetValue(item))</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="gt-pagination">
        <button class="btn btn-sm btn-outline-secondary" @onclick="FirstPage" disabled="@(currentPage == 1)" title="İlk Sayfa" aria-label="İlk Sayfa">
            <i class="bi bi-skip-backward-fill" aria-hidden="true"></i>
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="PrevPage" disabled="@(currentPage == 1)" title="Önceki" aria-label="Önceki">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </button>
        <span class="mx-2 align-middle">Sayfa @currentPage / @totalPages</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(currentPage == totalPages)" title="Sonraki" aria-label="Sonraki">
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LastPage" disabled="@(currentPage == totalPages)" title="Son Sayfa" aria-label="Son Sayfa">
            <i class="bi bi-skip-forward-fill" aria-hidden="true"></i>
        </button>
    </div>
</div>

@code {
    /* Parameters */
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter] public RenderFragment<TItem> RowTemplate { get; set; }
    [Parameter] public RenderFragment HeaderTemplate { get; set; }

    // NEW: Export customization (optional)
    [Parameter] public IReadOnlyList<string>? ExportHeaders { get; set; }
    [Parameter] public Func<TItem, IReadOnlyList<object?>>? ExportRow { get; set; }

    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int[] PageSizeOptions { get; set; } = new[] { 5, 10, 20, 50 };
    [Parameter] public string TableHeight { get; set; } = "400px";
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public string PlaceholderSearch { get; set; } = "Ara...";
    [Parameter] public EventCallback<TItem> OnRowClicked { get; set; }
    [Parameter] public Func<TItem, object> KeySelector { get; set; } // optional for @key

    [Parameter] public string TableClass { get; set; } = null;
    [Parameter] public bool ShowCopy { get; set; } = true;
    [Parameter] public bool ShowExport { get; set; } = true;
    [Parameter] public string ExportFileName { get; set; } = null; // if null, auto-generated

    private readonly string _tableId = $"gt-{Guid.NewGuid():N}";

    private IJSObjectReference? _genericTableExportModule;

    /* Internal state */
    private List<TItem> allItems = new();
    private List<TItem> filtered = new();
    private List<TItem> PagedItems = new();
    private int currentPage = 1;
    private int totalPages = 1;

    private string sortField;
    private bool sortDescending = false;

    private PropertyInfo[] props;
    private List<ColumnDef> Columns = new();

    private string searchText = string.Empty;
    private int boundPageSize;

    public string CurrentSearchText => searchText;

    private string TableCssClass
    {
        get
        {
            const string defaultClasses = "table gt-table";
            return string.IsNullOrWhiteSpace(TableClass) ? defaultClasses : $"{defaultClasses} {TableClass}".Trim();
        }
    }

    private string SearchText
    {
        get => searchText;
        set
        {
            if (searchText == value) return;
            searchText = value;
            currentPage = 1;
            ApplyFilterSortAndPaging();
        }
    }

    private int BoundPageSize
    {
        get => boundPageSize;
        set
        {
            if (boundPageSize == value) return;
            boundPageSize = value;
            PageSize = value;
            currentPage = 1;
            ApplyFilterSortAndPaging();
        }
    }

    protected override void OnParametersSet()
    {
        allItems = Items?.ToList() ?? new List<TItem>();

        props = typeof(TItem)
            .GetProperties(BindingFlags.Instance | BindingFlags.Public)
            .Where(p => p.GetCustomAttribute<BrowsableAttribute>()?.Browsable != false)
            .ToArray();

        BuildColumnsFromProps();

        boundPageSize = PageSize;

        ApplyFilterSortAndPaging();
    }

    private ValueTask<IJSObjectReference> GetGenericTableExportModuleAsync()
    {
        return _genericTableExportModule is not null
            ? ValueTask.FromResult(_genericTableExportModule)
            : LoadGenericTableExportModuleAsync();
    }

    private async ValueTask<IJSObjectReference> LoadGenericTableExportModuleAsync()
    {
        _genericTableExportModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./js/genericTableExport.mjs");

        return _genericTableExportModule;
    }

    private async Task CopyToClipboard()
    {
        var module = await GetGenericTableExportModuleAsync();
        await module.InvokeVoidAsync("copyTableToClipboard", _tableId);
    }

    private async Task ExportToExcel()
    {
        var fileName = string.IsNullOrWhiteSpace(ExportFileName)
            ? $"export-{DateTime.Now:yyyyMMddHHmmss}.xlsx"
            : ExportFileName;

        // Export should be based on *filtered* (not paged) to include all rows.
        IReadOnlyList<string> headers;
        List<IReadOnlyList<object?>> rows;

        if (ExportHeaders != null && ExportHeaders.Count > 0)
        {
            headers = ExportHeaders;
        }
        else
        {
            headers = Columns.Select(c => c.DisplayName).ToArray();
        }

        if (ExportRow != null)
        {
            rows = filtered.Select(item => ExportRow(item)).ToList();
        }
        else
        {
            rows = filtered
                .Select(item => (IReadOnlyList<object?>)Columns.Select(c => c.Property.GetValue(item)).ToArray())
                .ToList();
        }

        // Convert values using the same formatter at export time
        var formattedRows = rows
            .Select(r => r.Select(FormatValue).ToArray())
            .ToArray();

        var module = await GetGenericTableExportModuleAsync();
        await module.InvokeVoidAsync("downloadXlsx", fileName, headers, formattedRows);
    }

    public async ValueTask DisposeAsync()
    {
        if (_genericTableExportModule is not null)
        {
            await _genericTableExportModule.DisposeAsync();
        }
    }

    private void BuildColumnsFromProps()
    {
        Columns = props.Select(p =>
        {
            // Prefer DisplayNameAttribute, then DisplayAttribute, otherwise property name.
            string displayName = p.Name;
            var dn = p.GetCustomAttribute<DisplayNameAttribute>();
            if (dn != null && !string.IsNullOrWhiteSpace(dn.DisplayName))
            {
                displayName = dn.DisplayName;
            }
            else
            {
                var disp = p.GetCustomAttribute<DisplayAttribute>();
                if (disp != null && !string.IsNullOrWhiteSpace(disp.Name))
                {
                    displayName = disp.Name;
                }
            }

            return new ColumnDef
            {
                Name = p.Name,
                DisplayName = displayName,
                Property = p
            };
        }).ToList();
    }

    private void ApplyFilterSortAndPaging()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filtered = allItems.ToList();
        }
        else
        {
            var q = searchText.Trim();
            filtered = allItems.Where(x => ItemMatchesSearch(x, q)).ToList();
        }

        if (!string.IsNullOrEmpty(sortField))
        {
            var col = Columns.FirstOrDefault(c => c.Name == sortField);
            if (col != null)
            {
                // Safe ordering: handle nulls and non-IComparable by using string fallback
                filtered = filtered.OrderBy(x =>
                {
                    var v = col.Property.GetValue(x);
                    if (v == null) return (object)string.Empty;
                    if (v is IComparable) return v;
                    return v.ToString() ?? string.Empty;
                }, new ObjectAsComparable()).ToList();

                if (sortDescending)
                    filtered.Reverse();
            }
        }

        if (PageSize <= 0) PageSize = 10;
        totalPages = (int)Math.Ceiling(filtered.Count / (double)PageSize);
        if (totalPages < 1) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        PagedItems = filtered.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();

        StateHasChanged();
    }

    // public helper to allow parent to trigger sort when custom HeaderTemplate is used
    public void SortBy(string field)
    {
        ToggleSort(field);
    }

    // expose current sort state for parent to be able to render indicators
    public string CurrentSortField => sortField;
    public bool CurrentSortDescending => sortDescending;

    private bool ItemMatchesSearch(TItem item, string q)
    {
        if (item == null) return false;

        // Build a combined searchable string for the item -- try all top-level properties
        var sb = new StringBuilder();
        foreach (var p in props)
        {
            object val;
            try { val = p.GetValue(item); }
            catch { val = null; }
            var part = ToSearchString(val, 0);
            if (!string.IsNullOrEmpty(part))
            {
                if (sb.Length > 0) sb.Append(' ');
                sb.Append(part);
            }
        }

        var hay = sb.ToString();
        if (string.IsNullOrEmpty(hay)) return false;
        return hay.IndexOf(q, StringComparison.OrdinalIgnoreCase) >= 0;
    }

    // recursive serializer to plain searchable string (depth-limited)
    private string ToSearchString(object obj, int depth)
    {
        if (obj == null) return string.Empty;
        if (depth > 2) return string.Empty; // derinlik sınırı: 0..2 (ayarlanabilir)

        // string direkt döndür
        if (obj is string s) return s;

        var type = obj.GetType();

        // primitive/value types, enum, decimal, DateTime, Guid vb.
        if (type.IsPrimitive || obj is decimal || obj is DateTime || obj is Guid || type.IsEnum)
        {
            return Convert.ToString(obj, CultureInfo.CurrentCulture) ?? string.Empty;
        }

        // IEnumerable ise içeriklerini düzleştir (string hariç)
        if (obj is System.Collections.IEnumerable enumerable && obj is not string)
        {
            var sb = new StringBuilder();
            foreach (var item in enumerable)
            {
                var part = ToSearchString(item, depth + 1);
                if (!string.IsNullOrEmpty(part))
                {
                    if (sb.Length > 0) sb.Append(' ');
                    sb.Append(part);
                }
            }
            return sb.ToString();
        }

        // kompleks tipe fallback: TypeConverter varsa dene, yoksa ToString
        var converter = TypeDescriptor.GetConverter(type);
        if (converter != null && converter.CanConvertTo(typeof(string)))
        {
            try
            {
                var converted = converter.ConvertToString(null, CultureInfo.CurrentCulture, obj);
                if (!string.IsNullOrWhiteSpace(converted))
                    return converted;
            }
            catch
            {
            }
        }

        return obj.ToString() ?? string.Empty;
    }

    private string FormatValue(object value)
    {
        if (value == null) return string.Empty;
        if (value is DateTime dt) return dt.ToString("dd.MM.yyyy");
        return value.ToString();
    }

    private void ToggleSort(string field)
    {
        if (sortField == field)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortField = field;
            sortDescending = false;
        }

        currentPage = 1;
        ApplyFilterSortAndPaging();
    }

    private void FirstPage()
    {
        currentPage = 1;
        ApplyFilterSortAndPaging();
    }

    private void PrevPage()
    {
        if (currentPage > 1) currentPage--;
        ApplyFilterSortAndPaging();
    }

    private void NextPage()
    {
        if (currentPage < totalPages) currentPage++;
        ApplyFilterSortAndPaging();
    }

    private void LastPage()
    {
        currentPage = totalPages;
        ApplyFilterSortAndPaging();
    }

    private async Task OnRowClickedInternal(TItem item)
    {
        if (OnRowClicked.HasDelegate)
            await OnRowClicked.InvokeAsync(item);
    }

    private object GetKey(TItem item)
    {
        if (KeySelector == null) return item;
        return KeySelector(item);
    }

    private sealed class ColumnDef
    {
        public string Name { get; set; }
        public string DisplayName { get; set; }
        public PropertyInfo Property { get; set; }
    }

    private sealed class ObjectAsComparable : IComparer<object>
    {
        public int Compare(object x, object y)
        {
            if (ReferenceEquals(x, y)) return 0;
            if (x == null) return -1;
            if (y == null) return 1;

            if (x is IComparable cx)
            {
                try
                {
                    return cx.CompareTo(y);
                }
                catch
                {
                    // if types mismatch, fallback
                }
            }

            return string.Compare(x.ToString(), y.ToString(), StringComparison.CurrentCulture);
        }
    }
}