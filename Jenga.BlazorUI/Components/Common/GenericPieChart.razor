@typeparam TItem
@using System.Globalization

<div class="generic-pie-chart">
    @if (Items == null || !Items.Any())
    {
        <div class="text-muted">No data to display</div>
    }
    else
    {
        <div class="chart-row d-flex align-items-start gap-3 border">
            <svg width="@Width" height="@Height" viewBox="0 0 @Width @Height" class="flex-shrink-0">
                @* Title at the top of the pie chart (inside the SVG) *@
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <svg:text x="@CenterX" y="@TitleTextY" text-anchor="middle" font-size="14" font-weight="600" fill="#333">
                        @Title
                    </svg:text>
                }

                @foreach (var s in Slices)
                {
                    <path d="@s.Path" fill="@s.Color" stroke="#fff" stroke-width="1"></path>
                }
            </svg>

            <div class="legend"> 
                @foreach (var s in Slices)
                {
                    <div class="d-flex align-items-center mb-1">
                        <span class="color-swatch" style="--swatch-color:@s.Color"></span>
                        <div>
                            <div class="legend-header">@s.Label</div>
                            <div class="text-muted value">@FormatMoney(s.Value) (@(s.Percent.ToString("P1", CultureInfo.CurrentCulture)))</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    [Parameter]
    public Func<TItem, string>? LabelSelector { get; set; }

    [Parameter]
    public Func<TItem, decimal>? ValueSelector { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public int Width { get; set; } = 300;

    [Parameter]
    public int Height { get; set; } = 300;

    [Parameter]
    public string[]? ColorPalette { get; set; }

    private record Slice(string Label, decimal Value, double StartAngle, double EndAngle, string Color, string Path, double Percent);

    private List<Slice> Slices = new();

    private double TitleOffset => string.IsNullOrWhiteSpace(Title) ? 0 : 28; // space reserved at top for title
    private double CenterX => Width / 2.0;
    private double CenterY => (Height + TitleOffset) / 2.0; // center adjusted when title is present
    private double TitleTextY => 18; // y coordinate for title text inside SVG

    protected override void OnParametersSet()
    {
        BuildSlices();
    }

    private void BuildSlices()
    {
        Slices.Clear();

        if (Items == null || LabelSelector == null || ValueSelector == null) return;

        var list = Items.Select(i => new { Label = LabelSelector(i), Value = ValueSelector(i) })
                        .Where(x => x.Value > 0)
                        .ToList();

        var total = list.Sum(x => x.Value);
        if (total <= 0) return;

        var palette = ColorPalette ?? new[]
        {
            "#4e79a7", "#f28e2b", "#e15759", "#76b7b2", "#59a14f", "#edc949", "#af7aa1", "#ff9da7", "#9c755f", "#bab0ac"
        };

        double currentAngle = -Math.PI / 2; // start at top
        int idx = 0;

        // reserve vertical space for title when computing radius
        double availableHeight = Math.Max(0, Height - TitleOffset);
        double r = Math.Min(Width, availableHeight) / 2.0 - 8; // padding

        foreach (var item in list)
        {
            double portion = (double)item.Value / (double)total;
            double sweep = portion * Math.PI * 2.0;
            double start = currentAngle;
            double end = currentAngle + sweep;

            var color = palette[idx % palette.Length];

            string path = DescribeSector(CenterX, CenterY, r, start, end);

            double percent = portion;

            Slices.Add(new Slice(item.Label ?? string.Empty, item.Value, start, end, color, path, percent));

            currentAngle = end;
            idx++;
        }
    }

    private static string DescribeSector(double cx, double cy, double r, double startAngle, double endAngle)
    {
        // compute points
        double x1 = cx + r * Math.Cos(startAngle);
        double y1 = cy + r * Math.Sin(startAngle);
        double x2 = cx + r * Math.Cos(endAngle);
        double y2 = cy + r * Math.Sin(endAngle);

        // large-arc-flag
        var largeArc = (endAngle - startAngle) > Math.PI ? 1 : 0;

        // Path: Move to center, line to start, arc to end, close
        return $"M {cx.ToString(CultureInfo.InvariantCulture)} {cy.ToString(CultureInfo.InvariantCulture)} L {x1.ToString(CultureInfo.InvariantCulture)} {y1.ToString(CultureInfo.InvariantCulture)} A {r.ToString(CultureInfo.InvariantCulture)} {r.ToString(CultureInfo.InvariantCulture)} 0 {largeArc} 1 {x2.ToString(CultureInfo.InvariantCulture)} {y2.ToString(CultureInfo.InvariantCulture)} Z";
    }

    private static string FormatMoney(decimal value)
    {
        return value.ToString("N2", CultureInfo.CurrentCulture);
    }
}