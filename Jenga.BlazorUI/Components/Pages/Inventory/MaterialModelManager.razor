@page "/inventory/material-model-manager"
@rendermode InteractiveServer
@using Jenga.BlazorUI.Components.Inventory
@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.Inventory
@using Microsoft.JSInterop
@inject IMaterialModelService MaterialModelService
@inject IMaterialBrandService MaterialBrandService
@inject IJSRuntime JS

<h3>Malzeme Model Yönetimi</h3>
<MaterialModelTable Models="@models" Brands="@brands" />

@code {
    private List<MaterialModel> models = new();
    private List<MaterialBrand> brands = new();
    private bool _dataLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_dataLoaded)
        {
            var modelsResult = await MaterialModelService.GetAllAsync();
            if (modelsResult.IsSuccess) models = modelsResult.Value;
            var brandsResult = await MaterialBrandService.GetAllAsync();
            if (brandsResult.IsSuccess) brands = brandsResult.Value;
            _dataLoaded = true;
            StateHasChanged();
        }
    }
}