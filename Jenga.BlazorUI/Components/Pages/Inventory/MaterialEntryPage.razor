@page "/inventory/material-entry-page"
@rendermode InteractiveServer
@using Jenga.BlazorUI.Components.Inventory
@using Jenga.DataAccess.Services.IKYS
@using Jenga.DataAccess.Services.Inventory
@using Jenga.BlazorUI.Services.Common
@using Jenga.Models.IKYS
@using Jenga.Models.Inventory
@using Microsoft.JSInterop
@inject IMaterialEntryService MaterialEntryService
@inject IMaterialService MaterialService
@inject IMaterialUnitService MaterialUnitService
@inject ILocationService LocationService
@inject IPersonelService PersonelService
@inject IMaterialBrandService MaterialBrandService
@inject IMaterialModelService MaterialModelService
@inject IMaterialCategoryService MaterialCategoryService
@inject IJSRuntime JS
@inject ICurrentUserService CurrentUserService

<PermissionGuard Module="ModuleName.Inventory" Operation="Operation.View">
<h3>Malzeme Girisleri</h3>
<MaterialEntryTable MaterialEntries="@materialEntries"
                            Materials="@materials"
                            Locations="@locations"
                            Personels="@personels"
                            MaterialUnits="@materialUnits"
                            Brands="@brands"
                            Models="@models"
                            Categories="@categories"
                            CanCreate="@_canCreate"
                            CanEdit="@_canEdit"
                            CanDelete="@_canDelete"/>

</PermissionGuard>

@code {
    private List<MaterialEntry> materialEntries = new();
    private List<Material> materials = new();
    private List<MaterialUnit> materialUnits = new();
    private List<Location> locations = new();
    private List<Personel> personels = new();
    private List<MaterialBrand> brands = new();
    private List<MaterialModel> models = new();
    private List<MaterialCategory> categories = new();
    private bool _dataLoaded;
    private bool _canCreate;
    private bool _canEdit;
    private bool _canDelete;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_dataLoaded)
        {
            _canCreate = await CurrentUserService.HasPermissionAsync(ModuleName.Inventory, Operation.Create);
            _canEdit   = await CurrentUserService.HasPermissionAsync(ModuleName.Inventory, Operation.Edit);
            _canDelete = await CurrentUserService.HasPermissionAsync(ModuleName.Inventory, Operation.Delete);
            var entriesR = await MaterialEntryService.GetAllAsync();
            materialEntries = entriesR.IsSuccess ? entriesR.Value : new();
            var matsR = await MaterialService.GetAllAsync();
            materials = matsR.IsSuccess ? matsR.Value : new();
            var locsR = await LocationService.GetAllAsync();
            locations = locsR.IsSuccess ? locsR.Value : new();
            var personelResult = await PersonelService.GetCalisanPersonelAsync();
            personels = personelResult.IsSuccess ? personelResult.Value : new List<Personel>();
            var brandsR = await MaterialBrandService.GetAllAsync();
            brands = brandsR.IsSuccess ? brandsR.Value : new();
            var modelsR = await MaterialModelService.GetAllAsync();
            models = modelsR.IsSuccess ? modelsR.Value : new();
            var catsR = await MaterialCategoryService.GetAllAsync();
            categories = catsR.IsSuccess ? catsR.Value : new();
            var unitsR = await MaterialUnitService.GetAllAsync();
            materialUnits = unitsR.IsSuccess ? unitsR.Value : new();
            _dataLoaded = true;
            StateHasChanged();
        }
    }


}