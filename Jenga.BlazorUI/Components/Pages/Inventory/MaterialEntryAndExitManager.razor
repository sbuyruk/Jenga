@page "/inventory/materialentry-and-exit-manager"
@rendermode InteractiveServer

@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Components.Inventory
@using Jenga.BlazorUI.Helpers
@using Jenga.DataAccess.Services.Inventory
@using Jenga.DataAccess.Services.IKYS
@using Jenga.Models.Common
@using Jenga.Models.Helper
@using Jenga.Models.IKYS
@using Jenga.Models.Inventory
@using Jenga.Utility.Modal
@using Jenga.Utility.Toast

@inject IToastService ToastService
@inject IModalService ModalService
@inject IMaterialService MaterialService
@inject IMaterialInventoryService MaterialInventoryService
@inject IMaterialBrandService MaterialBrandService
@inject IMaterialModelService MaterialModelService
@inject IMaterialCategoryService MaterialCategoryService
@inject IMaterialUnitService MaterialUnitService
@inject ILocationService LocationService
@inject IMaterialEntryService MaterialEntryService
@inject IMaterialExitService MaterialExitService
@inject IHttpContextAccessor httpContextAccessor
@inject IMaterialMovementService MaterialMovementService
@inject IMaterialTransferService MaterialTransferService
@inject IPersonelService PersonelService

<div class="row g-4" style="height:90vh;">
    <!-- LEFT: TreeViewer -->
    <div class="col-md-5" style="height:100%;">
        <h5 class="mb-0">Malzeme Cinsleri & Malzemeler</h5>
        <div class="mt-3 d-flex gap-2">
            <input class="form-control form-control-sm" placeholder="Malzeme Ara..."
                   @bind="searchTerm" @bind:event="oninput" />
            <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshData">Yenile</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSearch">Temizle</button>
        </div>
        <div class="card shadow-sm mt-1" style="height:90%;">
            <div class="card-body">
                <TreeViewer T="MaterialCategoryNode"
                            Items="categoryTree"
                            SearchTerm="@searchTerm"
                            FilterFunc="@filter"
                            LabelSelector="@(item => item.Data.Category?.CategoryName ?? "")"
                            DescriptionSelector="@(item => item.Data.Category?.Aciklama ?? "")"
                            SubItemLabelSelector="@(item => item.Data.Material?.MaterialName ?? "")"
                            ChildrenSelector="@(item => item.Children)"
                            SortSelector='@(item => item.Data.Category?.CategoryName ?? item.Data.Material?.MaterialName ?? "")'
                            SortAscending="@sortAscending"
                            SortAscendingChanged="@(v => sortAscending = v)"
                            OnSubItemEdit="HandleEditMaterial"
                            OnSubItemCreate="HandleCreateMaterial"
                            OnEdit="HandleEditCategory"
                            OnCreate="HandleCreateCategory"
                            OnDelete="HandleDeleteCategory"
                            OnSelect="HandleNodeSelect"
                            CreateContextMenuLabel="@CreateContextMenuLabel" />
            </div>
        </div>
    </div>

    <!-- RIGHT: Cards & Grid -->
    <div class="col-md-7">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="mb-0">Envanter İşlemleri</h5>
        </div>

        <div class="card p-3 mb-3">
            <div class="row align-items-center">
                <div class="col-12" id="MaterialCards">
                    @if (SelectedMaterial != null)
                    {
                        <MaterialLocationGrid SelectedMaterial="SelectedMaterial"
                                              SelectedMaterialStock="SelectedMaterialStock"
                                              MaterialUnitSymbol="@GetSelectedMaterialUnitSymbol()"
                                              SelectedMaterialLocations="selectedMaterialLocations"
                                              SelectedLocationId="selectedLocationId"
                                              AllCategories="categories"
                                              AllLocations="locations"
                                              OnStartEntry="@(args => StartEntry(args.Item1, args.Item2))"
                                              OnStartExit="@(args => StartExit(args.Item1, args.Item2))"
                                              OnStartTransfer="@(args => StartTransfer(args.Item1, args.Item2))"
                                              OnCategoryClick="SelectCategoryCard" />
                    }
                    else
                    {
                        <CategoryMaterialGrid DisplayedCategory="displayedCategory"
                                              CategoryCards="categoryCards"
                                              MaterialCards="materialCards"
                                              AllCategories="categories"
                                              AllMaterials="materials"
                                              OnCategoryClick="SelectCategoryCard"
                                              OnOpenMaterial="SelectMaterialFromCard"
                                              OnOpenMaterialEdit="OpenMaterialFromCard"
                                              OnOpenEntry="OpenEntryModalWithMaterial"
                                              MaterialUnits="materialUnits"
                                              MaterialInventories="materialInventories" />
                    }
                </div>

                <div class="col">
                    @if (materialTransactions.Any())
                    {
                        <div class="text-muted small mt-3 border-top pt-2">Son işlemler (Giriş/Çıkış/Transfer)</div>
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var tx in materialTransactions.Take(6))
                            {
                                <li class="mb-1">
                                    <span class="badge bg-light text-dark border">@tx.Type</span>
                                    <span class="text-muted">@tx.Date.ToString("dd.MM.yyyy HH:mm")</span>
                                    <span class="fw-bold ms-1">@($"{(tx.IsIncrease ? "+" : "-")}{tx.Quantity} {tx.UnitName}")</span>
                                    <span class="text-muted ms-1">@tx.LocationName</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* MODALS *@
<MaterialEntryEditModal MaterialEntry="editingEntry"
                        Materials="materials"
                        MaterialUnits="materialUnits"
                        Locations="locations"
                        Persons="persons"
                        IsOpen="isEntryOpen"
                        OnSave="OnEntryModalSave"
                        OnClose="CloseEntryModal" />

<MaterialExitEditModal MaterialExit="editingExit"
                       Materials="materials"
                       MaterialUnits="materialUnits"
                       Locations="locations"
                       MaterialInventories="materialInventories"
                       IsOpen="isExitOpen"
                       OnSave="OnExitModalSave"
                       OnClose="CloseExitModal" />

<MaterialCategoryEditModal Category="selectedCategory"
                           IsOpen="isCategoryEditOpen"
                           ParentCategories="categories"
                           OnSave="OnCategoryModalSave"
                           OnClose="CloseCategoryModal" />

<MaterialEditModal Material="editingMaterial"
                   Categories="categories"
                   IsOpen="isMaterialEditOpen"
                   OnSave="OnMaterialModalSave"
                   OnClose="CloseMaterialModal"
                   Brands="brands"
                   Models="models"
                   MaterialUnits="materialUnits" />

<MaterialTransferEditModalV2 MaterialTransfer="editingTransfer"
                             Materials="materials"
                             MaterialUnits="materialUnits"
                             Locations="locations"
                             Persons="persons"
                             MaterialInventories="materialInventories"
                             IsOpen="isTransferOpen"
                             InitialSelectedFromInventoryId="modalInitialFromInventoryId"
                             OnSave="OnTransferModalSave"
                             OnClose="CloseTransferModal" />

@code {
    // Models
    public class MaterialCategoryNode
    {
        public MaterialCategory? Category { get; set; }
        public Material? Material { get; set; }
    }

    // State
    private List<TreeItem<MaterialCategoryNode>> categoryTree = new();
    private List<Material> materials = new();
    private List<MaterialUnit> materialUnits = new();
    private List<Location> locations = new();
    private List<MaterialCategory> categories = new();
    private List<MaterialBrand> brands = new();
    private List<MaterialModel> models = new();
    private List<Personel> persons = new();
    private List<MaterialInventory> materialInventories = new();

    // Display State
    private List<Material> materialCards = new();
    private List<MaterialCategory> categoryCards = new();
    private List<MaterialLocationCard> selectedMaterialLocations = new();
    private List<MaterialTransactionView> materialTransactions = new();

    private Material? SelectedMaterial;
    private MaterialCategory? displayedCategory;
    private int SelectedMaterialStock => selectedMaterialLocations.Sum(x => x.Quantity);

    // UI Control
    private string searchTerm = "";
    private bool sortAscending = true;
    private int? selectedLocationId = null;
    private string CreateContextMenuLabel = "Alt Kategori Tanımla";

    // Modal Controls
    private bool isEntryOpen, isExitOpen, isCategoryEditOpen, isMaterialEditOpen, isTransferOpen;
    private MaterialEntry? editingEntry;
    private MaterialExit? editingExit;
    private MaterialCategory? selectedCategory;
    private Material? editingMaterial;
    private MaterialTransfer? editingTransfer;
    private int? modalInitialFromInventoryId;

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
    }

    private async Task RefreshData()
    {
        // Parelel veri çekme işlemi performans için
        var t1 = MaterialCategoryService.GetAllAsync();
        var t2 = MaterialService.GetAllAsync();
        var t3 = MaterialBrandService.GetAllAsync();
        var t4 = MaterialModelService.GetAllAsync();
        var t5 = MaterialUnitService.GetAllAsync();
        var t6 = LocationService.GetAllAsync();
        var t7 = PersonelService.GetCalisanPersonelAsync();
        var t8 = MaterialInventoryService.GetAllAsync();

        await Task.WhenAll(t1, t2, t3, t4, t5, t6, t7, t8);

        categories = t1.Result;
        materials = t2.Result;
        brands = t3.Result;
        models = t4.Result;
        materialUnits = t5.Result;
        locations = t6.Result;
        persons = t7.Result;
        materialInventories = t8.Result;

        BuildTree();

        // Reset UI logic
        if (SelectedMaterial == null && displayedCategory == null)
        {
            // Root kategoriler
            categoryCards = categories.Where(c => (c.ParentCategoryId ?? 0) == 0).ToList();
        }
        else if (SelectedMaterial != null)
        {
            // Mevcut seçim varsa state'i güncelle
            await LoadMaterialLocationCards(SelectedMaterial);
            await LoadMaterialTransactions(SelectedMaterial);
        }
    }

    private void BuildTree()
    {
        var categoryNodes = categories.Select(c => new MaterialCategoryNode { Category = c }).ToList();

        categoryTree = TreeHelper.BuildTree<MaterialCategoryNode>(
            categoryNodes,
            node => node.Category.Id.ToString(),
            node => node.Category.ParentCategoryId?.ToString()
        );

        // Malzemeleri ağaca ekle
        foreach (var mat in materials)
        {
            var parentId = mat.CategoryId.ToString();
            var parent = FindNodeById(categoryTree, parentId);
            if (parent != null)
            {
                parent.Children.Add(new TreeItem<MaterialCategoryNode>
                {
                    Id = "mat-" + mat.Id,
                    Data = new MaterialCategoryNode { Material = mat },
                    ShowCreate = true,
                    ShowEdit = true,
                    ShowDelete = true,
                    ShowSubItemCreate = true,
                    Children = new List<TreeItem<MaterialCategoryNode>>()
                });
            }
        }
    }

    private TreeItem<MaterialCategoryNode>? FindNodeById(List<TreeItem<MaterialCategoryNode>> nodes, string id)
    {
        foreach (var node in nodes)
        {
            if (node.Id == id) return node;
            var found = FindNodeById(node.Children, id);
            if (found != null) return found;
        }
        return null;
    }

    private Func<TreeItem<MaterialCategoryNode>, string, bool> filter = (item, term) =>
        (item.Data.Category?.CategoryName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (item.Data.Material?.MaterialName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);

    #region Handlers (Tree & Selection)

    private void HandleNodeSelect(TreeItem<MaterialCategoryNode>? item)
    {
        if (item == null) return;

        // Reset UI
        materialCards.Clear();
        categoryCards.Clear();
        materialTransactions.Clear();
        selectedLocationId = null;

        if (item.Data?.Material != null)
        {
            SelectMaterialFromCard(item.Data.Material);
        }
        else if (item.Data?.Category != null)
        {
            SelectedMaterial = null;
            displayedCategory = item.Data.Category;

            categoryCards = categories.Where(c => c.ParentCategoryId == item.Data.Category.Id).ToList();
            materialCards = materials.Where(m => m.CategoryId == item.Data.Category.Id).ToList();
        }
        StateHasChanged();
    }

    private void SelectCategoryCard(MaterialCategory cat)
    {
        // Ağaçta bulup seçimi tetikle
        var node = FindNodeById(categoryTree, cat.Id.ToString());
        if (node != null) HandleNodeSelect(node);
    }

    private void SelectMaterialFromCard(Material mat)
    {
        if (mat == null) return;
        SelectedMaterial = mat;
        displayedCategory = null;

        // Tek malzeme kartı göster
        materialCards = new List<Material> { mat };

        // Detayları yükle
        _ = LoadMaterialLocationCards(mat);
        _ = LoadMaterialTransactions(mat);

        StateHasChanged();
    }

    #endregion

    #region Data Loading Methods

    private async Task LoadMaterialLocationCards(Material mat)
    {
        selectedMaterialLocations.Clear();

        var invs = materialInventories.Where(mi => mi.MaterialId == mat.Id).ToList();

        // Group by Location & Personel
        var groups = invs
            .GroupBy(mi => new { mi.LocationId, mi.PersonelId })
            .Select(g => new
            {
                g.Key.LocationId,
                g.Key.PersonelId,
                Quantity = g.Sum(x => x.Quantity),
                UnitId = g.First().Material?.MaterialUnitId,
                InvId = g.First().Id
            });

        foreach (var g in groups.Where(x => x.Quantity != 0))
        {
            var loc = locations.FirstOrDefault(l => l.Id == g.LocationId);
            var unit = materialUnits.FirstOrDefault(u => u.Id == (g.UnitId ?? mat.MaterialUnitId));
            var person = g.PersonelId.HasValue ? persons.FirstOrDefault(p => p.Id == g.PersonelId) : null;

            selectedMaterialLocations.Add(new MaterialLocationCard
            {
                LocationId = g.LocationId ?? 0,
                LocationName = loc?.LocationName ?? "-",
                Quantity = g.Quantity,
                UnitName = unit?.Symbol ?? unit?.Name ?? "",
                PersonelId = g.PersonelId,
                PersonelName = person != null ? $"{person.Adi} {person.Soyadi}" : null,
                InventoryId = g.InvId
            });
        }
        StateHasChanged();
    }

    private async Task LoadMaterialTransactions(Material mat)
    {
        var movements = await MaterialMovementService.GetMovementsByMaterialIdAsync(mat.Id);
        materialTransactions = movements.OrderByDescending(m => m.MovementDate).Take(20)
            .Select(m =>
            {
                // Basitleştirilmiş logic
                bool isEntry = !m.FromLocationId.HasValue && m.ToLocationId.HasValue;
                bool isExit = m.FromLocationId.HasValue && !m.ToLocationId.HasValue;
                bool isTransfer = m.FromLocationId.HasValue && m.ToLocationId.HasValue;

                string type = isTransfer ? "Transfer" : (isEntry ? "Giriş" : "Çıkış");
                string locName = isEntry
                    ? InventoryUIHelper.GetLocationFullName(m.ToLocationId, locations)
                    : InventoryUIHelper.GetLocationFullName(m.FromLocationId, locations);

                if (isTransfer) locName += " -> " + InventoryUIHelper.GetLocationFullName(m.ToLocationId, locations);

                return new MaterialTransactionView
                {
                    Date = m.MovementDate,
                    Quantity = m.Quantity,
                    LocationName = locName,
                    Type = type,
                    IsIncrease = isEntry || (isTransfer && m.ToLocationId == selectedLocationId),
                    UnitName = materialUnits.FirstOrDefault(u => u.Id == m.MaterialUnitId)?.Symbol ?? ""
                };
            }).ToList();

        StateHasChanged();
    }

    #endregion

    #region Action Handlers (Entry/Exit/Transfer)

    private void StartEntry(Material? mat, MaterialLocationCard loc)
    {
        if (mat == null) return;
        selectedLocationId = loc?.LocationId;
        editingEntry = new MaterialEntry
        {
            MaterialId = mat.Id,
            MaterialUnitId = mat.MaterialUnitId,
            LocationId = loc?.LocationId ?? 0,
            EntryDate = DateTime.Now
        };
        SelectedMaterial = mat;
        isEntryOpen = true;
    }

    private void StartExit(Material? mat, MaterialLocationCard loc)
    {
        if (mat == null || loc == null) return;
        selectedLocationId = loc.LocationId;
        editingExit = new MaterialExit
        {
            MaterialId = mat.Id,
            LocationId = loc.LocationId,
            MaterialUnitId = mat.MaterialUnitId,
            ExitDate = DateTime.Now,
            Quantity = 1
        };
        SelectedMaterial = mat;
        isExitOpen = true;
    }

    private void StartTransfer(Material? mat, MaterialLocationCard fromLoc)
    {
        if (mat == null || fromLoc == null) return;

        editingTransfer = new MaterialTransfer
        {
            MaterialId = mat.Id,
            MaterialUnitId = mat.MaterialUnitId,
            FromLocationId = fromLoc.LocationId,
            TransferDate = DateTime.Now,
            Quantity = 1
        };

        // inventory ID logic logic simplifed
        if (fromLoc.InventoryId != 0)
        {
            modalInitialFromInventoryId = fromLoc.InventoryId;
        }

        SelectedMaterial = mat;
        isTransferOpen = true;
    }

    // Modal Save Callbacks
    private async Task OnEntryModalSave()
    {
        if (editingEntry == null) return;
        await ExecuteTransaction(async () =>
            await MaterialEntryService.AddAsync(editingEntry, httpContextAccessor.HttpContext?.User?.Identity?.Name, CancellationToken.None),
            "Giriş", () => isEntryOpen = false);
    }

    private async Task OnExitModalSave()
    {
        if (editingExit == null) return;
        await ExecuteTransaction(async () =>
            await MaterialExitService.AddAsync(editingExit, CancellationToken.None),
            "Çıkış", () => isExitOpen = false);
    }

    private async Task OnTransferModalSave()
    {
        if (editingTransfer == null) return;
        await ExecuteTransaction(async () =>
            await MaterialTransferService.AddAsync(editingTransfer, httpContextAccessor.HttpContext?.User?.Identity?.Name, CancellationToken.None),
            "Transfer", () => isTransferOpen = false);
    }

    // Helper Wrapper for Transactions
    private async Task ExecuteTransaction(Func<Task> action, string actionName, Action closeAction)
    {
        try
        {
            await action();
            ToastService.ShowSuccess($"{actionName} başarıyla kaydedildi.");
            closeAction();

            // Refresh data partial
            materialInventories = await MaterialInventoryService.GetAllAsync();
            if (SelectedMaterial != null)
            {
                await LoadMaterialLocationCards(SelectedMaterial);
                await LoadMaterialTransactions(SelectedMaterial);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Hata: {ex.Message}");
        }
    }

    #endregion

    #region CRUD Modals (Category/Material)

    private void HandleCreateMaterial(TreeItem<MaterialCategoryNode> item) { editingMaterial = new Material { CategoryId = item.Data.Category?.Id ?? 0 }; isMaterialEditOpen = true; }
    private void HandleEditMaterial(TreeItem<MaterialCategoryNode> item) { editingMaterial = item.Data.Material; isMaterialEditOpen = true; }
    private void OpenEntryModalWithMaterial(Material mat) { StartEntry(mat, null); }
    private void OpenMaterialFromCard(Material mat) { editingMaterial = mat; isMaterialEditOpen = true; }

    private void HandleCreateCategory(TreeItem<MaterialCategoryNode> item) { selectedCategory = new MaterialCategory { ParentCategoryId = item.Data.Category?.Id }; isCategoryEditOpen = true; }
    private void HandleEditCategory(TreeItem<MaterialCategoryNode> item) { selectedCategory = item.Data.Category; isCategoryEditOpen = true; }

    private async Task OnCategoryModalSave()
    {
        // Implementation same as before but cleaner
        if (selectedCategory == null) return;
        if (selectedCategory.Id == 0) await MaterialCategoryService.AddAsync(selectedCategory);
        else await MaterialCategoryService.UpdateAsync(selectedCategory);
        isCategoryEditOpen = false;
        await RefreshData();
    }

    private async Task OnMaterialModalSave()
    {
        if (editingMaterial == null) return;
        if (editingMaterial.Id == 0) await MaterialService.AddAsync(editingMaterial);
        else await MaterialService.UpdateAsync(editingMaterial);
        isMaterialEditOpen = false;
        await RefreshData();
    }

    private async Task HandleDeleteCategory(TreeItem<MaterialCategoryNode> item)
    {
        if (item.Data.Category == null) return;
        var check = await MaterialCategoryService.CanDeleteAsync(item.Data.Category.Id);

        // BURASI DÜZELTİLDİ: Property isimleri PascalCase (CanDelete, Reason) yapıldı
        if (!check.CanDelete) { ToastService.ShowError(check.Reason); return; }

        ModalService.ShowConfirmation("Silme Onayı", $"{item.Data.Category.CategoryName} silinsin mi?", async (res) =>
        {
            if (res)
            {
                await MaterialCategoryService.DeleteAsync(item.Data.Category.Id);
                await RefreshData();
            }
        });
    }

    private void CloseEntryModal() => isEntryOpen = false;
    private void CloseExitModal() => isExitOpen = false;
    private void CloseTransferModal() => isTransferOpen = false;
    private void CloseCategoryModal() => isCategoryEditOpen = false;
    private void CloseMaterialModal() => isMaterialEditOpen = false;
    private void ClearSearch() { searchTerm = ""; RefreshData(); }
    private string GetSelectedMaterialUnitSymbol() => materialUnits.FirstOrDefault(u => u.Id == SelectedMaterial?.MaterialUnitId)?.Symbol ?? "";

    #endregion
}