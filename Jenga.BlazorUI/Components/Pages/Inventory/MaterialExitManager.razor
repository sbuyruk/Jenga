@page "/inventory/material-exit-manager"
@rendermode InteractiveServer
@using Jenga.BlazorUI.Components.Inventory
@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.Inventory
@using Microsoft.JSInterop
@inject IMaterialExitService MaterialExitService
@inject IMaterialService MaterialService
@inject IMaterialUnitService MaterialUnitService
@inject ILocationService LocationService
@inject IMaterialInventoryService MaterialInventoryService
@inject IJSRuntime JS

<h3>Malzeme Çıkış Yönetimi</h3>

<MaterialExitTable MaterialExits="@materialExits"
                   Materials="@materials"
                   MaterialUnits="@units"
                   Locations="@locations"
                   MaterialInventories="@materialInventories" />

@code {
    private List<MaterialExit> materialExits = new();
    private List<Material> materials = new();
    private List<MaterialUnit> units = new();
    private List<Location> locations = new();
    private List<MaterialInventory> materialInventories = new();

    private bool _dataLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_dataLoaded)
        {
            var exitsR = await MaterialExitService.GetAllAsync();
            materialExits = exitsR.IsSuccess ? exitsR.Value : new();
            var matsR = await MaterialService.GetAllAsync();
            materials = matsR.IsSuccess ? matsR.Value : new();
            var unitsR = await MaterialUnitService.GetAllAsync();
            units = unitsR.IsSuccess ? unitsR.Value : new();
            var locsR = await LocationService.GetAllAsync();
            locations = locsR.IsSuccess ? locsR.Value : new();
            var invR = await MaterialInventoryService.GetAllAsync();
            materialInventories = invR.IsSuccess ? invR.Value : new();
            _dataLoaded = true;
            StateHasChanged();
        }
    }
}