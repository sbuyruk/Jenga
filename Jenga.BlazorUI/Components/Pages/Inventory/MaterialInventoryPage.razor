@page "/inventory/material-inventory-page"
@rendermode InteractiveServer

@using Jenga.DataAccess.Services.IKYS
@using Jenga.DataAccess.Services.Inventory
@using Jenga.BlazorUI.Services.Common
@using Jenga.Models.IKYS
@using Jenga.Models.Inventory
@using Jenga.BlazorUI.Components.Inventory

@inject IMaterialInventoryService MaterialInventoryService
@inject IMaterialService MaterialService
@inject IMaterialUnitService MaterialUnitService
@inject IMaterialCategoryService MaterialCategoryService
@inject ILocationService LocationService
@inject IPersonelService PersonelService
@inject IMaterialEntryService MaterialEntryService
@inject IMaterialBrandService MaterialBrandService
@inject IMaterialModelService MaterialModelService
@inject IToastService ToastService
@inject ICurrentUserService CurrentUserService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Malzeme Envanteri</h5>
    <div>
        <button class="btn btn-success" @onclick="OpenNewEntryModal">
            <i class="bi bi-box-arrow-in-right me-1"></i>Envantere Malzeme Ekle
        </button>
    </div>
</div>

@if (!dataLoaded)
{
    <div class="text-muted">Yükleniyor...</div>
}
else
{
    <MaterialInventoryTable MaterialInventories="inventories.ToList()"
                            Materials="materials"
                            Brands="brands"
                            Models="models"
                            MaterialUnits="units"
                            Categories="categories"
                            Locations="locations"
                            Persons="persons"
                            OnOpenMovements="HandleOpenMovements"
                            OnOpenLocations="HandleOpenLocations"
                            OnInventoryChanged="HandleInventoryChanged" />
}

@* Local entry modal opened by the "Malzeme gir" button *@
<MaterialEntryEditModal MaterialEntry="editingEntry"
                        Materials="materials"
                        MaterialUnits="units"
                        Locations="locations"
                        Persons="persons"
                        Brands="brands"
                        Models="models"
                        Categories="categories"
                        IsOpen="isEntryOpen"
                        OnSave="OnEntryModalSave"
                        OnClose="CloseEntryModal" />

@* Movements modal (opened when user clicks "Hareketler") *@
@if (isMovementModalOpen)
{
    <div class="modal-backdrop fade show" style="z-index:1055"></div>
    <div class="modal show" tabindex="-1" style="display: block;">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-secondary-subtle">
                    <h5 class="modal-title">Hareketler - @GetMaterialName(selectedMovementMaterialId)</h5>
                    <button type="button" class="btn-close" @onclick="CloseMovementModal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <MaterialMovementTable MaterialId="selectedMovementMaterialId"
                                           Materials="materials"
                                           Categories="categories"
                                           Locations="locations"
                                           Persons="persons"
                                           Brands="brands"
                                           Models="models"
                                           MaterialUnits="units"
                                           MaxItems="0" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseMovementModal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MaterialInventory> inventories = new();
    private List<Material> materials = new();
    private List<MaterialUnit> units = new();
    private List<MaterialCategory> categories = new();
    private List<Location> locations = new();
    private List<Personel> persons = new();
    private List<MaterialBrand> brands = new();
    private List<MaterialModel> models = new();

    private bool dataLoaded;
    // private string searchTerm = "";

    // Entry modal state
    private MaterialEntry? editingEntry;
    private bool isEntryOpen;

    // Movement modal state
    private int selectedMovementMaterialId;
    private bool isMovementModalOpen;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        // load all required lists in parallel
        var t1 = MaterialInventoryService.GetAllAsync();
        var t2 = MaterialService.GetAllAsync();
        var t3 = MaterialUnitService.GetAllAsync();
        var t4 = MaterialCategoryService.GetAllAsync();
        var t5 = LocationService.GetAllAsync();
        var t6 = PersonelService.GetCalisanPersonelAsync();
        var t7 = MaterialBrandService.GetAllAsync();
        var t8 = MaterialModelService.GetAllAsync();

        await Task.WhenAll(t1, t2, t3, t4, t5, t6, t7, t8);

        inventories = t1.Result.IsSuccess ? t1.Result.Value : new();
        materials = t2.Result.IsSuccess ? t2.Result.Value : new();
        units = t3.Result.IsSuccess ? t3.Result.Value : new();
        categories = t4.Result.IsSuccess ? t4.Result.Value : new();
        locations = t5.Result.IsSuccess ? t5.Result.Value : new();
        var personsResult = t6.Result;
        persons = personsResult.IsSuccess ? personsResult.Value : new List<Personel>();
        brands = t7.Result.IsSuccess ? t7.Result.Value : new();
        models = t8.Result.IsSuccess ? t8.Result.Value : new();

        dataLoaded = true;
        StateHasChanged();
    }

    private async Task HandleOpenMovements(int materialId)
    {
        selectedMovementMaterialId = materialId;
        isMovementModalOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    private Task HandleOpenLocations(int materialId)
    {
        // existing locations handling...
        return Task.CompletedTask;
    }

    // Button handler: open modal for a new MaterialEntry
    private void OpenNewEntryModal()
    {
        editingEntry = new MaterialEntry
        {
            EntryDate = DateTime.Now,
            Quantity = 1
        };
        isEntryOpen = true;
    }

    private async Task OnEntryModalSave()
    {
        if (editingEntry == null) return;

        try
        {
            var currentUser = await CurrentUserService.GetUserNameAsync();
            var saved = await MaterialEntryService.AddAsync(editingEntry, currentUser, CancellationToken.None);
            if (saved.IsSuccess)
            {
                ToastService.ShowToast("Giris kaydedildi.", ToastType.Success, 2000);
                // reload full data to ensure latest DB state
                await LoadDataAsync();
            }
            else
            {
                ToastService.ShowToast("Giris kaydedilemedi.", ToastType.Error, 3000);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast($"Hata: {ex.Message}", ToastType.Error, 5000);
        }
        finally
        {
            isEntryOpen = false;
            editingEntry = null;
            StateHasChanged();
        }
    }

    private void CloseEntryModal()
    {
        isEntryOpen = false;
        editingEntry = null;
    }

    private void CloseMovementModal()
    {
        isMovementModalOpen = false;
        selectedMovementMaterialId = 0;
    }

    private string GetMaterialName(int id)
    {
        var m = materials.FirstOrDefault(x => x.Id == id);
        return m?.MaterialName ?? $"id:{id}";
    }

    // New callback invoked when child table indicates the inventory changed
    private async Task HandleInventoryChanged()
    {
        await LoadDataAsync();
    }
}