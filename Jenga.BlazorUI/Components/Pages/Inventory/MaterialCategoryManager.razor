@page "/inventory/material-category-manager"
@rendermode InteractiveServer
@using Jenga.BlazorUI.Components.Inventory
@using Jenga.DataAccess.Services.Inventory
@using Jenga.Models.Inventory
@using Microsoft.JSInterop
@inject IMaterialCategoryService MaterialCategoryService
@inject IJSRuntime JS

<h3>Malzeme Kategori Tanımları</h3>
<MaterialCategoryTable Categories="@categories" />

@code {
    private List<MaterialCategory> categories = new();
    private bool _dataLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_dataLoaded)
        {
            var catsR = await MaterialCategoryService.GetAllAsync();
            categories = catsR.IsSuccess ? catsR.Value : new();
            _dataLoaded = true;
            StateHasChanged();
        }
    }
}