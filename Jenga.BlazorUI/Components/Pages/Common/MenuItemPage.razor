@page "/common/menu-item-page"
@rendermode InteractiveServer

@using Jenga.DataAccess.Services.Common
@using Jenga.Models.Common
@using Jenga.BlazorUI.Components.Menus
@using Jenga.BlazorUI.Services.Common

@inject IMenuItemService MenuItemService
@inject IToastService ToastService
@inject ICurrentUserService CurrentUserService

<PermissionGuard Module="ModuleName.Admin" Operation="Operation.View">
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Menü Yönetimi</h5>

</div>

@if (!dataLoaded)
{
    <div class="text-muted">Yükleniyor...</div>
}
else
{
    <MenuItemTable Menus="menuItems"
                   CanCreate="@_canCreate"
                   CanEdit="@_canEdit"
                   CanDelete="@_canDelete" />
}

</PermissionGuard>

@code {
    private List<MenuItem> menuItems = new();
    private bool dataLoaded;
    private bool _canCreate;
    private bool _canEdit;
    private bool _canDelete;

    protected override async Task OnInitializedAsync()
    {
        _canCreate = await CurrentUserService.HasPermissionAsync(ModuleName.Admin, Operation.Create);
        _canEdit   = await CurrentUserService.HasPermissionAsync(ModuleName.Admin, Operation.Edit);
        _canDelete = await CurrentUserService.HasPermissionAsync(ModuleName.Admin, Operation.Delete);
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var result = await MenuItemService.GetAllAsync();
            menuItems = result.IsSuccess ? result.Value : new List<MenuItem>();
            if (result.IsFailure)
            {
                ToastService.ShowToast($"Menüler yüklenemedi: {result.Error.Message}", ToastType.Error, 5000);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast($"Menüler yüklenemedi: {ex.Message}", ToastType.Error, 5000);
            menuItems = new List<MenuItem>();
        }
        dataLoaded = true;
        StateHasChanged();
    }

    // Provide a simple entry point for "Yeni Menü" button: open a client-side modal by
    // delegating to MenuItemTable's behavior ï¿½ MenuItemTable opens its own edit modal
    // when a MenuItem with Id == 0 is passed. To keep parent simple we add the new item
    // into the list and let the table show it immediately.
    private void OpenNewMenuModal()
    {
        var newItem = new MenuItem();
        menuItems.Add(newItem);
        StateHasChanged();
    }
}