@page "/common/switch-user"
@rendermode InteractiveServer
@using Jenga.BlazorUI.Services.Common
@inject ImpersonationService ImpersonationService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject IHostEnvironment HostEnvironment

<PermissionGuard Module="ModuleName.Admin" Operation="Operation.View">
<div class="container" style="max-width:480px; margin-top:2rem;">
    <div class="card shadow-sm">
        <div class="card-header bg-warning-subtle">
            <h5 class="mb-0"><i class="bi bi-person-fill-gear me-2"></i>Kullanici Degistir (Dev Only)</h5>
        </div>
        <div class="card-body">
            @if (!HostEnvironment.IsDevelopment())
            {
                <div class="alert alert-danger">Bu sayfa yalnizca gelistirme ortaminda calisir.</div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="alert alert-info">@_message</div>
                }

                <div class="mb-3">
                    <label class="form-label fw-semibold">Aktif Kullanici</label>
                    <div class="form-control-plaintext text-muted">@(_activeUser ?? "---")</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Yeni Kullanici Adi</label>
                    <input class="form-control" @bind="_username" placeholder="Kullanici adi girin..." />
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SwitchAsync">
                        <i class="bi bi-arrow-left-right me-1"></i>Degistir
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ClearAsync">
                        <i class="bi bi-x-circle me-1"></i>Sifirla (Gercek Kullanici)
                    </button>
                </div>
            }
        </div>
    </div>
</div>
</PermissionGuard>

@code {
    private string? _username;
    private string? _activeUser;
    private string? _message;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var overrideUser = await ImpersonationService.GetOverrideAsync();
        var personel = await CurrentUserService.GetCurrentPersonelAsync();
        _activeUser = !string.IsNullOrWhiteSpace(overrideUser)
            ? $"{overrideUser} (impersonation)"
            : personel?.KullaniciAdi ?? "---";
        StateHasChanged();
    }

    private async Task SwitchAsync()
    {
        if (string.IsNullOrWhiteSpace(_username)) return;
        await ImpersonationService.SetOverrideAsync(_username.Trim());
        CurrentUserService.Invalidate();
        _message = $"Kullanıcıya geçildi. Sayfa yenileniyor...";
        StateHasChanged();
        await Task.Delay(800);
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    private async Task ClearAsync()
    {
        await ImpersonationService.ClearOverrideAsync();
        CurrentUserService.Invalidate();
        _message = "Impersonation temizlendi. Sayfa yenileniyor...";
        StateHasChanged();
        await Task.Delay(800);
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}