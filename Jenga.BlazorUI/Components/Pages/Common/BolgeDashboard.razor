                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-rose h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-exclamation-triangle"></i></div>
                                        <div class="bd-stat-label">5+ Yıl Güncel Değil</div>
                                        <div class="bd-stat-value">@_ftkEski</div>
                                        <div class="bd-stat-sub">adet</div>
                                    </div>
                                </div>
                            </div>
