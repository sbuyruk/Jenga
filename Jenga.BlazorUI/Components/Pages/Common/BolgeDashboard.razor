                                        <div class="bd-stat-label">FTK Üye</div>
                                        <div class="bd-stat-value">@_toplamFtkUye</div>
                                        <div class="bd-stat-sub">kişi</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-green h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-calendar-check"></i></div>
                                        <div class="bd-stat-label">Bu Yıl Kurulan</div>
                                        <div class="bd-stat-value">@_ftkBuYilKurulan</div>
                                        <div class="bd-stat-sub">adet</div>
                                    </div>
                                </div>
