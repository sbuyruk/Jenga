@page "/bolge/dashboard"
@page "/bolge/dashboard/{BolgeId:int}"
@rendermode InteractiveServer

@using System.Globalization
@using Jenga.BlazorUI.Components.Common
@using Jenga.DataAccess.Services.Common
@using Jenga.DataAccess.Services.FTK
@using Jenga.DataAccess.Services.IKYS
@using Jenga.DataAccess.Services.NBYS
@using Jenga.DataAccess.Services.TBYS
@using Jenga.Models.Common
@using Jenga.Models.FTK
@using Jenga.Models.IKYS
@using Jenga.Models.NBYS
@using Jenga.Models.TBYS
@using Microsoft.JSInterop

@inject IBolgeService BolgeService
@inject IIlService IlService
@inject ITasinmazService TasinmazService
@inject IKiraSozlesmeService KiraSozlesmeService
@inject IOdemeService OdemeService
@inject IBagisService BagisService
@inject ITasinmazBagisciService TasinmazBagisciService
@inject INakitBagisHareketService NakitBagisHareketService
@inject INakitBagisciService NakitBagisciService
@inject IArmaganService ArmaganService
@inject IArmaganTanimService ArmaganTanimService
@inject IFtkService FtkService
@inject IFtkIslemService FtkIslemService
@inject IPersonelService PersonelService
@inject IIsBilgileriService IsBilgileriService
@inject IJSRuntime JS
@inject ILogger<BolgeDashboard> Logger
@implements IDisposable

<PermissionGuard Module="ModuleName.TBYS" Operation="Operation.View">
<div class="bolge-dashboard container-fluid px-0 px-sm-2">

    @if (_isLoading && _bolgeler.Count == 0)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-border text-primary me-3" role="status"></div>
            <span class="text-muted">Bölgeler yükleniyor…</span>
        </div>
    }
    else
    {
        <!-- ── Bölge Seçici ──────────────────────────────────────── -->
        <div class="bd-bolge-selector mb-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="bd-selector-label">
                    <i class="bi bi-geo-alt-fill me-1 text-primary"></i>
                    <strong>Bölge Seç:</strong>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var b in _bolgeler.Where(x => x.Aktif && x.TemsilcilikMi))
                    {
                        <button class="btn btn-sm @(_secilenBolge?.Id == b.Id ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => SelectBolgeAsync(b)">
                            @(b.KisaAdi ?? b.Adi)
                        </button>
                    }
                </div>
                @if (_secilenBolge != null)
                {
                    <button class="btn btn-sm btn-outline-secondary ms-auto"
                            @onclick="RefreshAsync"
                            disabled="@_isLoading">
                        <i class="bi bi-arrow-clockwise @(_isLoading ? "bd-spin" : "")"></i>
                        @(_isLoading ? "Yükleniyor..." : "Yenile")
                    </button>
                }
            </div>
        </div>

        @if (_secilenBolge == null)
        {
            <div class="bd-empty-state">
                <i class="bi bi-map fs-1 text-muted d-block mb-3"></i>
                <h5 class="text-muted">Bir bölge seçin</h5>
                <p class="text-muted small">Yukarıdan bir bölge seçerek o bölgeye ait özet verileri görüntüleyebilirsiniz.</p>
            </div>
        }
        else if (_isLoading)
        {
            <div class="d-flex justify-content-center align-items-center py-5">
                <div class="spinner-border text-primary me-3" role="status"></div>
                <span class="text-muted">@_secilenBolge.Adi bölgesi verileri yükleniyor…</span>
            </div>
        }
        else if (_loadFailed)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Veri yüklenirken bir hata oluştu.
                <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="RefreshAsync">Tekrar Dene</button>
            </div>
        }
        else
        {
            <div class="bd-scrollspy-layout">

                <!-- ── Scrollspy Nav ─────────────────────────────── -->
                <nav id="bd-scrollspy-nav" class="bd-scrollspy-nav">
                    <div class="nav nav-pills flex-column gap-1">
                        <div class="bd-nav-title">
                            <i class="bi bi-geo-alt-fill me-1"></i> @_secilenBolge.KisaAdi
                        </div>
                        <a class="nav-link" href="#bd-genel-ozet" @onclick:preventDefault="true" @onclick='() => ScrollToAsync("bd-genel-ozet")'>
                            <i class="bi bi-grid-1x2-fill me-1"></i>Genel Özet
                        </a>
                        <a class="nav-link" href="#bd-tasinmaz" @onclick:preventDefault="true" @onclick='() => ScrollToAsync("bd-tasinmaz")'>
                            <i class="bi bi-buildings me-1"></i>Taşınmaz
                        </a>
                        <a class="nav-link" href="#bd-kira" @onclick:preventDefault="true" @onclick='() => ScrollToAsync("bd-kira")'>
                            <i class="bi bi-house-door-fill me-1"></i>Kira
                        </a>
                        <a class="nav-link" href="#bd-nakit" @onclick:preventDefault="true" @onclick='() => ScrollToAsync("bd-nakit")'>
                            <i class="bi bi-cash-stack me-1"></i>Nakit Bağış
                        </a>
                        <a class="nav-link" href="#bd-armagan" @onclick:preventDefault="true" @onclick='() => ScrollToAsync("bd-armagan")'>
                            <i class="bi bi-award-fill me-1"></i>Armağan
                        </a>
                        <a class="nav-link" href="#bd-ftk" @onclick:preventDefault="true" @onclick='() => ScrollToAsync("bd-ftk")'>
                            <i class="bi bi-people-fill me-1"></i>FTK
                        </a>
                        <a class="nav-link" href="#bd-personel" @onclick:preventDefault="true" @onclick='() => ScrollToAsync("bd-personel")'>
                            <i class="bi bi-person-badge-fill me-1"></i>Personel
                        </a>
                    </div>
                </nav>

                <!-- ── Scrollspy Content ─────────────────────────── -->
                <div id="bd-scrollspy-content"
                     class="bd-scrollspy-content"
                     data-bs-spy="scroll"
                     data-bs-target="#bd-scrollspy-nav"
                     data-bs-smooth-scroll="true"
                     tabindex="0">

                    <!-- ── Sayfa Başlığı ────────────────────────────── -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                        <div>
                            <h5 class="mb-0 fw-bold">
                                <i class="bi bi-geo-alt-fill me-2 text-primary"></i>@_secilenBolge.Adi Bölgesi – Dashboard
                            </h5>
                            <small class="text-muted">
                                @_bolgeIller.Count il • Son güncelleme: @DateTime.Now.ToString("HH:mm", _trCulture)
                            </small>
                        </div>
                    </div>

                    <!-- ════════════════════════════════════════════════
                         BÖLÜM 1 – GENEL ÖZET
                    ════════════════════════════════════════════════ -->
                    <section id="bd-genel-ozet" class="bd-section">
                        <div class="section-label">Genel Özet</div>
                        <div class="row g-2 mb-3">
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-blue h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-buildings"></i></div>
                                        <div class="bd-stat-label">Taşınmaz</div>
                                        <div class="bd-stat-value">@_toplamTasinmaz</div>
                                        <div class="bd-stat-sub">adet</div>
                                    </div>
                                </div>
                            </div>
 
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-sky h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-house-heart"></i></div>
                                        <div class="bd-stat-label">Taşınmaz Bağışçı</div>
                                        <div class="bd-stat-value">@_toplamTasinmazBagisci</div>
                                        <div class="bd-stat-sub">kişi</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-green h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-cash-stack"></i></div>
                                        <div class="bd-stat-label">Nakit Bağışçı</div>
                                        <div class="bd-stat-value">@_toplamNakitBagisci</div>
                                        <div class="bd-stat-sub">kişi</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-teal h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-arrow-repeat"></i></div>
                                        <div class="bd-stat-label">Düzenli Bağışçı</div>
                                        <div class="bd-stat-value">@_toplamDuzenliNakitBagisci</div>
                                        <div class="bd-stat-sub">@Percent(_toplamDuzenliNakitBagisci, _toplamNakitBagisci)% bağışçı</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-purple h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-people"></i></div>
                                        <div class="bd-stat-label">FTK</div>
                                        <div class="bd-stat-value">@_toplamFtk</div>
                                        <div class="bd-stat-sub">birim</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-amber h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-person-badge"></i></div>
                                        <div class="bd-stat-label">Personel</div>
                                        <div class="bd-stat-value">@_toplamPersonel</div>
                                        <div class="bd-stat-sub">çalışan</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- İller listesi -->
                        <div class="card shadow-sm mb-3">
                            <div class="card-header fw-semibold py-2">
                                <i class="bi bi-map me-1 text-primary"></i> @_secilenBolge.Adi Bölgesi – İller
                                <span class="badge bg-primary-subtle text-primary-emphasis ms-2">@_bolgeIller.Count il</span>
                            </div>
                            <div class="card-body p-2">
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var il in _bolgeIller.OrderBy(x => x.IlAdi))
                                    {
                                        <span class="badge rounded-pill bg-light text-dark border">
                                            <i class="bi bi-geo me-1 text-secondary"></i>@il.IlAdi
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                        <hr class="bd-separator" />
                    </section>

                    <!-- ════════════════════════════════════════════════
                         BÖLÜM 2 – TAŞINMAZ
                    ════════════════════════════════════════════════ -->
                    <section id="bd-tasinmaz" class="bd-section">
                        <div class="section-label">Taşınmaz</div>
                        <div class="row g-2 mb-3">
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-blue h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-buildings"></i></div>
                                        <div class="bd-stat-label">Toplam</div>
                                        <div class="bd-stat-value">@_toplamTasinmaz</div>
                                        <div class="bd-stat-sub">adet</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-indigo h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-house-check"></i></div>
                                        <div class="bd-stat-label">Tam Mülkiyet</div>
                                        <div class="bd-stat-value">@_toplamTamMulkiyet</div>
                                        <div class="bd-stat-sub">@Percent(_toplamTamMulkiyet, _toplamTasinmaz)% TM</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-purple h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-house-dash"></i></div>
                                        <div class="bd-stat-label">Çıplak Mülkiyet</div>
                                        <div class="bd-stat-value">@_toplamCiplakMulkiyet</div>
                                        <div class="bd-stat-sub">@Percent(_toplamCiplakMulkiyet, _toplamTasinmaz)% ÇM</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-teal h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-house-door"></i></div>
                                        <div class="bd-stat-label">Kiraya Uygun</div>
                                        <div class="bd-stat-value">@_toplamKirayaUygun</div>
                                        <div class="bd-stat-sub">@Percent(_toplamKirayaUygun, _toplamTasinmaz)% kiralık</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-rose h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-house-x"></i></div>
                                        <div class="bd-stat-label">Kiraya Uygun Değil</div>
                                        <div class="bd-stat-value">@_toplamKirayaUygunDegil</div>
                                        <div class="bd-stat-sub">@Percent(_toplamKirayaUygunDegil, _toplamTasinmaz)% uygun değil</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-teal h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-map"></i></div>
                                        <div class="bd-stat-label">Taşınmaz Bulunan İl</div>
                                        <div class="bd-stat-value">@_tasinmazBulunanIlSayisi</div>
                                        <div class="bd-stat-sub">@Percent(_tasinmazBulunanIlSayisi, _bolgeIller.Count)% il</div>
                                    </div>
                                </div>
                            </div>
                            </div>

                            <!-- Değer KPI'ları –– ayrı satır -->
                            <div class="row g-2 mb-3">
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-purple h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-clipboard-check"></i></div>
                                        <div class="bd-stat-label">Değerlemesi Yapılan</div>
                                        <div class="bd-stat-value">@_degerlemeYapilanSayisi</div>
                                        <div class="bd-stat-sub">@Percent(_degerlemeYapilanSayisi, _toplamTasinmaz)% taşınmaz</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-amber h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-house"></i></div>
                                        <div class="bd-stat-label">Emlak Beyan Değeri</div>
                                        <div class="bd-stat-value" style="font-size:0.85rem">@FormatMoney(_toplamEmlakBeyan)</div>
                                        <div class="bd-stat-sub">TL</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-indigo h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-graph-up"></i></div>
                                        <div class="bd-stat-label">Tahmini Rayiç Bedeli</div>
                                        <div class="bd-stat-value" style="font-size:0.85rem">@FormatMoney(_toplamRayic)</div>
                                        <div class="bd-stat-sub">TL</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-sky h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-cash"></i></div>
                                        <div class="bd-stat-label">Muhasebeye Kayıtlı Değeri</div>
                                        <div class="bd-stat-value" style="font-size:0.85rem">@FormatMoney(_toplamMuhasebeKayitli)</div>
                                        <div class="bd-stat-sub">TL</div>
                                    </div>
                                </div>
                            </div>


                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="card bd-stat-card bd-accent-green h-100">
                                    <div class="card-body bd-stat-body text-center">
                                        <div class="bd-stat-icon"><i class="bi bi-graph-up-arrow"></i></div>
                                        <div class="bd-stat-label">Yaklaşık Piyasa Değeri</div>
                                        <div class="bd-stat-value" style="font-size:0.85rem">@FormatMoney(_toplamYaklasikPiyasa)</div>
                                        <div class="bd-stat-sub">TL</div>
                                    </div>
                                </div>
                            </div>
                            </div>

                            @if (_tasinmazCinsiItems.Count > 0)
                            {
                                <div class="card shadow-sm mb-3">
                                    <div class="card-header fw-semibold py-2">
                                        <i class="bi bi-pie-chart-fill me-1 text-primary"></i> Taşınmaz Cinsleri Dağılımı
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="row g-0">
                                            <div class="col-12 col-md-6" style="height:300px;">
                                                <GenericChart TItem="PieItem"
                                                              Items="_tasinmazCinsiItems"
                                                              LabelSelector="@(p => p.Label)"
                                                              ValueSelector="@(p => p.Value)"
                                                              Title=""
                                                              SeriesName="Cins"
                                                              Type="GenericChart<PieItem>.GenericChartType.Pie"
                                                              Height="100%"
                                                              Width="100%"
                                                              ShowLegend="true"
                                                              ShowDataLabels="true"
                                                              ColorPalette="@_mainPalette" />
                                            </div>
                                            <div class="col-12 col-md-6 border-start">
                                                <div class="table-responsive" style="max-height:300px; overflow-y:auto;">
                                                    <table class="table table-sm table-hover mb-0 bd-table">
                                                        <thead class="table-light sticky-top">
                                                            <tr>
                                                                <th>Cins</th>
                                                                <th class="text-end">Adet</th>
                                                                <th class="text-end">%</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var item in _tasinmazCinsiItems)
                                                            {
                                                                <tr>
                                                                    <td>@item.Label</td>
                                                                    <td class="text-end">@((int)item.Value)</td>
                                                                    <td class="text-end">@Percent((int)item.Value, _toplamTasinmaz)%</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                        <tfoot class="table-secondary fw-bold">
                                                            <tr>
                                                                <td>Toplam</td>
                                                                <td class="text-end">@_toplamTasinmaz</td>
                                                                <td class="text-end">100%</td>
                                                            </tr>
                                                        </tfoot>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                        <!-- İl bazlı taşınmaz tablosu -->
                        <div class="card shadow-sm mb-3">
                            <div class="card-header fw-semibold py-2 bd-collapsible-header"
                                 @onclick="() => _isTasinmazIlOpen = !_isTasinmazIlOpen"
                                 role="button">
                                <span>
                                    <i class="bi @(_isTasinmazIlOpen ? "bi-chevron-down" : "bi-chevron-right") me-2"></i>
                                    <i class="bi bi-table me-1 text-primary"></i> İl Bazlı Taşınmaz Dağılımı
                                </span>
                                <small class="text-muted">@_tasinmazIlSatirlari.Count il</small>
                            </div>
                            @if (_isTasinmazIlOpen)
                            {
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover table-bordered mb-0 bd-table">
                                            <thead class="table-light sticky-top">
                                                <tr>
                                                    <th>İl</th>
                                                    <th class="text-center">Toplam</th>
                                                    <th class="text-center">TM</th>
                                                    <th class="text-center">ÇM</th>
                                                    <th class="text-end">Emlak Beyan Değeri</th>
                                                    <th class="text-end">Tah.Ray.Değeri</th>
                                                    <th class="text-end">Muh.Kay.Değeri</th>
                                                    <th class="text-end">Yak.Piy.Değeri</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var satir in _tasinmazIlSatirlari.OrderByDescending(x => x.Toplam))
                                                {
                                                    <tr>
                                                        <td class="fw-semibold">@satir.IlAdi</td>
                                                        <td class="text-center">@satir.Toplam</td>
                                                        <td class="text-center text-primary">@satir.TM</td>
                                                        <td class="text-center text-info">@satir.CM</td>
                                                        <td class="text-end">@(satir.EmlakBeyan == 0 ? "–" : satir.EmlakBeyan.ToString("N0", _trCulture))</td>
                                                        <td class="text-end">@(satir.TahminiRayic == 0 ? "–" : satir.TahminiRayic.ToString("N0", _trCulture))</td>
                                                        <td class="text-end">@(satir.MuhasebeyeKayitli == 0 ? "–" : satir.MuhasebeyeKayitli.ToString("N0", _trCulture))</td>
                                                        <td class="text-end">@(satir.YaklasikPiyasa == 0 ? "–" : satir.YaklasikPiyasa.ToString("N0", _trCulture))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot class="table-secondary fw-bold">
                                                <tr>
                                                    <td>Toplam</td>
                                                    <td class="text-center">@_toplamTasinmaz</td>
                                                    <td class="text-center">@_toplamTamMulkiyet</td>
