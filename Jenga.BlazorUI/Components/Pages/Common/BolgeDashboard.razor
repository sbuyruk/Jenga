                        <!-- FTK listesi – il bazlı accordion -->
                        @if (_ftkSatirlari.Count > 0)
                        {
                            @foreach (var ilGrubu in _ftkSatirlari.GroupBy(x => x.IlAdi).OrderBy(g => g.Key))
                            {
                                var ilAdi = ilGrubu.Key;
                                var acik = _ftkIllerOpen.TryGetValue(ilAdi, out var v) && v;
                                <div class="card shadow-sm mb-2">
                                    <div class="card-header fw-semibold py-2 bd-collapsible-header"
