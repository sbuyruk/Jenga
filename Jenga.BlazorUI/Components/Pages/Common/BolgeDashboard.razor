                </div><!-- scrollspy-content -->
            </div><!-- scrollspy-layout -->
        }
    }
</div>

</PermissionGuard>

@code {
    [Parameter] public int? BolgeId { get; set; }

    private static readonly CultureInfo _trCulture = new("tr-TR");

    // ── Durum ────────────────────────────────────────────────────
    private bool _isLoading = true;
    private bool _loadFailed = false;
    private bool _scrollSpyInitialized = false;
    private CancellationTokenSource? _cts;

    // ── Bölgeler ─────────────────────────────────────────────────
    private List<Bolge> _bolgeler = [];
    private Bolge? _secilenBolge;
    private List<Il> _bolgeIller = [];
    private HashSet<int> _bolgeIlIds = [];
    private HashSet<string> _bolgeIlAdlari = [];

    // ── Collapse durumları ────────────────────────────────────────
    private bool _isTasinmazIlOpen = true;
    private Dictionary<string, bool> _ftkIllerOpen = [];
    private bool _isPersonelListeOpen = true;

    // ── Renk paleti ───────────────────────────────────────────────
    private static readonly string[] _mainPalette =
    [
        "#2563EB", "#10B981", "#F59E0B", "#EF4444", "#7C3AED",
        "#06B6D4", "#F97316", "#9B5DE5", "#8AC926", "#1982C4",
        "#FF6B6B", "#4ECDC4"
    ];

    // ── Taşınmaz ─────────────────────────────────────────────────
    private int _toplamTasinmaz;
    private int _toplamTamMulkiyet;
    private int _toplamCiplakMulkiyet;
    private int _toplamKirayaUygun;
    private int _toplamKirayaUygunDegil;
    private int _tasinmazBulunanIlSayisi;
    private int _toplamKullanimda;
    private int _toplamBos;
    private decimal _toplamMuhasebeKayitli;
    private decimal _toplamRayic;
    private decimal _toplamEmlakBeyan;
    private decimal _toplamYaklasikPiyasa;
    private int _degerlemeYapilanSayisi;
    private List<PieItem> _tasinmazCinsiItems = [];
    private List<TasinmazIlSatir> _tasinmazIlSatirlari = [];

    // ── Kira ─────────────────────────────────────────────────────
    private int _toplamAktifSozlesme;
    private decimal _buYilKiraTahsilat;
    private int _buAySonaEren;
    private int _ucAySonaEren;
    private List<YearAmount> _kiraYillikItems = [];

    // ── Nakit Bağış ──────────────────────────────────────────────
    private int _toplamTasinmazBagisci;
    private int _toplamNakitBagisci;
    private int _toplamDuzenliNakitBagisci;
    private int _toplamNakitHareket;
    private decimal _buYilNakitToplam;
    private decimal _genelNakitToplam;
    private List<YearAmount> _nakitYillikItems = [];

    // ── Armağan ──────────────────────────────────────────────────
    private int _toplamArmagan;
    private int _armaganTeslimEdilen;
    private int _armaganBekleyen;
    private int _buYilArmagan;
    private List<PieItem> _armaganTurleriItems = [];

    // ── FTK ──────────────────────────────────────────────────────
    private int _toplamFtk;
    private int _toplamFtkUye;
    private int _ftkBuYilKurulan;
    private int _ftkEski;
    private List<FtkSatir> _ftkSatirlari = [];

    // ── Personel ─────────────────────────────────────────────────
    private int _toplamPersonel;
    private int _erkekPersonel;
    private int _kadinPersonel;
    private int _yasOrtalamasi;
    private List<PersonelSatir> _personelSatirlari = [];

    // ── Inner records ─────────────────────────────────────────────
    private record TasinmazIlSatir(string IlAdi, int Toplam, int TM, int CM, decimal EmlakBeyan, decimal TahminiRayic, decimal MuhasebeyeKayitli, decimal YaklasikPiyasa);
    private record FtkSatir(string IlAdi, string IlceAdi, string AdiSoyadi, string? Gorev, DateTime? KurulusTarihi, DateTime? GuncellemeTarihi);
    private record PersonelSatir(string AdSoyad, int SicilNo, string? Unvan, string? Birim, string? CalismaDurumu);

    // ── Lifecycle ─────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        var bolgeResult = await BolgeService.GetAktifBolgelerAsync(_cts.Token);
        _bolgeler = bolgeResult.IsSuccess ? bolgeResult.Value : [];

        if (BolgeId.HasValue)
        {
            _secilenBolge = _bolgeler.FirstOrDefault(b => b.Id == BolgeId.Value);
            if (_secilenBolge != null)
                await LoadBolgeDataAsync(_cts.Token);
        }
        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollSpyInitialized && _secilenBolge != null && !_isLoading)
        {
            _scrollSpyInitialized = true;
            await JS.InvokeVoidAsync("initScrollSpy", "bd-scrollspy-content", "bd-scrollspy-nav", 12);
        }
    }

    public void Dispose() { _cts?.Cancel(); _cts?.Dispose(); }

    private async Task SelectBolgeAsync(Bolge bolge)
    {
        if (_secilenBolge?.Id == bolge.Id) return;
        _secilenBolge = bolge;
        _scrollSpyInitialized = false;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        await LoadBolgeDataAsync(_cts.Token);
    }

    private async Task RefreshAsync()
    {
        if (_secilenBolge == null) return;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        await LoadBolgeDataAsync(_cts.Token);
    }

    private ValueTask ScrollToAsync(string id)
        => JS.InvokeVoidAsync("scrollSpyScrollTo", "bd-scrollspy-content", id);

    private async Task LoadBolgeDataAsync(CancellationToken ct)
    {
        _isLoading = true;
        _loadFailed = false;
        StateHasChanged();

        try
        {
            // ── İller ──────────────────────────────────────────
            var illerResult = await IlService.GetAktifIllerAsync(ct);
            var tumIller = illerResult.IsSuccess ? illerResult.Value : [];
            _bolgeIller = tumIller.Where(i => i.BolgeId == _secilenBolge!.Id).ToList();
            _bolgeIlIds = _bolgeIller.Select(i => i.Id).ToHashSet();
            _bolgeIlAdlari = _bolgeIller
                .Where(i => !string.IsNullOrEmpty(i.IlAdi))
                .Select(i => i.IlAdi!)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var ilIdToAdi = _bolgeIller.ToDictionary(i => i.Id, i => i.IlAdi ?? "?");

            // ── Paralel veri yükleme ────────────────────────────
            var tTasinmazBagisciSayisi = TasinmazBagisciService.CountByIlIdsAsync(_bolgeIlIds, ct);
            var tTasinmaz = TasinmazService.GetEnvanterdekilerForBolgeDashboardAsync(_secilenBolge!.Adi, _bolgeIlAdlari, ct);
            var tKiraSozlesme = KiraSozlesmeService.GetAllForBolgeDashboardAsync(_secilenBolge!.Id, ct);
            var tNakitBagisci = NakitBagisciService.GetAllForBolgeDashboardAsync(_bolgeIlIds, ct);
            var tFtk = FtkService.GetLatestPerIslemForBolgeDashboardAsync(_secilenBolge!.Id, ct);
            var tPersonelDash = IsBilgileriService.GetPersonelForBolgeDashboardAsync(_secilenBolge!.Id, ct);
            var tArmaganTanim = ArmaganTanimService.GetAllAsync(ct);

            await Task.WhenAll(tTasinmazBagisciSayisi, tTasinmaz, tKiraSozlesme, tNakitBagisci, tFtk, tPersonelDash, tArmaganTanim);

            var bolgeTasinmazlar = tTasinmaz.Result.IsSuccess ? tTasinmaz.Result.Value : [];
            var bolgeKiraSozlesmeler = tKiraSozlesme.Result.IsSuccess ? tKiraSozlesme.Result.Value : [];
            var bolgeNakitBagiscilar = tNakitBagisci.Result.IsSuccess ? tNakitBagisci.Result.Value : [];
            var bolgeFtkler = tFtk.Result.IsSuccess ? tFtk.Result.Value : [];
            var bolgePersoneller = tPersonelDash.Result.IsSuccess ? tPersonelDash.Result.Value : [];
            var armaganTanimlar = tArmaganTanim.Result.IsSuccess ? tArmaganTanim.Result.Value : [];
            var tasinmazBagisciSayisi = tTasinmazBagisciSayisi.Result.IsSuccess ? tTasinmazBagisciSayisi.Result.Value : 0;

            var bolgeSozlesmeIds = bolgeKiraSozlesmeler.Select(s => s.Id).ToHashSet();

            var bolgeBagisciIds = bolgeNakitBagiscilar
                .Select(nb => nb.Id)
                .ToHashSet();

            var bolgeFtkIslemIds0 = bolgeFtkler.Select(f => f.FtkIslemId).Where(x => x.HasValue).Select(x => x!.Value).ToHashSet();

            var tOdeme = OdemeService.GetAllForBolgeDashboardBySozlesmeIdsAsync(bolgeSozlesmeIds, ct);
            var tNakitHareket = NakitBagisHareketService.GetAllForBolgeDashboardAsync(bolgeBagisciIds, ct);
            var tArmagan = ArmaganService.GetAllForBolgeDashboardAsync(bolgeBagisciIds, ct);
            var tFtkIslem = FtkIslemService.GetForBolgeDashboardAsync(bolgeFtkIslemIds0, ct);

            await Task.WhenAll(tOdeme, tNakitHareket, tArmagan, tFtkIslem);

            var bolgeOdemeler = tOdeme.Result.IsSuccess ? tOdeme.Result.Value : [];
            var bolgeNakitHareketler = tNakitHareket.Result.IsSuccess ? tNakitHareket.Result.Value : [];
            var bolgeArmaganlar = tArmagan.Result.IsSuccess ? tArmagan.Result.Value : [];
            var bolgeFtkIslemler = tFtkIslem.Result.IsSuccess ? tFtkIslem.Result.Value : [];

            var ilceDict = new Dictionary<int, string>(); // doldurulmadı, sadece FTK tablosu için
            var ilDict2 = tumIller.ToDictionary(i => i.Id, i => i.IlAdi ?? "?");

            // ══════════════════════════════════
            // HESAPLAMALAR
            // ══════════════════════════════════

            // Taşınmaz
            _toplamTasinmaz = bolgeTasinmazlar.Count;
            _toplamTamMulkiyet = bolgeTasinmazlar.Count(t => t.TamMulkiyetMi);
            _toplamCiplakMulkiyet = bolgeTasinmazlar.Count(t => t.CiplakMulkiyetMi);
            _toplamKirayaUygun = bolgeTasinmazlar.Count(t => t.KirayaUygunMu);
            _toplamKirayaUygunDegil = bolgeTasinmazlar.Count(t => !t.KirayaUygunMu);
            _toplamKullanimda = bolgeTasinmazlar.Count(t =>
                !string.IsNullOrEmpty(t.KullanimSekli) &&
                t.KullanimSekli.Contains("kullanım", StringComparison.OrdinalIgnoreCase));
            _toplamBos = bolgeTasinmazlar.Count(t =>
                !t.KirayaUygunMu &&
                (string.IsNullOrEmpty(t.KullanimSekli) || !t.KullanimSekli.Contains("kullanım", StringComparison.OrdinalIgnoreCase)));
            _toplamMuhasebeKayitli = bolgeTasinmazlar.Sum(t => t.MuhasebeyeKayitliDeger ?? 0m);
            _toplamRayic = bolgeTasinmazlar.Sum(t => t.TahminiRayicDegeri ?? 0m);
            _toplamEmlakBeyan = bolgeTasinmazlar.Sum(t => t.EmlakBeyanDegeri ?? 0m);
            _toplamYaklasikPiyasa = bolgeTasinmazlar.Sum(t => t.YaklasikPiyasaDegeri ?? 0m);
            _degerlemeYapilanSayisi = bolgeTasinmazlar.Count(t => t.YaklasikPiyasaDegeri > 0);

            // Taşınmaz bulunan il sayısı
            _tasinmazBulunanIlSayisi = bolgeTasinmazlar
                .Where(t => !string.IsNullOrEmpty(t.Ili))
                .Select(t => t.Ili!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();

            // Taşınmaz il bazlı tablo
            _tasinmazIlSatirlari = _bolgeIller
                .Select(il =>
                {
                    var ilTasinmazlar = bolgeTasinmazlar
                        .Where(t => !string.IsNullOrEmpty(t.Ili) && t.Ili.Equals(il.IlAdi, StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    return new TasinmazIlSatir(
                        il.IlAdi ?? "?",
                        ilTasinmazlar.Count,
                        ilTasinmazlar.Count(t => t.TamMulkiyetMi),
                        ilTasinmazlar.Count(t => t.CiplakMulkiyetMi),
                        ilTasinmazlar.Sum(t => t.EmlakBeyanDegeri ?? 0m),
                        ilTasinmazlar.Sum(t => t.TahminiRayicDegeri ?? 0m),
                        ilTasinmazlar.Sum(t => t.MuhasebeyeKayitliDeger ?? 0m),
                        ilTasinmazlar.Sum(t => t.YaklasikPiyasaDegeri ?? 0m)
                    );
                })
                .Where(x => x.Toplam > 0)
                .ToList();

            // Taşınmaz cinsi pie
            _tasinmazCinsiItems = bolgeTasinmazlar
                .Where(t => !string.IsNullOrEmpty(t.KullanimSekli))
                .GroupBy(t => NormalizeCins(t.KullanimSekli!))
                .Select(g => new PieItem { Label = g.Key, Value = g.Count() })
                .OrderByDescending(p => p.Value)
                .ToList();

            // Kira
            var now = DateTime.Today;
            _toplamAktifSozlesme = bolgeKiraSozlesmeler.Count(k =>
                (k.SozBasTar == null || k.SozBasTar <= now) &&
                (k.SozBitTar == null || k.SozBitTar >= now));
            _buYilKiraTahsilat = bolgeOdemeler
                .Where(o => o.OdemeTarihi.HasValue && o.OdemeTarihi.Value.Year == now.Year)
                .Sum(o => o.OdenenTutar ?? 0m);
            _buAySonaEren = bolgeKiraSozlesmeler.Count(k =>
                k.SozBitTar.HasValue &&
                k.SozBitTar.Value.Year == now.Year &&
                k.SozBitTar.Value.Month == now.Month);
            _ucAySonaEren = bolgeKiraSozlesmeler.Count(k =>
                k.SozBitTar.HasValue &&
                k.SozBitTar > now &&
                k.SozBitTar <= now.AddMonths(3));

            // Kira yıllık chart (son 5 yıl)
            _kiraYillikItems = Enumerable.Range(now.Year - 4, 5)
                .Select(y => new YearAmount
                {
                    Label = y.ToString(),
                    Amount = bolgeOdemeler
                        .Where(o => o.OdemeTarihi.HasValue && o.OdemeTarihi.Value.Year == y)
                        .Sum(o => o.OdenenTutar ?? 0m)
                })
                .ToList();

            // Taşınmaz bağışçı
            _toplamTasinmazBagisci = tasinmazBagisciSayisi;

            // Nakit bağış
            _toplamNakitBagisci = bolgeBagisciIds.Count;
            _toplamDuzenliNakitBagisci = bolgeArmaganlar
                .Count(a => a.ArmaganTanimId == 9);
            _toplamNakitHareket = bolgeNakitHareketler.Count;
            _buYilNakitToplam = bolgeNakitHareketler
                .Where(h => h.BagisTarihi.HasValue && h.BagisTarihi.Value.Year == now.Year &&
                            (h.IadeEdildiMi != true))
                .Sum(h => h.BagisMiktari ?? 0m);
            _genelNakitToplam = bolgeNakitHareketler
                .Where(h => h.IadeEdildiMi != true)
                .Sum(h => h.BagisMiktari ?? 0m);

            // Nakit yıllık chart (son 5 yıl)
            _nakitYillikItems = Enumerable.Range(now.Year - 4, 5)
                .Select(y => new YearAmount
                {
                    Label = y.ToString(),
                    Amount = bolgeNakitHareketler
                        .Where(h => h.BagisTarihi.HasValue && h.BagisTarihi.Value.Year == y && h.IadeEdildiMi != true)
                        .Sum(h => h.BagisMiktari ?? 0m)
                })
                .ToList();

            // Armağan
            _toplamArmagan = bolgeArmaganlar.Count;
            _armaganTeslimEdilen = bolgeArmaganlar.Count(a =>
                a.Durum != null && a.Durum.Contains("teslim", StringComparison.OrdinalIgnoreCase));
            _armaganBekleyen = _toplamArmagan - _armaganTeslimEdilen;
            _buYilArmagan = bolgeArmaganlar.Count(a => a.Tarih.HasValue && a.Tarih.Value.Year == now.Year);

            // Armağan türleri pie (sadece bu yıl)
            var armaganTanimDict = armaganTanimlar.ToDictionary(t => t.Id, t => t.Armagan ?? "?");
            _armaganTurleriItems = bolgeArmaganlar
                .Where(a => a.ArmaganTanimId.HasValue && a.Tarih.HasValue && a.Tarih.Value.Year == now.Year)
                .GroupBy(a => a.ArmaganTanimId!.Value)
                .Select(g => new PieItem
                {
                    Label = armaganTanimDict.TryGetValue(g.Key, out var ad) ? ad : g.Key.ToString(),
                    Value = g.Count()
                })
                .OrderByDescending(p => p.Value)
                .ToList();

            // FTK
            var fiveYearsAgo = DateTime.Today.AddYears(-5);
            _toplamFtkUye = bolgeFtkler.Count;
            _toplamFtk = bolgeFtkler
                .Where(f => f.Ili.HasValue && f.Ilcesi.HasValue)
                .Select(f => (f.Ili!.Value, f.Ilcesi!.Value))
                .Distinct()
                .Count();
            _ftkBuYilKurulan = bolgeFtkIslemler.Count(i => i.KurulusTarihi.HasValue && i.KurulusTarihi.Value.Year == now.Year);
            _ftkEski = bolgeFtkIslemler.Count(i => i.GuncellemeTarihi.HasValue && i.GuncellemeTarihi < fiveYearsAgo
                                                || !i.GuncellemeTarihi.HasValue);

            // FTK accordion state sıfırla
            _ftkIllerOpen.Clear();

            // FTK satır listesi
            _ftkSatirlari = bolgeFtkler
                .Select(f =>
                {
                    var islem = f.FtkIslemId.HasValue && bolgeFtkIslemler.FirstOrDefault(i => i.Id == f.FtkIslemId.Value) is { } ism ? ism : null;
                    var ilAdi = f.Ili.HasValue && ilDict2.TryGetValue(f.Ili.Value, out var ia) ? ia : "?";
                    var ilceAdi = f.Ilcesi is { } ilceId && ilceId == -1 ? "İl Merkezi" : $"İlçe ({f.Ilcesi})";
                    return new FtkSatir(ilAdi, ilceAdi, $"{f.Adi} {f.Soyadi}".Trim(), f.FtkGorevi, islem?.KurulusTarihi, islem?.GuncellemeTarihi);
                })
                .ToList();

            // Personel
            _toplamPersonel = bolgePersoneller.Count;
            // Cinsiyet bilgisi Kimlik tablosunda; burada IsBilgileri'ne göre değerlendiriyoruz
            // AskerSivil alanından tahmini cinsiyet çıkarma mümkün değil, KimlikService yok
            // Şimdilik 0 gösteriyoruz; ileride KimlikService entegrasyonu eklenebilir
            _erkekPersonel = 0;
            _kadinPersonel = 0;
            _yasOrtalamasi = 0;

            _personelSatirlari = bolgePersoneller
                .Select(p => (ProtokolSiraNo: p.ProtokolSiraNo ?? int.MaxValue, Satir: new PersonelSatir(
                        $"{p.Adi} {p.Soyadi}",
                        p.SicilNo,
                        p.UnvanAdi,
                        p.BirimAdi,
                        p.CalismaDurumu
                    )))
                .OrderBy(x => x.ProtokolSiraNo)
                .Select(x => x.Satir)
                .ToList();
        }
        catch (OperationCanceledException) { /* iptal edildi */ }
        catch (Exception ex)
        {
            Logger.LogError(ex, "BolgeDashboard veri yükleme hatası");
            _loadFailed = true;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // ── Yardımcı ─────────────────────────────────────────────────

    private class PieItem
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
    }

    private class YearAmount
    {
        public int Year { get; set; }
        public string Label { get; set; } = "";
        public decimal Amount { get; set; }
    }

    private static string Percent(int parca, int toplam)
        => toplam == 0 ? "0" : $"{(parca * 100.0 / toplam):N1}";

    private static string NormalizeCins(string kullanimSekli)
    {
        if (kullanimSekli.Contains("İşhanı", StringComparison.OrdinalIgnoreCase) ||
            kullanimSekli.Contains("Apt.", StringComparison.OrdinalIgnoreCase))
            return "Bina";
        return kullanimSekli;
    }

    private string FormatMoney(decimal deger)
    {
        if (deger >= 1_000_000_000) return $"{deger / 1_000_000_000:N2}M₺";
        if (deger >= 1_000_000) return $"{deger / 1_000_000:N1}M₺";
        if (deger >= 1_000) return $"{deger / 1_000:N0}K₺";
        return deger.ToString("N0", _trCulture) + "₺";
    }
}
