                                                            <th>İlçe / Birim</th>
                                                            <th>Ad Soyad</th>
                                                            <th>Görev</th>
                                                            <th style="white-space:nowrap;">Kuruluş</th>
                                                            <th style="white-space:nowrap;">Güncelleme</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var satir in ilGrubu)
                                                        {
                                                            <tr>
                                                                <td>@satir.IlceAdi</td>
                                                                <td>@satir.AdiSoyadi</td>
                                                                <td><span class="badge rounded-pill bg-primary-subtle text-primary-emphasis">@satir.Gorev</span></td>
                                                                <td style="white-space:nowrap;">@(satir.KurulusTarihi?.ToString("dd.MM.yyyy", _trCulture) ?? "-")</td>
                                                                <td style="white-space:nowrap;">
                                                                    @if (satir.GuncellemeTarihi.HasValue)
                                                                    {
                                                                        var yil = (DateTime.Today - satir.GuncellemeTarihi.Value).TotalDays / 365.25;
                                                                        <span class="@(yil >= 5 ? "text-danger fw-semibold" : "")">
                                                                            @satir.GuncellemeTarihi.Value.ToString("dd.MM.yyyy", _trCulture)
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">-</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        <hr class="bd-separator" />
                    </section>

                    <!-- ════════════════════════════════════════════════
                         BÖLÜM 7 – PERSONEL
                    ════════════════════════════════════════════════ -->
                    <section id="bd-personel" class="bd-section">
                        <div class="section-label">Personel</div>
                        <!-- Personel listesi tablosu -->
                        @if (_personelSatirlari.Count > 0)
                        {
                            <div class="card shadow-sm mb-3">
