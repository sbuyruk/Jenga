@page "/Error"
@using System.Diagnostics
@using System.IO
@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment HostEnvironment

<PageTitle>Hata</PageTitle>

<h1 class="text-danger">İşlem tamamlanamadı.</h1>
<p class="lead">İstek işlenirken beklenmeyen bir hata oluştu.</p>

@if (ShowRequestId)
{
    <p>
        <strong>İstek numarası:</strong> <code>@RequestId</code>
    </p>
}

@if (HostEnvironment.IsDevelopment())
{
    <div class="alert alert-warning" role="alert">
        Geliştirme ortamında bu sayfa, hatanın temel nedenini izlemek için ek bilgiler gösterebilir.
        <div class="mt-2 small text-muted">Log dosyası: <code>@TodayLogPath</code></div>
    </div>
}
else
{
    <p class="text-muted">Hata kaydı oluşturuldu. Lütfen birkaç dakika sonra tekrar deneyin veya destek ekibiyle iletişime geçin.</p>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private string TodayLogPath => Path.Combine(Directory.GetCurrentDirectory(), "Logs", $"jenga-{DateTime.Today:yyyy-MM-dd}.log");

    // In local development, logs are written under the current working directory so the project Logs folder is used.

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
