@page "/admin/navigation-summary"
@rendermode InteractiveServer

@using Jenga.BlazorUI.Services.Presence

@inject UserPresenceQueryService PresenceQueryService

<div class="navbar navbar-expand-lg bg-body-tertiary gap-3 mb-3 shadow-sm rounded py-2 px-3" style="min-height:56px;">
    <h3 class="mb-0 flex-grow-1">Kullanıcı Navigasyon Özeti</h3>

    <button class="btn btn-outline-primary" @onclick="@(async () => await RefreshAsync())" disabled="@_isLoading" type="button">
        Yenile
    </button>
</div>

@if (_isLoading)
{
    <div class="text-muted">Yükleniyor...</div>
}
else if (_rows.Count == 0)
{
    <div class="text-muted">Kayıt bulunamadı.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width:120px;">Personel</th>
                    <th class="text-center" style="width:160px;">Navigasyon Sayısı</th>
                    <th>Son URL</th>
                    <th style="width:190px;">Son Hareket</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr style="cursor:pointer;" @onclick="@(() => OpenUserDetailsAsync(r.PersonelId))">
                        <td class="text-center">@r.FullName</td>
                        <td class="text-center">@r.NavigationCount</td>
                        <td style="max-width:720px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                            @r.LastUrl
                        </td>
                        <td>@(r.LastOccurredAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="text-muted">
        Toplam kullanıcı: @_rows.Count
    </div>
}

@if (_isUserModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);" @onclick="CloseUserDetails">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Navigation Detay (PersonelId: @_selectedPersonelId)</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseUserDetails"></button>
                </div>

                <div class="modal-body">
                    @if (_isUserModalLoading)
                    {
                        <div class="text-muted">Yükleniyor...</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_userModalError))
                    {
                        <div class="text-danger">@_userModalError</div>
                    }
                    else if (_userEvents.Count == 0)
                    {
                        <div class="text-muted">Kayıt bulunamadı.</div>
                    }
                    else
                    {
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:190px;">Occurred</th>
                                    <th style="width:120px;">SessionId</th>
                                    <th>Url</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in _userEvents)
                                {
                                    <tr>
                                        <td>@e.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td class="text-center">@e.PresenceSessionId</td>
                                        <td style="max-width:720px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                            @e.Url
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseUserDetails">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private List<UserPresenceQueryService.UserNavigationSummaryItem> _rows = new();

    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCts;
    private Task? _refreshLoop;

    private bool _isUserModalOpen;
    private bool _isUserModalLoading;
    private string? _userModalError;
    private int _selectedPersonelId;
    private List<UserPresenceQueryService.UserNavigationHistoryItem> _userEvents = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        StartAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        _refreshTimer?.Dispose();

        _refreshCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));

        _refreshLoop = RunRefreshLoopAsync(_refreshCts.Token);
    }

    private async Task RunRefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (_refreshTimer != null && await _refreshTimer.WaitForNextTickAsync(token))
            {
                await RefreshAsync(silent: true);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshAsync(bool silent = false)
    {
        if (!silent)
            _isLoading = true;

        try
        {
            _rows = await PresenceQueryService.GetUserNavigationSummaryAsync();
        }
        finally
        {
            if (!silent)
                _isLoading = false;
        }
    }

    private async Task OpenUserDetailsAsync(int personelId)
    {
        _selectedPersonelId = personelId;
        _isUserModalOpen = true;
        _isUserModalLoading = true;
        _userModalError = null;
        _userEvents = new();

        try
        {
            _userEvents = await PresenceQueryService.GetUserNavigationHistoryByPersonelAsync(personelId, take: 500);
        }
        catch (Exception ex)
        {
            _userModalError = ex.Message;
        }
        finally
        {
            _isUserModalLoading = false;
        }
    }

    private void CloseUserDetails()
    {
        _isUserModalOpen = false;
    }

    public void Dispose()
    {
        _refreshCts?.Cancel();
        _refreshTimer?.Dispose();
        _refreshCts?.Dispose();
    }
}
