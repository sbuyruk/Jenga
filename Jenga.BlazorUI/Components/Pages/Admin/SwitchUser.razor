@page "/admin/switch-user"
@rendermode InteractiveServer
@using Jenga.BlazorUI.Services.Common
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject ImpersonationPolicy ImpersonationPolicy

<div class="container" style="max-width:480px; margin-top:2rem;">
    <div class="card shadow-sm">
        <div class="card-header bg-warning-subtle">
            <h5 class="mb-0"><i class="bi bi-person-fill-gear me-2"></i>Kullanıcı Değiştir (Test)</h5>
        </div>
        <div class="card-body">
            @if (!_ready)
            {
                <p>Test erişimi denetleniyor...</p>
            }
            else
            {
                @if (!_canSwitch)
                {
                    <div class="alert alert-warning" role="alert">@_accessMessage</div>
                }
                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="alert alert-info">@_message</div>
                }

                <div class="mb-3">
                    <label class="form-label fw-semibold">Aktif Kullanici</label>
                    <div class="form-control-plaintext text-muted">@(_activeUser ?? "---")</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Yeni Kullanici Adi</label>
                    <input class="form-control" @bind="_username" disabled="@(!_canSwitch || _busy)" placeholder="Kullanici adi girin..." />
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SwitchAsync" disabled="@(!_canSwitch || _busy)">
                        <i class="bi bi-arrow-left-right me-1"></i>Degistir
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ClearAsync" disabled="@_busy">
                        <i class="bi bi-x-circle me-1"></i>Sifirla (Gercek Kullanici)
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string? _username;
    private string? _activeUser;
    private string? _message;
    private bool _ready;
    private bool _canSwitch;
    private bool _busy;
    private string? _accessMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _canSwitch = await CurrentUserService.CanImpersonateAsync();
        UpdateAccessMessage();
        var personel = await CurrentUserService.GetCurrentPersonelAsync();
        _activeUser = personel?.KullaniciAdi ?? "---";
        _ready = true;
        StateHasChanged();
    }

    private async Task SwitchAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_username)) return;
        _busy = true;
        try
        {
            if (await CurrentUserService.SetImpersonationOverrideAsync(_username.Trim()))
                NavigationManager.NavigateTo("/", forceLoad: true);
            else
            {
                _canSwitch = await CurrentUserService.CanImpersonateAsync();
                UpdateAccessMessage();
                _message = "Kullanıcı değiştirilemedi. Kullanıcı adını, gerçek hesabınızın yetkisini ve test erişiminin süresini kontrol edin.";
            }
        }
        finally { _busy = false; }
    }

    private async Task ClearAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await CurrentUserService.SetImpersonationOverrideAsync(null);
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        finally { _busy = false; }
    }

    private void UpdateAccessMessage()
        => _accessMessage = ImpersonationPolicy.GetDisabledReasonAt(DateTimeOffset.UtcNow)
            ?? "Gerçek oturum hesabınızın Admin / Manage yetkisi yok. Sistem yöneticisi rolünüzde bu iznin tanımlı olduğunu kontrol edin.";
}
