    private void PrepareMonthlyCards(int monthCount)
    {
        monthlyCards.Clear();

        if (nakitBagislarLastYears == null || nakitBagislarLastYears.Count == 0)
        {
            return;
        }

        var now = DateTime.Now;
        var startMonth = new DateTime(now.Year, now.Month, 1).AddMonths(-(monthCount - 1));

        var items = nakitBagislarLastYears
            .Where(x => x?.BagisTarihi != null)
            .Select(x => x!)
            .ToList();

        var firstDonationDateByDonor = items
            .Where(x => x.BagisciId != null && x.BagisTarihi != null)
            .GroupBy(x => x.BagisciId!.Value)
            .ToDictionary(
                g => g.Key,
                g => g.Min(v => v.BagisTarihi!.Value));

        for (var m = 0; m < monthCount; m++)
        {
            var monthStart = startMonth.AddMonths(m);
            var year = monthStart.Year;
            var month = monthStart.Month;

            var monthItems = items
                .Where(x => x.BagisTarihi!.Value.Year == year && x.BagisTarihi!.Value.Month == month)
                .ToList();

            var totalAmount = monthItems.Sum(x => x.BagisMiktari) ?? 0m;

            var totalDonorCount = monthItems
                .Where(x => x.BagisciId != null)
                .Select(x => x.BagisciId!.Value)
                .Distinct()
                .Count();

            var firstTimeDonorCount = monthItems
                .Where(x => x.BagisciId != null)
                .Select(x => x.BagisciId!.Value)
                .Distinct()
                .Count(donorId =>
                    firstDonationDateByDonor.TryGetValue(donorId, out var firstDate)
                    && firstDate.Year == year
                    && firstDate.Month == month);

            monthlyCards.Add(new MonthlyNakitBagisCardVM
            {
                Year = year,
                Month = month,
                TotalDonationAmount = totalAmount,
                TotalDonorCount = totalDonorCount,
                FirstTimeDonorCount = firstTimeDonorCount
            });
        }

        monthlyCards.Sort((a, b) => (b.Year, b.Month).CompareTo((a.Year, a.Month)));
    }

    private void PrepareCurrentYearProvinceMonthlyDonorTable()
    {
        currentYearProvinceMonthlyRows.Clear();

        if (nakitBagislarSince == null || nakitBagislarSince.Count == 0)
        {
            return;
        }

        var now = DateTime.Now;
        var yearNow = now.Year;

        var items = nakitBagislarSince
            .Where(x => x?.BagisTarihi != null
                        && x.BagisTarihi.Value.Year == yearNow
                        && x.BagisciId != null)
            .Select(x => x!)
            .ToList();

        if (items.Count == 0)
        {
            return;
        }

        var currentYearDonorFirstDonationDate = nakitBagislarSince
            .Where(x => x?.BagisTarihi != null && x.BagisciId != null)
            .Select(x => x!)
            .GroupBy(x => x.BagisciId!.Value)
            .Select(g => new { DonorId = g.Key, FirstDonationDate = g.Min(v => v.BagisTarihi!.Value) })
            .Where(x => x.FirstDonationDate.Year == yearNow)
            .ToDictionary(x => x.DonorId, x => x.FirstDonationDate);

        var provinceIds = items
            .Select(x => x.BagisciId!.Value)
            .Distinct()
            .Select(donorId =>
            {
                _donorProvinceIdByDonorId.TryGetValue(donorId, out var provinceId);
                return provinceId;
            })
            .Where(provinceId => provinceId != null)
            .Select(provinceId => provinceId!.Value)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        foreach (var provinceId in provinceIds)
        {
            var provinceName =
                _ilNameById.TryGetValue(provinceId, out var name) && !string.IsNullOrWhiteSpace(name)
                    ? name
                    : provinceId.ToString(_trCulture);

            for (var month = 1; month <= 12; month++)
            {
                var monthItems = items
                    .Where(x => x.BagisTarihi != null
                                && x.BagisTarihi.Value.Month == month
                                && x.BagisciId != null
                                && _donorProvinceIdByDonorId.TryGetValue(x.BagisciId.Value, out var donorProvinceId)
                                && donorProvinceId == provinceId)
                    .ToList();

                if (monthItems.Count == 0)
                {
                    continue;
                }

                var donorIds = monthItems
                    .Select(x => x.BagisciId!.Value)
                    .Distinct()
                    .ToList();

                var donorCount = donorIds.Count;

                var newDonorCount = donorIds.Count(donorId =>
                    currentYearDonorFirstDonationDate.TryGetValue(donorId, out var firstDonationDate)
                    && firstDonationDate.Month == month);

                currentYearProvinceMonthlyRows.Add(new ProvinceMonthlyDonorRow
                {
                    ProvinceId = provinceId,
                    ProvinceName = provinceName,
                    Month = month,
                    MonthLabel = new DateTime(2000, month, 1).ToString("MMMM", _trCulture),
                    DonorCount = donorCount,
                    NewDonorCount = newDonorCount
                });
            }
        }

        currentYearProvinceMonthlyRows.Sort((a, b) =>
        {
            var cmp = string.Compare(a.ProvinceName, b.ProvinceName, StringComparison.CurrentCulture);
            if (cmp != 0) return cmp;

            return a.Month.CompareTo(b.Month);
        });

        ApplyProvinceRowSpans(currentYearProvinceMonthlyRows);
    }

    private static void ApplyProvinceRowSpans(List<ProvinceMonthlyDonorRow> rows)
    {
        if (rows.Count == 0)
        {
            return;
        }

        for (var i = 0; i < rows.Count; i++)
        {
            rows[i].IsProvinceFirstRow = false;
            rows[i].ProvinceRowSpan = 0;
        }

        var index = 0;
        while (index < rows.Count)
        {
            var provinceId = rows[index].ProvinceId;

            var start = index;
            while (index < rows.Count && rows[index].ProvinceId == provinceId)
            {
                index++;
            }

            var span = index - start;
            rows[start].IsProvinceFirstRow = true;
            rows[start].ProvinceRowSpan = span;
        }
    }

