    // ── Yaşam döngüsü ──────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var minTarih = new DateTime(2005, 1, 1);
        _armaganlar = (await ArmaganService.GetAllAsync())
            .Where(a => a.Tarih.HasValue && a.Tarih.Value >= minTarih)
            .ToList();
        int currentYear = DateTime.Now.Year;
        int previousYear = DateTime.Now.AddYears(-1).Year;

        _buYilArmaganSayisi = _armaganlar.Count(a => a.Tarih.HasValue && a.Tarih.Value.Year == currentYear);
        _gecenYilArmaganSayisi = _armaganlar.Count(a => a.Tarih.HasValue && a.Tarih.Value.Year == previousYear);

        _buYilAltinSayisi    = _armaganlar.Count(a => a.ArmaganTanimId == 4 && a.Tarih.HasValue && a.Tarih.Value.Year == currentYear);
        _buYilGumusSayisi    = _armaganlar.Count(a => a.ArmaganTanimId == 3 && a.Tarih.HasValue && a.Tarih.Value.Year == currentYear);
        _buYilBronzSayisi    = _armaganlar.Count(a => a.ArmaganTanimId == 2 && a.Tarih.HasValue && a.Tarih.Value.Year == currentYear);
        _buYilTesekkurSayisi = _armaganlar.Count(a => a.ArmaganTanimId == 1 && a.Tarih.HasValue && a.Tarih.Value.Year == currentYear);
        _buYilDuzenliBagisciSayisi = _armaganlar.Count(a => a.ArmaganTanimId == 9 && a.Tarih.HasValue && a.Tarih.Value.Year == currentYear);
       
        _gecenYilAltinSayisi    = _armaganlar.Count(a => a.ArmaganTanimId == 4 && a.Tarih.HasValue && a.Tarih.Value.Year == previousYear);
        _gecenYilGumusSayisi    = _armaganlar.Count(a => a.ArmaganTanimId == 3 && a.Tarih.HasValue && a.Tarih.Value.Year == previousYear);
        _gecenYilBronzSayisi    = _armaganlar.Count(a => a.ArmaganTanimId == 2 && a.Tarih.HasValue && a.Tarih.Value.Year == previousYear);
        _gecenYilTesekkurSayisi = _armaganlar.Count(a => a.ArmaganTanimId == 1 && a.Tarih.HasValue && a.Tarih.Value.Year == previousYear);
        _gecenYilDuzenliBagisciSayisi = _armaganlar.Count(a => a.ArmaganTanimId == 9 && a.Tarih.HasValue && a.Tarih.Value.Year == previousYear);

        var bagisList = await BagisService.GetAllAsync();
        _buYilTasinmazArmaganSayisi   = bagisList.Count(b => b.ArmaganTarihi.HasValue && b.ArmaganTarihi.Value.Year == currentYear  && b.BagisciId.HasValue);
        _gecenYilTasinmazArmaganSayisi = bagisList.Count(b => b.ArmaganTarihi.HasValue && b.ArmaganTarihi.Value.Year == previousYear && b.BagisciId.HasValue);

        var armaganTanimlar = await ArmaganTanimService.GetAllAsync();
        _armaganTanimTickerItems = armaganTanimlar
            .Where(t => t.Id is >= 1 and <= 3)
            .OrderByDescending(t => t.Id)
            .Select(t =>
                $"{t.Armagan} belgesi, ₺{(t.OzelKisiAltLimit ?? 0).ToString("N0", _trCulture)}" +
                $" ile ₺{(t.OzelKisiUstLimit ?? 0).ToString("N0", _trCulture)} arasında bağış yapan bağışçılarımıza verilmektedir.")
            .ToList();

        TickerText1 = armaganTanimlar
            .Where(t => t.Id == 4)
            .Select(t =>
                $"{t.Armagan} belgesi, ₺{(t.OzelKisiAltLimit ?? 0).ToString("N0", _trCulture)}" +
                $" ve üzerinde bağış yapan bağışçılarımıza verilmektedir.")
            .FirstOrDefault() ?? "";

        // Armağan Türlerine Göre Dağılım – gerçek veri
        var aktifTanimIdler = armaganTanimlar
            .Where(t => t.Aktif == true)
            .Select(t => t.Id)
            .ToHashSet();

        var turGruplari = _armaganlar
            .Where(a => a.ArmaganTanimId.HasValue
                     && aktifTanimIdler.Contains(a.ArmaganTanimId!.Value)
                     && a.Tarih.HasValue && a.Tarih.Value.Year == currentYear)
            .GroupBy(a => a.ArmaganTanimId!.Value)
            .Select(g =>
            {
                var tanim = armaganTanimlar.FirstOrDefault(t => t.Id == g.Key);
                return new ArmaganTurDetay
                {
                    Adi      = tanim?.Armagan ?? $"Tür #{g.Key}",
                    Adet     = g.Count(),
                    OrtTutar = g.Any(a => a.BagisMiktari.HasValue)
                                 ? g.Where(a => a.BagisMiktari.HasValue).Average(a => a.BagisMiktari!.Value)
                                 : 0m
                };
            })
            .OrderByDescending(t => t.Adet)
            .ToList();
        _armaganTurleriDetay.AddRange(turGruplari);
        _armaganTurleriItems.AddRange(turGruplari.Select(t => new PieItem { Label = t.Adi, Value = t.Adet }));

        // Aylık Dağılım – gerçek veri (türe göre adet)
        var ayAdlari = new[] { "Oca", "Şub", "Mar", "Nis", "May", "Haz", "Tem", "Ağu", "Eyl", "Eki", "Kas", "Ara" };
        foreach (var tanim in armaganTanimlar.Where(t => t.Aktif == true).OrderBy(t => t.Id ).ThenBy(t => t.Id))
        {
            var aylikSayilar = _armaganlar
                .Where(a => a.ArmaganTanimId == tanim.Id && a.Tarih.HasValue && a.Tarih.Value.Year == currentYear)
                .GroupBy(a => a.Tarih!.Value.Month)
                .ToDictionary(g => g.Key, g => (decimal)g.Count());
            var ayItems = Enumerable.Range(1, 12)
                .Select(m => new MonthlyAmount { Month = m, Label = ayAdlari[m - 1], Amount = aylikSayilar.TryGetValue(m, out var cnt) ? cnt : 0m })
                .ToList();
            _aylikTurSeries.Add(new GenericChart<MonthlyAmount>.GenericSeries(tanim.Armagan ?? $"Tür #{tanim.Id}", ayItems));
        }

        // Durum Dağılımı – gerçek veri
        _durumDagilimItems.AddRange(
            _armaganlar
                .Where(a => a.Tarih.HasValue && a.Tarih.Value.Year == currentYear && !string.IsNullOrWhiteSpace(a.Durum))
                .GroupBy(a => a.Durum switch
                {
                    "Erken Gönderildi"             => "Gönderildi",
                    "Gönderilmedi"                 => "Hazırlık Aşamasında",
                    _                              => a.Durum!
                })
                .Select(g => new PieItem { Label = g.Key, Value = g.Count() })
                .OrderByDescending(p => p.Value));

        // Son 5 Yıl Trendi – gerçek veri (türe göre adet)
        var son5Yil = Enumerable.Range(currentYear - 4, 5).ToArray();
        foreach (var tanim in armaganTanimlar.Where(t => t.Aktif == true).OrderBy(t => t.Id))
        {
            var yillikSayilar = _armaganlar
                .Where(a => a.ArmaganTanimId == tanim.Id && a.Tarih.HasValue && son5Yil.Contains(a.Tarih.Value.Year))
                .GroupBy(a => a.Tarih!.Value.Year)
                .ToDictionary(g => g.Key, g => (decimal)g.Count());
            var yilItems = son5Yil
                .Select(y => new YearlyAmount { Year = y, Label = y.ToString(), Amount = yillikSayilar.TryGetValue(y, out var cnt) ? cnt : 0m })
                .ToList();
            _son5YilSeries.Add(new GenericChart<YearlyAmount>.GenericSeries(tanim.Armagan ?? $"Tür #{tanim.Id}", yilItems));
        }

        // Son Armağanlar – gerçek veri
        var tanimAdi = armaganTanimlar.ToDictionary(t => t.Id, t => t.Armagan ?? $"Tür #{t.Id}");
        var bagiscilar = await NakitBagisciService.GetAllAsync();
        var bagisciDict = bagiscilar.ToDictionary(b => b.Id);
        var iller = await IlService.GetAllAsync();
        var ilDict = iller.ToDictionary(i => i.Id);
        var bolgeler = await BolgeService.GetAllAsync();
        var bolgeDict = bolgeler.ToDictionary(b => b.Id);
        _sonArmaganlar.AddRange(
            _armaganlar
                .Where(a => a.Tarih.HasValue && a.Tarih.Value >= DateTime.Today.AddMonths(-3))
                .OrderByDescending(a => a.Tarih)
                .Select(a =>
                {
                    var bagisciAdi = "-";
                    var ilAdi = "-";
                    var bolgeAdi = "-";
                    if (a.BagisciId.HasValue && bagisciDict.TryGetValue(a.BagisciId.Value, out var b))
                    {
                        bagisciAdi = $"{b.Adi} {b.Soyadi}".Trim();
                        if (b.Ili.HasValue && ilDict.TryGetValue(b.Ili.Value, out var il))
                        {
                            ilAdi = il.IlAdi ?? "-";
                            if (il.BolgeId.HasValue && bolgeDict.TryGetValue(il.BolgeId.Value, out var bolge))
                                bolgeAdi = bolge.Adi;
                        }
                    }
                    else if (!string.IsNullOrWhiteSpace(a.BelgedeYazanIsim))
                        bagisciAdi = a.BelgedeYazanIsim;
                    return new SonArmaganRow
                    {
                        Tarih        = a.Tarih!.Value,
                        BagisciAdi   = bagisciAdi,
                        IlAdi        = ilAdi,
                        BolgeAdi     = bolgeAdi,
                        ArmaganTur   = a.ArmaganTanimId.HasValue && tanimAdi.TryGetValue(a.ArmaganTanimId.Value, out var ad) ? ad : "-",
                        Tutar        = a.BagisMiktari ?? 0m,
                        Doviz        = a.DovizCinsi ?? "TRY",
                        Durum        = a.Durum ?? "-",
                        DuzenliBagis = a.DuzenliBagis ?? false,
                        CokluBagis = a.CokluBagis ?? false
                    };
                }));

        // Ay filtreleri
        _ayFiltreler = Enumerable.Range(0, 3)
            .Select(i => DateTime.Today.AddMonths(-i))
            .Select(d => (d.Year, d.Month, Label: $"{_trCulture.DateTimeFormat.GetAbbreviatedMonthName(d.Month)} {d.Year}"))
            .ToList();
        _secilenAy = (_ayFiltreler[0].Year, _ayFiltreler[0].Month);
        _bolgeFiltreler = _sonArmaganlar
            .Select(a => a.BolgeAdi)
            .Where(b => b != "-")
            .Distinct()
            .OrderBy(b => b)
            .ToList();
        ApplyFilters();

        // Ticker
        TickerText2 = $"Bu yıl {_buYilArmaganSayisi:N0} adet bağışçımıza armağan belgeleri verilmiştir.";
        TickerText3 = $"Verilen armağanların {_buYilAltinSayisi:N0} adedi Altın, {_buYilGumusSayisi:N0} adedi Gümüş, {_buYilBronzSayisi:N0} adedi Bronz, {_buYilTesekkurSayisi:N0} adedi Teşekkür şeklinde gerçekleşmiştir. Ayrıca {_buYilDuzenliBagisciSayisi:N0} adet düzenli bağışçıya belgeleri verilmiştir.";

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollSpyInitialized || isLoading)
            return;

        _scrollSpyInitialized = true;
        await JS.InvokeVoidAsync("initScrollSpy", "armagan-scrollspy-content", "armagan-scrollspy-nav", 12);
    }

    private Task ScrollToAsync(string sectionId)
        => JS.InvokeVoidAsync("scrollSpyScrollTo", "armagan-scrollspy-content", sectionId).AsTask();

    // ── Yardımcı metodlar ─────────────────────────────
    private static string GetDurumBadgeClass(string durum) => durum switch
    {
        "Gönderildi"                       => "bg-success",
        "E-Devletten Belge Gönderildi"     => "bg-success",
        "Erken Gönderildi"                 => "bg-success",
        "Kontrol Edildi"                   => "bg-primary",
        "Kontol Edildi"                    => "bg-primary",
        "Ertelendi"                        => "bg-warning text-dark",
        "Ulasilamadi"                      => "bg-warning text-dark",
        "Iade Edildi"                      => "bg-danger",
        "Parasi Iade Edildi"               => "bg-danger",
        "Daha Önce Belgesi Iade Edildi"    => "bg-danger",
        "Afet Nedeniyle Gönderilmedi"      => "bg-secondary",
        "Gönderilmedi"                     => "bg-info",
        "Belge Istemiyor"                  => "bg-secondary",
        _                                  => "bg-secondary"
    };

    private void SortByArmaganField(string field) => _sonArmaganlarTable?.SortBy(field);

    private string GetArmaganSortIcon(string field)
    {
        if (_sonArmaganlarTable?.CurrentSortField != field)
            return "bi bi-arrow-down-up ms-2 text-muted";
        return _sonArmaganlarTable.CurrentSortDescending
            ? "bi bi-caret-down-fill ms-2"
            : "bi bi-caret-up-fill ms-2";
    }

    private void SelectMonth(int year, int month)
    {
        _secilenAy = (year, month);
        ApplyFilters();
    }

    private void SelectBolge(string? bolge)
    {
        _secilenBolge = bolge;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _sonArmaganlarFiltered = _sonArmaganlar
            .Where(a => a.Tarih.Year == _secilenAy.Year && a.Tarih.Month == _secilenAy.Month)
            .Where(a => _secilenBolge == null || a.BolgeAdi == _secilenBolge)
            .ToList();
    }

    private static string GetDovizBadgeClass(string doviz) => doviz switch
    {
        "TRY" => "bg-danger",
        "USD" => "bg-dark",
        "EUR" => "bg-info text-dark",
        "GBP" => "bg-secondary",
        _     => "bg-light text-dark"
    };

    // ── İç DTO sınıfları ──────────────────────────────
    private class PieItem
    {
        public string Label  { get; set; } = "";
        public decimal Value { get; set; }
    }

    private class MonthlyAmount
    {
        public int     Month  { get; set; }
        public string  Label  { get; set; } = "";
        public decimal Amount { get; set; }
    }

    private class YearlyAmount
    {
        public int     Year   { get; set; }
        public string  Label  { get; set; } = "";
        public decimal Amount { get; set; }
    }

    private class ArmaganTurDetay
    {
        public string  Adi      { get; set; } = "";
        public int     Adet     { get; set; }
        public decimal OrtTutar { get; set; }
    }

    private class TopDonorRow
    {
        public string   BagisciAdi   { get; set; } = "";
        public bool     TuzelKisi    { get; set; }
        public int      ArmaganAdedi { get; set; }
        public decimal  ToplamTutar  { get; set; }
        public DateTime SonArmagan   { get; set; }
    }

    private class SonArmaganRow
    {
        public DateTime Tarih       { get; set; }
        public string   BagisciAdi  { get; set; } = "";
        public string   IlAdi       { get; set; } = "";
        public string   BolgeAdi    { get; set; } = "";
        public string   ArmaganTur  { get; set; } = "";
        public decimal  Tutar       { get; set; }
        public string   Doviz       { get; set; } = "";
        public string   Durum       { get; set; } = "";
        public bool     DuzenliBagis { get; set; }
        public bool     CokluBagis { get; set; }
    }
}
