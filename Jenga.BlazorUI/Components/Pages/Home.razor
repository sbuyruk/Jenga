@page "/"
@rendermode InteractiveServer
@using Jenga.BlazorUI.Services.Common
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Nav

<div class="home-hero">

    @* ── Karşılama Başlığı ── *@
    <div class="home-hero__header">
        <h1 class="home-hero__title">Jenga Yönetim Platformu</h1>
        <p class="home-hero__subtitle">
            Hoş geldiniz@(_adSoyad != null ? $", {_adSoyad}" : "")!
            Sol menüden bir modül seçerek çalışmaya başlayabilirsiniz.
        </p>
    </div>

    @* ── Global Arama Kutusu ── *@
    <div style="display:flex; flex-direction:column; align-items:center; margin: 1.5rem auto 2rem; width:100%; max-width:720px; padding: 0 1rem;">
        <div style="display:flex; align-items:center; width:100%; background:var(--bs-body-bg,#fff); border:2.5px solid @(_searchFocused ? "#0d6efd" : "#ced4da"); border-radius:50px; padding:.65rem 1.25rem; gap:.5rem; box-shadow: 0 4px 20px rgba(13,110,253,.09); transition: border-color .2s, box-shadow .2s;">
            <i class="bi bi-search" style="color:#6c757d; font-size:1.2rem; flex-shrink:0;"></i>
            <input type="text"
                   style="flex:1; border:none; outline:none; background:transparent; font-size:1.15rem; color:var(--bs-body-color,#212529); min-width:0;"
                   placeholder="Taşınmaz, kiracı, bağışçı, personel ara..."
                   value="@_searchQuery"
                   @oninput="e => _searchQuery = e.Value?.ToString() ?? string.Empty"
                   @onfocus="() => _searchFocused = true"
                   @onblur="() => _searchFocused = false"
                   @onkeydown="OnSearchKeyDown"
                   autocomplete="off"
                   spellcheck="false" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button style="background:none; border:none; cursor:pointer; color:#6c757d; padding:0 .25rem; font-size:.9rem; flex-shrink:0;" @onclick="() => _searchQuery = string.Empty" title="Temizle">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
            <button style="background:#0d6efd; border:none; color:#fff; border-radius:999px; width:2.2rem; height:2.2rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; cursor:pointer;" @onclick="GoSearch" title="Ara">
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>
        <p style="margin-top:.4rem; font-size:.78rem; color:#adb5bd;">Enter veya → ile arayın</p>
    </div>

    @* ── Hızlı Erişim Kartları ── *@
    <div class="home-hero__cards">

        <div class="home-card home-card--blue">
            <i class="bi bi-award-fill home-card__icon"></i>
            <div class="home-card__title">Armağan</div>
            <div class="home-card__desc">Armağan yönetimi ve istatistikleri</div>
        </div>

        <div class="home-card home-card--green">
            <i class="bi bi-people-fill home-card__icon"></i>
            <div class="home-card__title">NBYS</div>
            <div class="home-card__desc">Nakdi bağış yönetim sistemi</div>
        </div>

        <div class="home-card home-card--purple">
            <i class="bi bi-house-fill home-card__icon"></i>
            <div class="home-card__title">TBYS</div>
            <div class="home-card__desc">Taşınmaz bağış yönetim sistemi</div>
        </div>

        <div class="home-card home-card--amber">
            <i class="bi bi-bar-chart-fill home-card__icon"></i>
            <div class="home-card__title">Raporlar</div>
            <div class="home-card__desc">İstatistik ve analiz raporları</div>
        </div>

    </div>

    @* ── Bilgi Kutusu ── *@
    <div class="home-hero__info">
        <i class="bi bi-info-circle-fill me-2 text-primary"></i>
        <span>Daha fazla modüle erişmek için sol taraftaki menüyü kullanabilirsiniz.</span>
    </div>

</div>

@code {
    private string? _adSoyad;
    private string _searchQuery = string.Empty;
    private bool _searchFocused;

    protected override async Task OnInitializedAsync()
    {
        var personel = await CurrentUserService.GetCurrentPersonelAsync();
        if (personel != null)
            _adSoyad = $"{personel.Adi} {personel.Soyadi}".Trim();
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") GoSearch();
    }

    private void GoSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery)) return;
        Nav.NavigateTo($"/arama?q={Uri.EscapeDataString(_searchQuery.Trim())}");
    }
}