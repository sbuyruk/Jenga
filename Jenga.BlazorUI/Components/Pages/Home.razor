@page "/"
@page "/home"
@rendermode InteractiveServer
@using Jenga.BlazorUI.Services.Common
@inject ICurrentUserService CurrentUserService

<div class="workspace-shell">
    <header class="workspace-topbar">
        <div class="workspace-brand">
            <div class="workspace-brand__mark">J</div>
            <span>Jenga Workspace</span>
        </div>

        <div class="workspace-actions">
            <button class="btn btn-light">Bildirimler</button>
            <button class="btn btn-primary">İzin Talebi</button>
        </div>
    </header>

    <section class="workspace-hero">
        <div class="workspace-hero__content">
            <h1>Merhaba, @DisplayName</h1>
            <p>
                Bugün @(_tasks.Count(t => t.State == "waiting" || t.State == "inprogress")) göreviniz,
                @(_pendingApprovals) onay bekleyen iş akışınız ve 1 kritik uyarınız var.
            </p>
        </div>

        <div class="workspace-hero__meta">
            <div class="workspace-pill">
                <small>Departman</small>
                <strong>Operasyon</strong>
            </div>
            <div class="workspace-pill">
                <small>Pozisyon</small>
                <strong>Uzman</strong>
            </div>
            <div class="workspace-pill">
                <small>Yönetici</small>
                <strong>Elif K.</strong>
            </div>
        </div>
    </section>

    <section class="workspace-stats">
        @foreach (var metric in _metrics)
        {
            <div class="workspace-card summary-card">
                <div class="summary-card__top">
                    <div>
                        <p>@metric.Title</p>
                        <h3>@metric.Value</h3>
                    </div>
                    <div class="summary-card__icon" style="background:@metric.IconBackground;color:@metric.IconColor;">@metric.Icon</div>
                </div>
                <div class="metric-trend" style="background:@metric.TrendBackground;color:@metric.TrendColor;">@metric.Trend</div>
                <p class="summary-card__meta">@metric.SubText</p>
            </div>
        }
    </section>

    <section class="workspace-grid">
        <article class="workspace-card">
            <div class="workspace-card__header">
                <h3>Personel Bilgileri</h3>
                <a href="#">Detay</a>
            </div>

            <div class="profile-list">
                <div class="profile-row">
                    <span class="label">Ad Soyad</span>
                    <span class="value">@DisplayName</span>
                </div>
                <div class="profile-row">
                    <span class="label">İşe Giriş</span>
                    <span class="value">12.02.2021</span>
                </div>
                <div class="profile-row">
                    <span class="label">Çalışma Şekli</span>
                    <span class="value">Tam Zamanlı</span>
                </div>
                <div class="profile-row">
                    <span class="label">Lokasyon</span>
                    <span class="value">İstanbul</span>
                </div>
                <div class="profile-row">
                    <span class="label">E-posta</span>
                    <span class="value">ahmet.yilmaz@jenga.local</span>
                </div>
            </div>
        </article>

        <article class="workspace-card">
            <div class="workspace-card__header">
                <h3>Görevler</h3>
                <a href="/ikys/task-approvals">Tümünü gör</a>
            </div>

            <div class="task-list">
                @foreach (var task in _tasks)
                {
                    <div class="task-item">
                        <span class="task-dot @GetTaskDotClass(task.State)"></span>
                        <div class="task-item__body">
                            <strong>@task.Title</strong>
                            <small>@task.Description</small>
                        </div>
                        <span class="badge @GetBadgeClass(task.State)">@task.StateText</span>
                    </div>
                }
            </div>
        </article>

        <article class="workspace-card">
            <div class="workspace-card__header">
                <h3>İzin Bilgileri</h3>
                <a href="#">Rapor</a>
            </div>

            <div class="leave-box">
                <div class="leave-row">
                    <span>Toplam</span>
                    <strong>20 gün</strong>
                </div>
                <div class="leave-row">
                    <span>Kullanılan</span>
                    <strong>6 gün</strong>
                </div>
                <div class="leave-row">
                    <span>Kalan</span>
                    <strong>14 gün</strong>
                </div>

                <div class="leave-progress">
                    <div class="leave-progress__label">
                        <small>Kullanım oranı</small>
                        <strong>30%</strong>
                    </div>
                    <div class="progress-bar">
                        <span style="width:30%;"></span>
                    </div>
                </div>
            </div>
        </article>
    </section>

    <section class="workspace-bottom">
        <article class="workspace-card workspace-card--wide">
            <div class="workspace-card__header">
                <h3>Malzeme Zimeti</h3>
                <a href="#">Tüm zimmetler</a>
            </div>

            <table class="material-table">
                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th>Seri No</th>
                        <th>Durum</th>
                        <th>Lokasyon</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _materials)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Serial</td>
                            <td><span class="status @GetStatusClass(item.Status)">@item.StatusText</span></td>
                            <td>@item.Location</td>
                        </tr>
                    }
                </tbody>
            </table>
        </article>

        <article class="workspace-card">
            <div class="workspace-card__header">
                <h3>Son Etkinlikler</h3>
                <a href="#">Hepsi</a>
            </div>

            <div class="activity-list">
                @foreach (var activity in _activities)
                {
                    <div class="activity-item">
                        <div class="activity-icon" style="background:@activity.IconBackground;color:@activity.IconColor;">@activity.Icon</div>
                        <div>
                            <strong>@activity.Title</strong>
                            <small>@activity.Time</small>
                        </div>
                    </div>
                }
            </div>
        </article>
    </section>
</div>

<style>
    .workspace-shell {
        max-width: 1440px;
        margin: 28px auto;
        padding: 0 20px 24px;
    }

    .workspace-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 22px;
        background: rgba(255,255,255,0.82);
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15,23,42,.08);
        backdrop-filter: blur(8px);
    }

    .workspace-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .workspace-brand__mark {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: linear-gradient(135deg, #1d4ed8, #60a5fa);
        color: #fff;
        display: grid;
        place-items: center;
        font-size: 1.2rem;
    }

    .workspace-actions {
        display: flex;
        gap: 10px;
    }

    .workspace-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        margin-top: 24px;
        padding: 28px;
        border-radius: 26px;
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 10px 24px rgba(15,23,42,.12);
    }

    .workspace-hero__content h1 {
        margin: 0 0 10px;
        font-size: clamp(1.7rem, 3vw, 2.6rem);
        line-height: 1.2;
    }

    .workspace-hero__content p {
        margin: 0;
        opacity: .9;
        font-size: 1rem;
    }

    .workspace-hero__meta {
        display: flex;
        gap: 20px;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .workspace-pill {
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 12px;
        padding: 10px 14px;
        min-width: 120px;
    }

    .workspace-pill small {
        display: block;
        opacity: .8;
        margin-bottom: 6px;
        font-size: .72rem;
    }

    .workspace-pill strong {
        font-size: 1.05rem;
    }

    .workspace-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(220px, 1fr));
        gap: 18px;
        margin-top: 24px;
    }

    .workspace-card {
        background: #fff;
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15,23,42,.08);
        overflow: hidden;
    }

    .summary-card {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-height: 160px;
    }

    .summary-card__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .summary-card__top p {
        margin: 0;
        color: var(--bs-secondary-color, #6c757d);
        font-size: .92rem;
    }

    .summary-card__top h3 {
        margin: 8px 0 0;
        font-size: 2rem;
        line-height: 1.1;
    }

    .summary-card__icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-size: 1.2rem;
        font-weight: 700;
    }

    .metric-trend {
        width: max-content;
        font-size: .82rem;
        font-weight: 700;
        border-radius: 999px;
        padding: 6px 10px;
    }

    .summary-card__meta {
        margin: 0;
        color: var(--bs-secondary-color, #6c757d);
        font-size: .92rem;
    }

    .workspace-grid {
        display: grid;
        grid-template-columns: 1.15fr 1.2fr 1fr;
        gap: 18px;
        margin-top: 22px;
    }

    .workspace-card__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 18px 12px;
        border-bottom: 1px solid var(--bs-border-color, #e5e7eb);
    }

    .workspace-card__header h3 {
        margin: 0;
        font-size: 1.08rem;
    }

    .workspace-card__header a {
        color: var(--bs-primary, #0d6efd);
        text-decoration: none;
        font-size: .85rem;
        font-weight: 600;
    }

    .profile-list,
    .task-list,
    .activity-list {
        display: grid;
        gap: 10px;
        padding: 14px 18px 18px;
    }

    .profile-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid var(--bs-border-color, #e5e7eb);
    }

    .profile-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .profile-row .label {
        color: var(--bs-secondary-color, #6c757d);
        font-size: .9rem;
    }

    .profile-row .value {
        font-weight: 600;
        text-align: right;
    }

    .task-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 10px;
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 14px;
        background: #fafcff;
    }

    .task-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin-top: 8px;
        flex-shrink: 0;
    }

    .task-dot.waiting { background: #2563eb; }
    .task-dot.inprogress { background: #f59e0b; }
    .task-dot.completed { background: #16a34a; }
    .task-dot.critical { background: #ef4444; }

    .task-item__body {
        flex: 1;
    }

    .task-item__body strong {
        display: block;
        margin-bottom: 4px;
    }

    .task-item__body small {
        color: var(--bs-secondary-color, #6c757d);
        display: block;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 28px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .badge.primary { background: #e8f0ff; color: #2563eb; }
    .badge.warning { background: #fff5de; color: #b45309; }
    .badge.success { background: #eafaf1; color: #16a34a; }
    .badge.danger { background: #fee2e2; color: #ef4444; }

    .leave-box {
        display: grid;
        gap: 12px;
        padding: 14px 18px 18px;
    }

    .leave-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 14px;
        background: #f9fafb;
    }

    .leave-progress {
        margin-top: 6px;
    }

    .leave-progress__label {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .progress-bar {
        height: 10px;
        width: 100%;
        background: #edf2f7;
        border-radius: 999px;
        overflow: hidden;
    }

    .progress-bar span {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #2563eb, #60a5fa);
    }

    .workspace-bottom {
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 18px;
        margin-top: 22px;
    }

    .workspace-card--wide {
        width: 100%;
    }

    .material-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 8px;
    }

    .material-table th,
    .material-table td {
        padding: 12px 18px;
        text-align: left;
        border-bottom: 1px solid var(--bs-border-color, #e5e7eb);
        font-size: .93rem;
    }

    .material-table th {
        color: var(--bs-secondary-color, #6c757d);
        background: #fafbfc;
        font-weight: 700;
    }

    .status {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
    }

    .status.ok { background: #eafaf1; color: #16a34a; }
    .status.warn { background: #fff5de; color: #b45309; }
    .status.danger { background: #fee2e2; color: #ef4444; }

    .activity-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid var(--bs-border-color, #e5e7eb);
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        font-size: .9rem;
        font-weight: 700;
    }

    .activity-item strong {
        display: block;
        margin-bottom: 4px;
    }

    .activity-item small {
        color: var(--bs-secondary-color, #6c757d);
    }

    @@media (max-width: 1100px) {
        .workspace-stats {
            grid-template-columns: repeat(2, minmax(220px, 1fr));
        }

        .workspace-grid,
        .workspace-bottom {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .workspace-shell {
            padding: 0 12px 24px;
        }

        .workspace-topbar,
        .workspace-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .workspace-actions {
            width: 100%;
        }

        .workspace-actions .btn {
            flex: 1;
        }

        .workspace-stats {
            grid-template-columns: 1fr;
        }

        .workspace-hero__meta {
            justify-content: flex-start;
        }
    }
</style>

@code {
    private string DisplayName { get; set; } = "Kullanıcı";
    private int _pendingApprovals = 3;

    private readonly DashboardMetric[] _metrics =
    [
        new("Zimmet Sayısı", "12", "💻", "#e8f0ff", "#2563eb", "+2 bu ay", "#e8f0ff", "#2563eb", "Aktif cihaz ve ekipmanlar"),
        new("Açık Görev", "5", "✓", "#eafaf1", "#16a34a", "2 tamamlandı", "#eafaf1", "#16a34a", "Devam eden iş listesi"),
        new("Kalan İzin", "14", "📅", "#fff5de", "#f59e0b", "+3 gün eklenebilir", "#fff5de", "#b45309", "Yıllık izin durumu"),
        new("Bekleyen Onay", "3", "⚠", "#fee2e2", "#ef4444", "1 kritik", "#fee2e2", "#ef4444", "Onay bekleyen talepler")
    ];

    private readonly DashboardTask[] _tasks =
    [
        new("Yıllık envanter kontrolü", "Son teslim: 18 Eylül 2026", "waiting", "Bekliyor"),
        new("Yeni cihaz teslimi", "Opsiyonel kontrol tamamlandı", "completed", "Tamam"),
        new("İzin onayı", "Yönetici incelemede", "inprogress", "İnceleniyor"),
        new("Arızalı cihaz raporu", "Hızlı müdahale gerekli", "critical", "Kritik")
    ];

    private readonly MaterialItem[] _materials =
    [
        new("Dizüstü Bilgisayar", "ABC12345", "Aktif", "ok", "İstanbul"),
        new("Telefon", "XYZ987", "Bakım", "warn", "Ankara"),
        new("Monitör", "QWE654", "Aktif", "ok", "İzmir"),
        new("Yazıcı", "LMN258", "Arızalı", "danger", "İstanbul")
    ];

    private readonly ActivityItem[] _activities =
    [
        new("Yeni cihaz teslim edildi", "Bugün, 09:40", "✓", "#e8f0ff", "#2563eb"),
        new("İzin talebi onay bekliyor", "Dün, 17:55", "⏱", "#eafaf1", "#16a34a"),
        new("Arızalı ekipman bildirimi", "Bugün, 08:15", "!", "#fff5de", "#b45309")
    ];

    protected override async Task OnInitializedAsync()
    {
        var personel = await CurrentUserService.GetCurrentPersonelAsync();
        if (personel != null)
        {
            var adSoyad = $"{personel.Adi} {personel.Soyadi}".Trim();
            if (!string.IsNullOrWhiteSpace(adSoyad))
                DisplayName = adSoyad;
        }
    }

    private string GetTaskDotClass(string state) => state switch
    {
        "waiting" => "waiting",
        "inprogress" => "inprogress",
        "completed" => "completed",
        "critical" => "critical",
        _ => "waiting"
    };

    private string GetBadgeClass(string state) => state switch
    {
        "waiting" => "primary",
        "inprogress" => "warning",
        "completed" => "success",
        "critical" => "danger",
        _ => "primary"
    };

    private string GetStatusClass(string status) => status switch
    {
        "ok" => "ok",
        "warn" => "warn",
        "danger" => "danger",
        _ => "ok"
    };

    private sealed record DashboardMetric(
        string Title,
        string Value,
        string Icon,
        string IconBackground,
        string IconColor,
        string Trend,
        string TrendBackground,
        string TrendColor,
        string SubText);

    private sealed record DashboardTask(
        string Title,
        string Description,
        string State,
        string StateText);

    private sealed record MaterialItem(
        string Name,
        string Serial,
        string StatusText,
        string Status,
        string Location);

    private sealed record ActivityItem(
        string Title,
        string Time,
        string Icon,
        string IconBackground,
        string IconColor);
}





























































































































































































































































































































































































