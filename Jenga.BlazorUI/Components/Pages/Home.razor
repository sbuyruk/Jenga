@page "/"
@page "/home"
@rendermode InteractiveServer
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Data
@using Jenga.DataAccess.Services.IKYS
@using Jenga.Models.IKYS
@using Jenga.Models.Inventory
@using Jenga.Models.Enums
@using Microsoft.EntityFrameworkCore
@inject ICurrentUserService CurrentUserService
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IGorevOnayService GorevOnayService

<div class="workspace-shell">
    <section class="workspace-hero">
        <div class="workspace-hero__content">
            <h3>Merhaba, @DisplayName</h3>
            <p>Personel, izin ve zimmet bilgileriniz.</p>
        </div>

        <div class="workspace-hero__meta">
            <div class="workspace-pill">
                <small>Birim</small>
                <strong>@Department</strong>
            </div>
            <div class="workspace-pill">
                <small>Görev</small>
                <strong>@Position</strong>
            </div>
        </div>
    </section>

    <section class="workspace-grid">
        <article class="workspace-card">
            <div class="workspace-card__header">
                <h3>Personel Bilgileri</h3>
            </div>

            <div class="profile-list">
                <div class="profile-row">
                    <span class="label">Ad Soyad</span>
                    <span class="value">@DisplayName</span>
                </div>
                <div class="profile-row">
                    <span class="label">İşe Giriş</span>
                    <span class="value">@EmploymentDate</span>
                </div>
                <div class="profile-row">
                    <span class="label">Derece / Kademe</span>
                    <span class="value">@DegreeStep</span>
                </div>
                <div class="profile-row">
                    <span class="label">Sicil No</span>
                    <span class="value">@EmployeeNumber</span>
                </div>
                <div class="profile-row">
                    <span class="label">E-posta</span>
                    <span class="value">@Email</span>
                </div>
            </div>
        </article>

        <article class="workspace-card">
            <div class="workspace-card__header">
                <h3>İzin Taleplerim</h3>
            </div>

            <div class="task-list">
                @if (_leaveRequests.Count == 0)
                {
                    <p class="empty-state">Gösterilecek izin talebi bulunmuyor.</p>
                }
                else
                {
                    @foreach (var request in _leaveRequests)
                    {
                        <div class="task-item">
                            <span class="task-dot @GetTaskDotClass(request.State)"></span>
                            <div class="task-item__body">
                                <strong>@request.Title</strong>
                                <small>@request.Description</small>
                            </div>
                            <span class="badge @GetBadgeClass(request.State)">@request.StateText</span>
                        </div>
                    }
                }
            </div>
        </article>

        <article class="workspace-card">
            <div class="workspace-card__header">
                <h3>İzin Bilgileri</h3>
            </div>

            <div class="leave-box">
                <div class="leave-row">
                    <span>Bu Yıl İzin hakkı</span>
                    <strong>@LeaveSummaryText(LeaveTotalDays, "gün")</strong>
                </div>
                <div class="leave-row">
                    <span>Bu Yıl Kullanılan</span>
                    <strong>@LeaveSummaryText(LeaveUsedDays, "gün")</strong>
                </div>
                <div class="leave-row">
                    <span>Bu Yıldan Kalan</span>
                    <strong>@LeaveSummaryText(LeaveRemainingDays, "gün")</strong>
                </div>
                <div class="leave-row">
                    <span>Geçmiş yıllardan kalan</span>
                    <strong>@LeaveSummaryText(LeavePreviousYearsRemainingDays, "gün")</strong>
                </div>
                <div class="leave-row">
                    <span>Kalan Toplam İzin</span>
                    <strong>@LeaveSummaryText(LeaveTotalRemainingDays, "gün")</strong>
                </div>

                <div class="leave-progress">
                    <div class="leave-progress__label">
                        <small>Kullanım oranı</small>
                        <strong>@(LeaveUsagePercent.HasValue ? $"{LeaveUsagePercent}%" : "Veri yok")</strong>
                    </div>
                    <div class="progress-bar">
                        <span style="width:@(LeaveUsagePercent ?? 0)%;"></span>
                    </div>
                </div>
            </div>
        </article>
    </section>

    <section class="workspace-grid">
        <article class="workspace-card workspace-card--full-row">
            <div class="workspace-card__header">
                <h3>Görev Onay İşlemlerim</h3>
                <span class="workspace-card__link-disabled">Tümünü gör</span>
            </div>

            <div class="task-list">
                @if (_taskApprovals.Count == 0)
                {
                    <p class="empty-state">Görev onay kaydı bulunmuyor.</p>
                }
                else
                {
                    @foreach (var approval in _taskApprovals)
                    {
                        <div class="task-item">
                            <span class="task-dot @GetTaskDotClass(approval.State)"></span>
                            <div class="task-item__body">
                                <strong>@approval.Title</strong>
                                <small>@approval.Description</small>
                            </div>
                            <span class="badge @GetBadgeClass(approval.State)">@approval.StateText</span>
                        </div>
                    }
                }
            </div>
        </article>
    </section>

    <section class="workspace-bottom">
        <article class="workspace-card workspace-card--wide">
            <div class="workspace-card__header">
                <h3>Malzeme Zimeti</h3>
            </div>

            <table class="material-table">
                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th>Seri No</th>
                        <th>Durum</th>
                        <th>Lokasyon</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_materials.Count == 0)
                    {
                        <tr><td colspan="4" class="empty-state">Kişiye zimmetli varlık bulunmuyor.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in _materials)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Serial</td>
                                <td><span class="status @GetStatusClass(item.Status)">@item.StatusText</span></td>
                                <td>@item.Location</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </article>

        <article class="workspace-card">
            <div class="workspace-card__header">
                <h3>Son Zimmet Hareketleri</h3>
            </div>

            <div class="activity-list">
                @if (_activities.Count == 0)
                {
                    <p class="empty-state">Kayıtlı zimmet hareketi bulunmuyor.</p>
                }
                else
                {
                    @foreach (var activity in _activities)
                    {
                        <div class="activity-item">
                            <div class="activity-icon" style="background:@activity.IconBackground;color:@activity.IconColor;">@activity.Icon</div>
                            <div>
                                <strong>@activity.Title</strong>
                                <small>@activity.Time</small>
                            </div>
                        </div>
                    }
                }
            </div>
        </article>
    </section>
</div>

<style>
    .workspace-shell {
        max-width: 1440px;
        margin: 28px auto;
        padding: 0 20px 24px;
    }

    .workspace-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 22px;
        background: rgba(255,255,255,0.82);
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15,23,42,.08);
        backdrop-filter: blur(8px);
    }

    .workspace-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .workspace-brand__mark {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: linear-gradient(135deg, #1d4ed8, #60a5fa);
        color: #fff;
        display: grid;
        place-items: center;
        font-size: 1.2rem;
    }

    .workspace-actions {
        display: flex;
        gap: 10px;
    }

    .workspace-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        margin-top: 24px;
        padding: 28px;
        border-radius: 26px;
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 10px 24px rgba(15,23,42,.12);
    }

    .workspace-hero__content h1 {
        margin: 0 0 10px;
        font-size: clamp(1.7rem, 3vw, 2.6rem);
        line-height: 1.2;
    }

    .workspace-hero__content p {
        margin: 0;
        opacity: .9;
        font-size: 1rem;
    }

    .workspace-hero__meta {
        display: flex;
        gap: 20px;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .workspace-pill {
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 12px;
        padding: 10px 14px;
        min-width: 120px;
    }

        .workspace-pill small {
            display: block;
            opacity: .8;
            margin-bottom: 6px;
            font-size: .72rem;
        }

        .workspace-pill strong {
            font-size: 1.05rem;
        }

    .workspace-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(220px, 1fr));
        gap: 18px;
        margin-top: 24px;
    }

    .workspace-card {
        background: #fff;
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15,23,42,.08);
        overflow: hidden;
    }

    .summary-card {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-height: 160px;
    }

    .summary-card__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .summary-card__top p {
            margin: 0;
            color: var(--bs-secondary-color, #6c757d);
            font-size: .92rem;
        }

        .summary-card__top h3 {
            margin: 8px 0 0;
            font-size: 2rem;
            line-height: 1.1;
        }

    .summary-card__icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-size: 1.2rem;
        font-weight: 700;
    }

    .metric-trend {
        width: max-content;
        font-size: .82rem;
        font-weight: 700;
        border-radius: 999px;
        padding: 6px 10px;
    }

    .empty-state {
        margin: 0;
        padding: 12px;
        color: var(--bs-secondary-color, #6c757d);
    }

    .summary-card__meta {
        margin: 0;
        color: var(--bs-secondary-color, #6c757d);
        font-size: .92rem;
    }

    .workspace-grid {
        display: grid;
        grid-template-columns: 1.15fr 1.2fr 1fr;
        gap: 18px;
        margin-top: 22px;
    }

    .workspace-card__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 18px 12px;
        border-bottom: 1px solid var(--bs-border-color, #e5e7eb);
    }

        .workspace-card__header h3 {
            margin: 0;
            font-size: 1.08rem;
        }

        .workspace-card__header a,
        .workspace-card__header .workspace-card__link-disabled {
            color: var(--bs-primary, #0d6efd);
            text-decoration: none;
            font-size: .85rem;
            font-weight: 600;
        }

    .profile-list,
    .task-list,
    .activity-list {
        display: grid;
        gap: 10px;
        padding: 14px 18px 18px;
    }

    .profile-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid var(--bs-border-color, #e5e7eb);
    }

        .profile-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .profile-row .label {
            color: var(--bs-secondary-color, #6c757d);
            font-size: .9rem;
        }

        .profile-row .value {
            font-weight: 600;
            text-align: right;
        }

    .task-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 10px;
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 14px;
        background: #fafcff;
    }

    .task-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin-top: 8px;
        flex-shrink: 0;
    }

        .task-dot.waiting {
            background: #2563eb;
        }

        .task-dot.inprogress {
            background: #f59e0b;
        }

        .task-dot.completed {
            background: #16a34a;
        }

        .task-dot.critical {
            background: #ef4444;
        }

    .task-item__body {
        flex: 1;
    }

        .task-item__body strong {
            display: block;
            margin-bottom: 4px;
        }

        .task-item__body small {
            color: var(--bs-secondary-color, #6c757d);
            display: block;
        }

    .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 28px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        border: 1px solid transparent;
        white-space: nowrap;
    }

        .badge.primary {
            background: #e8f0ff;
            color: #2563eb;
        }

        .badge.warning {
            background: #fff5de;
            color: #b45309;
        }

        .badge.success {
            background: #eafaf1;
            color: #16a34a;
        }

        .badge.danger {
            background: #fee2e2;
            color: #ef4444;
        }

    .leave-box {
        display: grid;
        gap: 12px;
        padding: 14px 18px 18px;
    }

    .leave-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 14px;
        background: #f9fafb;
    }

    .leave-progress {
        margin-top: 6px;
    }

    .leave-progress__label {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .progress-bar {
        height: 10px;
        width: 100%;
        background: #edf2f7;
        border-radius: 999px;
        overflow: hidden;
    }

        .progress-bar span {
            display: block;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #2563eb, #60a5fa);
        }

    .workspace-bottom {
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 18px;
        margin-top: 22px;
    }

    .workspace-card--wide {
        width: 100%;
    }

    .workspace-card--full-row {
        grid-column: 1 / -1;
    }

    .material-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 8px;
    }

        .material-table th,
        .material-table td {
            padding: 12px 18px;
            text-align: left;
            border-bottom: 1px solid var(--bs-border-color, #e5e7eb);
            font-size: .93rem;
        }

        .material-table th {
            color: var(--bs-secondary-color, #6c757d);
            background: #fafbfc;
            font-weight: 700;
        }

    .status {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
    }

        .status.ok {
            background: #eafaf1;
            color: #16a34a;
        }

        .status.warn {
            background: #fff5de;
            color: #b45309;
        }

        .status.danger {
            background: #fee2e2;
            color: #ef4444;
        }

    .activity-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid var(--bs-border-color, #e5e7eb);
    }

        .activity-item:last-child {
            border-bottom: none;
        }

    .activity-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        font-size: .9rem;
        font-weight: 700;
    }

    .activity-item strong {
        display: block;
        margin-bottom: 4px;
    }

    .activity-item small {
        color: var(--bs-secondary-color, #6c757d);
    }

    @@media (max-width: 1100px) {
        .workspace-stats {
            grid-template-columns: repeat(2, minmax(220px, 1fr));
        }

        .workspace-grid,
        .workspace-bottom {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .workspace-shell {
            padding: 0 12px 24px;
        }

        .workspace-topbar,
        .workspace-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .workspace-actions {
            width: 100%;
        }

            .workspace-actions .btn {
                flex: 1;
            }

        .workspace-stats {
            grid-template-columns: 1fr;
        }

        .workspace-hero__meta {
            justify-content: flex-start;
        }
    }
</style>

@code {
    private string DisplayName { get; set; } = "Kullanıcı";
    private string Department { get; set; } = "Belirtilmemiş";
    private string Position { get; set; } = "Belirtilmemiş";
    private string EmploymentDate { get; set; } = "Belirtilmedi";
    private string DegreeStep { get; set; } = "Belirtilmedi";
    private string EmployeeNumber { get; set; } = "Belirtilmedi";
    private string Email { get; set; } = "Belirtilmedi";
    private int? LeaveTotalDays { get; set; }
    private int? LeaveUsedDays { get; set; }
    private int? LeaveRemainingDays { get; set; }
    private int? LeavePreviousYearsRemainingDays { get; set; }
    private int? LeaveTotalRemainingDays { get; set; }
    private int? LeaveUsagePercent { get; set; }

    private List<LeaveRequestItem> _leaveRequests = [];
    private List<TaskApprovalItem> _taskApprovals = [];
    private List<MaterialItem> _materials = [];
    private List<ActivityItem> _activities = [];

    protected override async Task OnInitializedAsync()
    {
        var personel = await CurrentUserService.GetCurrentPersonelAsync();
        if (personel is not null)
        {
            var adSoyad = $"{personel.Adi} {personel.Soyadi}".Trim();
            if (!string.IsNullOrWhiteSpace(adSoyad))
                DisplayName = adSoyad;
            EmployeeNumber = personel.SicilNo.ToString();
        }

        await LoadDashboardAsync(personel);
    }

    private async Task LoadDashboardAsync(Personel? personel)
    {
        if (personel is null)
        {
            _leaveRequests = [];
            _taskApprovals = [];
            _materials = [];
            _activities = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var taskApprovalResult = await GorevOnayService.GetTaskApprovalListAsync(
            personel.Id,
            authorizedUnitView: false);

        if (taskApprovalResult.IsSuccess && taskApprovalResult.Value is not null)
        {
            _taskApprovals = taskApprovalResult.Value
                .Take(4)
                .Select(x => new TaskApprovalItem(
                    GetTaskApprovalTitle(x.Reason),
                    x.StartDate.HasValue
                        ? $"{x.StartDate:dd.MM.yyyy} – {x.EndDate:dd.MM.yyyy}{(string.IsNullOrWhiteSpace(x.Destination) ? "" : $" · {x.Destination}")}" 
                        : x.Destination ?? "Tarih belirtilmedi",
                    (ApprovalStatus)x.ManagerApprovalValue switch
                    {
                        ApprovalStatus.PendingApproval => "waiting",
                        ApprovalStatus.Approved => "completed",
                        ApprovalStatus.Rejected => "critical",
                        _ => "inprogress"
                    },
                    x.ManagerApprovalDisplay))
                .ToList();
        }

        var jobInfo = await db.IsBilgileri_Table
            .AsNoTracking()
            .Include(x => x.BirimTanim)
            .Include(x => x.UnvanTanim)
            .FirstOrDefaultAsync(x => x.PersonelId == personel.Id);

        if (jobInfo is not null)
        {
            Department = string.IsNullOrWhiteSpace(jobInfo.BirimTanim?.Adi) ? "Belirtilmemiş" : jobInfo.BirimTanim.Adi;
            Position = string.IsNullOrWhiteSpace(jobInfo.UnvanTanim?.Adi) ? "Belirtilmemiş" : jobInfo.UnvanTanim.Adi;
            EmploymentDate = jobInfo.BaslamaTar.HasValue ? jobInfo.BaslamaTar.Value.ToString("dd.MM.yyyy") : "Belirtilmedi";
        }

        var latestDegreeStep = await db.DereceKademeDegisim_Table
            .AsNoTracking()
            .Where(x => x.PersonelId == personel.Id)
            .OrderByDescending(x => x.DegisimTarihi ?? x.OlusturmaTarihi ?? DateTime.MinValue)
            .ThenByDescending(x => x.Id)
            .FirstOrDefaultAsync();

        if (latestDegreeStep is not null && (latestDegreeStep.Derece.HasValue || latestDegreeStep.Kademe.HasValue))
        {
            DegreeStep = $"{(latestDegreeStep.Derece.HasValue ? $"{latestDegreeStep.Derece.Value}. derece" : "")}" +
                         $"{(latestDegreeStep.Derece.HasValue && latestDegreeStep.Kademe.HasValue ? ", " : "")}" +
                         $"{(latestDegreeStep.Kademe.HasValue ? $"{latestDegreeStep.Kademe.Value}. kademe" : "")}";
        }

        var contactInfo = await db.IletisimBilgileri_Table
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.PersonelId == personel.Id);

        if (contactInfo is not null)
        {
            Email = new[] { contactInfo.IntranetEPosta, contactInfo.InternetEPosta, contactInfo.OzelEPosta }
                .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "Belirtilmedi";

        }

        var leavePeriods = await db.IzinDonem_Table
            .AsNoTracking()
            .Where(x => x.PersonelId == personel.Id)
            .OrderByDescending(x => x.BaslangicTarihi ?? DateTime.MinValue)
            .ToListAsync();

        var leavePeriod = leavePeriods.FirstOrDefault();
        var currentYear = DateTime.Today.Year;
        var previousYearBalances = leavePeriods
            .Where(x => x.BaslangicTarihi.HasValue && x.BaslangicTarihi.Value.Year < currentYear)
            .Select(x => TryParseDayValue(x.KalanIzin))
            .Where(x => x.HasValue)
            .ToList();
        LeavePreviousYearsRemainingDays = previousYearBalances.Count > 0
            ? previousYearBalances.Sum(x => x!.Value)
            : null;

        if (leavePeriod is not null)
        {
            var total = TryParseDayValue(leavePeriod.IzinHakki);
            var used = TryParseDayValue(leavePeriod.KullanilanIzin);
            var remaining = TryParseDayValue(leavePeriod.KalanIzin);
            LeaveTotalDays = total ?? (remaining.HasValue && used.HasValue ? Math.Max(0, remaining.Value + used.Value) : null);
            LeaveUsedDays = used;
            LeaveRemainingDays = remaining ?? (LeaveTotalDays.HasValue && used.HasValue
                ? Math.Max(0, LeaveTotalDays.Value - used.Value)
                : null);
            LeaveUsagePercent = LeaveTotalDays > 0 && LeaveUsedDays.HasValue
                ? Math.Clamp((LeaveUsedDays.Value * 100) / LeaveTotalDays.Value, 0, 100)
                : null;
            LeaveTotalRemainingDays = LeaveRemainingDays.HasValue && LeavePreviousYearsRemainingDays.HasValue
                ? LeaveRemainingDays.Value + LeavePreviousYearsRemainingDays.Value
                : LeaveRemainingDays ?? LeavePreviousYearsRemainingDays;
        }
        else
        {
            LeaveTotalDays = 0;
            LeaveUsedDays = 0;
            LeaveRemainingDays = 0;
            LeaveTotalRemainingDays = LeavePreviousYearsRemainingDays;
            LeaveUsagePercent = 0;
        }

        var leaveRequests = await db.IzinTalep_Table
            .AsNoTracking()
            .Where(x => x.PersonelId == personel.Id && x.Aktif == true)
            .OrderByDescending(x => x.BaslangicTarihi ?? DateTime.MinValue)
            .Take(4)
            .ToListAsync();

        var leaveTypes = await db.IzinTanim_Table
            .AsNoTracking()
            .ToDictionaryAsync(x => x.Id, x => x.Adi);

        _leaveRequests = leaveRequests
            .Select(x => new LeaveRequestItem(
                x.IzinTipi.HasValue && leaveTypes.TryGetValue(x.IzinTipi.Value, out var leaveType) && !string.IsNullOrWhiteSpace(leaveType)
                    ? leaveType
                    : "İzin talebi",
                x.BaslangicTarihi.HasValue
                    ? $"{x.BaslangicTarihi:dd.MM.yyyy} – {x.BitisTarihi:dd.MM.yyyy}"
                    : "Tarih belirtilmedi",
                x.OnayDurumu switch
                {
                    IzinTalep.OnayDurumuTipi.IslemBekliyor => "waiting",
                    IzinTalep.OnayDurumuTipi.KontrolEdildi => "inprogress",
                    IzinTalep.OnayDurumuTipi.KayitlaraIslendi => "completed",
                    IzinTalep.OnayDurumuTipi.Reddedildi or IzinTalep.OnayDurumuTipi.IptalEdildi => "critical",
                    IzinTalep.OnayDurumuTipi.DilekceBekleniyor => "waiting",
                    _ => "waiting"
                },
                x.OnayDurumu switch
                {
                    IzinTalep.OnayDurumuTipi.IslemBekliyor => "İşlem Bekliyor",
                    IzinTalep.OnayDurumuTipi.KontrolEdildi => "Kontrol Edildi",
                    IzinTalep.OnayDurumuTipi.KayitlaraIslendi => "Kayıtlara İşlendi",
                    IzinTalep.OnayDurumuTipi.Reddedildi => "Reddedildi",
                    IzinTalep.OnayDurumuTipi.IptalEdildi => "İptal Edildi",
                    IzinTalep.OnayDurumuTipi.DilekceBekleniyor => "Dilekçe Bekleniyor",
                    _ => "Durum belirtilmedi"
                }))
            .ToList();

        var materialAssets = await db.MaterialAsset_Table
            .AsNoTracking()
            .Include(x => x.Material)
            .Include(x => x.Location)
            .Where(x => x.PersonelId == personel.Id)
            .OrderByDescending(x => x.Id)
            .Take(4)
            .ToListAsync();

        _materials = materialAssets
            .Select(x => new MaterialItem(
                x.Material?.MaterialName ?? "Bilinmeyen",
                x.SerialNumber ?? "Belirtilmedi",
                x.Status switch
                {
                    AssetStatus.Active => "Aktif",
                    AssetStatus.InRepair => "Bakım",
                    AssetStatus.Retired => "Kullanılmıyor",
                    AssetStatus.Lost => "Kayıp",
                    _ => "Aktif"
                },
                x.Status switch
                {
                    AssetStatus.Active => "ok",
                    AssetStatus.InRepair => "warn",
                    AssetStatus.Retired => "danger",
                    AssetStatus.Lost => "danger",
                    _ => "ok"
                },
                x.Location?.LocationName ?? "Belirtilmedi"))
            .ToList();

        var assetLogs = await db.MaterialAssetLog_Table
            .AsNoTracking()
            .Include(x => x.MaterialAsset)
                .ThenInclude(x => x!.Material)
            .Where(x => x.FromPersonelId == personel.Id || x.ToPersonelId == personel.Id)
            .OrderByDescending(x => x.TransactionDate)
            .Take(4)
            .ToListAsync();

        _activities = assetLogs
            .Select(x => new ActivityItem(
                string.IsNullOrWhiteSpace(x.Aciklama) ? x.TransactionType : x.Aciklama,
                x.TransactionDate.ToString("dd.MM.yyyy HH:mm"),
                "↔",
                "#e8f0ff",
                "#2563eb"))
            .ToList();

    }

    private static int? TryParseDayValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        if (int.TryParse(value.Trim(), out var parsed))
            return parsed;

        var candidate = value.Trim().Replace(',', '.');
        return double.TryParse(candidate, out var numeric)
            ? (int)Math.Round(numeric)
            : null;
    }

    private static string LeaveSummaryText(int? value, string suffix)
        => value.HasValue ? $"{value.Value} {suffix}" : "Veri yok";

    private static string ToPlainText(string value)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(value, "<[^>]*>", " ");
        text = System.Net.WebUtility.HtmlDecode(text);
        return System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
    }

    private static string GetTaskApprovalTitle(string? reason)
    {
        var title = string.IsNullOrWhiteSpace(reason) ? string.Empty : ToPlainText(reason);
        return string.IsNullOrWhiteSpace(title) ? "Görev onayı" : title;
    }

    private string GetTaskDotClass(string state) => state switch
    {
        "waiting" => "waiting",
        "inprogress" => "inprogress",
        "completed" => "completed",
        "critical" => "critical",
        _ => "waiting"
    };

    private string GetBadgeClass(string state) => state switch
    {
        "waiting" => "primary",
        "inprogress" => "warning",
        "completed" => "success",
        "critical" => "danger",
        _ => "primary"
    };

    private string GetStatusClass(string status) => status switch
    {
        "ok" => "ok",
        "warn" => "warn",
        "danger" => "danger",
        _ => "ok"
    };

    private sealed record LeaveRequestItem(
        string Title,
        string Description,
        string State,
        string StateText);

    private sealed record TaskApprovalItem(
        string Title,
        string Description,
        string State,
        string StateText);

    private sealed record MaterialItem(
        string Name,
        string Serial,
        string StatusText,
        string Status,
        string Location);

    private sealed record ActivityItem(
        string Title,
        string Time,
        string Icon,
        string IconBackground,
        string IconColor);
}

																																																																																																																																																																																																																																																																																																												
