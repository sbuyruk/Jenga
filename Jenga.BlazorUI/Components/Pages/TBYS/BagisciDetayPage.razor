@page "/tbys/bagisci/{BagisciId:int}"
@using Jenga.BlazorUI.Components.TBYS
@rendermode InteractiveServer

<PermissionGuard Module="ModuleName.TBYS" Operation="Operation.View">
    <TasinmazBagisciProfil BagisciId="@BagisciId" GeriUrl="@Geri" />
</PermissionGuard>

@code {
    [Parameter] public int BagisciId { get; set; }

    [SupplyParameterFromQuery(Name = "geri")]
    public string? Geri { get; set; }
}
