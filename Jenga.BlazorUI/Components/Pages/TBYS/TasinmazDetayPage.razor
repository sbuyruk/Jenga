@page "/tbys/tasinmaz/{TasinmazId:int}"
@using Jenga.BlazorUI.Components.TBYS
@rendermode InteractiveServer

<PermissionGuard Module="ModuleName.TBYS" Operation="Operation.View">
    <TasinmazProfil TasinmazId="@TasinmazId" GeriUrl="@Geri" />
</PermissionGuard>

@code {
    [Parameter] public int TasinmazId { get; set; }

    [SupplyParameterFromQuery(Name = "geri")]
    public string? Geri { get; set; }
}
