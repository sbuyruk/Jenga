@page "/tbys/tasinmaz-summary"
@rendermode InteractiveServer
@using Jenga.BlazorUI.Components.TBYS
@using Jenga.BlazorUI.Components.Common
@using Jenga.Models.Common
@using Jenga.Models.TBYS
@using Jenga.DataAccess.Services.Common
@using Jenga.DataAccess.Services.TBYS
@using Jenga.BlazorUI.Services.Common
@using Jenga.Utility
@inject ITasinmazService TasinmazService
@inject ITasinmazBagisciService TasinmazBagisciService
@inject IBagisService BagisService
@inject IIlService IlService
@inject IBolgeService BolgeService
@inject NavigationManager NavigationManager
@inject IModalService ModalService
@implements IDisposable

<PermissionGuard Module="ModuleName.TBYS" Operation="Operation.View">
<div class="admin-overview p-3 manager-summary-layout">
    <div>
        @if (isLoading)
        {
            <div class="d-flex text-muted justify-content-center">Yükleniyor...</div>
        }
        else if (loadFailed)
        {
            <div class="text-danger">Veri yüklenirken hata oluştu.</div>
        }
        else
        {
            <div class="summary-top-block">
                <div class="w-100">
                    <h5 class="mb-3 text-center">Taşınmaz ve Bağışçı Bilgileri</h5>
                </div>

                <div class="d-flex flex-wrap summary-top-row">
                    <div>
                        <TasinmazCard Tasinmazlar="@tasinmazlar"
                                      Iller="@iller"
                                      Bolgeler="@bolgeler"
                                      Height="360px" />
                    </div>

                    <div class="component-container component-container--pie">
                        <GenericChart TItem="PieItem"
                                      Items="kullanimChartItems"
                                      LabelSelector="@(p => p.Label)"
                                      ValueSelector="@(p => p.Value)"
                                      Title="Taşınmaz Cinsleri"
                                      SeriesName="Cins"
                                      Type="GenericChart<PieItem>.GenericChartType.Pie"
                                      Height="100%"
                                      Width="100%"
                                      ShowLegend="false"
                                      ShowDataLabels="true"
                                      ColorPalette="@_piePalette"
                                      GridPaddingBottom="40" />
                    </div>

                    <div>
                        <TasinmazBagisciCard Bagiscilar="@bagiscilar"
                                             Iller="@iller"
                                             Bolgeler="@bolgeler"
                                             Bagislar="@bagislar"
                                             Height="360px" />
                    </div>
                </div>
            </div>

            <hr />

            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <div class="map-summary-block">

                    <div class="map-surface">
                        <h5 class="mb-3 text-center">Taşınmaz Haritası </h5>
                        <div class="map-host">
                            <TurkeyMap OnProvinceClick="OnProvinceClickAsync" />
                        </div>
                    </div>
                </div>
            </div>

            <hr />

            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <div class="year-summary-block">
                    <div class="year-surface">
                        <div class="year-host">
                            <h5 class="mb-3 text-center">Yıl Bazında Taşınmaz Bağışları</h5>

                            <TasinmazYearDashboard Tasinmazlar="tasinmazBagislar ?? new List<Tasinmaz>()"
                                                   Years="Years"
                                                   SelectedYear="SelectedYear"
                                                   SelectedYearChanged="OnSelectedYearChanged" />
                        </div>
                    </div>
                </div>
            </div>
            <hr />
            <div class="page-container">
                <div class="content-wrapper">
                    <div class="component-container">
                        <GenericChart TItem="YearCountItem"
                                      Items="bagisYilChartItems"
                                      LabelSelector="@(x => x.Label)"
                                      ValueSelector="@(x => x.Value)"
                                      TooltipExtraSelector="@(x => $"Tam hisse Adedi={x.TamHisseAdedi}\nHisseli Adedi={x.HisseliAdedi}\nTahmini Rayiç Değeri={x.TahminiRayicDegeri:N0} ₺\nYaklaşık Piyasa Değeri={x.YaklasikPiyasaDegeri:N0} ₺")"
                                      Title="Taşınmaz Bağış Adedi (Son 10 Yıl)"
                                      SeriesName="Bağış Adedi"
                                      Type="GenericChart<YearCountItem>.GenericChartType.Bar"
                                      ShowLegend="false"
                                      ShowDataLabels="true"
                                      ColorPalette="@_barPalette"
                                      XAxisLabelRotateDegrees="-45"
                                      XAxisLabelsAlwaysRotate="true"
                                      XAxisHideOverlappingLabels="true"
                                      GridPaddingBottom="40"
                                      Width="100%"
                                      Height="100%" />
                    </div>
                </div>
            </div>

            <hr />



        }

        <div class="d-flex justify-content-center mt-4">
            <img src="/images/zekayi.gif"
                 alt="Zekayi"
                 loading="lazy"
                 data-bs-toggle="tooltip"
                 data-bs-placement="top"
                 border-radius="0.5rem"
                 title="Burada yayınlanan tüm Taşınmaz verileri Emlak Direktörlüğü tarafından girilmektedir. İrtibat için Zekayi ÇALIŞ, dahili tel: 229" />
        </div>
    </div>
</div>
</PermissionGuard>

@code {
    private List<Tasinmaz>? tasinmazlar;
    private List<Tasinmaz>? tumTasinmazlar;
    private List<Tasinmaz>? tasinmazBagislar;
    private List<TasinmazBagisci>? bagiscilar;
    private List<Il>? iller;
    private List<Bolge>? bolgeler;
    private List<Bagis>? bagislar;
    private bool isLoading;
    private bool loadFailed;
    private CancellationTokenSource? _cts;

    private readonly List<PieItem> kullanimChartItems = new();
    private readonly List<YearCountItem> bagisYilChartItems = new();

    private int SelectedYear { get; set; } = DateTime.Now.Year;
    private List<int> Years { get; } = Enumerable.Range(DateTime.Now.Year - 9, 10).Reverse().ToList();

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadDataAsync(_cts.Token);
    }

    private async Task LoadDataAsync(CancellationToken cancellationToken)
    {
        isLoading = true;
        loadFailed = false;

        try
        {
            tasinmazlar = (await TasinmazService.GetEnvanterdekilerAsync(cancellationToken)) is { IsSuccess: true } tEnvRes ? tEnvRes.Value : new();
            tumTasinmazlar = (await TasinmazService.GetAllAsync(cancellationToken)) is { IsSuccess: true } tAllRes ? tAllRes.Value : new();
            bagiscilar = (await TasinmazBagisciService.GetAllAsync(cancellationToken)) is { IsSuccess: true } bRes2 ? bRes2.Value : new();
            iller = (await IlService.GetAllAsync(cancellationToken)) is { IsSuccess: true } ilRes ? ilRes.Value : new();
            bolgeler = (await BolgeService.GetAllAsync(cancellationToken)) is { IsSuccess: true } bRes ? bRes.Value : new();
            bagislar = (await BagisService.GetAllAsync(cancellationToken)) is { IsSuccess: true } bgRes ? bgRes.Value : new();

            PrepareTasinmazCinsleriChart();
            PrepareBagisYilChart();
        }
        catch
        {
            loadFailed = true;
            tasinmazlar = new List<Tasinmaz>();
            bagiscilar = new List<TasinmazBagisci>();
            iller = new List<Il>();
            bolgeler = new List<Bolge>();
            bagislar = new List<Bagis>();
            kullanimChartItems.Clear();
            bagisYilChartItems.Clear();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void PrepareTasinmazCinsleriChart()
    {
        kullanimChartItems.Clear();

        if (tasinmazlar == null || !tasinmazlar.Any())
        {
            return;
        }

        var filtered = tasinmazlar.Where(x => x != null && x.EnvanterdeMi == 1);

        var groups = filtered
            .GroupBy(x => string.IsNullOrWhiteSpace(x.KullanimSekli) ? "Diğer" : x.KullanimSekli!.Trim())
            .Select(g => (Name: g.Key, Count: g.Count()))
            .OrderByDescending(g => g.Count)
            .ToList();

        foreach (var g in groups)
        {
            kullanimChartItems.Add(new PieItem
            {
                Label = g.Name,
                Value = Convert.ToDecimal(g.Count)
            });
        }
    }

    private void PrepareBagisYilChart()
    {
        bagisYilChartItems.Clear();

        if (tumTasinmazlar == null || tumTasinmazlar.Count == 0)
        {
            return;
        }

        tasinmazBagislar = tumTasinmazlar
            .Where(t => t is not null && t.BagisYili != null &&
                t.EnvanterdeMi == 1 ||
                (
                    t.EnvanterdeMi == 0 &&
                    string.Equals(t.EnvanterdenCikmaSebebi?.Trim(), "Satış", StringComparison.OrdinalIgnoreCase)
                ))
            .ToList();

        var currentYear = DateTime.Now.Year;
        var startYear = currentYear - 9;

        var yearSummaries = tasinmazBagislar
            .Select(t => new
            {
                Year = TryParseYear(t.BagisYili),
                TamHisse = NormalizeTamHisse(t.TamHisse),
                TahminiRayicDegeri = t.TahminiRayicDegeri ?? 0m,
                YaklasikPiyasaDegeri = t.YaklasikPiyasaDegeri ?? 0m
            })
            .Where(x => x.Year.HasValue && x.Year.Value >= startYear && x.Year.Value <= currentYear)
            .GroupBy(x => x.Year!.Value)
            .ToDictionary(
                g => g.Key,
                g => new
                {
                    Total = g.Count(),
                    Tam = g.Count(x => string.Equals(x.TamHisse, ProjectConstants.TAM_HISSE, StringComparison.OrdinalIgnoreCase)),
                    Hisseli = g.Count(x => string.Equals(x.TamHisse, ProjectConstants.HISSELI, StringComparison.OrdinalIgnoreCase)),
                    TahminiRayicDegeri = g.Sum(x => x.TahminiRayicDegeri),
                    YaklasikPiyasaDegeri = g.Sum(x => x.YaklasikPiyasaDegeri)
                });

        for (var year = startYear; year <= currentYear; year++)
        {
            var total = 0;
            var tam = 0;
            var hisseli = 0;
            var tahminiRayic = 0m;
            var yaklasikPiyasa = 0m;

            if (yearSummaries.TryGetValue(year, out var summary))
            {
                total = summary.Total;
                tam = summary.Tam;
                hisseli = summary.Hisseli;
                tahminiRayic = summary.TahminiRayicDegeri;
                yaklasikPiyasa = summary.YaklasikPiyasaDegeri;
            }

            bagisYilChartItems.Add(new YearCountItem
            {
                Label = year.ToString(),
                Value = total,
                TamHisseAdedi = tam,
                HisseliAdedi = hisseli,
                TahminiRayicDegeri = tahminiRayic,
                YaklasikPiyasaDegeri = yaklasikPiyasa
            });
        }
    }

    private static int? TryParseYear(string? yearText)
    {
        if (string.IsNullOrWhiteSpace(yearText))
        {
            return null;
        }

        return int.TryParse(yearText.Trim(), out var year) ? year : null;
    }

    private static string NormalizeTamHisse(string? tamHisse)
    {
        return string.IsNullOrWhiteSpace(tamHisse) ? string.Empty : tamHisse.Trim();
    }

    private Task OnSelectedYearChanged(int year)
    {
        SelectedYear = year;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnProvinceClickAsync(int provinceId)
    {
        var il = iller?.FirstOrDefault(x => x.Id == provinceId);
        var ilAdi = il?.IlAdi?.Trim() ?? provinceId.ToString();

        var rows = (tasinmazlar ?? [])
            .Where(x => x is not null && x.EnvanterdeMi == 1 && x.IlId == provinceId)
            .ToList();

        RenderFragment content = builder =>
        {
            builder.OpenComponent<ProvinceTasinmazGenericTable>(0);
            builder.AddAttribute(1, "Items", rows);
            builder.AddAttribute(2, "ExportFileName", $"{ilAdi}-tasinmazlari.xlsx");
            builder.AddAttribute(3, "Bagiscilar", bagiscilar ?? new List<TasinmazBagisci>());
            builder.CloseComponent();
        };

        await ModalService.Show(new ModalRequest
        {
            Title = $"{ilAdi} İlinde Bulunan Taşınmazlar ({rows.Count} kayıt)",
            Content = content,
            ShowConfirmationButtons = false
        });
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private sealed class PieItem
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
    }

    private sealed class YearCountItem
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
        public int TamHisseAdedi { get; set; }
        public int HisseliAdedi { get; set; }
        public decimal TahminiRayicDegeri { get; set; }
        public decimal YaklasikPiyasaDegeri { get; set; }
    }

    private static readonly string[] _piePalette =
    [
        "#2563EB",
        "#7C3AED",
        "#06B6D4",
        "#10B981",
        "#F59E0B",
        "#EF4444",
        "#F97316",
        "#84CC16",
        "#EC4899",
        "#64748B"
    ];

    private static readonly string[] _barPalette =
    [
        "#0EA5E9"
    ];
}