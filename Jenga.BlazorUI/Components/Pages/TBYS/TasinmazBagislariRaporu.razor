@page "/tbys/tasinmaz-bagislari"
@rendermode InteractiveServer

@using Jenga.BlazorUI.Components.TBYS
@using Jenga.DataAccess.Services.TBYS
@using Jenga.Models.TBYS
@using Microsoft.AspNetCore.Components

@inject ITasinmazService TasinmazService


<div class="card shadow-sm mb-4">
    <div class="card-header bg-light fw-semibold">
        <i class="bi bi-bar-chart"></i> Taşınmaz Bağışları Raporu
    </div>
    <div class="card-body">
        <div class="row align-items-end g-2 mb-3">
            <div class="col-auto">
                @* <label class="form-label mb-1">Yıl</label> *@
                <select class="form-select form-select-sm"
                        @bind="SelectedYear"
                        @bind:after="OnYearChanged">
                    @foreach (var y in Years)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync">
                    <i class="bi bi-arrow-clockwise"></i> Yenile
                </button>
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-success" @onclick="ExportExcelAsync">
                    <i class="bi bi-file-earmark-excel"></i> Excel
                </button>
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-primary" @onclick="PrintAsync">
                    <i class="bi bi-printer"></i> Yazdır
                </button>
            </div>
        </div>
        <YilBazindaTasinmazBagisTable @ref="_table"
                                     Tasinmazlar="@Tasinmazlar"
                                     Years="@Years"
                                     @bind-SelectedYear="@SelectedYear" />
    </div>
</div>

@code {
    private YilBazindaTasinmazBagisTable? _table;

    private List<int> Years { get; } = Enumerable.Range(DateTime.Now.Year - 9, 10).Reverse().ToList();
    private int SelectedYear { get; set; } = DateTime.Now.Year;

    private List<Tasinmaz> Tasinmazlar { get; set; } = new();

    protected override async Task OnInitializedAsync()
        => await RefreshAsync();

    private Task OnYearChanged()
        => Task.CompletedTask;

    private async Task RefreshAsync()
        => Tasinmazlar = (await TasinmazService.GetEnvanterdekilerAsync()) is { IsSuccess: true } r ? r.Value : new();

    private async Task ExportExcelAsync()
    {
        if (_table is null) return;
        await _table.ExportExcelAsync();
    }

    private async Task PrintAsync()
    {
        if (_table is null) return;
        await _table.PrintAsync();
    }
}