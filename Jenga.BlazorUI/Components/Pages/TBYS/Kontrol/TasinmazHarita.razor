@using Jenga.DataAccess.Services.TBYS
@implements IAsyncDisposable
@inject ITasinmazKontrolService KontrolService
@inject IJSRuntime JS
@inject ILogger<TasinmazHarita> Logger

<div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-3">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-map me-2 text-primary"></i>Taşınmaz Haritası</h5>
        <p class="text-muted small mb-0">Taşınmaz bilgilerini görmek için işaretçilere veya parsel sınırlarına dokunun.</p>
    </div>
    <a class="btn btn-sm btn-outline-secondary" href="/tbys/tasinmaz-kontrol"><i class="bi bi-list-ul me-1"></i>Kontrol Listesi</a>
</div>

@if (_loading)
{
    <JengaLoading />
}
else if (_veriHatasi is not null)
{
    <div class="alert alert-danger" role="alert">@_veriHatasi <button class="btn btn-sm btn-outline-danger ms-2" @onclick="YukleAsync">Yeniden Dene</button></div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="harita-filtreler mb-3">
                <div>
                    <label for="harita-arama" class="form-label small">Taşınmaz ara</label>
                    <input id="harita-arama" class="form-control form-control-sm" type="search" placeholder="Sicil no, adres, il veya ilçe…" @bind="_arama" @bind:event="oninput" @bind:after="Filtrele" />
                </div>
                <div>
                    <label for="harita-cinsi" class="form-label small">Cinsi</label>
                    <select id="harita-cinsi" class="form-select form-select-sm" @bind="_cinsi" @bind:after="Filtrele">
                        <option value="">Tümü</option>
                        @foreach (var cins in _noktalar.Select(n => n.Cinsi).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c))
                        {
                            <option value="@cins">@cins</option>
                        }
                    </select>
                </div>
                <button class="btn btn-sm btn-outline-primary" @onclick="TumunuGoster" disabled="@(_harita is null)">Tümünü Göster</button>
            </div>
            <div class="d-flex justify-content-between flex-wrap gap-2 small mb-2" role="status">
                <span><strong>@_gosterilen.Count</strong> / @_noktalar.Count taşınmaz</span>
            </div>
            @if (_noktalar.Count == 0)
            {
                <div class="alert alert-info py-2 small">Yetkili olduğunuz taşınmazlarda kayıtlı geçerli koordinat bulunamadı. Kayıtlı parsel sınırı da bulunmuyor.</div>
            }
            else if (_gosterilen.Count == 0)
            {
                <div class="alert alert-info py-2 small">Aramanızla eşleşen taşınmaz bulunamadı.</div>
            }
            @if (_haritaHatasi is not null)
            {
                <div class="alert alert-warning py-2 small" role="alert">@_haritaHatasi <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="HaritayiYenidenDene">Yeniden Dene</button></div>
            }
            <div class="tasinmaz-harita" @ref="_haritaElementi" role="region" aria-label="Taşınmaz konumları haritası"></div>
        </div>
    </div>
}

@code {
    private List<TasinmazHaritaNoktasi> _noktalar = [], _gosterilen = [];
    private string _arama = "", _cinsi = "";
    private string? _veriHatasi, _haritaHatasi;
    private bool _loading = true, _yenile, _disposed, _haritaIslemi;
    private ElementReference _haritaElementi;
    private IJSObjectReference? _module, _harita;

    protected override Task OnInitializedAsync() => YukleAsync();

    private async Task YukleAsync()
    {
        _loading = true;
        _veriHatasi = null;
        try
        {
            var sonuc = await KontrolService.GetHaritaNoktalariAsync();
            if (sonuc.IsFailure) _veriHatasi = sonuc.Error.Message;
            else { _noktalar = sonuc.Value; Filtrele(); }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Taşınmaz haritası verileri yüklenemedi.");
            _veriHatasi = "Taşınmaz bilgileri alınamadı. Yeniden deneyin.";
        }
        finally { _loading = false; }
    }

    private void Filtrele()
    {
        var kelimeler = KontrolFormAdimlari.AramaMetni(_arama).Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        _gosterilen = _noktalar.Where(n => (_cinsi.Length == 0 || n.Cinsi == _cinsi)
            && kelimeler.All(k => KontrolFormAdimlari.AramaMetni($"{n.EmlakSicilNo} {n.Adres} {n.Cinsi} {n.Ili} {n.Ilcesi}").Contains(k, StringComparison.Ordinal))).ToList();
        _yenile = true;
    }

    private void TumunuGoster() { _arama = ""; _cinsi = ""; Filtrele(); }
    private void HaritayiYenidenDene() { _haritaHatasi = null; _yenile = true; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _loading || _veriHatasi is not null || !_yenile || _haritaIslemi) return;
        _haritaIslemi = true;
        _yenile = false;
        var noktalar = _gosterilen;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/tasinmaz-harita.js");
            if (_disposed) return;
            if (_harita is null) _harita = await _module.InvokeAsync<IJSObjectReference>("olustur", _haritaElementi);
            if (_disposed) return;
            await _harita.InvokeVoidAsync("guncelle", noktalar);
        }
        catch (Exception ex) when (ex is JSException or OperationCanceledException)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "Taşınmaz haritası başlatılamadı.");
            _haritaHatasi = "Harita yüklenemedi. İnternet bağlantınızı kontrol edip yeniden deneyin.";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _haritaIslemi = false;
            if (_disposed) await KaynaklariKapatAsync();
            else if (_yenile) await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (!_haritaIslemi) await KaynaklariKapatAsync();
    }

    private async ValueTask KaynaklariKapatAsync()
    {
        try
        {
            if (_harita is not null) { await _harita.InvokeVoidAsync("kapat"); await _harita.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException) { }
    }
}
