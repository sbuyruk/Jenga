@using Jenga.Models.TBYS.Kontrol
@using Jenga.DataAccess.Services.TBYS
@using System.Globalization
@inject IJSRuntime JS

@foreach (var bolum in (Bolumler ?? Tanim.Bolumler).OrderBy(b => b.Sira))
{
    <section class="kontrol-bolum">
        <div class="kontrol-bolum-baslik"><strong>@bolum.Baslik</strong>
            @if (!string.IsNullOrWhiteSpace(bolum.Aciklama)) { <small class="text-muted ms-2">@bolum.Aciklama</small> }
        </div>
        <div class="kontrol-bolum-icerik">
            @if (bolum.Kod == "kanaat" && !ReadOnly)
            {
                <div class="alert alert-info small mb-3" role="note">
                    <div class="fw-semibold mb-2"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Genel Değerlendirme ve Öneriler alanları mutlaka doldurulmalıdır.</div>
                    <p class="mb-2">Taşınmaza uygun olan konularda değerlendirmenizi ve önerilerinizi belirtin. Uygulanamayan konuları gerekçesiyle açıklayın.</p>
                    <ul class="mb-0">
                        <li>Taşınmazın tadilata ihtiyacı var mı?</li>
                        <li>Kira bedeli rayice uygun mu?</li>
                        <li>DASK yapılması gerekli mi?</li>
                        <li>Taşınmaza İlişkin Hukuki İşlem Var mı?</li>
                        <li>Taşınmazın kiraya verilebilirliği ve satış niteliği nasıl değerlendiriliyor?</li>
                        <li>Bilinmesi gereken çevresel faktörler var mı?</li>
                        <li>Tarla ve arsaların değerlendirilmesine ilişkin öneriler nelerdir?</li>
                    </ul>
                </div>
            }
            @if (bolum.Alanlar.Count > 0)
            {
                <div class="kontrol-alanlar">
                    @foreach (var alan in bolum.Alanlar.OrderBy(a => a.Sira))
                    {
                        <div @key="alan.Kod" class="kontrol-alan @KontrolFormAdimlari.AlanGenisligi(alan) @(SeciliAlanKodu == alan.Kod ? "kontrol-alan-secili" : "")"
                             tabindex="-1" @ref="_alanReferanslari[alan.Kod]">
                            @RenderAlan(alan, () => Cevaplar.Al(alan.Kod), v => Cevaplar.Alanlar[alan.Kod] = v, null, null)
                        </div>
                    }
                </div>
            }

            @foreach (var grup in bolum.Gruplar.OrderBy(g => g.Sira))
            {
                var satirlar = Satirlar(grup);
                <div @key="grup.Kod" class="mt-3 @(SeciliGrupKodu == grup.Kod && satirlar.Count == 0 ? "kontrol-alan-secili" : "")"
                     tabindex="-1" @ref="_grupReferanslari[grup.Kod]">
                    <div class="d-flex align-items-center mb-2">
                        <strong class="me-auto">@grup.Baslik</strong>
                        @if (!ReadOnly && grup.Tekrarlanabilir)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="async () => { satirlar.Add(new(StringComparer.OrdinalIgnoreCase)); Cevaplar.Gruplar[grup.Kod] = satirlar; await OnChanged.InvokeAsync(); }">
                                <i class="bi bi-plus-lg me-1"></i>Satır Ekle
                            </button>
                        }
                    </div>
                    @if (satirlar.Count == 0)
                    {
                        <div class="text-muted small fst-italic">Kayıt yok.</div>
                        @if (SeciliGrupKodu == grup.Kod && !ReadOnly)
                        {
                            <div class="small mt-1">Aradığınız “@grup.Alanlar.FirstOrDefault(a => a.Kod == SeciliAlanKodu)?.Baslik” alanını doldurmak için Satır Ekle düğmesini kullanabilirsiniz.</div>
                        }
                    }
                    @for (int i = 0; i < satirlar.Count; i++)
                    {
                        var idx = i;
                        var satir = satirlar[idx];
                        <div class="border rounded p-2 mb-2 bg-light-subtle @(grup.Kod == "bb_olculer" ? "kontrol-olcu-satiri" : "")">
                            @if (grup.Kod != "bb_olculer")
                            {
                                <div class="d-flex align-items-center mb-1">
                                    <small class="text-muted me-auto">#@(idx + 1)</small>
                                    @if (!ReadOnly && grup.Tekrarlanabilir)
                                    {
                                        var belgeEkleriVar = grup.Kod == "tasinmaz_belge_satirlari" && Ekler.Any(e => e.GrupKodu == grup.Kod && e.SatirNo >= idx);
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" disabled="@belgeEkleriVar" @onclick="async () => { satirlar.RemoveAt(idx); await OnChanged.InvokeAsync(); }" title="@(belgeEkleriVar ? "Bu ve sonraki satırların dosyalarını kaldırdıktan sonra satırı silebilirsiniz." : "Satırı sil")"><i class="bi bi-trash"></i></button>
                                    }
                                </div>
                            }
                            <div class="kontrol-alanlar">
                                @foreach (var alan in grup.Alanlar.OrderBy(a => a.Sira))
                                {
                                    <div class="kontrol-alan @KontrolFormAdimlari.AlanGenisligi(alan) @(SeciliAlanKodu == alan.Kod ? "kontrol-alan-secili" : "")" tabindex="-1">
                                        @RenderAlan(alan, () => satir.TryGetValue(alan.Kod, out var v) ? v : null, v => { satir[alan.Kod] = v; Cevaplar.Gruplar[grup.Kod] = satirlar; }, grup.Kod, idx)
                                    </div>
                                }
                            </div>
                            @if (grup.Kod == "bb_olculer" && !ReadOnly && grup.Tekrarlanabilir)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger kontrol-olcu-sil" @onclick="async () => { satirlar.RemoveAt(idx); await OnChanged.InvokeAsync(); }" title="Ölçü satırını sil" aria-label="Ölçü satırını sil"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            }
                        </div>
                    }
                    @if (grup.Kod == "bb_olculer")
                    {
                        <div class="kontrol-olcu-toplam" role="status" aria-live="polite">
                            <span>Toplam Alan (m²)</span>
                            <output aria-label="Toplam Alan (m²)">@(ToplamAlan(satirlar)?.ToString("N2", CultureInfo.GetCultureInfo("tr-TR")) ?? "Hesaplanamadı")</output>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public KontrolFormTanimi Tanim { get; set; } = new();
    [Parameter, EditorRequired] public KontrolCevaplari Cevaplar { get; set; } = new();
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public IReadOnlyList<KontrolBolumTanimi>? Bolumler { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public string? SeciliAlanKodu { get; set; }
    [Parameter] public string? SeciliGrupKodu { get; set; }
    [Parameter] public IReadOnlyList<TasinmazKontrolEk> Ekler { get; set; } = Array.Empty<TasinmazKontrolEk>();
    /// <summary>BölgePersoneli tipli alanlar için seçenekler (amir başta).</summary>
    [Parameter] public IReadOnlyList<BolgePersoneli> BolgePersonelleri { get; set; } = Array.Empty<BolgePersoneli>();
    /// <summary>Ek alanı için yükleme UI'ı (alanKodu, grupKodu, satirNo).</summary>
    [Parameter] public RenderFragment<(string AlanKodu, string? GrupKodu, int? SatirNo)>? EkYukleTemplate { get; set; }
    [Parameter] public EventCallback<TasinmazKontrolEk> OnEkSil { get; set; }

    private readonly Dictionary<string, ElementReference> _alanReferanslari = new();
    private readonly Dictionary<string, ElementReference> _grupReferanslari = new();

    public async Task<bool> AlanaOdaklanAsync(string alanKodu, string? grupKodu)
    {
        if ((grupKodu is null ? _alanReferanslari : _grupReferanslari).TryGetValue(grupKodu ?? alanKodu, out var hedef))
        {
            await hedef.FocusAsync();
            return true;
        }
        return false;
    }

    private List<Dictionary<string, string?>> Satirlar(KontrolGrupTanimi grup)
    {
        if (Cevaplar.Gruplar.TryGetValue(grup.Kod, out var s) && (s.Count > 0 || grup.Tekrarlanabilir || ReadOnly)) return s;
        // Yalnızca görüntülemek cevapları değiştirmez. Satır, kullanıcı düzenlediğinde kayda eklenir.
        return !grup.Tekrarlanabilir && !ReadOnly ? new() { new(StringComparer.OrdinalIgnoreCase) } : new();
    }

    private RenderFragment RenderAlan(KontrolAlanTanimi alan, Func<string?> oku, Action<string?> yaz, string? grupKodu, int? satirNo) => __builder =>
    {
        var saltOkunur = ReadOnly || alan.VeriKaynagi == KontrolVeriKaynagiTipi.TasinmazSaltOkunur;
        var deger = oku();
        async Task YazAsync(string? v) { yaz(v); await OnChanged.InvokeAsync(); }
        var id = $"f_{alan.Kod}_{satirNo?.ToString() ?? "x"}";

        <label class="form-label small mb-1" for="@id">
            @alan.Baslik
            @if (alan.Zorunlu) { <span class="text-danger">*</span> }
            @if (!string.IsNullOrWhiteSpace(alan.Birim)) { <span class="text-muted">(@alan.Birim)</span> }
            @if (alan.VeriKaynagi != KontrolVeriKaynagiTipi.Manuel) { <i class="bi bi-building text-muted ms-1" title="Taşınmaz kaydından"></i> }
        </label>

        @switch (alan.Tip)
        {
            case KontrolAlanTipi.Ek:
                var ekler = Ekler.Where(e => e.AlanKodu.Equals(alan.Kod, StringComparison.OrdinalIgnoreCase) && e.SatirNo == satirNo).ToList();
                <div>
                    @foreach (var ek in ekler)
                    {
                        <div class="d-flex align-items-center gap-2 small mb-1">
                            <a href="/api/tbys/kontrol-ek/@ek.Id" target="_blank"><i class="bi bi-paperclip"></i> @ek.DosyaAdi</a>
                            <span class="text-muted">(@((ek.Boyut / 1024.0).ToString("N0")) KB)</span>
                            @if (!ReadOnly)
                            {
                                <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => OnEkSil.InvokeAsync(ek)"><i class="bi bi-x-circle"></i></button>
                            }
                        </div>
                    }
                    @if (ekler.Count == 0) { <div class="text-muted small fst-italic">Ek yok.</div> }
                    @if (!ReadOnly && EkYukleTemplate is not null) { @EkYukleTemplate((alan.Kod, grupKodu, satirNo)) }
                </div>
                break;

            case KontrolAlanTipi.UzunMetin:
                <textarea id="@id" class="form-control form-control-sm" rows="3" disabled="@saltOkunur" @oninput="e => YazAsync(e.Value?.ToString())">@deger</textarea>
                break;

            case KontrolAlanTipi.TamSayi:
            case KontrolAlanTipi.OndalikSayi:
                <input id="@id" type="text" inputmode="decimal" class="form-control form-control-sm" disabled="@saltOkunur" value="@deger" @oninput="e => YazAsync(SayiNormalize(e.Value?.ToString()))" />
                break;

            case KontrolAlanTipi.Tarih:
                <input id="@id" type="date" class="form-control form-control-sm" disabled="@saltOkunur" value="@deger" @oninput="e => YazAsync(e.Value?.ToString())" />
                break;

            case KontrolAlanTipi.EvetHayir:
                <select id="@id" class="form-select form-select-sm" disabled="@saltOkunur" value="@(deger ?? "")" @onchange="e => YazAsync(string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())">
                    <option value="">—</option>
                    <option value="@nameof(EvetHayirCevabi.Evet)">Evet</option>
                    <option value="@nameof(EvetHayirCevabi.Hayir)">Hayır</option>
                    <option value="@nameof(EvetHayirCevabi.Uygulanamaz)">Uygulanamaz</option>
                </select>
                break;

            case KontrolAlanTipi.TekliSecim:
                <select id="@id" class="form-select form-select-sm" disabled="@saltOkunur" value="@(deger ?? "")" @onchange="e => YazAsync(string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())">
                    <option value="">—</option>
                    @foreach (var s in alan.Secenekler.OrderBy(s => s.Sira)) { <option value="@s.Kod">@s.Etiket</option> }
                </select>
                break;

            case KontrolAlanTipi.CokluSecim:
                var secili = new HashSet<string>((deger ?? "").Split(KontrolCevaplari.CokluSecimAyirici, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries), StringComparer.OrdinalIgnoreCase);
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var s in alan.Secenekler.OrderBy(s => s.Sira))
                    {
                        var kod = s.Kod;
                        <div class="form-check form-check-sm">
                            <input class="form-check-input" type="checkbox" id="@($"{id}_{kod}")" disabled="@saltOkunur" checked="@secili.Contains(kod)"
                                   @onchange="async e => { if ((bool)e.Value!) secili.Add(kod); else secili.Remove(kod); await YazAsync(secili.Count == 0 ? null : string.Join(KontrolCevaplari.CokluSecimAyirici, alan.Secenekler.Where(x => secili.Contains(x.Kod)).Select(x => x.Kod))); }" />
                            <label class="form-check-label small" for="@($"{id}_{kod}")">@s.Etiket</label>
                        </div>
                    }
                </div>
                break;

            case KontrolAlanTipi.BolgePersoneli:
                var listede = deger is not null && BolgePersonelleri.Any(p => p.AdSoyad == deger);
                <select id="@id" class="form-select form-select-sm" disabled="@saltOkunur" value="@(deger ?? "")" @onchange="e => YazAsync(string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())">
                    <option value="">—</option>
                    @if (deger is not null && !listede) { <option value="@deger">@deger</option> }
                    @foreach (var p in BolgePersonelleri)
                    {
                        <option value="@p.AdSoyad">@p.AdSoyad@(p.Unvan is null ? "" : $" – {p.Unvan}")@(p.Amir ? " (Birim Amiri)" : "")</option>
                    }
                </select>
                @if (BolgePersonelleri.Count == 0 && !saltOkunur) { <small class="text-muted">Bu bölgede tanımlı personel bulunamadı.</small> }
                break;

            default:
                <input id="@id" type="text" class="form-control form-control-sm" disabled="@saltOkunur" value="@deger" @oninput="e => YazAsync(e.Value?.ToString())" />
                break;
        }
        @if (alan.Kod == "konum_koordinat")
        {
            var haritaAdresi = HaritaAdresi(deger);
            <div class="d-flex flex-wrap gap-2 mt-2">
                @if (!saltOkunur)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_konumAliniyor" @onclick="KonumAlAsync">
                        <i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@(_konumAliniyor ? "Konum alınıyor…" : "Bulunduğum Konumu Al")
                    </button>
                }
                @if (haritaAdresi is not null)
                {
                    <a class="btn btn-sm btn-outline-secondary" href="@haritaAdresi" target="_blank" rel="noopener noreferrer"><i class="bi bi-map me-1" aria-hidden="true"></i>Haritada Göster</a>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => _haritaHatasi = "Geçerli bir enlem, boylam girin. Örnek: 39.925533, 32.866287"'><i class="bi bi-map me-1" aria-hidden="true"></i>Haritada Göster</button>
                }
            </div>
            @if (_haritaHatasi is not null && haritaAdresi is null)
            {
                <div class="text-danger small mt-1" role="alert">@_haritaHatasi</div>
            }
            @if (_konumHatasi is not null)
            {
                <div class="text-danger small mt-1" role="alert">@_konumHatasi</div>
            }
        }
    };

    private bool _konumAliniyor;
    private string? _konumHatasi;
    private string? _haritaHatasi;

    private static string? HaritaAdresi(string? koordinat)
    {
        if (string.IsNullOrWhiteSpace(koordinat)) return null;
        var eslesme = System.Text.RegularExpressions.Regex.Match(koordinat,
            @"^\s*([+-]?\d+(?:\.\d+)?)(?:\s*[,;]\s*|\s+)([+-]?\d+(?:\.\d+)?)\s*$");
        if (!eslesme.Success
            || !decimal.TryParse(eslesme.Groups[1].Value, NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var enlem)
            || !decimal.TryParse(eslesme.Groups[2].Value, NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var boylam)
            || enlem is < -90 or > 90 || boylam is < -180 or > 180) return null;
        var sorgu = $"{enlem.ToString(CultureInfo.InvariantCulture)},{boylam.ToString(CultureInfo.InvariantCulture)}";
        return $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(sorgu)}";
    }

    public sealed class KonumSonucu
    {
        public string? Koordinat { get; set; }
        public string? Hata { get; set; }
    }

    private async Task KonumAlAsync()
    {
        var alan = Tanim.AlanBul("konum_koordinat");
        if (_konumAliniyor || ReadOnly || alan is null || alan.VeriKaynagi == KontrolVeriKaynagiTipi.TasinmazSaltOkunur) return;
        var cevaplar = Cevaplar;
        _konumAliniyor = true;
        _konumHatasi = null;
        try
        {
            var sonuc = await JS.InvokeAsync<KonumSonucu>("kontrolKonum.al");
            if (ReadOnly || !ReferenceEquals(cevaplar, Cevaplar)) return;
            if (string.IsNullOrWhiteSpace(sonuc?.Koordinat))
                _konumHatasi = sonuc?.Hata ?? "Konum alınamadı. Yeniden deneyin.";
            else
            {
                Cevaplar.Koy("konum_koordinat", sonuc.Koordinat);
                await OnChanged.InvokeAsync();
            }
        }
        catch (JSException) { _konumHatasi = "Konum alınamadı. Yeniden deneyin."; }
        catch (OperationCanceledException) { _konumHatasi = "Konum isteği zaman aşımına uğradı. Yeniden deneyin."; }
        finally { _konumAliniyor = false; }
    }

    private static decimal? ToplamAlan(IEnumerable<Dictionary<string, string?>> satirlar)
    {
        decimal toplam = 0;
        foreach (var satir in satirlar)
        {
            var deger = SayiNormalize(satir.GetValueOrDefault("bbo_olcu_alan"));
            if (!decimal.TryParse(deger, NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var alan)) continue;
            try { toplam += alan; }
            catch (OverflowException) { return null; }
        }
        return toplam;
    }

    private static string? SayiNormalize(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        s = s.Trim();
        // Kullanıcı tr-TR ondalık virgül girebilir; depolama invariant.
        if (s.Contains(',') && !s.Contains('.')) s = s.Replace(',', '.');
        return s;
    }
}
