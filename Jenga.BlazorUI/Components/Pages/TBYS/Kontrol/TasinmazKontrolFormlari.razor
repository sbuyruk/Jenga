@page "/tbys/tasinmaz-kontrol-formlari"
@rendermode InteractiveServer

@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.BlazorUI.Services.Common.Toast
@using Jenga.DataAccess.Services.TBYS
@using Jenga.Models.Enums
@using Jenga.Models.TBYS.Kontrol
@using System.Globalization

@inject ITasinmazKontrolFormService FormService
@inject IToastService Toast
@inject IModalService Modal

<PermissionGuard Module="ModuleName.TBYS" Operation="Operation.View">
<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
    <h5 class="mb-0 fw-bold"><i class="bi bi-ui-checks me-2 text-primary"></i>Kontrol Form Şablonları</h5>
    <div class="ms-auto d-flex gap-2 align-items-center">
        <div class="form-check form-check-sm mb-0">
            <input class="form-check-input" type="checkbox" id="arsiv" @bind="_arsivDahil" @bind:after="YenileAsync" />
            <label class="form-check-label small" for="arsiv">Arşivdekileri göster</label>
        </div>
        <PermissionGuard Module="ModuleName.TBYS" Operation="Operation.Create" HideWhenUnauthorized="true">
            <button class="btn btn-sm btn-primary" @onclick="YeniAc"><i class="bi bi-plus-lg me-1"></i>Yeni Form</button>
        </PermissionGuard>
        <button class="btn btn-sm btn-outline-secondary" @onclick="YenileAsync"><i class="bi bi-arrow-clockwise"></i></button>
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <GenericTable TItem="TasinmazKontrolForm" Items="_formlar" TableHeight="70vh" TableClass="table-bordered table-hover" ShowCopy="false"
                          SearchTextSelector="@(f => $"{f.Kod} {f.Ad} {f.Kapsam} {f.KapsamCinsi}")">
                <HeaderTemplate>
                    <th style="min-width:210px">İşlem</th>
                    <th>Kod</th>
                    <th>Ad</th>
                    <th>Sürüm</th>
                    <th>Kapsam</th>
                    <th>Durum</th>
                    <th>Varsayılan Periyot</th>
                    <th>Yayım</th>
                </HeaderTemplate>
                <RowTemplate Context="f">
                    <td>
                        <button class="btn btn-sm btn-outline-secondary me-1" title="@(f.Durum == KontrolFormDurumu.Taslak ? "Düzenle" : "Görüntüle")" @onclick="() => DuzenleAc(f)">
                            <i class="bi @(f.Durum == KontrolFormDurumu.Taslak ? "bi-pencil" : "bi-eye")"></i>
                        </button>
                        @if (f.Durum == KontrolFormDurumu.Taslak)
                        {
                            <button class="btn btn-sm btn-success me-1" title="Yayımla" @onclick="() => YayimlaAsync(f)"><i class="bi bi-megaphone"></i></button>
                            <button class="btn btn-sm btn-outline-danger me-1" title="Taslağı Sil" @onclick="() => SilAsync(f)"><i class="bi bi-trash"></i></button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-primary me-1" title="Yeni Sürüm (taslak)" @onclick="() => YeniSurumAsync(f)"><i class="bi bi-layers"></i></button>
                            <button class="btn btn-sm btn-outline-secondary me-1" title="Kopyala" @onclick="() => KopyaAc(f)"><i class="bi bi-copy"></i></button>
                        }
                        @if (f.Durum == KontrolFormDurumu.Yayimlanmis)
                        {
                            <button class="btn btn-sm btn-outline-warning" title="Arşivle" @onclick="() => ArsivleAsync(f)"><i class="bi bi-archive"></i></button>
                        }
                    </td>
                    <td>@f.Kod</td>
                    <td>@f.Ad</td>
                    <td>v@(f.Surum)</td>
                    <td>@KapsamEtiket(f)</td>
                    <td><span class="badge @DurumRenk(f.Durum)">@DurumEtiket(f.Durum)</span></td>
                    <td>@KontrolPeriyodu.Etiket(f.VarsayilanPeriyotSure, f.VarsayilanPeriyotBirim)</td>
                    <td>@(f.YayimTarihi?.ToString("d", Tr) ?? "—")</td>
                </RowTemplate>
            </GenericTable>
        </div>
    </div>
}

@if (_duzenlenen is not null)
{
    var ro = _duzenlenen.Id != 0 && _duzenlenen.Durum != KontrolFormDurumu.Taslak;
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.4)">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">@(_duzenlenen.Id == 0 ? "Yeni Form" : $"{_duzenlenen.Ad} (v{_duzenlenen.Surum})") @if (ro) { <span class="badge bg-secondary ms-2">Salt okunur</span> }</h6>
                    <ul class="nav nav-pills nav-sm ms-3">
                        <li class="nav-item"><button class="nav-link py-1 @(_sekme == 0 ? "active" : "")" @onclick="() => _sekme = 0">Bilgiler</button></li>
                        <li class="nav-item"><button class="nav-link py-1 @(_sekme == 1 ? "active" : "")" @onclick="() => _sekme = 1">Tanım (JSON)</button></li>
                        <li class="nav-item"><button class="nav-link py-1 @(_sekme == 2 ? "active" : "")" @onclick="Onizle">Önizleme</button></li>
                    </ul>
                    <button type="button" class="btn-close" @onclick="() => _duzenlenen = null"></button>
                </div>
                <div class="modal-body">
                    @if (_sekme == 0)
                    {
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label small mb-1">Kod <span class="text-danger">*</span></label>
                                <input class="form-control form-control-sm" disabled="@(ro || _duzenlenen.Id != 0)" @bind="_duzenlenen.Kod" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">Ad <span class="text-danger">*</span></label>
                                <input class="form-control form-control-sm" disabled="@ro" @bind="_duzenlenen.Ad" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-1">Kapsam</label>
                                <select class="form-select form-select-sm" disabled="@ro" @bind="_duzenlenen.Kapsam">
                                    <option value="@KontrolFormKapsami.Genel">Genel</option>
                                    <option value="@KontrolFormKapsami.Cins">Cins</option>
                                    <option value="@KontrolFormKapsami.Tasinmaz">Taşınmaz</option>
                                </select>
                            </div>
                            @if (_duzenlenen.Kapsam == KontrolFormKapsami.Cins)
                            {
                                <div class="col-md-4">
                                    <label class="form-label small mb-1">Cins <span class="text-danger">*</span></label>
                                    <input class="form-control form-control-sm" disabled="@ro" @bind="_duzenlenen.KapsamCinsi" placeholder="örn. ARSA" />
                                </div>
                            }
                            @if (_duzenlenen.Kapsam == KontrolFormKapsami.Tasinmaz)
                            {
                                <div class="col-md-4">
                                    <label class="form-label small mb-1">Taşınmaz Id <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control form-control-sm" disabled="@ro" @bind="_duzenlenen.KapsamTasinmazId" />
                                </div>
                            }
                            <div class="col-md-2">
                                <label class="form-label small mb-1">Varsayılan Periyot</label>
                                <input type="number" min="1" class="form-control form-control-sm" disabled="@ro" @bind="_duzenlenen.VarsayilanPeriyotSure" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small mb-1">Birim</label>
                                <select class="form-select form-select-sm" disabled="@ro" @bind="_duzenlenen.VarsayilanPeriyotBirim">
                                    <option value="">—</option>
                                    @foreach (var b in Enum.GetValues<PeriyotBirimi>()) { <option value="@b">@b</option> }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small mb-1">Açıklama</label>
                                <textarea class="form-control form-control-sm" rows="2" disabled="@ro" @bind="_duzenlenen.Aciklama"></textarea>
                            </div>
                            @if (_duzenlenen.Id != 0)
                            {
                                <div class="col-12 small text-muted">
                                    Durum: @DurumEtiket(_duzenlenen.Durum)
                                    @if (_duzenlenen.YayimTarihi is not null) { <span class="ms-3">Yayım: @_duzenlenen.YayimTarihi?.ToString("g", Tr) (@_duzenlenen.Yayimlayan)</span> }
                                    @if (_duzenlenen.ArsivTarihi is not null) { <span class="ms-3">Arşiv: @_duzenlenen.ArsivTarihi?.ToString("g", Tr) (@_duzenlenen.Arsivleyen)</span> }
                                    @if (_duzenlenen.KaynakFormId is not null) { <span class="ms-3">Kaynak form: #@_duzenlenen.KaynakFormId</span> }
                                </div>
                            }
                        </div>
                    }
                    else if (_sekme == 1)
                    {
                        <div class="d-flex gap-2 mb-2">
                            @if (!ro)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="VarsayilanYukle"><i class="bi bi-file-earmark-text me-1"></i>Excel şablonunu yükle</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="Bicimlendir"><i class="bi bi-braces me-1"></i>Biçimlendir</button>
                            }
                            <button class="btn btn-sm btn-outline-primary" @onclick="Dogrula"><i class="bi bi-check2-all me-1"></i>Doğrula</button>
                        </div>
                        <textarea class="form-control form-control-sm font-monospace" rows="22" readonly="@ro" @bind="_duzenlenen.TanimJson"></textarea>
                        @if (_dogrulamaHatalari is not null)
                        {
                            @if (_dogrulamaHatalari.Count == 0) { <div class="alert alert-success py-2 mt-2 small">Tanım geçerli.</div> }
                            else
                            {
                                <div class="alert alert-danger py-2 mt-2 small"><ul class="mb-0">@foreach (var h in _dogrulamaHatalari) { <li>@h</li> }</ul></div>
                            }
                        }
                    }
                    else
                    {
                        @if (_onizleme is null) { <div class="alert alert-warning py-2 small">Tanım JSON çözümlenemedi: @_onizlemeHata</div> }
                        else { <KontrolFormRenderer Tanim="_onizleme" Cevaplar="_onizlemeCevap" ReadOnly="false" /> }
                    }
                    @if (_hata is not null) { <div class="alert alert-danger py-2 small mt-2">@_hata</div> }
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-sm btn-secondary" @onclick="() => _duzenlenen = null">Kapat</button>
                    @if (!ro)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="KaydetAsync" disabled="@_busy"><i class="bi bi-save me-1"></i>Kaydet</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_kopyaKaynak is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2"><h6 class="modal-title">Formu Kopyala — @_kopyaKaynak.Ad</h6><button type="button" class="btn-close" @onclick="() => _kopyaKaynak = null"></button></div>
                <div class="modal-body">
                    <div class="mb-2"><label class="form-label small mb-1">Yeni Kod</label><input class="form-control form-control-sm" @bind="_kopyaKod" /></div>
                    <div class="mb-2"><label class="form-label small mb-1">Yeni Ad</label><input class="form-control form-control-sm" @bind="_kopyaAd" /></div>
                    @if (_hata is not null) { <div class="alert alert-danger py-2 small">@_hata</div> }
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-sm btn-secondary" @onclick="() => _kopyaKaynak = null">Vazgeç</button>
                    <button class="btn btn-sm btn-primary" @onclick="KopyalaAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_kopyaKod) || string.IsNullOrWhiteSpace(_kopyaAd))">Kopyala</button>
                </div>
            </div>
        </div>
    </div>
}
</PermissionGuard>

@code {
    private static readonly CultureInfo Tr = new("tr-TR");

    private bool _loading = true, _busy, _arsivDahil;
    private string? _hata;
    private List<TasinmazKontrolForm> _formlar = new();

    private TasinmazKontrolForm? _duzenlenen;
    private int _sekme;
    private List<string>? _dogrulamaHatalari;
    private KontrolFormTanimi? _onizleme;
    private KontrolCevaplari _onizlemeCevap = new();
    private string? _onizlemeHata;

    private TasinmazKontrolForm? _kopyaKaynak;
    private string? _kopyaKod, _kopyaAd;

    protected override async Task OnInitializedAsync() => await YenileAsync();

    private async Task YenileAsync()
    {
        _loading = true;
        var r = await FormService.GetAllAsync(_arsivDahil);
        _formlar = r.IsSuccess ? r.Value : new();
        if (r.IsFailure) Toast.ShowError(r.Error.Message);
        _loading = false;
    }

    private void YeniAc()
    {
        _hata = null; _dogrulamaHatalari = null; _sekme = 0;
        _duzenlenen = new TasinmazKontrolForm { TanimJson = new KontrolFormTanimi().ToJson() };
    }

    private async Task DuzenleAc(TasinmazKontrolForm f)
    {
        _hata = null; _dogrulamaHatalari = null; _sekme = 0;
        var r = await FormService.GetByIdAsync(f.Id);
        if (r.IsFailure) { Toast.ShowError(r.Error.Message); return; }
        _duzenlenen = r.Value;
    }

    private void VarsayilanYukle()
    {
        if (_duzenlenen is null) return;
        _duzenlenen.TanimJson = VarsayilanKontrolFormu.Olustur().ToJson();
        _dogrulamaHatalari = null;
    }

    private void Bicimlendir()
    {
        if (_duzenlenen is null) return;
        try { _duzenlenen.TanimJson = KontrolFormTanimi.FromJson(_duzenlenen.TanimJson).ToJson(); _hata = null; }
        catch (Exception ex) { _hata = "JSON çözümlenemedi: " + ex.Message; }
    }

    private void Dogrula()
    {
        if (_duzenlenen is null) return;
        try
        {
            var tanim = KontrolFormTanimi.FromJson(_duzenlenen.TanimJson);
            _dogrulamaHatalari = KontrolFormDogrulayici.TanimiDogrula(tanim).ToList();
            _hata = null;
        }
        catch (Exception ex) { _dogrulamaHatalari = new() { "JSON çözümlenemedi: " + ex.Message }; }
    }

    private void Onizle()
    {
        _sekme = 2; _onizlemeCevap = new();
        try { _onizleme = KontrolFormTanimi.FromJson(_duzenlenen?.TanimJson); _onizlemeHata = null; }
        catch (Exception ex) { _onizleme = null; _onizlemeHata = ex.Message; }
    }

    private async Task KaydetAsync()
    {
        if (_duzenlenen is null) return;
        _busy = true; _hata = null;
        if (_duzenlenen.Id == 0)
        {
            var r = await FormService.AddAsync(_duzenlenen);
            if (r.IsSuccess) { Toast.ShowSuccess("Form taslağı oluşturuldu."); _duzenlenen = null; await YenileAsync(); } else _hata = r.Error.Message;
        }
        else
        {
            var r = await FormService.UpdateAsync(_duzenlenen);
            if (r.IsSuccess) { Toast.ShowSuccess("Form kaydedildi."); _duzenlenen = null; await YenileAsync(); } else _hata = r.Error.Message;
        }
        _busy = false;
    }

    private Task YayimlaAsync(TasinmazKontrolForm f)
    {
        Modal.ShowConfirmation("Formu Yayımla", $"'{f.Ad}' v{f.Surum} yayımlanacak. Aynı kodlu önceki yayım arşivlenir ve bu sürüm artık değiştirilemez. Devam edilsin mi?", async ok =>
        {
            if (!ok) return;
            var r = await FormService.YayimlaAsync(f.Id);
            if (r.IsSuccess) Toast.ShowSuccess("Form yayımlandı."); else Toast.ShowError(r.Error.Message);
            await YenileAsync(); await InvokeAsync(StateHasChanged);
        });
        return Task.CompletedTask;
    }

    private Task ArsivleAsync(TasinmazKontrolForm f)
    {
        Modal.ShowConfirmation("Formu Arşivle", $"'{f.Ad}' v{f.Surum} arşivlenecek; yeni kontrol başlatılamaz, mevcut kayıtlar korunur. Devam edilsin mi?", async ok =>
        {
            if (!ok) return;
            var r = await FormService.ArsivleAsync(f.Id);
            if (r.IsSuccess) Toast.ShowSuccess("Form arşivlendi."); else Toast.ShowError(r.Error.Message);
            await YenileAsync(); await InvokeAsync(StateHasChanged);
        });
        return Task.CompletedTask;
    }

    private Task SilAsync(TasinmazKontrolForm f)
    {
        Modal.ShowConfirmation("Taslağı Sil", $"'{f.Ad}' v{f.Surum} taslağı silinecek. Devam edilsin mi?", async ok =>
        {
            if (!ok) return;
            var r = await FormService.DeleteAsync(f.Id);
            if (r.IsSuccess) Toast.ShowSuccess("Taslak silindi."); else Toast.ShowError(r.Error.Message);
            await YenileAsync(); await InvokeAsync(StateHasChanged);
        });
        return Task.CompletedTask;
    }

    private async Task YeniSurumAsync(TasinmazKontrolForm f)
    {
        var r = await FormService.YeniSurumOlusturAsync(f.Id);
        if (r.IsFailure) { Toast.ShowError(r.Error.Message); return; }
        Toast.ShowSuccess("Yeni taslak sürüm oluşturuldu.");
        await YenileAsync();
        var yeni = _formlar.FirstOrDefault(x => x.Id == r.Value);
        if (yeni is not null) await DuzenleAc(yeni);
    }

    private void KopyaAc(TasinmazKontrolForm f)
    {
        _hata = null; _kopyaKaynak = f; _kopyaKod = f.Kod + "-KOPYA"; _kopyaAd = f.Ad + " (Kopya)";
    }

    private async Task KopyalaAsync()
    {
        if (_kopyaKaynak is null) return;
        _busy = true; _hata = null;
        var r = await FormService.KopyalaAsync(_kopyaKaynak.Id, _kopyaKod!.Trim(), _kopyaAd!.Trim());
        _busy = false;
        if (r.IsSuccess) { Toast.ShowSuccess("Form kopyalandı."); _kopyaKaynak = null; await YenileAsync(); } else _hata = r.Error.Message;
    }

    private static string KapsamEtiket(TasinmazKontrolForm f) => f.Kapsam switch
    {
        KontrolFormKapsami.Cins => $"Cins: {f.KapsamCinsi}",
        KontrolFormKapsami.Tasinmaz => $"Taşınmaz #{f.KapsamTasinmazId}",
        _ => "Genel"
    };
    private static string DurumEtiket(KontrolFormDurumu d) => d switch
    {
        KontrolFormDurumu.Taslak => "Taslak", KontrolFormDurumu.Yayimlanmis => "Yayımda", KontrolFormDurumu.Arsivlenmis => "Arşiv", _ => d.ToString()
    };
    private static string DurumRenk(KontrolFormDurumu d) => d switch
    {
        KontrolFormDurumu.Taslak => "bg-secondary", KontrolFormDurumu.Yayimlanmis => "bg-success", _ => "bg-dark"
    };
}
