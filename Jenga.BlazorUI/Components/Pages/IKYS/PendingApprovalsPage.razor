@page "/ikys/pending-approvals"
@rendermode InteractiveServer

@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.IKYS
@using Jenga.Models.Enums
@using Jenga.Models.IKYS

@inject IGorevOnayService GorevOnayService
@inject ICurrentUserService CurrentUserService
@inject ILogger<PendingApprovalsPage> Logger

<div class="pending-approvals-page">
<PermissionGuard Module="ModuleName.IKYS" Operation="Operation.View">

    <h3 class="mb-3">
        <i class="bi bi-clock-history me-2"></i>Bekleyen İşlemler
    </h3>

    <PermissionGuard Module="ModuleName.IKYS" Operation="Operation.Manage" HideWhenUnauthorized="true">
        <a class="btn btn-outline-secondary mb-3" href="/ikys/leave-requests/manage">İzin Talepleri</a>
    </PermissionGuard>

    @if (_isLoading)
    {
        <JengaLoading Message="Veriler yükleniyor…" />
    }
    else if (_loadFailed)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@_loadError</span>
            <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="LoadDataAsync">Tekrar Dene</button>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@_successMessage
                <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@_errorMessage
                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        @if (_noManagerUnits && _pendingTasks.Count == 0 && _recentApprovedTasks.Count == 0)
        {
            <div class="alert alert-info">Bekleyen işlem bulunamadı.</div>
        }
        @if (!_noManagerUnits)
        {
            <h4 class="h5 mt-4">Onay İşlemleri</h4>
            @if (_items.Count == 0)
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox me-2"></i>Bekleyen işlem bulunamadı.
                </div>
            }
            else
            {
                <GenericTable TItem="PendingApprovalItem"
                              Items="_items"
                              TableHeight="Auto"
                              ShowSearch="true"
                              ShowExport="true"
                              ExportFileName="bekleyen-islemler.xlsx"
                              ExportHeaders="PendingApprovalExport.ReviewHeaders"
                              ExportRow="PendingApprovalExport.ReviewRow"
                              RowClassSelector="GetRowClass"
                              KeySelector="(item => item.GorevOnayId)">
                    <HeaderTemplate>
                        <th>Adı Soyadı</th>
                        <th>Başlangıç Tarihi</th>
                        <th>Bitiş Tarihi</th>
                        <th>Görevin Sebebi</th>
                        <th>Görevin Yeri</th>
                        <th>Ulaşım Aracı</th>
                        <th>Transfer</th>
                        <th>Konaklama</th>
                        <th>Açıklama</th>
                        <th>Durum</th>
                        <th class="pending-approval-actions-column">İşlemler</th>
                    </HeaderTemplate>
                    <RowTemplate Context="item">
                        <td>@item.AdiSoyadi</td>
                        <td>@item.BaslangicTarihi?.ToString("dd.MM.yyyy")</td>
                        <td>@item.BitisTarihi?.ToString("dd.MM.yyyy")</td>
                        <td>@item.GorevinSebebi</td>
                        <td>@item.GorevinYeri</td>
                        <td>@item.UlasimAraci</td>
                        <td>@item.Transfer</td>
                        <td>@item.Konaklama</td>
                        <td>@item.Aciklama</td>
                        <td>
                            <ApprovalStatusBadge Status="item.ApprovalStatus" />
                            @if (item.ApprovalStatus == ApprovalStatus.Rejected)
                            {
                                <div class="small text-danger">@item.OnayRedAciklama</div>
                            }
                        </td>
                        <td>
                            <div class="pending-approval-actions d-flex flex-column gap-1">
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => OpenDetail(item)">
                                    <i class="bi bi-eye"></i> İncele
                                </button>
                                @if (_canManage && item.ApprovalStatus == ApprovalStatus.PendingApproval)
                                {
                                    <button class="btn btn-sm btn-outline-success"
                                            @onclick="() => OpenApproveConfirm(item)"
                                            disabled="@_isBusy">
                                        <i class="bi bi-check-lg"></i> Onayla
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => OpenRejectDialog(item)"
                                            disabled="@_isBusy">
                                        <i class="bi bi-x-lg"></i> Reddet
                                    </button>
                                }
                            </div>
                        </td>
                    </RowTemplate>
                </GenericTable>
            }
        }
        @if (_pendingTasks.Count > 0)
        {
            <section class="mt-4">
                <h4 class="h5">@(_isAuthorizedIkysView ? "Onay Bekleyen Görevler" : "Onay Bekleyen Görevlerim")</h4>
                <PendingApprovalReadOnlyTable Items="_pendingTasks" ExportFileName="onay-bekleyen-gorevler.xlsx" />
            </section>
        }
        @if (_recentApprovedTasks.Count > 0)
        {
            <details class="mt-4">
                <summary class="text-primary">@(_isAuthorizedIkysView ? "Son 5 Onaylanmış Görev" : "Son 5 Onaylanmış Görevim")</summary>
                <p class="text-secondary mt-2">Görev başlangıç tarihine göre en yeni kayıtlar gösterilmektedir.</p>
                <PendingApprovalReadOnlyTable Items="_recentApprovedTasks" ExportFileName="son-onaylanmis-gorevler.xlsx" />
            </details>
        }
    }
</PermissionGuard>
</div>

<!-- Detail Modal -->
@if (_detailItem != null)
{
    <PendingApprovalDetailModal Item="_detailItem" OnClose="CloseDetail" />
}

<!-- Approve Confirmation Modal -->
@if (_approveItem != null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.4)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Onaylama Onayı</h5>
                    <button type="button" class="btn-close" disabled="@_isBusy" @onclick="() => _approveItem = null"></button>
                </div>
                <div class="modal-body">
                    <p>
                        <strong>@_approveItem.AdiSoyadi</strong> için
                        @_approveItem.BaslangicTarihi?.ToString("dd.MM.yyyy") -
                        @_approveItem.BitisTarihi?.ToString("dd.MM.yyyy")
                        tarihleri arasındaki görevi onaylamak istediğinize emin misiniz?
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" disabled="@_isBusy" @onclick="() => _approveItem = null">İptal</button>
                    <button class="btn btn-success" @onclick="ConfirmApproveAsync" disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <JengaLoading Inline="true" />
                        }
                        Evet, Onayla
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Reject Dialog Modal -->
@if (_rejectItem != null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.4)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reddetme Gerekçesi</h5>
                    <button type="button" class="btn-close" disabled="@_isBusy" @onclick="() => { _rejectItem = null; _rejectReason = null; }"></button>
                </div>
                <div class="modal-body">
                    <p>
                        <strong>@_rejectItem.AdiSoyadi</strong> için
                        @_rejectItem.BaslangicTarihi?.ToString("dd.MM.yyyy") -
                        @_rejectItem.BitisTarihi?.ToString("dd.MM.yyyy")
                        tarihleri arasındaki görevi reddetmek için gerekçe giriniz:
                    </p>
                    <textarea class="form-control" rows="4" placeholder="Reddetme gerekçesi (zorunlu)"
                              @bind="_rejectReason"></textarea>
                    @if (_rejectReasonError)
                    {
                        <div class="text-danger small mt-1">Gerekçe alanı boş bırakılamaz.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" disabled="@_isBusy" @onclick="() => { _rejectItem = null; _rejectReason = null; _rejectReasonError = false; }">İptal</button>
                    <button class="btn btn-danger" @onclick="ConfirmRejectAsync" disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <JengaLoading Inline="true" />
                        }
                        Reddet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PendingApprovalItem> _items = new();
    private bool _isLoading = true;
    private bool _loadFailed;
    private bool _noManagerUnits;
    [SupplyParameterFromQuery(Name = "Auth")]
    public string? Auth { get; set; }

    private bool _isAuthorizedIkysView;
    private bool _canManage;
    private List<PendingApprovalItem> _pendingTasks = [];
    private List<PendingApprovalItem> _recentApprovedTasks = [];
    private string? _loadError;
    private string? _successMessage;
    private string? _errorMessage;
    private bool _isBusy;

    private PendingApprovalItem? _detailItem;
    private PendingApprovalItem? _approveItem;
    private PendingApprovalItem? _rejectItem;
    private string? _rejectReason;
    private bool _rejectReasonError;

    private int? _managerPersonelId;
    private bool _interactiveReady;
    private string? _loadedAuth;

    protected override async Task OnParametersSetAsync()
    {
        if (_interactiveReady && !string.Equals(_loadedAuth, Auth, StringComparison.Ordinal))
            await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interactiveReady = true;
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _loadedAuth = Auth;
        _isLoading = true;
        _loadFailed = false;
        _noManagerUnits = false;
        StateHasChanged();

        try
        {
            if (!await CurrentUserService.HasPermissionAsync(ModuleName.IKYS, Operation.View))
            {
                _loadFailed = true;
                _loadError = "Bu sayfayı görüntüleme yetkiniz bulunmuyor.";
                return;
            }
            _canManage = await CurrentUserService.HasPermissionAsync(ModuleName.IKYS, Operation.Manage);
            _isAuthorizedIkysView = string.Equals(Auth, "IKYS", StringComparison.OrdinalIgnoreCase) && _canManage;
            var personel = await CurrentUserService.GetCurrentPersonelAsync();
            if (personel is null && !_isAuthorizedIkysView)
            {
                _loadFailed = true;
                _loadError = "Mevcut kullanıcı bilgisi alınamadı.";
                return;
            }
            _managerPersonelId = personel?.Id;

            var result = await GorevOnayService.GetPendingApprovalsAsync(_managerPersonelId, _isAuthorizedIkysView);
            if (!result.IsSuccess)
            {
                _loadFailed = true;
                _loadError = result.Error?.Message ?? "Veriler yüklenemedi.";
                return;
            }

            _items = result.Value.ReviewItems;
            _pendingTasks = result.Value.PendingTasks;
            _recentApprovedTasks = result.Value.RecentApprovedTasks;
            _noManagerUnits = !result.Value.HasManagerUnits;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PendingApprovalsPage.LoadDataAsync");
            _loadFailed = true;
            _loadError = "Beklenmeyen bir hata oluştu.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private string? GetRowClass(PendingApprovalItem item) => item.ApprovalStatus switch
    {
        ApprovalStatus.Approved => "table-success",
        ApprovalStatus.Rejected => "table-danger",
        _ => ""
    };

    private void OpenDetail(PendingApprovalItem item) => _detailItem = item;
    private void CloseDetail() => _detailItem = null;


    private void OpenApproveConfirm(PendingApprovalItem item) => _approveItem = item;

    private void OpenRejectDialog(PendingApprovalItem item)
    {
        _rejectItem = item;
        _rejectReason = null;
        _rejectReasonError = false;
    }

    private async Task ConfirmApproveAsync()
    {
        if (_approveItem is null || _isBusy) return;
        var item = _approveItem;
        _isBusy = true;
        _successMessage = null;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var userName = await CurrentUserService.GetUserNameAsync();
            var result = await GorevOnayService.ApproveAsync(item.GorevOnayId, _managerPersonelId ?? 0, userName, authorizedIkysView: _isAuthorizedIkysView);
            if (result.IsSuccess)
            {
                _successMessage = $"{item.AdiSoyadi} için görev başarıyla onaylandı.";
                _approveItem = null;
                await LoadDataAsync();
            }
            else
            {
                _errorMessage = result.Error?.Message ?? "Onaylama başarısız oldu.";
                _approveItem = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Bekleyen görev onay işlemi tamamlanamadı.");
            _errorMessage = "İşlem tamamlanamadı. Lütfen listeyi yenileyip tekrar deneyin.";
            _approveItem = null;
            _rejectItem = null;
        }
        finally
        {
            _isBusy = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmRejectAsync()
    {
        if (_rejectItem is null || _isBusy) return;
        var item = _rejectItem;

        if (string.IsNullOrWhiteSpace(_rejectReason))
        {
            _rejectReasonError = true;
            return;
        }

        _isBusy = true;
        _successMessage = null;
        _errorMessage = null;
        _rejectReasonError = false;
        StateHasChanged();

        try
        {
            var userName = await CurrentUserService.GetUserNameAsync();
            var result = await GorevOnayService.RejectAsync(item.GorevOnayId, _managerPersonelId ?? 0, _rejectReason!, userName, authorizedIkysView: _isAuthorizedIkysView);
            if (result.IsSuccess)
            {
                _successMessage = $"{item.AdiSoyadi} için görev reddedildi.";
                _rejectItem = null;
                _rejectReason = null;
                await LoadDataAsync();
            }
            else
            {
                _errorMessage = result.Error?.Message ?? "Reddetme başarısız oldu.";
                _rejectItem = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Bekleyen görev reddetme işlemi tamamlanamadı.");
            _errorMessage = "İşlem tamamlanamadı. Lütfen listeyi yenileyip tekrar deneyin.";
            _rejectItem = null;
        }
        finally
        {
            _isBusy = false;
            StateHasChanged();
        }
    }
}
