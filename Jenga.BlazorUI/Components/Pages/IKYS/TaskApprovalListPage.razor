@page "/ikys/task-approvals"
@page "/ikys/task-approvals/personal"
@rendermode InteractiveServer

@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.IKYS
@using Jenga.Models.Enums
@using Jenga.Models.IKYS

@inject IGorevOnayService GorevOnayService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject ILogger<TaskApprovalListPage> Logger

<div class="task-approval-page">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-outline-primary" href="/ikys/task-approvals/personal">Kişisel Görev Onay Listem</a>
        @if (_canManage)
        {
            <a class="btn btn-outline-primary" href="/ikys/task-approvals">Genel Görev Onay Listesi</a>
        }
    </div>
    <PermissionGuard Module="ModuleName.IKYS" Operation="@(IsPersonalView ? Operation.View : Operation.Manage)">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <h3 class="mb-0 me-auto"><i class="bi bi-card-checklist me-2"></i>@(IsPersonalView ? "Kişisel Görev Onay Listesi" : "Görev Onay Listesi")</h3>
            @if (_canCreate)
            {
                <button class="btn btn-outline-success" @onclick="NavigateToNew">Yeni Görev Onayı</button>
            }
            @if (!IsPersonalView && _canManage)
            {
                <button class="btn btn-outline-primary" disabled="@(_selectedIds.Count == 0 || _isBusy)" @onclick="CreateBulkReport">Seçilen Görevler İçin Rapor Al</button>
                <button class="btn btn-outline-success" disabled="@(_selectedIds.Count == 0 || _isBusy)" @onclick="() => _confirmPaid = true">Ödendi Yap</button>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert alert-info" role="status">@_message</div>
        }
        @if (_isLoading)
        {
            <JengaLoading Message="Görev onayları yükleniyor…" />
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <div class="alert alert-danger d-flex flex-wrap align-items-center gap-2">
                <span>@_loadError</span>
                <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="LoadAsync">Tekrar Dene</button>
            </div>
        }
        else
        {
            <p class="text-muted small">@(IsPersonalView ? "Tüm kişisel görev geçmişiniz gösterilir. Ödenmemiş, onay bekleyen veya onay gerekmeyen görevlerinizi dönüş tarihinden itibaren 14 gün içinde düzenleyebilirsiniz." : "Son bir yıl içinde biten ve gelecek görevler gösterilir. Rapor ve ödeme için yalnızca onaylanmış veya onay gerekmeyen, ödenmemiş görevler seçilebilir.")</p>
            @if (!IsPersonalView)
            {
                <p class="text-muted small">@_selectedIds.Count kayıt seçildi</p>
            }
            @if (_items.Count == 0)
            {
                <div class="alert alert-info">Kayıt bulunamadı.</div>
            }
            else
            {
                <GenericTable TItem="TaskApprovalListItem" @ref="_table" Items="_items" TableHeight="Auto"
                              ExportHeaders="TableExportHeaders" ExportRow="BuildExportRow"
                              ExportFileName="@(IsPersonalView ? "kisisel-gorev-onaylari.xlsx" : "gorev-onaylari.xlsx")"
                              ShowSearch="true" ShowExport="true" RowClassSelector="GetRowClass" KeySelector="x => x.TaskApprovalId">
                    <HeaderTemplate>
                        @if (!IsPersonalView)
                        {
                            <th class="selection-column"><input type="checkbox" class="form-check-input" checked="@AreAllSelected"
                                disabled="@_isBusy" @onchange="ToggleAllSelection" aria-label="Bu sayfadaki uygun görevleri seç" title="Bu sayfadakileri seç" /></th>
                        }
                        <th>Adı Soyadı</th>
                        <th>Görevin Sebebi</th>
                        <th>Gidiş Tarihi</th>
                        <th>Dönüş Tarihi</th>
                        <th>Görevin Yeri</th>
                        <th>Amir Onayı</th>
                        <th class="actions-column">İşlemler</th>
                    </HeaderTemplate>
                    <RowTemplate Context="item">
                        @if (!IsPersonalView)
                        {
                            <td>
                                @if (item.CanReport)
                                {
                                    <input class="form-check-input" type="checkbox" checked="@_selectedIds.Contains(item.TaskApprovalId)"
                                           disabled="@_isBusy" @onchange="args => ToggleSelection(item.TaskApprovalId, args.Value is true)"
                                           aria-label="@(item.FullName + " görevini seç")" />
                                }
                            </td>
                        }
                        <td>@item.FullName</td>
                        <td>@item.Reason</td>
                        <td>@item.StartDate?.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.EndDate?.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.Destination</td>
                        <td>
                            <ApprovalStatusBadge Status="item.ManagerApprovalStatus" />
                            @if (item.IsRejected) { <div class="small text-danger">@item.RejectionNote</div> }
                        </td>
                        <td>
                            <div class="d-flex flex-column gap-1">
                                @if (item.IsPaid) { <span class="text-success">Ödendi</span> }
                                @if (!IsPersonalView && item.CanReport)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => NavigateToReport(item.TaskApprovalId)">Rapor Al</button>
                                }
                                @if (_canEdit && CanEdit(item))
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => NavigateToEdit(item.TaskApprovalId)">Düzenle</button>
                                }
                            </div>
                        </td>
                    </RowTemplate>
                </GenericTable>
            }
        }
        @if (_confirmPaid && !IsPersonalView)
        {
            <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="paidConfirmTitle" style="background:rgba(0,0,0,.4)">
                <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                    <div class="modal-header"><h5 id="paidConfirmTitle" class="modal-title">Ödendi Yap</h5></div>
                    <div class="modal-body">Seçilen @_selectedIds.Count görevi ödendi olarak işaretlemek istediğinize emin misiniz?</div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" disabled="@_isBusy" @onclick="() => _confirmPaid = false">İptal</button>
                        <button class="btn btn-success" disabled="@_isBusy" @onclick="MarkPaidAsync">Evet, Ödendi Yap</button>
                    </div>
                </div></div>
            </div>
        }
    </PermissionGuard>
</div>

@code {
    private const string PersonalPath = "/ikys/task-approvals/personal";
    private static readonly string[] TableExportHeaders = ["Adı Soyadı", "Görevin Sebebi", "Gidiş Tarihi", "Dönüş Tarihi", "Görevin Yeri", "Amir Onayı", "Ret Gerekçesi"];
    private IReadOnlyList<object?> BuildExportRow(TaskApprovalListItem r) =>
        [r.FullName, r.Reason, r.StartDate?.ToString("dd.MM.yyyy HH:mm"), r.EndDate?.ToString("dd.MM.yyyy HH:mm"), r.Destination, r.ManagerApprovalDisplay, r.IsRejected ? r.RejectionNote : null];

    [SupplyParameterFromQuery(Name = "Auth")] public string? Auth { get; set; }
    [SupplyParameterFromQuery(Name = "SecilenId")] public int? SelectedTaskApprovalId { get; set; }
    private bool IsPersonalView => string.Equals(new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/'), PersonalPath, StringComparison.OrdinalIgnoreCase);
    private readonly HashSet<int> _selectedIds = [];
    private List<TaskApprovalListItem> _items = [];
    private GenericTable<TaskApprovalListItem>? _table;
    private Personel? _currentPersonel;
    private bool _canCreate, _canEdit, _canManage, _isBusy, _confirmPaid, _initialized;
    private bool _isLoading = true;
    private string? _loadError, _message, _loadedUrl;
    private IEnumerable<TaskApprovalListItem> SelectablePageItems => _table?.CurrentPageItems.Where(x => x.CanReport) ?? [];
    private bool AreAllSelected => SelectablePageItems.Any() && SelectablePageItems.All(x => _selectedIds.Contains(x.TaskApprovalId));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { _initialized = true; await LoadAsync(); }
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _loadedUrl != NavigationManager.Uri) await LoadAsync();
    }
    private async Task LoadAsync()
    {
        _loadedUrl = NavigationManager.Uri;
        _isLoading = true;
        _loadError = null;
        _selectedIds.Clear();
        _items = [];
        _confirmPaid = false;
        StateHasChanged();
        try
        {
            _canManage = await CurrentUserService.HasPermissionAsync(ModuleName.IKYS, Operation.Manage);
            if (!await CurrentUserService.HasPermissionAsync(ModuleName.IKYS, IsPersonalView ? Operation.View : Operation.Manage))
            {
                _loadError = "Bu listeyi görüntüleme yetkiniz bulunmuyor. Kişisel Görev Onay Listem bağlantısını kullanabilirsiniz.";
                return;
            }
            _currentPersonel = await CurrentUserService.GetCurrentPersonelAsync();
            _canCreate = await CurrentUserService.HasPermissionAsync(ModuleName.IKYS, Operation.Create);
            _canEdit = await CurrentUserService.HasPermissionAsync(ModuleName.IKYS, Operation.Edit);
            var result = await GorevOnayService.GetTaskApprovalListAsync(_currentPersonel?.Id, !IsPersonalView);
            if (result.IsFailure) { _loadError = result.Error.Message; return; }
            _items = result.Value;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "TaskApprovalListPage.LoadAsync");
            _loadError = "Görev onay listesi yüklenemedi. Lütfen tekrar deneyin.";
        }
        finally { _isLoading = false; StateHasChanged(); }
    }
    private string GetRowClass(TaskApprovalListItem item) => string.Join(" ", new[]
    {
        item.TaskApprovalId == SelectedTaskApprovalId ? "table-active" : "",
        item.IsPaid ? "table-secondary" : item.IsRejected ? "table-danger" : item.ManagerApprovalStatus == ApprovalStatus.Approved ? "table-success" : "",
        !IsPersonalView && item.HasCalculationError ? "task-approval-error-row" : ""
    });
    private bool CanEdit(TaskApprovalListItem item) => IsPersonalView ? item.CanEditPersonal(DateTime.Now) : item.CanEditGeneral;
    private void ToggleSelection(int id, bool selected)
    {
        if (IsPersonalView || _isBusy || !_items.Any(x => x.TaskApprovalId == id && x.CanReport)) return;
        if (selected) _selectedIds.Add(id); else _selectedIds.Remove(id);
    }
    private void ToggleAllSelection(ChangeEventArgs args)
    {
        foreach (var item in SelectablePageItems) ToggleSelection(item.TaskApprovalId, args.Value is true);
    }
    private void CreateBulkReport()
    {
        if (IsPersonalView || _isBusy) return;
        var ids = _items.Where(x => _selectedIds.Contains(x.TaskApprovalId) && x.CanReport).Select(x => x.TaskApprovalId).ToArray();
        if (ids.Length == 0) { _message = "Toplu rapor almak için uygun görevleri seçin."; return; }
        NavigationManager.NavigateTo("/ikys/task-approvals/report?Auth=IKYS&ids=" + string.Join(",", ids));
    }
    private async Task MarkPaidAsync()
    {
        if (IsPersonalView || !_canManage || _isBusy || _selectedIds.Count == 0) return;
        _isBusy = true;
        _message = null;
        try
        {
            var result = await GorevOnayService.SetTaskApprovalsPaidAsync(_selectedIds.ToArray());
            if (result.IsSuccess) { await LoadAsync(); _message = "Seçilen görevler ödendi olarak işaretlendi."; }
            else { _message = result.Error.Message; _confirmPaid = false; }
        }
        catch (Exception ex) { Logger.LogError(ex, "TaskApprovalListPage.MarkPaidAsync"); _message = "Ödendi işlemi tamamlanamadı."; }
        finally { _isBusy = false; _confirmPaid = false; }
    }
    private void NavigateToNew() => NavigationManager.NavigateTo("/ikys/task-approval-entry" + (IsPersonalView ? "" : "?Auth=IKYS"));
    private void NavigateToEdit(int id) => NavigationManager.NavigateTo($"/ikys/task-approval-entry/{id}" + (IsPersonalView ? "" : "?Auth=IKYS"));
    private void NavigateToReport(int id) => NavigationManager.NavigateTo($"/ikys/task-approvals/report?Auth=IKYS&taskApprovalId={id}");
}
