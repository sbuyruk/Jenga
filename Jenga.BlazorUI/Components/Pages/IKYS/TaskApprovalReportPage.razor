@page "/ikys/task-approvals/report"
@page "/IKYS/GorevOnayBelgesiViewer.aspx"
@page "/IKYS/GorevOnayBelgesiTopluViewer.aspx"
@rendermode InteractiveServer

@using Jenga.BlazorUI.Components.IKYS
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.IKYS
@using Jenga.Models.Enums
@using Jenga.Models.IKYS
@using Microsoft.AspNetCore.Components

@inject IGorevOnayService GorevOnayService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject ILogger<TaskApprovalReportPage> Logger

<PageTitle>TSKGV Görev Onayı</PageTitle>
<PermissionGuard Module="ModuleName.IKYS" Operation="Operation.Manage">
    <div class="no-print d-flex flex-wrap align-items-center gap-2 mb-3">
        <button class="btn btn-outline-secondary" @onclick="GoBack">
            <i class="bi bi-arrow-left me-1"></i>Listeye Dön
        </button>
        <button class="btn btn-primary" @onclick="PrintAsync" disabled="@(_isLoading || _sections.Count == 0 || !string.IsNullOrWhiteSpace(_loadError))">
            <i class="bi bi-printer me-1"></i>Yazdır
        </button>
    </div>

    @if (_isLoading)
    {
        <JengaLoading Message="Rapor hazırlanıyor…" />
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger">@_loadError</div>
    }
    else if (_sections.Count == 0)
    {
        <div class="alert alert-info">Raporlanacak görev bulunamadı.</div>
    }
    else
    {
        @if (_sections.Sum(x => x.Rows.Count) > 1 && _sections.Any(x => string.IsNullOrWhiteSpace(x.FinanceDirector.Name)))
        {
            <div class="alert alert-warning no-print" role="alert">Muhasebe ve Finans Direktörü tek bir aktif birim amiri olarak bulunamadı. Birim ve personel tanımlarını kontrol edin.</div>
        }
        <TaskApprovalReportTable @ref="_reportTable" Sections="_sections" ReportDate="_reportDate" />
    }
</PermissionGuard>

@code {
    private const string AuthorizedUnitCode = "IKYS";

    [SupplyParameterFromQuery(Name = "taskApprovalId")]
    public int? TaskApprovalId { get; set; }

    [SupplyParameterFromQuery(Name = "GorevOnayId")]
    public int? LegacyTaskApprovalId { get; set; }

    [SupplyParameterFromQuery(Name = "ids")]
    public string? Ids { get; set; }

    [SupplyParameterFromQuery(Name = "Auth")]
    public string? Auth { get; set; }

    private TaskApprovalReportTable? _reportTable;
    private List<TaskApprovalReportSection> _sections = [];
    private DateTime _reportDate = DateTime.Today;
    private int _loadVersion;
    private bool _isLoading = true;
    private string? _loadError;
    private bool _isAuthorizedUnitView;
    private Personel? _currentPersonel;

    private bool _interactiveReady;
    private string? _loadedUrl;
    protected override async Task OnParametersSetAsync()
    {
        if (_interactiveReady && _loadedUrl != NavigationManager.Uri) await LoadAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _interactiveReady = true;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        _loadedUrl = NavigationManager.Uri;
        _isLoading = true;
        _loadError = null;
        _sections = [];
        _reportTable = null;

        try
        {
            _currentPersonel = await CurrentUserService.GetCurrentPersonelAsync();
            _isAuthorizedUnitView = await CurrentUserService.HasPermissionAsync(ModuleName.IKYS, Operation.Manage);

            var effectiveTaskApprovalId = TaskApprovalId ?? LegacyTaskApprovalId;
            var ids = ParseIds();
            if (effectiveTaskApprovalId.HasValue && !ids.Contains(effectiveTaskApprovalId.Value))
                ids.Insert(0, effectiveTaskApprovalId.Value);

            var result = await GorevOnayService.GetTaskApprovalReportItemsAsync(ids, _currentPersonel?.Id, _isAuthorizedUnitView);
            if (version != _loadVersion) return;

            if (!result.IsSuccess)
            {
                _loadError = result.Error?.Message ?? "Rapor verileri alınamadı.";
                return;
            }

            var report = TaskApprovalReportBuilder.Build(result.Value ?? []);
            if (report.IsFailure) { _loadError = report.Error.Message; return; }
            _sections = report.Value;
            _reportDate = DateTime.Today;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "TaskApprovalReportPage.LoadAsync");
            if (version == _loadVersion) _loadError = "Rapor hazırlanamadı. Lütfen tekrar deneyin.";
        }
        finally
        {
            if (version == _loadVersion) _isLoading = false;
        }
    }

    private async Task PrintAsync()
    {
        if (_isLoading || _sections.Count == 0 || !string.IsNullOrWhiteSpace(_loadError)) return;
        try
        {
            if (_reportTable is not null) await _reportTable.PrintAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "TaskApprovalReportPage.PrintAsync");
            _loadError = "Yazdırma penceresi açılamadı. Sayfayı yenileyip tekrar deneyin.";
        }
    }

    private void GoBack()
    {
        var url = _isAuthorizedUnitView
            ? $"/ikys/task-approvals?Auth={AuthorizedUnitCode}"
            : "/ikys/task-approvals";
        NavigationManager.NavigateTo(url);
    }

    private List<int> ParseIds()
    {
        if (string.IsNullOrWhiteSpace(Ids))
            return new List<int>();

        return Ids.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(value => int.TryParse(value, out var parsed) ? parsed : 0)
            .Where(value => value > 0)
            .Distinct()
            .ToList();
    }
}
