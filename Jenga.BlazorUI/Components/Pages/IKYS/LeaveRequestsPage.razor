@page "/ikys/leave-requests"
@page "/ikys/leave-requests/{Scope}"
@rendermode InteractiveServer
@using System.Globalization
@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.IKYS
@using Jenga.Models.IKYS
@using static Jenga.BlazorUI.Components.IKYS.LeaveRequestDisplay
@using Status = Jenga.Models.IKYS.IzinTalep.OnayDurumuTipi
@inject ILeaveRequestWorkflow Workflow
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>@Title</PageTitle>

<PermissionGuard Module="ModuleName.IKYS" Operation="@(PersonnelOffice ? Operation.Manage : Operation.View)">
    <div class="leave-page">
        <header class="leave-heading">
            <h1>@Title</h1>
            <div class="leave-heading-actions">
                @if (PersonnelOffice)
                {
                    <a class="btn btn-outline-secondary" href="/ikys/leave-requests">
                        İzin Taleplerim <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i>
                    </a>
                }
                @if (_canEnterForPersonnel)
                {
                    <button type="button" class="btn btn-outline-primary" aria-controls="leave-personnel-picker"
                            aria-expanded="@(_showPersonnelPicker ? "true" : "false")" @onclick="TogglePersonnelPickerAsync">
                        <i class="bi bi-person-plus me-1" aria-hidden="true"></i> Personel Adına Talep
                    </button>
                }
                @if (_canCreate)
                {
                    <a class="btn btn-success" href="@EntryUrl()">
                        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Yeni İzin Talebi
                    </a>
                }
            </div>
        </header>

        @if (_canEnterForPersonnel)
        {
            <section id="leave-personnel-picker" class="leave-surface leave-personnel-picker" aria-label="Personel adına izin talebi"
                     hidden="@(!_showPersonnelPicker)">
                @if (_loadingPersonnel)
                {
                    <JengaLoading Message="Personel listesi yükleniyor…" />
                }
                else if (_personnelLookupError is { } lookupError)
                {
                    <span role="alert">@lookupError</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadPersonnelAsync">Tekrar Dene</button>
                }
                else if (_personnelOptions is { Count: > 0 } options)
                {
                    <div class="leave-personnel-choice">
                        <label for="leave-entry-personnel" class="form-label">İzin talebi açılacak personel</label>
                        <InputSelect id="leave-entry-personnel" class="form-select" @bind-Value="_selectedPersonelId">
                            <option value="">Personel seçiniz</option>
                            @foreach (var person in options)
                            {
                                <option value="@person.Id">@person.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <button type="button" class="btn btn-primary" disabled="@(!_selectedPersonelId.HasValue)"
                            @onclick="OpenPersonnelEntry">Talep Formunu Aç</button>
                }
                else
                {
                    <span>Seçilebilecek çalışan personel bulunamadı.</span>
                }
            </section>
        }

        @if (_feedback is not null)
        {
            <div class="alert @_feedbackClass mb-0" role="status">@_feedback</div>
        }

        <section class="leave-list" aria-label="@Title" aria-busy="@(_loading ? "true" : "false")">
            <div class="leave-toolbar">
                <fieldset class="leave-filter-group" disabled="@(_loading || _busy)">
                    <legend>İzin grubu</legend>
                    <div class="leave-filter-options">
                        @foreach (var filter in GroupFilters)
                        {
                            <button type="button" class="leave-filter" aria-pressed="@(_filter == filter.Value ? "true" : "false")"
                                    @onclick="() => SetGroupAsync(filter.Value)">@filter.Label</button>
                        }
                    </div>
                </fieldset>
                <div class="leave-status-filter">
                    <label for="leave-status">Durum</label>
                    <InputSelect class="form-select" id="leave-status" @bind-Value="_status" @bind-Value:after="LoadListAsync" disabled="@(_loading || _busy)">
                        <option value="">Tüm durumlar</option>
                        @foreach (var status in Enum.GetValues<Status>())
                        {
                            <option value="@status">@StatusText(status)</option>
                        }
                    </InputSelect>
                </div>
            </div>

            @if (_loading)
            {
                <div class="leave-list-state"><JengaLoading Message="İzin talepleri yükleniyor…" /></div>
            }
            else if (_rows?.Count == 0)
            {
                <div class="leave-list-state">
                    <i class="bi bi-calendar2-x leave-empty-icon" aria-hidden="true"></i>
                    <h2>@(HasFilters ? "Filtrelerle eşleşen talep yok" : "Henüz izin talebi yok")</h2>
                    @if (HasFilters)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearFiltersAsync">Filtreleri Temizle</button>
                    }
                    else if (_canCreate)
                    {
                        <a class="btn btn-sm btn-outline-primary" href="@EntryUrl()">Talep Oluştur</a>
                    }
                </div>
            }
            else if (_rows is { } rows)
            {
                <GenericTable TItem="LeaveTableRow" Items="rows" KeySelector="item => item.Request.Id" @ref="_table"
                              RowClassSelector="RequestRowClass" TableClass="leave-request-table" TableHeight="Auto"
                              SearchTextSelector="SearchText" PlaceholderSearch="İzin taleplerinde ara…"
                              ExportHeaders="TableExportHeaders" ExportRow="BuildExportRow"
                              ExportFileName="@(PersonnelOffice ? "izin-talepleri.xlsx" : "izin-taleplerim.xlsx")">
                    <HeaderTemplate>
                        @foreach (var (field, label) in SortColumns)
                        {
                            @if (PersonnelOffice || field != nameof(LeaveTableRow.Person))
                            {
                                <th scope="col" aria-sort="@SortDirection(field)">
                                    <button type="button" class="leave-sort-button" @onclick="() => _table?.SortBy(field)">
                                        @label <i class="@SortIcon(field)" aria-hidden="true"></i>
                                    </button>
                                </th>
                            }
                        }
                        <th scope="col" class="text-end">İşlemler</th>
                    </HeaderTemplate>
                    <RowTemplate Context="item">
                        @{ var row = item.Request; }
                        @if (PersonnelOffice) { <td class="leave-person">@row.Person</td> }
                        <td><strong>@row.TypeName</strong></td>
                        <td>
                            <span class="leave-dates">@DateRange(row.Start, row.End)</span>
                            @if (TimeRange(row) is { } times)
                            {
                                <span class="leave-times">@times</span>
                            }
                        </td>
                        <td><span class="leave-duration">@DurationText(row.Duration, row.Unit)</span></td>
                        <td><span class="leave-status @StatusClass(row.Status)">@item.StatusLabel</span></td>
                        <td>
                            <div class="leave-row-actions">
                                @if (_canEdit && IsPending(row.Status))
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="@EntryUrl(row.Id)"
                                       aria-label="@($"{row.TypeName} talebini düzenle")">Düzenle</a>
                                }
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy"
                                        aria-expanded="@(_detail?.Row.Id == row.Id ? "true" : "false")"
                                        aria-controls="@(_detail?.Row.Id == row.Id ? "leave-detail-panel" : null)"
                                        @onclick="() => OpenDetailAsync(row.Id)">
                                    @(CanPrint(row) ? "Belge ve Detay" : "İncele")
                                    <i class="bi bi-chevron-right ms-1" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </RowTemplate>
                </GenericTable>

            }
            else
            {
                <div class="leave-list-state">
                    <button type="button" class="btn btn-outline-secondary" @onclick="LoadListAsync">Tekrar Dene</button>
                </div>
            }
        </section>

        @if (_detail is { } detail)
        {
            <section class="leave-surface leave-detail" id="leave-detail-panel" aria-labelledby="leave-detail">
                <header class="leave-detail-header">
                    <div>
                        <h2 id="leave-detail" tabindex="-1" @ref="_detailHeading">@detail.Row.TypeName</h2>
                        @if (PersonnelOffice) { <p>@detail.Row.Person</p> }
                    </div>
                    <span class="leave-status @StatusClass(detail.Row.Status)">@StatusText(detail.Row.Status)</span>
                    @if (_canEdit && IsPending(detail.Row.Status))
                    {
                        <a class="btn btn-sm btn-outline-primary" href="@EntryUrl(detail.Row.Id)">Talebi Düzenle</a>
                    }
                    <button type="button" class="btn-close" aria-label="Ayrıntıyı kapat" disabled="@_busy" @onclick="CloseDetail"></button>
                </header>
                <dl class="leave-detail-grid">
                    <div>
                        <dt>Başlangıç</dt><dd>@FormatDate(detail.Row.Start, detail.Row.Type)</dd>
                    </div>
                    <div>
                        <dt>Bitiş</dt><dd>@FormatDate(detail.Row.End, detail.Row.Type)</dd>
                    </div>
                    <div>
                        <dt>Süre</dt><dd>@DurationText(detail.Row.Duration, detail.Row.Unit)</dd>
                    </div>
                    <div>
                        <dt>Vekil</dt><dd>@(detail.Substitute ?? "—")</dd>
                    </div>
                    <div>
                        <dt>Amir</dt><dd>@(detail.Manager ?? "—")</dd>
                    </div>
                    <div class="leave-detail-wide">
                        <dt>@(detail.Row.Type == (int)LeaveType.Personal ? "Mazeret" : "Adres")</dt><dd>@(detail.Address ?? "—")</dd>
                    </div>
                    <div class="leave-detail-wide">
                        <dt>Açıklama</dt><dd>@(detail.Description ?? "—")</dd>
                    </div>
                </dl>

                @if (CanPrint(detail.Row))
                {
                    <div class="leave-document">
                        @if (detail.FutureOffset is { } offset)
                        {
                            @if (offset.AppliedPeriod is { } applied)
                            {
                                <div>Mahsup edilen dönem @(PeriodRange(applied))</div>
                            }
                            else
                            {
                                <div>Mahsup dilekçesini yazdırın, imzalatın ve Personel Kısmına teslim edin.</div>
                            }
                        }
                        else if (detail.Row.Status == Status.KontrolEdildi)
                        {
                            <div>İzin belgesini yazdırın, imzalatın ve Personel Kısmına teslim edin.</div>
                        }
                        <a class="btn btn-sm btn-primary"
                           href="@($"/ikys/leave-requests/print/{detail.Row.Id}{(PersonnelOffice ? "?scope=manage" : "")}")"
                           target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-printer me-1" aria-hidden="true"></i>
                            @(detail.FutureOffset is null ? "İzin Belgesini Yazdır" : "Mahsup Dilekçesini Yazdır")
                        </a>
                    </div>
                }

                <details class="leave-history" open="@PersonnelOffice">
                    <summary>İzin dönemleri ve son izin hareketleri</summary>
                    <h3>İzin Dönemleri</h3>
                    @if (detail.Periods.Count == 0)
                    {
                        <p class="leave-muted">İzin dönemi bulunmuyor.</p>
                    }
                    else
                    {
                        <GenericTable TItem="IzinDonem" Items="detail.Periods" KeySelector="period => period.Id" TableHeight="auto"
                                      TableClass="leave-history-table" ShowPagination="false" ShowSearch="false" ShowCopy="false" ShowExport="false">
                            <HeaderTemplate>
                                <th scope="col">Dönem</th><th scope="col">İzin türü</th><th scope="col">Hak</th>
                                <th scope="col">Kullanılan</th><th scope="col">Kalan</th>
                            </HeaderTemplate>
                            <RowTemplate Context="period">
                                <td>@DateRange(period.BaslangicTarihi, period.BitisTarihi)</td>
                                <td>@(period.IzinTipi == (int)LeaveType.Paid ? "Yıllık Ücretli" : "Mazeret")</td>
                                <td>@DurationText(period.IzinHakki, period.Birim)</td>
                                <td>@DurationText(period.KullanilanIzin, period.Birim)</td>
                                <td>@DurationText(period.KalanIzin, period.Birim)</td>
                            </RowTemplate>
                        </GenericTable>
                    }

                    <h3>Son İzin Hareketleri</h3>
                    @if (detail.Movements.Count == 0)
                    {
                        <p class="leave-muted">İzin hareketi bulunmuyor.</p>
                    }
                    else
                    {
                        <GenericTable TItem="LeaveMovementRow" Items="detail.Movements" KeySelector="movement => movement.Id"
                                      TableHeight="auto" TableClass="leave-history-table"
                                      ShowPagination="false" ShowSearch="false" ShowCopy="false" ShowExport="false">
                            <HeaderTemplate>
                                <th scope="col">İzin türü</th><th scope="col">Başlangıç</th><th scope="col">Bitiş</th><th scope="col">Süre</th>
                            </HeaderTemplate>
                            <RowTemplate Context="movement">
                                <td>@movement.TypeName</td><td>@FormatDate(movement.Start, movement.Type)</td>
                                <td>@FormatDate(movement.End, movement.Type)</td><td>@DurationText(movement.Duration, movement.Unit)</td>
                            </RowTemplate>
                        </GenericTable>
                    }
                </details>

                @if (PersonnelOffice && (IsPending(detail.Row.Status) || detail.Row.Status == Status.KontrolEdildi))
                {
                    <div class="leave-decision">
                        <label class="form-label" for="leave-note">Karar açıklaması</label>
                        <textarea id="leave-note" class="form-control mb-3" rows="2" @bind="_note" disabled="@_busy"></textarea>
                        @if (detail.Row.Status == Status.KontrolEdildi && detail.Row.Type != (int)LeaveType.Nursing)
                        {
                            @if (detail.FutureOffset is { } offset)
                            {
                                <label class="form-label" for="leave-target-period">Mahsup edilecek izin dönemi</label>
                                <select id="leave-target-period" class="form-select mb-3" @bind="_targetPeriodId"
                                        disabled="@(_busy || offset.Targets.Count == 0)">
                                    <option value="">Hedef dönem seçiniz</option>
                                    @foreach (var target in offset.Targets)
                                    {
                                        <option value="@target.Id">@PeriodRange(target) · @target.AvailableDays gün @(target.Id == 0 ? "(onayda oluşturulacak)" : "")</option>
                                    }
                                </select>
                                @if (offset.Targets.Count == 0)
                                {
                                    <p class="leave-muted">Talep süresini karşılayan bir gelecek izin dönemi bulunmuyor.</p>
                                }
                            }
                            <div class="form-check mb-3">
                                <input type="checkbox" class="form-check-input" id="leave-document-received" @bind="_documentReceived" disabled="@_busy" />
                                <label class="form-check-label" for="leave-document-received">@(detail.FutureOffset is null
                                    ? "İmzalı izin belgesi teslim alındı." : "İmzalı mahsup dilekçesi teslim alındı.")</label>
                            </div>
                        }
                        <div class="leave-detail-actions">
                            @if (detail.Row.Status == Status.KontrolEdildi)
                            {
                                <button type="button" class="btn btn-success"
                                        disabled="@(_busy || (detail.Row.Type != (int)LeaveType.Nursing && !_documentReceived) ||
                                            (detail.FutureOffset is not null && !_targetPeriodId.HasValue))"
                                        @onclick="() => DecideAsync(LeaveDecision.Approve)">Onayla ve Kayıtlara İşle</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary" disabled="@_busy"
                                        @onclick="() => DecideAsync(LeaveDecision.Check)">Kontrol Edildi Olarak İşaretle</button>
                            }
                            <button type="button" class="btn btn-outline-danger" disabled="@_busy"
                                    @onclick="() => DecideAsync(LeaveDecision.Reject)">Reddet</button>
                        </div>
                    </div>
                }

                @if (_canDelete && IsPending(detail.Row.Status))
                {
                    <div class="leave-delete">
                        @if (_confirmDelete)
                        {
                            <div class="leave-detail-actions" role="status">
                                <span>Bu talebi silmek istiyor musunuz?</span>
                                <button type="button" class="btn btn-sm btn-danger" disabled="@_busy" @onclick="DeleteAsync">Talebi Sil</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                        @onclick="() => _confirmDelete = false">Vazgeç</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy"
                                    @onclick="() => _confirmDelete = true">Talebi Sil</button>
                        }
                    </div>
                }
            </section>
        }
    </div>
</PermissionGuard>

@code {
    private static readonly (LeaveListFilter Value, string Label)[] GroupFilters =
    [
        (LeaveListFilter.All, "Tümü"), (LeaveListFilter.General, "Genel İzinler"), (LeaveListFilter.Personal, "Mazeret İzinleri")
    ];
    private static readonly (string Field, string Label)[] SortColumns =
    [
        (nameof(LeaveTableRow.Person), "Personel"),
        (nameof(LeaveTableRow.TypeName), "İzin türü"),
        (nameof(LeaveTableRow.Dates), "İzin tarihleri"),
        (nameof(LeaveTableRow.Duration), "Süre"),
        (nameof(LeaveTableRow.StatusLabel), "Durum")
    ];
    private static readonly string[] OfficeExportHeaders = SortColumns.Select(column => column.Label).ToArray();
    private static readonly string[] PersonalExportHeaders = OfficeExportHeaders[1..];
    private IReadOnlyList<string> TableExportHeaders => PersonnelOffice ? OfficeExportHeaders : PersonalExportHeaders;

    [Parameter] public string? Scope { get; set; }
    [SupplyParameterFromQuery(Name = "requestId")] public int? RequestedDetailId { get; set; }
    private bool PersonnelOffice => string.Equals(Scope, "manage", StringComparison.OrdinalIgnoreCase);
    private string Title => PersonnelOffice ? "İzin Talepleri" : "İzin Taleplerim";
    private bool _ready, _loading = true, _busy, _canCreate, _canEdit, _canDelete;
    private bool _canEnterForPersonnel, _showPersonnelPicker, _loadingPersonnel;
    private int? _selectedPersonelId;
    private List<LeaveOption>? _personnelOptions;
    private string? _personnelLookupError;
    private bool _documentReceived, _confirmDelete, _focusDetail;
    private int? _targetPeriodId;
    private string? _note, _feedback;
    private string _feedbackClass = "alert-success";
    private LeaveListFilter _filter;
    private Status? _status;
    private bool HasFilters => _filter != LeaveListFilter.All || _status.HasValue;
    private List<LeaveTableRow>? _rows;
    private GenericTable<LeaveTableRow>? _table;
    private LeaveRequestDetail? _detail;
    private ElementReference _detailHeading;

    protected override async Task OnParametersSetAsync()
    {
        if (_ready) await InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ready = true;
            await InitializeAsync();
            StateHasChanged();
            return;
        }
        if (_focusDetail && _detail is not null)
        {
            _focusDetail = false;
            await _detailHeading.FocusAsync();
        }
    }

    private async Task InitializeAsync()
    {
        var canManage = await CurrentUser.HasPermissionAsync(ModuleName.IKYS, Operation.Manage);
        _canEnterForPersonnel = !PersonnelOffice && canManage;
        _showPersonnelPicker = false;
        _selectedPersonelId = null;
        _personnelOptions = null;
        _personnelLookupError = null;
        if (PersonnelOffice)
        {
            _canCreate = _canEdit = _canDelete = canManage;
        }
        else
        {
            _canCreate = await CurrentUser.HasPermissionAsync(ModuleName.IKYS, Operation.Create);
            _canEdit = await CurrentUser.HasPermissionAsync(ModuleName.IKYS, Operation.Edit);
            _canDelete = await CurrentUser.HasPermissionAsync(ModuleName.IKYS, Operation.Delete);
        }
        _filter = LeaveListFilter.All;
        _status = null;
        _feedback = null;
        CloseDetail();
        await LoadListAsync();
        if (RequestedDetailId is > 0)
            await OpenDetailAsync(RequestedDetailId.Value);
    }

    private async Task TogglePersonnelPickerAsync()
    {
        _showPersonnelPicker = !_showPersonnelPicker;
        if (_showPersonnelPicker && _personnelOptions is null)
            await LoadPersonnelAsync();
    }

    private async Task LoadPersonnelAsync()
    {
        if (!_canEnterForPersonnel || _loadingPersonnel) return;
        _loadingPersonnel = true;
        _personnelLookupError = null;
        var result = await Workflow.ListPersonnelForEntryAsync();
        if (result.IsSuccess) _personnelOptions = result.Value;
        else _personnelLookupError = result.Error.Message;
        _loadingPersonnel = false;
    }

    private void OpenPersonnelEntry()
    {
        if (!_canEnterForPersonnel || _selectedPersonelId is not { } id ||
            _personnelOptions?.Any(person => person.Id == id) != true) return;

        Navigation.NavigateTo($"/ikys/leave-request-entry?personelId={id}");
    }

    private Task SetGroupAsync(LeaveListFilter filter)
    {
        if (_filter == filter || _busy || _loading) return Task.CompletedTask;
        _filter = filter;
        return LoadListAsync();
    }

    private Task ClearFiltersAsync()
    {
        _filter = LeaveListFilter.All;
        _status = null;
        return LoadListAsync();
    }

    private async Task LoadListAsync()
    {
        _loading = true;
        var result = await Workflow.ListAsync(PersonnelOffice, _filter, _status);
        _loading = false;
        if (result.IsFailure) { _rows = null; Feedback(result.Error.Message, "alert-danger"); return; }
        _rows = result.Value.Items.Select(request => new LeaveTableRow(request)).ToList();
    }

    private async Task OpenDetailAsync(int id)
    {
        _busy = true;
        CloseDetail();
        var result = await Workflow.DetailAsync(id, PersonnelOffice);
        _busy = false;
        if (result.IsFailure) { Feedback(result.Error.Message, "alert-danger"); return; }
        _detail = result.Value;
        _focusDetail = true;
    }

    private void CloseDetail()
    {
        _detail = null;
        _targetPeriodId = null;
        _note = null;
        _documentReceived = _confirmDelete = _focusDetail = false;
    }

    private async Task DecideAsync(LeaveDecision decision)
    {
        if (_busy || _detail is null) return;
        _busy = true;
        var id = _detail.Row.Id;
        var result = await Workflow.DecideAsync(id, decision, _note, _documentReceived,
            targetPeriodId: decision == LeaveDecision.Approve ? _targetPeriodId : null);
        if (result.IsFailure)
        {
            Feedback(result.Error.Message, "alert-danger");
            _busy = false;
            return;
        }
        var message = decision switch
        {
            LeaveDecision.Check => "İzin talebi kontrol edildi.",
            LeaveDecision.Approve => "İzin talebi kayıtlara işlendi.",
            _ => "İzin talebi reddedildi."
        };
        Feedback(result.Value.NotificationFailed ? message + " E-posta bildirimi gönderilemedi." : message,
            result.Value.NotificationFailed ? "alert-warning" : "alert-success");
        await LoadListAsync();
        await OpenDetailAsync(id);
    }

    private async Task DeleteAsync()
    {
        if (_busy || _detail is null || !_confirmDelete) return;
        _busy = true;
        var result = await Workflow.DeleteAsync(_detail.Row.Id, PersonnelOffice);
        if (result.IsSuccess)
        {
            CloseDetail();
            Feedback("İzin talebi silindi.", "alert-success");
            await LoadListAsync();
        }
        else Feedback(result.Error.Message, "alert-danger");
        _busy = false;
    }

    private void Feedback(string message, string css)
    {
        _feedback = message;
        _feedbackClass = css;
    }

    private string EntryUrl(int? id = null) => "/ikys/leave-request-entry" + (id is { } value ? $"/{value}" : "") + (PersonnelOffice ? "?returnTo=manage" : "");
    private static string PeriodRange(FutureLeavePeriod period) => $"{period.Start:dd.MM.yyyy} – {period.End:dd.MM.yyyy}";
    private string? RequestRowClass(LeaveTableRow item) => _detail?.Row.Id == item.Request.Id ? "leave-row-active" : null;

    private string? SortDirection(string field) => _table?.CurrentSortField == field
        ? (_table.CurrentSortDescending ? "descending" : "ascending") : null;

    private string SortIcon(string field) => SortDirection(field) switch
    {
        "ascending" => "bi bi-caret-up-fill",
        "descending" => "bi bi-caret-down-fill",
        _ => "bi bi-arrow-down-up text-body-secondary"
    };

    private IReadOnlyList<object?> BuildExportRow(LeaveTableRow item)
    {
        var row = item.Request;
        var dates = DateRange(row.Start, row.End);
        if (TimeRange(row) is { } times) dates = $"{dates} {times}";

        IReadOnlyList<object?> values = [row.TypeName, dates, DurationText(row.Duration, row.Unit), item.StatusLabel];
        return PersonnelOffice ? [row.Person, .. values] : values;
    }

    private string SearchText(LeaveTableRow item) => string.Join(" ", BuildExportRow(item));

    private sealed class LeaveTableRow(LeaveRequestRow request)
    {
        public LeaveRequestRow Request { get; } = request;
        public string Person => Request.Person;
        public string TypeName => Request.TypeName;
        public (DateTime? Start, DateTime? End) Dates => (Request.Start, Request.End);
        public string StatusLabel => StatusText(Request.Status);
        public (int UnitOrder, decimal Amount) Duration { get; } = DurationSortKey(request);

        private static (int UnitOrder, decimal Amount) DurationSortKey(LeaveRequestRow row)
        {
            if (string.Equals(row.Unit, "Saat", StringComparison.OrdinalIgnoreCase) &&
                TimeSpan.TryParse(row.Duration, CultureInfo.InvariantCulture, out var hours))
                return (0, hours.Ticks);

            const NumberStyles decimalNumber = NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint;
            if (string.Equals(row.Unit, "Gün", StringComparison.OrdinalIgnoreCase) &&
                (decimal.TryParse(row.Duration?.Trim(), decimalNumber, CultureInfo.InvariantCulture, out var days) ||
                 decimal.TryParse(row.Duration?.Trim(), decimalNumber, CultureInfo.GetCultureInfo("tr-TR"), out days)))
                return (1, days);

            return (2, 0);
        }
    }

    private static bool IsPending(Status? status) => status is Status.IslemBekliyor or Status.DilekceBekleniyor;

    private static string DateRange(DateTime? start, DateTime? end) =>
        start?.Date == end?.Date ? FormatDate(start, null) : $"{FormatDate(start, null)} – {FormatDate(end, null)}";

    private static string? TimeRange(LeaveRequestRow row) =>
        row.Type is (int)LeaveType.Personal or (int)LeaveType.Nursing && row.Start.HasValue && row.End.HasValue
            ? $"{row.Start:HH:mm}–{row.End:HH:mm}" : null;

    private static string StatusClass(Status? status) => status switch
    {
        Status.KontrolEdildi => "leave-status-info",
        Status.KayitlaraIslendi => "leave-status-success",
        Status.Reddedildi or Status.IptalEdildi => "leave-status-danger",
        Status.IslemBekliyor or Status.DilekceBekleniyor => "leave-status-warning",
        _ => ""
    };
}
