@page "/ikys/leave-request-entry"
@page "/ikys/leave-request-entry/{RequestId:int}"
@rendermode InteractiveServer
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.IKYS
@using Jenga.Models.IKYS
@using static Jenga.BlazorUI.Components.IKYS.LeaveRequestDisplay
@inject ILeaveRequestWorkflow Workflow
@inject ICurrentUserService CurrentUser
@inject IToastService ToastService
@inject NavigationManager Navigation

<PageTitle>@Title</PageTitle>

<PermissionGuard Module="ModuleName.IKYS" Operation="@(RequestId.HasValue ? Operation.Edit : Operation.Create)">
    <div class="leave-entry-page">
        <header class="leave-entry-header">
            <div class="leave-entry-title">
                <span class="leave-entry-title-icon" aria-hidden="true"><i class="bi bi-calendar2-check"></i></span>
                <h1>@Title</h1>
            </div>
            <a class="btn btn-outline-secondary leave-entry-back" href="@ListUrl">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                @(ReturnsToOffice ? "İKYS İşlem Listesi" : "İzin Taleplerim")
            </a>
        </header>

        @if (_feedback is not null)
        {
            <div class="alert @_feedbackClass mb-0" role="status">@_feedback</div>
        }
        @if (_loading)
        {
            <JengaLoading Message="İzin talebi formu yükleniyor…" />
        }
        else if (_form is { } form && !_saved)
        {
            var pendingRequests = form.Input.Type is { } selectedType
                ? _pendingRequests.Where(request => request.Type == (int)selectedType).ToList()
                : [];

            @if (_pendingLoadFailed && form.Input.Type.HasValue)
            {
                <div class="alert alert-warning mb-0" role="status">İşlemi devam eden izin talepleri getirilemedi.</div>
            }
            @if (pendingRequests.Count > 0)
            {
                <section class="leave-entry-existing" aria-labelledby="leave-existing-heading">
                    <h2 id="leave-existing-heading">
                        <i class="bi bi-clock-history" aria-hidden="true"></i> İşlemi devam eden izin talepleri
                    </h2>
                    <ul class="leave-entry-existing-list">
                        @foreach (var request in pendingRequests)
                        {
                            <li @key="request.Id">
                                <strong>@request.TypeName</strong>
                                <span>@FormatDate(request.Start, request.Type) – @FormatDate(request.End, request.Type)</span>
                                <span>@DurationText(request.Duration, request.Unit)</span>
                                <span class="leave-entry-existing-status">@StatusText(request.Status)</span>
                                <a class="leave-entry-existing-link" href="@PendingRequestUrl(request.Id)">Talebi Aç</a>
                            </li>
                        }
                    </ul>
                </section>
            }

            <EditForm Model="form.Input" OnValidSubmit="SaveAsync">
                <ValidationSummary class="leave-entry-validation text-danger" />
                <fieldset class="leave-entry-layout" disabled="@_busy" aria-busy="@(_busy ? "true" : "false")">
                    <div class="leave-entry-fields">
                        <section class="leave-entry-section" aria-labelledby="leave-basics-heading">
                            <h2 id="leave-basics-heading">Talep bilgileri</h2>
                            <div class="leave-entry-grid">
                                <div>
                                    <label class="form-label" for="leave-person">Personel</label>
                                    <InputSelect id="leave-person" class="form-select" @bind-Value="form.Input.PersonelId" @bind-Value:after="OnPersonnelChangedAsync"
                                                 disabled="@(!_canManage || RequestId.HasValue)">
                                        <option value="">Personel seçiniz</option>
                                        @foreach (var person in form.People)
                                        {
                                            <option value="@person.Id">@person.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div>
                                    <label class="form-label" for="leave-type">İzin türü</label>
                                    <InputSelect id="leave-type" class="form-select" @bind-Value="form.Input.Type" @bind-Value:after="ClearCalculation"
                                                 disabled="@RequestId.HasValue">
                                        <option value="">İzin türü seçiniz</option>
                                        @foreach (var type in form.Types)
                                        {
                                            <option value="@((LeaveType)type.Id)">@type.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </section>

                        <section class="leave-entry-section" aria-labelledby="leave-dates-heading">
                            <h2 id="leave-dates-heading">İzin tarihleri</h2>
                            <div class="leave-entry-grid">
                                <div>
                                    <label class="form-label" for="leave-start">@(IsPersonal ? "İzin tarihi" : "Başlangıç tarihi")</label>
                                    <InputDate id="leave-start" class="form-control" @bind-Value="form.Input.StartDate" @bind-Value:after="ClearCalculation" />
                                </div>
                                @if (!IsPersonal)
                                {
                                    <div>
                                        <label class="form-label" for="leave-end">Bitiş tarihi</label>
                                        <InputDate id="leave-end" class="form-control" @bind-Value="form.Input.EndDate" @bind-Value:after="ClearCalculation" />
                                    </div>
                                }
                                @if (IsPersonal || IsNursing)
                                {
                                    <div>
                                        <label class="form-label" for="leave-start-time">Başlangıç saati</label>
                                        <InputDate id="leave-start-time" class="form-control" Type="InputDateType.Time" step="300" min="08:00" max="17:00"
                                                   @bind-Value="form.Input.StartTime" @bind-Value:after="ClearCalculation" />
                                    </div>
                                    @if (IsPersonal)
                                    {
                                        <div>
                                            <label class="form-label" for="leave-end-time">Bitiş saati</label>
                                            <InputDate id="leave-end-time" class="form-control" Type="InputDateType.Time" step="300" min="08:00" max="17:00"
                                                       @bind-Value="form.Input.EndTime" @bind-Value:after="ClearCalculation" />
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="leave-entry-helper leave-entry-wide">Süt izni seçilen saatte başlar ve günde 90 dakika uygulanır.</p>
                                    }
                                }
                            </div>
                        </section>

                        @if (form.Input.Type.HasValue)
                        {
                            <section class="leave-entry-section" aria-labelledby="leave-detail-heading">
                                <h2 id="leave-detail-heading">İzin ayrıntıları</h2>
                                <div class="leave-entry-grid">
                                    @if (!IsPersonal && !IsNursing)
                                    {
                                        <div>
                                            <label class="form-label" for="leave-substitute">Vekil</label>
                                            <InputSelect id="leave-substitute" class="form-select" @bind-Value="form.Input.SubstituteId">
                                                <option value="">Vekil seçiniz</option>
                                                @foreach (var signer in form.Substitutes)
                                                {
                                                    <option value="@signer.Id">@signer.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    }
                                    @if (!IsNursing)
                                    {
                                        <div>
                                            <label class="form-label" for="leave-manager">Amir</label>
                                            <InputSelect id="leave-manager" class="form-select" @bind-Value="form.Input.ManagerId">
                                                <option value="">Amir seçiniz</option>
                                                @foreach (var signer in form.Signers)
                                                {
                                                    <option value="@signer.Id">@signer.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    }
                                    <div class="leave-entry-wide">
                                        <label class="form-label" for="leave-address">@(IsPersonal ? "Mazeret" : "İzin adresi")</label>
                                        <InputTextArea id="leave-address" class="form-control" rows="2" @bind-Value="form.Input.Address" />
                                    </div>
                                    @if (!IsPersonal)
                                    {
                                        <div class="leave-entry-wide">
                                            <label class="form-label" for="leave-description">Açıklama</label>
                                            <InputTextArea id="leave-description" class="form-control" rows="2" @bind-Value="form.Input.Description" />
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    </div>

                    <aside class="leave-entry-summary" aria-labelledby="leave-summary-heading">
                        <h2 id="leave-summary-heading"><i class="bi bi-calculator" aria-hidden="true"></i> Süre ve bakiye</h2>
                        <div aria-live="polite">
                            @if (_calculation is { } calculation)
                            {
                                <dl class="leave-entry-calculation">
                                    <div class="leave-entry-duration">
                                        <dt>Talep edilen süre</dt>
                                        <dd>@DurationText(calculation.Duration, calculation.Unit)</dd>
                                    </div>
                                    @if (calculation.Available is not null)
                                    {
                                        <div>
                                            <dt>@(calculation.AvailableAfterPending is null ? "Kullanılabilir bakiye" : "Güncel bakiye")</dt>
                                            <dd>@calculation.Available @calculation.Unit</dd>
                                        </div>
                                    }
                                    @if (calculation.PendingDuration is { } pendingDuration)
                                    {
                                        <div>
                                            <dt>İşlemi devam eden süre</dt>
                                            <dd>@pendingDuration @calculation.Unit</dd>
                                        </div>
                                    }
                                    @if (calculation.AvailableAfterPending is { } availableAfterPending)
                                    {
                                        <div>
                                            <dt>Bekleyen talepler düşüldükten sonra</dt>
                                            <dd>@availableAfterPending @calculation.Unit</dd>
                                        </div>
                                    }
                                    @if (calculation.Remaining is { } remaining)
                                    {
                                        <div>
                                            <dt>Bu talepten sonra kalan</dt>
                                            <dd>@remaining @calculation.Unit</dd>
                                        </div>
                                    }
                                    @if (calculation.CombinedDuration is { } combinedDuration)
                                    {
                                        <div>
                                            <dt>Bekleyen ve yeni talep toplamı</dt>
                                            <dd>@combinedDuration @calculation.Unit</dd>
                                        </div>
                                    }
                                </dl>
                                @if (calculation.BalanceWarning is { } balanceWarning)
                                {
                                    <p class="leave-entry-balance-warning">@balanceWarning</p>
                                }
                                else if (calculation.PendingDuration is null && pendingRequests.Count > 0)
                                {
                                    <p class="leave-entry-helper mt-2">Bu hesapta bekleyen taleplerden düşülecek süre bulunmuyor.</p>
                                }
                            }
                            else
                            {
                                <p class="leave-entry-helper">İzin türünü ve tarihleri seçtikten sonra süreyi hesaplayabilirsiniz.</p>
                            }
                        </div>
                        <button type="button" class="btn btn-outline-primary leave-entry-calculate" @onclick="CalculateAsync">
                            Süreyi Hesapla
                        </button>
                    </aside>

                    <footer class="leave-entry-actions">
                        @if (_canManage)
                        {
                            <div class="form-check form-switch leave-entry-notify">
                                <InputCheckbox id="leave-notify" class="form-check-input" @bind-Value="form.Input.Notify" />
                                <label class="form-check-label" for="leave-notify">E-posta bildirimi gönder</label>
                            </div>
                        }
                        <button type="submit" class="btn btn-primary leave-entry-submit">
                            @(RequestId.HasValue ? "Değişiklikleri Kaydet" : "Talebi Gönder")
                            <i class="bi @(RequestId.HasValue ? "bi-check-lg" : "bi-arrow-right")" aria-hidden="true"></i>
                        </button>
                    </footer>
                </fieldset>
            </EditForm>
        }
    </div>
</PermissionGuard>

@code {
    private const string PersonalListUrl = "/ikys/leave-requests";

    [Parameter] public int? RequestId { get; set; }
    [SupplyParameterFromQuery(Name = "personelId")] public int? SelectedPersonelId { get; set; }
    [SupplyParameterFromQuery(Name = "returnTo")] public string? ReturnTo { get; set; }
    private string Title => RequestId.HasValue ? "İzin Talebini Düzenle" : "Yeni İzin Talebi";
    private bool ReturnsToOffice => _canManage && string.Equals(ReturnTo, "manage", StringComparison.OrdinalIgnoreCase);
    private string ListUrl => ReturnsToOffice ? "/ikys/leave-requests/manage" : PersonalListUrl;
    private string PendingRequestUrl(int id) => $"{PersonalListUrl}{(_canManage ? "/manage" : "")}?requestId={id}";
    private bool IsPersonal => _form?.Input.Type == LeaveType.Personal;
    private bool IsNursing => _form?.Input.Type == LeaveType.Nursing;
    private bool _ready, _loading = true, _busy, _saved, _canManage;
    private LeaveRequestForm? _form;
    private LeaveCalculation? _calculation;
    private List<LeaveRequestRow> _pendingRequests = [];
    private bool _pendingLoadFailed;
    private int _pendingLoadVersion;
    private string? _feedback;
    private string _feedbackClass = "alert-danger";

    protected override async Task OnParametersSetAsync()
    {
        if (_ready) await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ready = true;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _saved = false;
        _form = null;
        _pendingLoadVersion++;
        ClearCalculation();
        _canManage = await CurrentUser.HasPermissionAsync(ModuleName.IKYS, Operation.Manage);
        var result = await Workflow.LoadFormAsync(RequestId, _canManage);
        if (result.IsSuccess)
        {
            _form = result.Value;
            if (_canManage && !RequestId.HasValue && SelectedPersonelId is { } id)
            {
                if (_form.People.Any(person => person.Id == id))
                    _form.Input.PersonelId = id;
                else
                    Feedback("Seçilen personel izin girişi için kullanılamıyor. Listeden çalışan bir personel seçiniz.", "alert-warning");
            }
            await LoadPendingRequestsAsync();
        }
        else Feedback(result.Error.Message, "alert-danger");
        _loading = false;
    }

    private Task OnPersonnelChangedAsync()
    {
        ClearCalculation();
        return LoadPendingRequestsAsync();
    }

    private async Task LoadPendingRequestsAsync()
    {
        var version = ++_pendingLoadVersion;
        _pendingRequests = [];
        _pendingLoadFailed = false;
        if (_form?.Input is not { PersonelId: > 0 } input) return;

        var lookup = new LeaveRequestInput { Id = input.Id, PersonelId = input.PersonelId, Type = input.Type };
        var result = await Workflow.ListPendingForEntryAsync(lookup, _canManage);
        if (version != _pendingLoadVersion) return;

        if (result.IsSuccess) _pendingRequests = result.Value;
        else _pendingLoadFailed = true;
    }

    private async Task CalculateAsync()
    {
        if (_busy || _form is null) return;
        _busy = true;
        ClearCalculation();
        var result = await Workflow.CalculateAsync(_form.Input, _canManage);
        if (result.IsSuccess) _calculation = result.Value;
        else Feedback(result.Error.Message, "alert-danger");
        _busy = false;
    }

    private async Task SaveAsync()
    {
        if (_busy || _saved || _form is null) return;
        _busy = true;
        _feedback = null;
        var result = await Workflow.SaveAsync(_form.Input, _canManage);
        if (result.IsSuccess)
        {
            _saved = true;
            Navigation.NavigateTo(PersonalListUrl);
            var message = RequestId.HasValue ? "İzin talebi güncellendi." : "İzin talebi gönderildi.";
            if (result.Value.NotificationFailed)
                ToastService.ShowWarning(message + " E-posta bildirimi gönderilemedi.", 6000);
            else
                ToastService.ShowSuccess(message);
        }
        else ToastService.ShowError(result.Error.Message, 6000);
        _busy = false;
    }

    private void ClearCalculation()
    {
        _calculation = null;
        _feedback = null;
    }

    private void Feedback(string message, string css)
    {
        _feedback = message;
        _feedbackClass = css;
    }

}
