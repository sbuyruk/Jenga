@page "/ikys/task-approval-entry"
@page "/ikys/task-approval-entry/{TaskApprovalId:int}"
@page "/ikys/task-approvals/new"
@page "/ikys/task-approvals/edit/{TaskApprovalId:int}"
@page "/ikys/gorevonaygirisiwp"
@page "/IKYS/GorevOnayGirisiWP"
@page "/IKYS/GorevOnayGirisiWP.aspx"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.IKYS
@using Jenga.Models.Enums
@using Jenga.Models.IKYS
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

@inject IGorevOnayService GorevOnayService
@inject IPersonelService PersonelService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject ILogger<TaskApprovalEntryPage> Logger

<PermissionGuard Module="ModuleName.IKYS" Operation="Operation.View">
    <div class="d-flex align-items-center gap-2 mb-3">
        <button class="btn btn-outline-secondary" @onclick="NavigateBack">
            <i class="bi bi-arrow-left me-1"></i>Listeye Dön
        </button>
        <h3 class="mb-0">@PageTitle</h3>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-warning">@_statusMessage</div>
    }

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-border text-primary me-3" role="status"></div>
            <span class="text-muted">Görev onayı hazırlanıyor…</span>
        </div>
    }
    else if (_loadFailed)
    {
        <div class="alert alert-danger">Kayıt yüklenemedi. Listeye dönüp başka bir kayıt seçin.</div>
    }
    else if (!CanSave)
    {
        <div class="alert alert-danger">Bu işlem için yetkiniz bulunmuyor.</div>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3">
                        @if (_isAuthorizedUnitView)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Personel</label>
                                <InputSelect class="form-select" @bind-Value="_model.PersonelId">
                                    <option value="">Seçiniz</option>
                                    @foreach (var personel in _personels)
                                    {
                                        <option value="@personel.Id">@($"{personel.Adi} {personel.Soyadi}")</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                        <div class="col-md-6">
                            <label class="form-label">Görevin Sebebi</label>
                            <InputText class="form-control" @bind-Value="_model.GorevinSebebi" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Görevin Yeri</label>
                            <InputText class="form-control" @bind-Value="_model.GorevinYeri" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Gidiş Tarihi</label>
                            <InputDate class="form-control" @bind-Value="_model.BaslangicTarihi" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Gidiş Saati</label>
                            <InputText class="form-control" @bind-Value="_startTimeText" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Dönüş Tarihi</label>
                            <InputDate class="form-control" @bind-Value="_model.BitisTarihi" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Dönüş Saati</label>
                            <InputText class="form-control" @bind-Value="_endTimeText" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ulaşım Aracı</label>
                            <InputText class="form-control" @bind-Value="_model.UlasimAraci" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Transfer</label>
                            <InputText class="form-control" @bind-Value="_model.Transfer" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Konaklama</label>
                            <InputText class="form-control" @bind-Value="_model.Konaklama" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Günlük Yevmiye</label>
                            <InputText class="form-control" @bind-Value="_dailyAllowanceInput" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Para Birimi</label>
                            <InputText class="form-control" @bind-Value="_model.ParaBirimi" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Toplam Yevmiye</label>
                            <InputText class="form-control" @bind-Value="_model.Yevmiye" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Süre</label>
                            <InputText class="form-control" @bind-Value="_model.Sure" readonly />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Açıklama</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_model.Aciklama" />
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="NavigateBack">İptal</button>
                    <button type="submit" class="btn btn-success" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Kaydet
                    </button>
                </div>
            </div>
        </EditForm>
    }
</PermissionGuard>

@code {
    private const string AuthorizedUnitCode = "IKYS";
    private static readonly CultureInfo TrCulture = new("tr-TR");

    [Parameter] public int? TaskApprovalId { get; set; }

    [SupplyParameterFromQuery(Name = "GorevOnayId")]
    public int? LegacyTaskApprovalId { get; set; }

    [SupplyParameterFromQuery(Name = "Auth")]
    public string? Auth { get; set; }

    private GorevOnay _model = new();
    private readonly List<Personel> _personels = new();
    private Personel? _currentPersonel;
    private bool _isAuthorizedUnitView;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _canCreate;
    private bool _canEdit;
    private bool _loadFailed;
    private string? _statusMessage;
    private string _dailyAllowanceInput = "0";
    private string _startTimeText = "00:00";
    private string _endTimeText = "00:00";

    private int? EffectiveTaskApprovalId => TaskApprovalId ?? LegacyTaskApprovalId;
    private string PageTitle => EffectiveTaskApprovalId.HasValue ? "Görev Onayı Düzenle" : "Yeni Görev Onayı";
    private bool CanSave => EffectiveTaskApprovalId.HasValue ? _canEdit : _canCreate;

    protected override async Task OnParametersSetAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _statusMessage = null;

        try
        {
            _loadFailed = false;
            _currentPersonel = await CurrentUserService.GetCurrentPersonelAsync();
            _canCreate = await CurrentUserService.HasPermissionAsync(ModuleName.IKYS, Operation.Create);
            _canEdit = await CurrentUserService.HasPermissionAsync(ModuleName.IKYS, Operation.Edit);
            _isAuthorizedUnitView = string.Equals(Auth, AuthorizedUnitCode, StringComparison.OrdinalIgnoreCase)
                && await CurrentUserService.HasPermissionAsync(ModuleName.IKYS, Operation.Manage);

            if (_isAuthorizedUnitView)
            {
                var personelResult = _currentPersonel is null
                    ? null
                    : await GorevOnayService.GetManagedPersonnelAsync(_currentPersonel.Id);
                _personels.Clear();
                if (personelResult is { IsSuccess: true, Value: not null })
                    _personels.AddRange(personelResult.Value.OrderBy(x => x.Adi).ThenBy(x => x.Soyadi));
            }

            if (EffectiveTaskApprovalId.HasValue)
            {
                var result = await GorevOnayService.GetScopedByIdAsync(EffectiveTaskApprovalId.Value, _currentPersonel?.Id, _isAuthorizedUnitView);
                if (!result.IsSuccess || result.Value is null)
                {
                    _statusMessage = result.Error?.Message ?? "Görev onayı bulunamadı.";
                    _loadFailed = true;
                    _model = new GorevOnay();
                    return;
                }

                _model = result.Value;
            }
            else
            {
                _model = new GorevOnay
                {
                    PersonelId = _currentPersonel?.Id,
                    ParaBirimi = "TL",
                    AmirOnayi = (int)ApprovalStatus.PendingApproval
                };
            }

            _startTimeText = (_model.BaslangicTarihi?.TimeOfDay ?? TimeSpan.Zero).ToString(@"hh\:mm", CultureInfo.InvariantCulture);
            _endTimeText = (_model.BitisTarihi?.TimeOfDay ?? TimeSpan.Zero).ToString(@"hh\:mm", CultureInfo.InvariantCulture);
            _dailyAllowanceInput = _model.GunlukYevmiye ?? "0";
            RecalculateDerivedFields();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "TaskApprovalEntryPage.LoadAsync");
            _statusMessage = "Beklenmeyen bir hata oluştu.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        _statusMessage = null;

        if (!ValidateModel())
            return;

        _isSaving = true;
        try
        {
            ApplyDateTimes();
            RecalculateDerivedFields();
            _model.GunlukYevmiye = _dailyAllowanceInput;
            _model.AmirOnayi = (int)ApprovalStatus.PendingApproval;
            _model.OnayRedAciklama = null;

            var currentUserName = await CurrentUserService.GetUserNameAsync();
            var result = EffectiveTaskApprovalId.HasValue
                ? await GorevOnayService.UpdateScopedAsync(_model, _currentPersonel?.Id, _isAuthorizedUnitView)
                : await GorevOnayService.AddScopedAsync(_model, _currentPersonel?.Id, _isAuthorizedUnitView, currentUserName);

            if (!result.IsSuccess)
            {
                _statusMessage = result.Error?.Message ?? "Görev onayı kaydedilemedi.";
                return;
            }

            NavigateBack(_model.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "TaskApprovalEntryPage.SaveAsync");
            _statusMessage = "Görev onayı kaydedilirken beklenmeyen bir hata oluştu.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private bool ValidateModel()
    {
        if ((_isAuthorizedUnitView && !_model.PersonelId.HasValue) || (!_isAuthorizedUnitView && _currentPersonel is null))
        {
            _statusMessage = "Personel bilgisi zorunludur.";
            return false;
        }

        if (!decimal.TryParse(_dailyAllowanceInput, NumberStyles.Number, TrCulture, out var parsedDailyAllowance) || parsedDailyAllowance < 0m)
        {
            _statusMessage = "Günlük yevmiye alanını sayısal bir değer olarak giriniz.";
            return false;
        }

        ApplyDateTimes();
        if (!_model.BaslangicTarihi.HasValue || !_model.BitisTarihi.HasValue)
        {
            _statusMessage = "Başlangıç ve bitiş tarihi zorunludur.";
            return false;
        }

        if (!TryGetTimes(out _, out _))
        {
            _statusMessage = "Saat alanlarını HH:mm formatında giriniz.";
            return false;
        }

        if (_model.BitisTarihi <= _model.BaslangicTarihi)
        {
            _statusMessage = "Bitiş tarihi başlangıç tarihinden sonra olmalıdır.";
            return false;
        }

        if (!_isAuthorizedUnitView)
            _model.PersonelId = _currentPersonel?.Id;

        return true;
    }

    private void ApplyDateTimes()
    {
        if (!TryGetTimes(out var startTime, out var endTime))
            return;

        if (_model.BaslangicTarihi.HasValue)
            _model.BaslangicTarihi = _model.BaslangicTarihi.Value.Date + startTime;

        if (_model.BitisTarihi.HasValue)
            _model.BitisTarihi = _model.BitisTarihi.Value.Date + endTime;
    }

    private bool TryGetTimes(out TimeSpan startTime, out TimeSpan endTime)
    {
        startTime = TimeSpan.Zero;
        endTime = TimeSpan.Zero;

        var startOk = TimeOnly.TryParseExact(_startTimeText, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedStart);
        var endOk = TimeOnly.TryParseExact(_endTimeText, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedEnd);
        if (!startOk || !endOk)
            return false;

        startTime = parsedStart.ToTimeSpan();
        endTime = parsedEnd.ToTimeSpan();
        return true;
    }

    private void RecalculateDerivedFields()
    {
        if (!_model.BaslangicTarihi.HasValue || !_model.BitisTarihi.HasValue)
            return;

        var duration = CalculateDuration(_model.BaslangicTarihi.Value, _model.BitisTarihi.Value);
        _model.Sure = $"{duration.ToString("0.##", TrCulture)} gün";

        _ = decimal.TryParse(_dailyAllowanceInput, NumberStyles.Number, TrCulture, out var parsedDailyAllowance);
        var totalAllowance = duration * parsedDailyAllowance;
        _model.Yevmiye = totalAllowance.ToString("N2", TrCulture);
    }

    private static decimal CalculateDuration(DateTime startDate, DateTime endDate)
    {
        if (endDate <= startDate)
            return 0m;

        var minutes = (endDate - startDate).TotalMinutes;
        var hours = (minutes / 60d) % 24d;
        var days = (int)((minutes / 60d) / 24d);
        var remainder = hours == 0d ? 0m : hours > 12d ? 1m : 0.5m;
        return days + remainder;
    }

    private void NavigateBack()
        => NavigateBack(EffectiveTaskApprovalId);

    private void NavigateBack(int? selectedTaskApprovalId)
    {
        var queryParts = new List<string>();
        if (selectedTaskApprovalId.HasValue)
            queryParts.Add($"SecilenId={selectedTaskApprovalId.Value}");
        if (_isAuthorizedUnitView)
            queryParts.Add($"Auth={AuthorizedUnitCode}");

        var url = queryParts.Count == 0
            ? "/ikys/task-approvals"
            : $"/ikys/task-approvals?{string.Join("&", queryParts)}";

        NavigationManager.NavigateTo(url);
    }
}
