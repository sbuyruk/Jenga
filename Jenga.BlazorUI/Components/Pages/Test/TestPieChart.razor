@page "/test/pieChart"
@using Jenga.BlazorUI.Components.Common
@rendermode InteractiveServer

<h4>Generic Pie Chart — Mock Data</h4>

<GenericPieChart Items="@data" LabelSelector="x => x.Name" ValueSelector="x => x.Value" Title="Mock Categories" />

@code {
    private record CategoryData(string Name, decimal Value);

    private List<CategoryData> data = new()
    {
        new CategoryData("Red", 30m),
        new CategoryData("Blue", 50m),
        new CategoryData("Green", 20m)
    };
}