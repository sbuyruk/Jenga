@page "/test/rol"
@rendermode InteractiveServer
@using Jenga.DataAccess.Services.Common
@using Jenga.Models.Common
@using Jenga.BlazorUI.Services.Common
@inject IRoleService RolService

<h5>Rol Listesi</h5>
<table class="table">
    <thead>
        <tr>
            <th>Adi</th>
            <th>Açıklama</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in ExistingItems)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Aciklama</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private IEnumerable<Role> ExistingItems = new List<Role>();

    private bool _dataLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_dataLoaded)
        {
            var result = await RolService.GetAllAsync();
            ExistingItems = result.IsSuccess ? result.Value : new List<Role>();
            _dataLoaded = true;
            StateHasChanged();
            
        }
    }
}
