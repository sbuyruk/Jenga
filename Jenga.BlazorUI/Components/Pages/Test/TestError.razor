@page "/test/error"
@rendermode InteractiveServer
@inject IErrorService ErrorService

<h3>Error Test Sayfasi</h3>

<div class="d-flex flex-column gap-2 mt-3">
    <button class="btn btn-danger" @onclick="@(() => ErrorService.RaiseError("Hata olustu!", ErrorSeverity.Error))">Error</button>
    <button class="btn btn-warning" @onclick="@(() => ErrorService.RaiseError("Uyari!", ErrorSeverity.Warning))">Warning</button>
    <button class="btn btn-info" @onclick="@(() => ErrorService.RaiseError("Bilgilendirme", ErrorSeverity.Info))">Info</button>
</div>
