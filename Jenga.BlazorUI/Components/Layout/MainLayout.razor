@using Jenga.BlazorUI.Components.Menus
@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Components.Toast
@using Jenga.BlazorUI.Services.Common
@using Jenga.BlazorUI.Services.Presence
@using Microsoft.AspNetCore.Components.Routing

@inherits LayoutComponentBase

@inject MenuStateService MenuState
@inject IHttpContextAccessor HttpContextAccessor
@inject CurrentUserService CurrentUserService
@inject NavigationManager Nav
@inject PresenceHeartbeatService PresenceHeartbeatService
@inject Jenga.BlazorUI.Services.Presence.UserNavigationLogService UserNavigationLogService

<div class="page">
        <input id="navtoggle" type="checkbox" class="nav-toggle-checkbox" aria-label="Toggle navigation"
           @bind="NavChecked" />

        <div class="sidebar @(MenuState.IsOpen ? "open" : (MenuState.IsCollapsed ? "collapsed" : ""))" role="navigation" aria-expanded="@MenuState.IsOpen">
        <NavMenu Items="MenuState.MenuItems" IsCollapsed="@(MenuState.IsCollapsed)" />
    </div>

    <div class="sidebar-overlay @(MenuState.IsOpen ? "visible" : "")" @onclick="CloseSidebar"></div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                <label for="navtoggle" class="sidebar-toggle" aria-controls="main-nav" aria-label="Toggle sidebar" role="button" tabindex="0">
                    <span class="hamburger" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                    <span class="visually-hidden">Toggle sidebar</span>
                </label>

                <div class="header-left" style="display:flex;align-items:center;gap:14px">
                    <img id="logo" alt="Logo" src="/images/logo-light.png" class="site-logo" />
                </div>
            </div>

                        <div class="d-flex align-items-center gap-3">

                <div class="d-flex align-items-center">
                    <NavLink href="/" class="navbar-brand">@(_windowsUser.Length > 0 ? _windowsUser : "Jenga.BlazorUI")</NavLink>
                </div>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _windowsUser = string.Empty;
    private Jenga.Models.IKYS.Personel? _personel;

    // Expose a bindable property that synchronizes with MenuState.
    private bool NavChecked
    {
        get => MenuState.IsOpen;
        set
        {
            if (value == MenuState.IsOpen) return;
            MenuState.SetOpen(value);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _personel = await CurrentUserService.GetCurrentPersonelAsync();
        var personelId = _personel?.Id ?? 127;
        await MenuState.EnsureLoadedAsync(personelId);

        if (_personel != null)
        {
            _windowsUser = $"{_personel.Adi} {_personel.Soyadi}";
        }

        // subscribe to MenuState changes and keep UI in sync
        MenuState.OnChange += MenuStateChanged;

        // subscribe to navigation events so we can reapply theme after client navigation
        Nav.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            // absolute -> relative
            var relative = Nav.ToBaseRelativePath(e.Location);
            var url = "/" + relative.TrimStart('/');

            await UserNavigationLogService.LogAsync(url);
        }
        catch
        {
            // log failure should not break navigation
        }

        await InvokeAsync(StateHasChanged);
    }

    private void MenuStateChanged()
    {
        // MenuState changed externally — re-render so @bind reads the latest value
        InvokeAsync(StateHasChanged);
    }

    private void CloseSidebar()
    {
        MenuState.SetOpen(false);
    }

    private PeriodicTimer? _presenceTimer;
    private CancellationTokenSource? _presenceCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StartPresenceHeartbeat();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void StartPresenceHeartbeat()
    {
        _presenceCts?.Cancel();
        _presenceCts?.Dispose();

        _presenceCts = new CancellationTokenSource();
        _presenceTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));

        _ = Task.Run(async () =>
        {
            try
            {
                while (await _presenceTimer.WaitForNextTickAsync(_presenceCts.Token))
                {
                    await PresenceHeartbeatService.TouchAsync(_presenceCts.Token);
                }
            }
            catch (OperationCanceledException)
            {
                // ignore
            }
        }, _presenceCts.Token);
    }

    public void Dispose()
    {
        MenuState.OnChange -= MenuStateChanged;
        Nav.LocationChanged -= OnLocationChanged;

        _presenceCts?.Cancel();
        _presenceTimer?.Dispose();
        _presenceCts?.Dispose();
    }
}