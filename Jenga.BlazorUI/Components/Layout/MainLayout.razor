@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Components.Shared
@using Jenga.BlazorUI.Components.Toast
@using Jenga.BlazorUI.Services.Common
@using Jenga.BlazorUI.Services.Presence
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@implements IDisposable

@inherits LayoutComponentBase

@inject MenuStateService MenuState
@inject IHttpContextAccessor HttpContextAccessor
@inject CurrentUserService CurrentUserService
@inject NavigationManager Nav
@inject PresenceHeartbeatService PresenceHeartbeatService
@inject UserNavigationLogService UserNavigationLogService
@inject IJSRuntime JS

<div class="page @(MenuState.IsOpen ? "sidebar-open" : "sidebar-closed")">

    <aside class="sidebar" role="navigation" aria-label="Ana menü">
        <NavMenu Items="MenuState.MenuItems" IsCollapsed="@(!MenuState.IsOpen)" />
    </aside>

    @if (MenuState.IsOpen)
    {
        <div class="sidebar-overlay" @onclick="CloseSidebar"></div>
    }

    <div class="main-area">
        <header class="top-row">
            <div class="d-flex align-items-center">
                <button type="button"
                        class="sidebar-toggle"
                        aria-label="Menüyü aç/kapat"
                        @onclick="ToggleSidebar">
                    <span class="hamburger" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <img id="logo" alt="Logo" src="/images/logo-light.png" class="site-logo" />
            </div>

            <div class="d-flex align-items-center gap-3">
                <NavLink href="/" class="navbar-brand">
                    @(_windowsUser.Length > 0 ? _windowsUser : "Jenga.BlazorUI")
                </NavLink>
            </div>
        </header>

        <article class="content px-4">
            <JengaErrorBoundary @ref="_errorBoundary">
                @Body
            </JengaErrorBoundary>
        </article>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _windowsUser = string.Empty;
    private Jenga.Models.IKYS.Personel? _personel;
    private bool _initialUrlLogged;
    private JengaErrorBoundary? _errorBoundary;

    protected override async Task OnInitializedAsync()
    {
        // JS interop is not available during prerender, so skip the impersonation
        // override (sessionStorage) here. It will be applied in OnAfterRenderAsync.
        _personel = await CurrentUserService.GetCurrentPersonelWithoutImpersonationAsync();
        var personelId = _personel?.Id ?? 127;
        await MenuState.EnsureLoadedAsync(personelId);

        if (_personel != null)
            _windowsUser = $"{_personel.Adi} {_personel.Soyadi}";

        MenuState.OnChange += MenuStateChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // JS interop is now available. Re-resolve with impersonation override support
            // (development-only). If the result differs, refresh the UI.
            CurrentUserService.Invalidate();
            var resolved = await CurrentUserService.GetCurrentPersonelAsync();
            if (resolved?.Id != _personel?.Id)
            {
                _personel = resolved;
                var personelId = _personel?.Id ?? 127;
                await MenuState.EnsureLoadedAsync(personelId);
                if (_personel != null)
                    _windowsUser = $"{_personel.Adi} {_personel.Soyadi}";
                StateHasChanged();
            }

            await LogCurrentUrlAsync(source: "firstRender");
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void ToggleSidebar() => MenuState.ToggleOpen();

    private void CloseSidebar() => MenuState.SetOpen(false);

    private void MenuStateChanged() => InvokeAsync(StateHasChanged);

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Sayfa değişince error boundary'yi sıfırla (varsa hatayı temizle).
        _errorBoundary?.Recover();

        try
        {
            var isMobile = await JS.InvokeAsync<bool>("isMobileViewport");
            if (isMobile)
                CloseSidebar();
        }
        catch (JSDisconnectedException) { }

        await LogUrlAsync(e.Location, source: "LocationChanged");
    }

    private Task LogCurrentUrlAsync(string source) => LogUrlAsync(Nav.Uri, source);

    private async Task LogUrlAsync(string absoluteUri, string source)
    {
        try
        {
            if (source == "firstRender")
            {
                if (_initialUrlLogged) return;
                _initialUrlLogged = true;
            }

            var relative = Nav.ToBaseRelativePath(absoluteUri);
            var pathOnly = relative.Split('?', 2)[0];
            var url = "/" + pathOnly.TrimStart('/');

            Console.WriteLine($"[NAV] {source} -> {url}");
            await UserNavigationLogService.LogAsync(url);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"UserNavigationLogService.LogAsync failed ({source}): {ex}");
        }
    }

    private PeriodicTimer? _presenceTimer;
    private CancellationTokenSource? _presenceCts;

    private void StartPresenceHeartbeat()
    {
        _presenceCts?.Cancel();
        _presenceCts?.Dispose();

        _presenceCts = new CancellationTokenSource();
        _presenceTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));

        _ = Task.Run(async () =>
        {
            try
            {
                while (await _presenceTimer.WaitForNextTickAsync(_presenceCts.Token))
                    await PresenceHeartbeatService.TouchAsync(_presenceCts.Token);
            }
            catch (OperationCanceledException) { }
        }, _presenceCts.Token);
    }

    public void Dispose()
    {
        MenuState.OnChange -= MenuStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _presenceCts?.Cancel();
        _presenceTimer?.Dispose();
        _presenceCts?.Dispose();
    }
}