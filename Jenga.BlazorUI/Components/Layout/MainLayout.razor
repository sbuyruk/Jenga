@using Jenga.BlazorUI.Components.Menus
@using Jenga.BlazorUI.Components.Toast
@using Jenga.BlazorUI.Services.Common
@inherits LayoutComponentBase

@inject IJSRuntime JS
@inject MenuStateService MenuState
@inject IHttpContextAccessor HttpContextAccessor
@inject CurrentUserService CurrentUserService
@inject MenuStateService MenuStateService

<div class="page">
    <div class="sidebar">
        <NavMenu Items="MenuState.MenuItems" />
    </div>
    <main>
        <div class="top-row px-4">
            <ThemeSwitcher />
            <NavLink href="/" class="navbar-brand">@(_windowsUser.Length > 0 ? _windowsUser : "Jenga.BlazorUI")</NavLink>
        </div>

        <article class="content px-4">
            @Body
            
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<header>
  <div class="top-right">
    @if (_personel != null)
    {
        <span>@_personel.Adi @_personel.Soyadi</span>
    }
    else
    {
        <span>Guest</span>
    }
  </div>
</header>

@code {
    private bool _initialized;
    private string _windowsUser = string.Empty;
    private Jenga.Models.IKYS.Personel? _personel;

    protected override async Task OnInitializedAsync()
    {
        // Menü verisini yüklüyoruz
   

        _personel = await CurrentUserService.GetCurrentPersonelAsync();
        var personelId = _personel?.Id ?? 127; // fallback if needed
        await MenuStateService.EnsureLoadedAsync(personelId);

        if (_personel != null)
        {
            _windowsUser = $"{_personel.Adi} {_personel.Soyadi}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            var theme = await JS.InvokeAsync<string>("getBootstrapTheme");
            await JS.InvokeVoidAsync("setBootstrapTheme", theme);
            _initialized = true;
        }
    }
}

