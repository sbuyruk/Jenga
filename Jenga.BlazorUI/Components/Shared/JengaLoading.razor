@if (Inline)
{
    <span class="jenga-loading-inline" role="status" aria-label="@Message"><JengaBrand /></span>
}
else if (!IsSplash)
{
    <div class="jenga-loading jenga-loading--waiting" role="status" aria-live="polite" aria-label="@Message">
        <div class="jenga-loading__content">
            <JengaBrand SymbolOnly="true" />
            <p class="jenga-loading__message">@Message <span class="jenga-loading__dots" aria-hidden="true"><i></i><i></i><i></i></span></p>
        </div>
    </div>
}
else
{
    <div class="jenga-loading jenga-loading--splash" role="status" aria-live="polite" aria-label="Çalışma alanınız hazırlanıyor">
        <div class="jenga-loading__content">
            <div class="jenga-loading__identity">
                <JengaBrand />
                <p class="jenga-loading__expansion" lang="en"><span><strong>J</strong>oint <strong>E</strong>nvironment for</span> <span><strong>N</strong>ext-<strong>G</strong>eneration <strong>A</strong>pplications</span></p>
            </div>
            <div class="jenga-loading__copy">
                <h2 class="jenga-loading__title">
                    Çalışma alanınız hazırlanıyor
                    <span class="jenga-loading__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                </h2>
            </div>
        </div>
        <footer class="jenga-loading__footer"><span>TSK Güçlendirme Vakfı</span><span>Jenga™ — Bilgi Sistemleri tarafından geliştirilmiştir.</span></footer>
    </div>
}

@code {
    [Parameter] public bool IsSplash { get; set; }
    [Parameter] public bool Inline { get; set; }
    [Parameter] public string Message { get; set; } = "Veriler hazırlanıyor.";
}
