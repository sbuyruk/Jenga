@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.Common
@using Jenga.Models.Common
@using System.ComponentModel.DataAnnotations
@inject IToastService ToastService
@inject IModalService ModalService
@inject IMenuItemService MenuItemService

<div class="d-flex justify-content-end mb-2">
    <button class="btn btn-success" @onclick="OpenNewMenuModal" type="button">
        <i class="bi bi-plus-lg"></i> Yeni Menü
    </button>
</div>

@if (Menus?.Any() != true)
{
    <p>Menü bulunamadi.</p>
}
else
{
    <GenericTable TItem="MenuRow"
                  Items="menuRows"
                  PageSize="10"
                  TableHeight="Auto"
                  ShowSearch="true"
                  ShowExport="true"
                  ExportFileName="menuler-export.xlsx"
                  KeySelector="(r => r.Id)">
        <RowTemplate Context="row">
            <td>@row.Id</td>
            <td>@row.Title</td>
            <td>@row.Url</td>
            <td>@row.ParentTitle</td>
            <td>@(row.IsVisible ? "Evet" : "Hayir")</td>
            <td>
                <button class="btn btn-sm btn-primary me-2" @onclick="() => OnEditClicked(row.Original)">Düzenle</button>
                <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteClicked(row.Original)">Sil</button>
            </td>
        </RowTemplate>
    </GenericTable>
}

@if (showEditModal && selectedMenuItem != null)
{
    <MenuItemEditModal Menu="@selectedMenuItem"
                       IsOpen="true"
                       AllMenuItems="@Menus"
                       OnSave="HandleSave"
                       OnClose="HideModal" />
}

@code {
    [Parameter] public List<MenuItem> Menus { get; set; } = new();

    private MenuItem? selectedMenuItem { get; set; }
    private bool showEditModal = false;

    // Rows used by GenericTable (DTO wrapper so GenericTable auto-headers work and display names can be applied)
    private List<MenuRow> menuRows = new();

    protected override void OnParametersSet()
    {
        BuildMenuRows();
    }

    private void BuildMenuRows()
    {
        menuRows = Menus.Select(m => new MenuRow(m, Menus)).ToList();
    }

    private async Task OnEditClicked(MenuItem item)
    {
        selectedMenuItem = item;
        showEditModal = true;
    }

    private void OnDeleteClicked(MenuItem item)
    {
        if (item == null)
            return;

        var hasChildren = Menus.Any(m => m.ParentId == item.Id);
        if (hasChildren)
        {
            var childTitles = Menus
                .Where(m => m.ParentId == item.Id)
                .Select(m => m.Title)
                .Where(title => !string.IsNullOrEmpty(title))
                .ToList();

            var childList = string.Join(", ", childTitles);
            var message = "Önce alt menüler silinmelidir.";
            if (childTitles.Count > 0)
            {
                message += $" Alt menüler: {childList}";
            }

            ToastService.ShowToast(message, ToastType.Error, 5000);
            return;
        }

        ModalService.ShowConfirmation(
            "Silme Onayi",
            $"'{item.Title}' menüsünü silmek istediginizden emin misiniz?",
            async result =>
            {
                if (result)
                {
                    var deleted = await MenuItemService.DeleteAsync(item);
                    if (deleted.IsSuccess)
                    {
                        ToastService.ShowToast($"{item.Title} silindi", ToastType.Success, 3000);
                        Menus.Remove(item);
                        // remove corresponding row
                        var row = menuRows.FirstOrDefault(r => r.Original == item || r.Id == item.Id);
                        if (row != null) menuRows.Remove(row);
                        StateHasChanged();
                    }
                    else
                    {
                        ToastService.ShowToast($"Silme islemi basarisiz: {deleted.Error.Message}", ToastType.Error, 4000);
                    }
                }
            });
    }

    // NOTE: Changed signature to accept the MenuItem passed from the modal and return Task.
    // This prevents a race condition where the modal's OnClose clears selectedMenuItem before the async save completes.
    private async Task HandleSave(MenuItem menu)
    {
        if (menu != null)
        {
            if (menu.Id == 0)
            {
                // Add
                var saved = await MenuItemService.AddAsync(menu);
                if (saved.IsSuccess)
                {
                    Menus.Add(menu);
                    ToastService.ShowToast("Yeni menü eklendi", ToastType.Success, 3000);
                    menuRows.Add(new MenuRow(menu, Menus));
                }
                else
                {
                    ToastService.ShowToast($"Ekleme basarisiz: {saved.Error.Message}", ToastType.Error, 4000);
                }
            }
            else
            {
                var updated = await MenuItemService.UpdateAsync(menu);
                if (updated.IsSuccess)
                {
                    ToastService.ShowToast($"{menu.Title} güncellendi", ToastType.Success, 3000);
                    // update row
                    var row = menuRows.FirstOrDefault(r => r.Id == menu.Id);
                    if (row != null) row.UpdateFrom(menu, Menus);
                }
                else
                {
                    ToastService.ShowToast($"Güncelleme basarisiz: {updated.Error.Message}", ToastType.Error, 4000);
                }
            }

            showEditModal = false;
            StateHasChanged();
        }
    }

    private void HideModal()
    {
        selectedMenuItem = null;
        showEditModal = false;
    }

    private void OpenNewMenuModal()
    {
        selectedMenuItem = new MenuItem();
        showEditModal = true;
    }

    // DTO wrapper used only for UI table rendering and sorting labels
    private class MenuRow
    {
        public int Id { get; private set; }

        [Display(Name = "Baslik")]
        public string Title { get; private set; } = string.Empty;

        [Display(Name = "Url")]
        public string Url { get; private set; } = string.Empty;

        [Display(Name = "Üst Menüsü")]
        public string ParentTitle { get; private set; } = string.Empty;

        [Display(Name = "Görünür")]
        public bool IsVisible { get; private set; }

        // Keep original so action buttons can pass the real model to modals/services

        [Display(Name ="Islemler")]
        public MenuItem Original { get; private set; }

        public MenuRow(MenuItem item, IEnumerable<MenuItem> all)
        {
            Original = item;
            UpdateFrom(item, all);
        }

        public void UpdateFrom(MenuItem item, IEnumerable<MenuItem> all)
        {
            Id = item.Id;
            Title = item.Title ?? string.Empty;
            Url = item.Url ?? string.Empty;
            IsVisible = item.IsVisible == true;
            ParentTitle = string.Empty;
            if (item.ParentId.HasValue)
            {
                var p = all.FirstOrDefault(x => x.Id == item.ParentId.Value);
                ParentTitle = p?.Title ?? string.Empty;
            }
        }
    }
}