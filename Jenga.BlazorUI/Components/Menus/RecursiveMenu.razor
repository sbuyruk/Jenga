@using Jenga.Models.Common
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Nav

<ul class="recursive-menu">
    @foreach (var item in Items ?? Enumerable.Empty<MenuItem>())
    {
        <li class="menu-item @(item.IsExpanded ? "open" : "") @(item.IsActive ? "active" : "")">
            @if (!string.IsNullOrEmpty(item.Url) && (item.Children == null || !item.Children.Any()))
            {
                <a href="@item.Url"
                   class="menu-header nav-link"
                   @onclick="(e) => OnNavigate(e, item.Url)"
                   @onclick:preventDefault>
                    <span class="menu-title">@item.Title</span>
                </a>
            }
            else
            {
                <div class="menu-header"
                     @onclick="() => Toggle(item)"
                     @onclick:stopPropagation>
                    <span class="menu-title">@item.Title</span>
                    @if (item.Children?.Any() == true)
                    {
                        <span class="toggle-icon @(item.IsExpanded ? "rotated" : "")">
                            <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M8 5v14l11-7z" />
                            </svg>
                        </span>
                    }
                </div>
            }

            @if (item.IsExpanded && item.Children?.Any() == true)
            {
                <ul class="submenu show">
                    <RecursiveMenu Items="item.Children" />
                </ul>
            }
        </li>
    }
</ul>

@code {
    [Parameter]
    public List<MenuItem> Items { get; set; } = new();

    protected override void OnInitialized()
    {
        // update active flags at startup
        SetActiveRecursive(Items);
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SetActiveRecursive(Items);
        InvokeAsync(StateHasChanged);
    }

    private void Toggle(MenuItem item)
    {
        item.IsExpanded = !item.IsExpanded;
    }

    private void SetActiveRecursive(List<MenuItem> items)
    {
        var fullUri = Nav.Uri.ToLowerInvariant();
        var currentUrl = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/').ToLowerInvariant();

        foreach (var item in items)
        {
            var normalizedItemUrl = item.Url?.TrimStart('/').ToLowerInvariant();
            item.IsActive = (!string.IsNullOrWhiteSpace(normalizedItemUrl)
                             && (currentUrl == normalizedItemUrl || fullUri.EndsWith(normalizedItemUrl)));

            if (item.Children?.Any() == true)
            {
                SetActiveRecursive(item.Children);
                if (item.Children.Any(c => c.IsActive))
                    item.IsActive = true;
            }
        }
    }

    private void OnNavigate(MouseEventArgs e, string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return;

        // Normalize URLs:
        // - If absolute and host equals current host => use path+query for client-side navigation
        // - If path/relative => ensure it starts with '/' and NavigateTo
        // - If external => allow full load (forceLoad:true) so user can still reach external resource
        if (Uri.TryCreate(url, UriKind.Absolute, out var abs))
        {
            try
            {
                var baseUri = new Uri(Nav.BaseUri);
                if (string.Equals(abs.Host, baseUri.Host, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(abs.Scheme, baseUri.Scheme, StringComparison.OrdinalIgnoreCase))
                {
                    var path = abs.PathAndQuery + abs.Fragment;
                    Nav.NavigateTo(path, forceLoad: false);
                    return;
                }
            }
            catch
            {
                // fallback below
            }

            // external/other host -> full load
            Nav.NavigateTo(url, forceLoad: true);
            return;
        }

        // relative/partial path
        var normalized = url.StartsWith("/") ? url : "/" + url;
        Nav.NavigateTo(normalized, forceLoad: false);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}