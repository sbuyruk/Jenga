@using System.ComponentModel.DataAnnotations
@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Repositories.IRepository
@using Jenga.DataAccess.Services.Common
@using Jenga.Models
@using Jenga.Models.Common
@using Jenga.Models.IKYS

@using Jenga.Utility.Toast
@using System.ComponentModel
@inject IModalService ModalService
@inject IRoleService RolService
@inject IUnitOfWork UnitOfWork
@inject IToastService ToastService

<div class="d-flex justify-content-end mb-2">
    <button class="btn btn-success" @onclick="OpenNewRolModal" type="button">
        <i class="bi bi-plus-lg"></i> Yeni Rol
    </button>
</div>

@if (Roles?.Any() != true)
{
    <p>Rol bulunamadı.</p>
}
else
{
    <GenericTable TItem="RoleRow"
                  Items="roleRows"
                  PageSize="10"
                  TableHeight="Auto"
                  ShowSearch="true"
                  ShowExport="true"
                  ExportFileName="roller-export.xlsx"
                  KeySelector="(r => r.Id)">
        <RowTemplate Context="row">
            <td>@row.Name</td>
            <td>@row.Aciklama</td>
            <td>
                <button class="btn btn-sm btn-primary me-2" @onclick="() => OnEditClicked(row.Original)">Düzenle</button>
                <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteClicked(row.Original)">Sil</button>
            </td>
        </RowTemplate>
    </GenericTable>
}

@if (showEditModal && selectedRol != null && personelList != null && menuList != null)
{
    <RolEditModal Role="@selectedRol"
                  PersonelList="@personelList"
                  MenuList="@menuList"
                  IsOpen="true"
                  OnSave="HandleSave"
                  OnClose="HideModal" />
}

@code {
    [Parameter] public List<Role> Roles { get; set; } = new();
    private Role? selectedRol { get; set; }
    private List<Personel>? personelList { get; set; }
    private List<MenuItem>? menuList { get; set; }
    private bool showEditModal = false;

    // DTO rows for GenericTable
    private List<RoleRow> roleRows = new();

    protected override void OnParametersSet()
    {
        BuildRoleRows();
    }

    private void BuildRoleRows()
    {
        roleRows = Roles.Select(r => new RoleRow(r)).ToList();
    }

    private async Task OnEditClicked(Role rol)
    {
        selectedRol = await RolService.GetByIdWithRelationsAsync(rol.Id);
        var aktifPersoneller = (await UnitOfWork.Personel.GetAllAsync("IsBilgileri"))
            .Where(p => p.IsBilgileri != null && p.IsBilgileri.CalismaDurumu == "1")
            .Where(p => selectedRol?.PersonelRoles == null || !selectedRol.PersonelRoles!.Any(pr => pr.PersonelId == p.Id))
            .ToList();

        var aktifMenuler = (await UnitOfWork.MenuItem.GetAllAsync())
            .Where(p => p.IsVisible == true)
            .Where(p => selectedRol?.RoleMenus == null || !selectedRol.RoleMenus!.Any(rm => rm.MenuId == p.Id))
            .ToList();

        personelList = aktifPersoneller;
        menuList = aktifMenuler;
        showEditModal = true;
    }

    private void OnDeleteClicked(Role role)
    {
        ModalService.ShowConfirmation(
            "Silme Onayı",
            $"'{role.Name}' rolünü silmek istediğinizden emin misiniz?",
            async result =>
            {
                if (result)
                {
                    await RolService.DeleteAsync(role);
                    Roles.Remove(role);
                    var row = roleRows.FirstOrDefault(r => r.Original == role || r.Id == role.Id);
                    if (row != null) roleRows.Remove(row);
                    StateHasChanged();
                    ToastService.ShowToast($"{role.Name} silindi", ToastType.Success, 3000);
                }
            });
    }

    private async Task HandleSave()
    {
        if (selectedRol == null) return;

        if (selectedRol.Id == 0)
        {
            var ok = await RolService.AddWithRelationsAsync(selectedRol);
            if (ok)
            {
                ToastService.ShowToast(selectedRol.Name + " eklendi", ToastType.Success, 3000);
                Roles.Add(selectedRol);
                roleRows.Add(new RoleRow(selectedRol));
            }
            else
            {
                ToastService.ShowToast("Ekleme başarısız oldu", ToastType.Error, 3000);
            }
        }
        else
        {
            var ok = await RolService.UpdateWithRelationsAsync(selectedRol);
            if (ok)
            {
                ToastService.ShowToast(selectedRol.Name + " güncellendi", ToastType.Info, 3000);
                var row = roleRows.FirstOrDefault(r => r.Id == selectedRol.Id);
                if (row != null) row.UpdateFrom(selectedRol);
            }
            else
            {
                ToastService.ShowToast("Güncelleme başarısız oldu", ToastType.Error, 3000);
            }
        }

        showEditModal = false;
        StateHasChanged();
    }

    private void HideModal()
    {
        selectedRol = null;
        showEditModal = false;
    }

    private async Task OpenNewRolModal()
    {
        selectedRol = new Role();
        var aktifPersoneller = (await UnitOfWork.Personel.GetAllAsync("IsBilgileri"))
            .Where(p => p.IsBilgileri != null && p.IsBilgileri.CalismaDurumu == "1")
            .ToList();

        var aktifMenuler = (await UnitOfWork.MenuItem.GetAllAsync())
            .Where(p => p.IsVisible == true)
            .ToList();

        personelList = aktifPersoneller;
        menuList = aktifMenuler;
        showEditModal = true;
    }

    // DTO wrapper for UI table
    private class RoleRow
    {
        [Browsable(false)]
        public int Id { get; private set; }

        [Display(Name = "Ad")]
        public string Name { get; private set; } = string.Empty;

        [Display(Name = "Açıklama")]
        public string Aciklama { get; private set; } = string.Empty;
        
        [Display(Name = "İşlemler")]
        public Role Original { get; private set; }

        public RoleRow(Role r)
        {
            Original = r;
            UpdateFrom(r);
        }

        public void UpdateFrom(Role r)
        {
            Id = r.Id;
            Name = r.Name ?? string.Empty;
            Aciklama = r.Aciklama ?? string.Empty;
            Original = r;
        }
    }
}