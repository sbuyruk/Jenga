@using System.ComponentModel.DataAnnotations
@using Jenga.BlazorUI.Components.Common
@using Jenga.BlazorUI.Services.Common
@using Jenga.DataAccess.Services.Common
@using Jenga.DataAccess.Services.IKYS
@using Jenga.Models
@using Jenga.Models.Common
@using Jenga.Models.IKYS

@using System.ComponentModel
@inject IModalService ModalService
@inject IRoleService RolService
@inject IPersonelService PersonelService
@inject IMenuItemService MenuItemService
@inject IToastService ToastService

@if (CanCreate)
{
<div class="d-flex justify-content-end mb-2">
    <button class="btn btn-success" @onclick="OpenNewRolModal" type="button">
        <i class="bi bi-plus-lg"></i> Yeni Rol
    </button>
</div>
}

@if (Roles?.Any() != true)
{
    <p>Rol bulunamadi.</p>
}
else
{
    <GenericTable TItem="RoleRow"
                  Items="roleRows"
                  PageSize="10"
                  TableHeight="Auto"
                  ShowSearch="true"
                  ShowExport="true"
                  ExportFileName="roller-export.xlsx"
                  KeySelector="(r => r.Id)">
        <RowTemplate Context="row">
            <td>@row.Name</td>
            <td>@row.Aciklama</td>
            <td>
                @if (CanEdit)
                {
                    <button class="btn btn-sm btn-primary me-2" @onclick="() => OnEditClicked(row.Original)">Düzenle</button>
                }
                @if (CanDelete)
                {
                    <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteClicked(row.Original)">Sil</button>
                }
            </td>
        </RowTemplate>
    </GenericTable>
}

@if (showEditModal && selectedRol != null && personelList != null && menuList != null)
{
    <RolEditModal Role="@selectedRol"
                  PersonelList="@personelList"
                  MenuList="@menuList"
                  IsOpen="true"
                  OnSave="HandleSave"
                  OnClose="HideModal" />
}

@code {
    [Parameter] public List<Role> Roles { get; set; } = new();

    // Mutasyon oldugunda parent yeniden yüklesin/karar versin diye event tabanli bildirim.
    // RoleTable artik parent'in Roles listesini dogrudan mutate ETMEZ.
    [Parameter] public EventCallback<Role> OnRoleAdded { get; set; }
    [Parameter] public EventCallback<Role> OnRoleUpdated { get; set; }
    [Parameter] public EventCallback<Role> OnRoleDeleted { get; set; }
    [Parameter] public bool CanCreate { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }

    private Role? selectedRol { get; set; }
    private List<Personel>? personelList { get; set; }
    private List<MenuItem>? menuList { get; set; }
    private bool showEditModal = false;

    // DTO rows for GenericTable
    private List<RoleRow> roleRows = new();

    protected override void OnParametersSet()
    {
        BuildRoleRows();
    }

    private void BuildRoleRows()
    {
        roleRows = Roles.Select(r => new RoleRow(r)).ToList();
    }

    private async Task OnEditClicked(Role rol)
    {
        var roleResult = await RolService.GetByIdWithRelationsAsync(rol.Id);
        if (roleResult.IsFailure)
        {
            ToastService.ShowToast(roleResult.Error.Message, ToastType.Error, 4000);
            return;
        }
        selectedRol = roleResult.Value;

        var calisanResult = await PersonelService.GetCalisanPersonelAsync();
        var calisanList = calisanResult.IsSuccess ? calisanResult.Value : new List<Personel>();
        var aktifPersoneller = calisanList
            .Where(p => selectedRol?.PersonelRoles == null || !selectedRol.PersonelRoles!.Any(pr => pr.PersonelId == p.Id))
            .ToList();

        var menuResult1 = await MenuItemService.GetAllAsync();
        var aktifMenuler = (menuResult1.IsSuccess ? menuResult1.Value : new List<MenuItem>())
            .Where(p => p.IsVisible == true)
            .Where(p => selectedRol?.RoleMenus == null || !selectedRol.RoleMenus!.Any(rm => rm.MenuId == p.Id))
            .ToList();

        personelList = aktifPersoneller;
        menuList = aktifMenuler;
        showEditModal = true;
    }

    private void OnDeleteClicked(Role role)
    {
        // ShowConfirmation Action<bool> aliyor; içinde await kullanmak için
        // gerçek bir async metoda fire-and-forget yapiyoruz. Exception'lar
        // metot içinde yakalanip toast'lanir; render güncellemesi InvokeAsync
        // ile render thread'inde tetiklenir.
        ModalService.ShowConfirmation(
            "Silme Onayi",
            $"'{role.Name}' rolünü silmek istediginizden emin misiniz?",
            result =>
            {
                if (!result) return;
                _ = HandleDeleteAsync(role);
            });
    }

    private async Task HandleDeleteAsync(Role role)
    {
        var result = await RolService.DeleteAsync(role);
        await InvokeAsync(async () =>
        {
            if (result.IsSuccess)
            {
                ToastService.ShowToast($"{role.Name} silindi", ToastType.Success, 3000);
                await OnRoleDeleted.InvokeAsync(role);
            }
            else
            {
                ToastService.ShowToast($"Silme basarisiz: {result.Error.Message}", ToastType.Error, 4000);
            }
            StateHasChanged();
        });
    }

    private async Task HandleSave()
    {
        if (selectedRol == null) return;

        if (selectedRol.Id == 0)
        {
            var result = await RolService.AddWithRelationsAsync(selectedRol);
            if (result.IsSuccess)
            {
                ToastService.ShowToast(selectedRol.Name + " eklendi", ToastType.Success, 3000);
                await OnRoleAdded.InvokeAsync(selectedRol);
            }
            else
            {
                ToastService.ShowToast($"Ekleme basarisiz: {result.Error.Message}", ToastType.Error, 4000);
            }
        }
        else
        {
            var result = await RolService.UpdateWithRelationsAsync(selectedRol);
            if (result.IsSuccess)
            {
                ToastService.ShowToast(selectedRol.Name + " güncellendi", ToastType.Info, 3000);
                // Yerel DTO'yu da güncelle ki parent yeniden yüklemese bile UI tutarli kalsin.
                var row = roleRows.FirstOrDefault(r => r.Id == selectedRol.Id);
                row?.UpdateFrom(selectedRol);
                await OnRoleUpdated.InvokeAsync(selectedRol);
            }
            else
            {
                ToastService.ShowToast($"Güncelleme basarisiz: {result.Error.Message}", ToastType.Error, 4000);
            }
        }

        showEditModal = false;
        StateHasChanged();
    }

    private void HideModal()
    {
        selectedRol = null;
        showEditModal = false;
    }

    private async Task OpenNewRolModal()
    {
        selectedRol = new Role();
        var calisanResult = await PersonelService.GetCalisanPersonelAsync();
        var aktifPersoneller = calisanResult.IsSuccess ? calisanResult.Value : new List<Personel>();

        var menuResult2 = await MenuItemService.GetAllAsync();
        var aktifMenuler = (menuResult2.IsSuccess ? menuResult2.Value : new List<MenuItem>())
            .Where(p => p.IsVisible == true)
            .ToList();

        personelList = aktifPersoneller;
        menuList = aktifMenuler;
        showEditModal = true;
    }

    // DTO wrapper for UI table
    private class RoleRow
    {
        [Browsable(false)]
        public int Id { get; private set; }

        [Display(Name = "Ad")]
        public string Name { get; private set; } = string.Empty;

        [Display(Name = "Açiklama")]
        public string Aciklama { get; private set; } = string.Empty;
        
        [Display(Name = "Islemler")]
        public Role Original { get; private set; }

        public RoleRow(Role r)
        {
            Original = r;
            UpdateFrom(r);
        }

        public void UpdateFrom(Role r)
        {
            Id = r.Id;
            Name = r.Name ?? string.Empty;
            Aciklama = r.Aciklama ?? string.Empty;
            Original = r;
        }
    }
}